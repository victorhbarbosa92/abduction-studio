        void renderRekordboxTransportSection(KuroAudio::DJDeck& deck, ImVec2 pos, float w, float h) {
            // Caixa de loop superior
            renderRekordboxLoopBox(deck, pos, w);

            float lower_y = pos.y + 70.0f;
            float col_w = (w - 4.0f) * 0.5f;

            // Coluna Esquerda: INT v, CUE, PLAY
            float left_x = pos.x;
            ImGui::SetCursorScreenPos(ImVec2(left_x, lower_y));
            ImGui::SmallButton("INT v##D1");

            float r_btn = 20.0f;
            float btn_cx = left_x + col_w * 0.5f;
            float cue_cy = lower_y + 24.0f + r_btn;
            float play_cy = cue_cy + r_btn * 2.0f + 12.0f;

            bool at_cue = (std::abs(deck.current_frame - deck.cue_frame) <= deck.sample_rate * 0.04);
            bool blink_phase = ((int)(ImGui::GetTime() * 4.0) % 2 == 0);

            bool cue_lit = false;
            ImU32 cue_ring_col = IM_COL32(255, 140, 0, 255);
            if (deck.cue_active) {
                cue_lit = true;
                cue_ring_col = IM_COL32(255, 185, 40, 255);
            } else if (!deck.is_playing) {
                if (at_cue) {
                    cue_lit = true;
                    cue_ring_col = IM_COL32(255, 145, 0, 255);
                } else {
                    cue_lit = blink_phase;
                    cue_ring_col = blink_phase ? IM_COL32(255, 145, 0, 255) : IM_COL32(75, 45, 15, 160);
                }
            } else {
                cue_lit = false;
                cue_ring_col = IM_COL32(110, 75, 25, 160);
            }

            renderPioneerRoundButton("CUE", ImVec2(btn_cx, cue_cy), r_btn, cue_ring_col, IM_COL32(18, 14, 8, 255), cue_lit,
                [&]() { deck.pressCue(); },
                [&]() { deck.releaseCue(); }
            );

            bool play_lit = false;
            ImU32 play_ring_col = IM_COL32(0, 240, 90, 255);
            if (deck.is_playing && !deck.cue_active) {
                play_lit = true;
                play_ring_col = IM_COL32(0, 255, 100, 255);
            } else {
                play_lit = blink_phase;
                play_ring_col = blink_phase ? IM_COL32(0, 240, 90, 255) : IM_COL32(15, 65, 35, 160);
            }

            renderPioneerRoundButton("PLAY", ImVec2(btn_cx, play_cy), r_btn, play_ring_col, IM_COL32(8, 18, 12, 255), play_lit,
                [&]() { deck.togglePlay(); }
            );

            // Coluna Direita: SLIP, Q, MT
            float right_x = pos.x + col_w + 4.0f;
            ImGui::SetCursorScreenPos(ImVec2(right_x, lower_y));

            if (deck.slip_mode) {
                if (deck.is_slipping) {
                    float pulse = (std::sin((float)ImGui::GetTime() * 16.0f) + 1.0f) * 0.5f;
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(1.0f, 0.25f + pulse * 0.45f, 0.0f, 1.0f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1, 1, 1, 1));
                } else {
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(1.0f, 0.55f, 0.0f, 1.0f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0, 0, 0, 1));
                }
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.15f, 0.20f, 0.85f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button(deck.is_slipping ? "SLIP ⚡##D1" : "SLIP##D1", ImVec2(col_w, 18.0f))) deck.slip_mode = !deck.slip_mode;
            ImGui::PopStyleColor(2);
            if (ImGui::IsItemHovered()) {
                if (deck.is_slipping) ImGui::SetTooltip("SLIP ATIVO: Posição virtual avançando no fundo!\nSolte o scratch/loop para snap perfeito na cabeça do compasso.");
                else ImGui::SetTooltip("SLIP MODE (Pioneer CDJ-3000):\nPermite scratch, loops e hot cues sem perder o andamento original da faixa (Tecla L).");
            }

            ImGui::SetCursorScreenPos(ImVec2(right_x, lower_y + 24.0f));
            if (deck.quantize_active) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.0f, 0.85f, 0.35f, 0.95f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0, 0, 0, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.15f, 0.20f, 0.85f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button("Q##D1", ImVec2(col_w, 18.0f))) deck.quantize_active = !deck.quantize_active;
            ImGui::PopStyleColor(2);

            ImGui::SetCursorScreenPos(ImVec2(right_x, lower_y + 48.0f));
            if (deck.key_sync_active) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.0f, 0.52f, 1.0f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1, 1, 1, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.15f, 0.20f, 0.85f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button("MT##D1", ImVec2(col_w, 18.0f))) deck.key_sync_active = !deck.key_sync_active;
            ImGui::PopStyleColor(2);
        }

        void renderRekordboxPitchFaderWidget(KuroAudio::DJDeck& deck, ImVec2 pos, ImVec2 size, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
            ImFont* f_reg = g_font_rekordbox_regular ? g_font_rekordbox_regular : ImGui::GetFont();

            // 1. Chassi metálico obsidian do Pitch Fader
            dl->AddRectFilled(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(10, 12, 17, 255), 4.0f);
            dl->AddRect(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(30, 38, 50, 220), 4.0f, 0, 1.0f);

            // 2. Header: Label "TEMPO" + Valor "%" em destaque + Botões de Range e MT
            float hdr_h = 36.0f;
            dl->AddRectFilled(pos, ImVec2(pos.x + size.x, pos.y + hdr_h), IM_COL32(16, 20, 28, 255), 4.0f, ImDrawFlags_RoundCornersTop);
            dl->AddLine(ImVec2(pos.x, pos.y + hdr_h), ImVec2(pos.x + size.x, pos.y + hdr_h), IM_COL32(34, 44, 58, 220), 1.0f);

            // Linha 1 do Header: TEMPO e Botão MT (Key Lock)
            float mt_w = (size.x < 70.0f) ? 22.0f : 26.0f;
            float mt_h = 14.0f;
            ImVec2 mt_pos = ImVec2(pos.x + size.x - mt_w - 4.0f, pos.y + 3.0f);
            char mt_id[32]; snprintf(mt_id, sizeof(mt_id), "MT##PF_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(mt_pos);
            if (deck.key_sync_active) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.0f, 0.55f, 1.0f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1, 1, 1, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.16f, 0.22f, 0.9f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button(mt_id, ImVec2(mt_w, mt_h))) {
                deck.key_sync_active = !deck.key_sync_active;
            }
            ImGui::PopStyleColor(2);

            // Texto TEMPO com clipping para nunca encavalar no botão MT
            dl->PushClipRect(ImVec2(pos.x + 4.0f, pos.y + 2.0f), ImVec2(mt_pos.x - 2.0f, pos.y + 18.0f), true);
            dl->AddText(f_bld, 10.0f, ImVec2(pos.x + 5.0f, pos.y + 3.5f), IM_COL32(170, 185, 205, 230), "TEMPO");
            dl->PopClipRect();

            // Linha 2 do Header: Valor Numérico do Pitch e Botão de Range
            char val_str[32];
            if (std::abs(deck.pitch_percent) < 0.005f) {
                snprintf(val_str, sizeof(val_str), "±0.00%%");
            } else {
                snprintf(val_str, sizeof(val_str), "%+.2f%%", deck.pitch_percent);
            }
            for (char* p = val_str; *p; ++p) { if (*p == ',') *p = '.'; }

            // Se estiver em 0.00%, brilha em VERDE NEON (LED 0% Pioneer Rekordbox)
            bool is_center_zero = (std::abs(deck.pitch_percent) < 0.02f);
            ImU32 col_val = is_center_zero ? IM_COL32(0, 240, 120, 255) : IM_COL32(235, 245, 255, 255);

            const char* rg_str = (deck.pitch_range >= 90.0f) ? "WIDE" : (deck.pitch_range >= 15.0f ? "16%" : (deck.pitch_range >= 9.0f ? "10%" : "6%"));
            float rg_w = (size.x < 70.0f) ? 24.0f : 30.0f;
            float rg_h = 14.0f;
            ImVec2 rg_pos = ImVec2(pos.x + size.x - rg_w - 4.0f, pos.y + 19.0f);
            char rg_id[32]; snprintf(rg_id, sizeof(rg_id), "%s##PFRG_%d", rg_str, deck.deck_id);
            ImGui::SetCursorScreenPos(rg_pos);
            ImGui::PushStyleColor(ImGuiCol_Button, (deck.pitch_range >= 90.0f) ? ImVec4(0.6f, 0.1f, 0.15f, 0.9f) : ImVec4(0.14f, 0.18f, 0.24f, 0.9f));
            ImGui::PushStyleColor(ImGuiCol_Text, (deck.pitch_range >= 90.0f) ? ImVec4(1.0f, 0.3f, 0.35f, 1.0f) : ImVec4(0.85f, 0.9f, 1.0f, 1.0f));
            if (ImGui::Button(rg_id, ImVec2(rg_w, rg_h))) {
                if (deck.pitch_range < 8.0f) deck.pitch_range = 10.0f;
                else if (deck.pitch_range < 12.0f) deck.pitch_range = 16.0f;
                else if (deck.pitch_range < 20.0f) deck.pitch_range = 100.0f;
                else deck.pitch_range = 6.0f;
            }
            ImGui::PopStyleColor(2);

            // Texto de valor do pitch com clipping para não encavalar no botão de Range
            dl->PushClipRect(ImVec2(pos.x + 4.0f, pos.y + 18.0f), ImVec2(rg_pos.x - 2.0f, pos.y + 35.0f), true);
            float v_font_sz = (size.x < 70.0f) ? 10.5f : 12.0f;
            dl->AddText(f_bld, v_font_sz, ImVec2(pos.x + 5.0f, pos.y + 20.0f), col_val, val_str);
            dl->PopClipRect();

            // 3. Fader Track Vertical (Slot harmônico estilo Pioneer Rekordbox)
            float track_top = pos.y + hdr_h + 10.0f;
            float track_bot = pos.y + size.y - 12.0f;
            float track_h   = track_bot - track_top;
            float track_cx  = pos.x + size.x * 0.46f;
            float slot_w    = 7.0f;

            // Interação com o Fader (Submetido PRIMEIRO para zero latência visual e hit test prioritário)
            char fdr_btn_id[32]; snprintf(fdr_btn_id, sizeof(fdr_btn_id), "##PitchFaderHit_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(ImVec2(pos.x + 2.0f, track_top - 6.0f));
            ImGui::InvisibleButton(fdr_btn_id, ImVec2(size.x - 4.0f, track_h + 12.0f));
            bool fdr_active = ImGui::IsItemActive();
            bool fdr_hovered = ImGui::IsItemHovered();

            if (fdr_active) {
                float my = ImGui::GetMousePos().y;
                float new_norm = (my - track_top) / track_h;
                new_norm = std::clamp(new_norm, 0.0f, 1.0f);
                float target_pitch = -deck.pitch_range + new_norm * (deck.pitch_range * 2.0f);
                if (std::abs(target_pitch) < 0.04f) target_pitch = 0.0f;
                deck.pitch_percent = target_pitch;
                deck.sync_active = false;
            }

            if (fdr_hovered) {
                float mw = ImGui::GetIO().MouseWheel;
                if (mw != 0.0f) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent + mw * 0.02f, -deck.pitch_range, deck.pitch_range);
                    if (std::abs(deck.pitch_percent) < 0.01f) deck.pitch_percent = 0.0f;
                    deck.sync_active = false;
                }
                if (ImGui::IsMouseDoubleClicked(0)) {
                    deck.pitch_percent = 0.0f;
                    deck.sync_active = false;
                }
                ImGui::SetTooltip("Tempo / Pitch: %+.2f%% (Arraste / Roda do mouse ajusta / 2-clique reseta)", deck.pitch_percent);
            }

            // Rasgo rebaixado do fader (slot interno)
            ImVec2 slot_min = ImVec2(track_cx - slot_w * 0.5f, track_top);
            ImVec2 slot_max = ImVec2(track_cx + slot_w * 0.5f, track_bot);
            dl->AddRectFilled(slot_min, slot_max, IM_COL32(5, 6, 9, 255), 3.0f);
            dl->AddRect(slot_min, slot_max, IM_COL32(24, 30, 42, 220), 3.0f, 0, 1.0f);
            // Trilho metálico brilhante no fundo do rasgo
            dl->AddLine(ImVec2(track_cx, track_top + 2.0f), ImVec2(track_cx, track_bot - 2.0f), IM_COL32(42, 52, 70, 255), 1.5f);

            // Linha e Marcação Central de 0.0% (Detent)
            float center_y = track_top + track_h * 0.5f;
            dl->AddLine(ImVec2(track_cx - 11.0f, center_y), ImVec2(track_cx + 11.0f, center_y), IM_COL32(200, 220, 245, 230), 1.5f);

            // Escala Graduada Pioneer (- no topo, + na base)
            float tick_left_x = track_cx - 13.0f;
            dl->AddText(f_bld, 10.0f, ImVec2(tick_left_x - 7.0f, track_top - 5.0f), IM_COL32(180, 195, 215, 230), "-");
            dl->AddText(f_bld, 10.0f, ImVec2(tick_left_x - 7.0f, track_bot - 7.0f), IM_COL32(180, 195, 215, 230), "+");
            dl->AddText(f_reg, 9.5f, ImVec2(tick_left_x - 8.0f, center_y - 5.0f), IM_COL32(160, 175, 195, 220), "0");

            int num_steps = 10;
            for (int i = 0; i <= num_steps; i++) {
                float ty = track_top + (float)i / (float)num_steps * track_h;
                bool is_mid = (i == num_steps / 2);
                float tw = is_mid ? 8.0f : ((i % 2 == 0) ? 5.5f : 3.0f);
                ImU32 tcol = is_mid ? IM_COL32(200, 215, 235, 220) : IM_COL32(75, 90, 115, 180);
                dl->AddLine(ImVec2(track_cx - 6.0f - tw, ty), ImVec2(track_cx - 6.0f, ty), tcol, 1.0f);
            }

            // LED Indicador Central 0% Pioneer (Luz Verde que acende exatamente no 0.00% com soft glow)
            float led_x = track_cx + std::clamp(size.x * 0.35f, 22.0f, 32.0f);
            if (is_center_zero) {
                dl->AddCircleFilled(ImVec2(led_x, center_y), 7.0f, IM_COL32(0, 255, 120, 60), 16);
                dl->AddCircleFilled(ImVec2(led_x, center_y), 4.0f, IM_COL32(0, 255, 120, 255), 16);
                dl->AddCircleFilled(ImVec2(led_x, center_y), 1.8f, IM_COL32(230, 255, 240, 255), 16);
            } else {
                dl->AddCircleFilled(ImVec2(led_x, center_y), 2.5f, IM_COL32(14, 38, 22, 255), 16);
                dl->AddCircle(ImVec2(led_x, center_y), 2.5f, IM_COL32(28, 65, 38, 255), 16, 1.0f);
            }

            // 4. Handle (Knob do Fader Metálico Pioneer CDJ Harmonizado com a UI)
            float norm = (deck.pitch_percent - (-deck.pitch_range)) / (deck.pitch_range * 2.0f);
            norm = std::clamp(norm, 0.0f, 1.0f);
            float knob_cy = track_top + norm * track_h;

            float knob_w = std::clamp(size.x * 0.40f, 28.0f, 32.0f);
            float knob_h = 16.0f;
            ImVec2 k_min = ImVec2(track_cx - knob_w * 0.5f, knob_cy - knob_h * 0.5f);
            ImVec2 k_max = ImVec2(track_cx + knob_w * 0.5f, knob_cy + knob_h * 0.5f);

            // Sombra 3D projetada do knob
            dl->AddRectFilled(ImVec2(k_min.x + 1.0f, k_min.y + 2.0f), ImVec2(k_max.x + 1.5f, k_max.y + 3.0f), IM_COL32(0, 0, 0, 160), 2.5f);
            // Corpo metálico chanfrado obsidian
            dl->AddRectFilled(k_min, k_max, IM_COL32(36, 42, 54, 255), 2.5f);
            // Chanfro e reflexo de luz superior
            dl->AddRectFilled(k_min, ImVec2(k_max.x, knob_cy), IM_COL32(56, 66, 84, 255), 2.5f, ImDrawFlags_RoundCornersTop);
            // Sombra inferior do chanfro
            dl->AddRectFilled(ImVec2(k_min.x, knob_cy), k_max, IM_COL32(24, 28, 38, 255), 2.5f, ImDrawFlags_RoundCornersBottom);
            // Borda chanfrada superior metálica
            dl->AddLine(ImVec2(k_min.x + 1.5f, k_min.y + 1.0f), ImVec2(k_max.x - 1.5f, k_min.y + 1.0f), IM_COL32(110, 130, 160, 220), 1.0f);
            // Ranhuras táteis de pegada lateral (Pioneer P-LOCK grips - 2 frisos)
            for (int g = 0; g < 2; g++) {
                float gx_l = k_min.x + 3.0f + g * 2.2f;
                float gx_r = k_max.x - 3.0f - g * 2.2f;
                dl->AddLine(ImVec2(gx_l, knob_cy - 4.5f), ImVec2(gx_l, knob_cy + 4.5f), IM_COL32(18, 22, 30, 200), 1.0f);
                dl->AddLine(ImVec2(gx_r, knob_cy - 4.5f), ImVec2(gx_r, knob_cy + 4.5f), IM_COL32(18, 22, 30, 200), 1.0f);
            }
            // Borda com realce cyan ao interagir ou passar o mouse
            ImU32 bd_col = fdr_active ? IM_COL32(0, 200, 255, 255) : (fdr_hovered ? IM_COL32(0, 160, 230, 220) : IM_COL32(75, 90, 115, 230));
            dl->AddRect(k_min, k_max, bd_col, 2.5f, 0, (fdr_active || fdr_hovered) ? 1.5f : 1.0f);
            // Marcador branco central de alta precisão (Pioneer White Index Bar)
            dl->AddRectFilled(ImVec2(k_min.x + 3.0f, knob_cy - 1.0f), ImVec2(k_max.x - 3.0f, knob_cy + 1.0f), IM_COL32(255, 255, 255, 255), 1.0f);
        }

        void renderRekordboxPitchFader(KuroAudio::DJDeck& deck, ImVec2 pos, float h) {
            renderRekordboxPitchFaderWidget(deck, pos, ImVec2(75.0f, h), ImVec4(0.0f, 0.8f, 1.0f, 1.0f));
        }

        void renderRekordboxDeckPanel(KuroAudio::DJDeck& deck, int deck_slot, ImVec4 theme_col, KuroAudio::DJEngine& engine) {
            ImGui::PushID(deck.deck_id);
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 p_min = ImGui::GetCursorScreenPos();
            float w = ImGui::GetContentRegionAvail().x;
            float total_h = ImGui::GetContentRegionAvail().y;

            dl->AddRectFilled(p_min, ImVec2(p_min.x + w, p_min.y + total_h), IM_COL32(14, 16, 21, 255), 4.0f);
            dl->AddRect(p_min, ImVec2(p_min.x + w, p_min.y + total_h), IM_COL32(28, 34, 44, 200), 4.0f, 0, 1.0f);

            int d_num = deck.deck_id + 1;
            ImFont* f_reg = g_font_rekordbox_regular ? g_font_rekordbox_regular : ImGui::GetFont();
            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();

            // 1. Deck Number (1 ou 2) - Pioneer Rekordbox Bold
            bool is_sub_layer = (deck.deck_id >= 2);
            ImU32 d_num_col = is_sub_layer ? IM_COL32(255, 170, 30, 255) : IM_COL32(255, 255, 255, 255);
            char d_num_str[8]; snprintf(d_num_str, sizeof(d_num_str), "%d", d_num);
            dl->AddText(f_bld, 16.0f, ImVec2(p_min.x + 8.0f, p_min.y + 7.0f), d_num_col, d_num_str);

            // Clique no número alterna Dual Layer (Deck 1 <-> 3, Deck 2 <-> 4)
            ImGui::SetCursorScreenPos(ImVec2(p_min.x + 6.0f, p_min.y + 5.0f));
            char d_num_btn[32]; snprintf(d_num_btn, sizeof(d_num_btn), "##DeckNumBtn_%d", deck.deck_id);
            if (ImGui::InvisibleButton(d_num_btn, ImVec2(14.0f, 22.0f))) {
                if (deck_slot == 0) {
                    int cur_l = ddj_hardware.getActiveLeftDeck();
                    ddj_hardware.setActiveLeftDeck(cur_l == 0 ? 2 : 0);
                } else {
                    int cur_r = ddj_hardware.getActiveRightDeck();
                    ddj_hardware.setActiveRightDeck(cur_r == 1 ? 3 : 1);
                }
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Dual Layer: Alternar Deck %d <-> %d", deck_slot == 0 ? 1 : 2, deck_slot == 0 ? 3 : 4);

            // 2. Vinyl Album Art Square Tile (30x30px) com sulcos concêntricos de vinil
            ImVec2 tile_min = ImVec2(p_min.x + 24.0f, p_min.y + 5.0f);
            ImVec2 tile_max = ImVec2(tile_min.x + 30.0f, tile_min.y + 30.0f);
            dl->AddRectFilled(tile_min, tile_max, IM_COL32(14, 17, 22, 255), 3.0f);
            dl->AddRect(tile_min, tile_max, IM_COL32(36, 44, 58, 220), 3.0f, 0, 1.0f);

            ImVec2 v_center = ImVec2(tile_min.x + 15.0f, tile_min.y + 15.0f);
            dl->AddCircle(v_center, 12.0f, IM_COL32(40, 50, 65, 180), 20, 1.0f);
            dl->AddCircle(v_center, 8.5f, IM_COL32(55, 68, 88, 200), 20, 1.0f);
            dl->AddCircle(v_center, 5.0f, IM_COL32(80, 95, 120, 220), 16, 1.0f);
            dl->AddCircleFilled(v_center, 2.0f, IM_COL32(215, 230, 250, 255));

            // 3. Bloco de Botões de Controle na Direita: KEY SYNC, MASTER e BEAT SYNC empilhado
            float r_ctrl_w = 126.0f;
            float rx = p_min.x + w - r_ctrl_w - 6.0f;

            // KEY SYNC (topo à esquerda)
            ImGui::SetCursorScreenPos(ImVec2(rx, p_min.y + 4.0f));
            if (deck.key_sync_active) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.0f, 0.85f, 1.0f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0, 0, 0, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.11f, 0.14f, 0.18f, 0.95f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.72f, 0.80f, 0.90f, 1.0f));
            }
            if (ImGui::Button("KEY SYNC##KS", ImVec2(66.0f, 15.0f))) engine.toggleKeySync(deck.deck_id);
            ImGui::PopStyleColor(2);

            // MASTER (embaixo de KEY SYNC)
            ImGui::SetCursorScreenPos(ImVec2(rx, p_min.y + 22.0f));
            bool is_m = engine.isMasterDeck(deck.deck_id);
            if (is_m) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.95f, 0.70f, 0.05f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0, 0, 0, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.11f, 0.14f, 0.18f, 0.95f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.72f, 0.80f, 0.90f, 1.0f));
            }
            if (ImGui::Button("MASTER##M", ImVec2(66.0f, 15.0f))) engine.setMasterDeck(deck.deck_id);
            ImGui::PopStyleColor(2);

            // BEAT SYNC (botão alto de 2 linhas na direita: "BEAT" e "SYNC")
            ImGui::SetCursorScreenPos(ImVec2(rx + 70.0f, p_min.y + 4.0f));
            ImVec2 sync_btn_pos = ImVec2(rx + 70.0f, p_min.y + 4.0f);
            ImVec2 sync_btn_sz = ImVec2(48.0f, 33.0f);
            ImU32 sync_bg = deck.sync_active ? IM_COL32(0, 120, 255, 255) : IM_COL32(26, 32, 42, 245);
            ImU32 sync_bd = deck.sync_active ? IM_COL32(60, 160, 255, 255) : IM_COL32(45, 54, 70, 220);
            ImU32 sync_tx = deck.sync_active ? IM_COL32(255, 255, 255, 255) : IM_COL32(210, 225, 245, 240);

            dl->AddRectFilled(sync_btn_pos, ImVec2(sync_btn_pos.x + sync_btn_sz.x, sync_btn_pos.y + sync_btn_sz.y), sync_bg, 3.0f);
            dl->AddRect(sync_btn_pos, ImVec2(sync_btn_pos.x + sync_btn_sz.x, sync_btn_pos.y + sync_btn_sz.y), sync_bd, 3.0f, 0, 1.0f);

            ImVec2 b_sz = f_bld->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "BEAT");
            ImVec2 s_sz = f_bld->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "SYNC");
            dl->AddText(f_bld, 11.0f, ImVec2(sync_btn_pos.x + (sync_btn_sz.x - b_sz.x) * 0.5f, sync_btn_pos.y + 4.0f), sync_tx, "BEAT");
            dl->AddText(f_bld, 11.0f, ImVec2(sync_btn_pos.x + (sync_btn_sz.x - s_sz.x) * 0.5f, sync_btn_pos.y + 17.0f), sync_tx, "SYNC");

            char sync_btn_id[32]; snprintf(sync_btn_id, sizeof(sync_btn_id), "##BeatSyncTall_%d", deck.deck_id);
            if (ImGui::InvisibleButton(sync_btn_id, sync_btn_sz)) {
                engine.toggleSync(deck.deck_id, (deck_slot == 0 ? 1 : 0));
            }

            // 4. Drag & Drop Target sobre a área do Cabeçalho / Título
            ImGui::SetCursorScreenPos(ImVec2(p_min.x + 22.0f, p_min.y + 2.0f));
            char title_drop_id[32]; snprintf(title_drop_id, sizeof(title_drop_id), "##DeckTitleDrop_%d", deck.deck_id);
            ImGui::InvisibleButton(title_drop_id, ImVec2(std::max(100.0f, rx - p_min.x - 26.0f), 38.0f));
            if (ImGui::BeginDragDropTarget()) {
                if (const ImGuiPayload* payload = ImGui::AcceptDragDropPayload("DND_DJ_TRACK_ID")) {
                    const char* dropped_id = (const char*)payload->Data;
                    auto* ptr = KuroAudio::DJLibraryManager::getInstance().getTrackById(dropped_id);
                    if (ptr) {
                        if (ptr->is_downloaded) spotify_service.loadLibraryTrack(*ptr, deck.deck_id, engine);
                        else spotify_service.downloadLibraryTrackAsync(*ptr, deck.deck_id, engine);
                    }
                }
                dl->AddRect(ImVec2(p_min.x + 22.0f, p_min.y + 2.0f), ImVec2(rx - 4.0f, p_min.y + 38.0f), ImGui::ColorConvertFloat4ToU32(theme_col), 3.0f, 0, 2.0f);
                ImGui::EndDragDropTarget();
            }

            // 5. Linha 1 do Cabeçalho: Artista + Título da Faixa (ou "Not Loaded.")
            float text_x = p_min.x + 60.0f;
            float row1_y = p_min.y + 4.0f;
            float row2_y = p_min.y + 23.0f;

            if (!deck.track_title.empty()) {
                std::string artist = deck.track_artist;
                std::string title = deck.track_title;
                if (artist.empty()) {
                    size_t sep = title.find(" - ");
                    if (sep != std::string::npos) {
                        artist = title.substr(0, sep);
                        title = title.substr(sep + 3);
                    }
                }

                dl->PushClipRect(ImVec2(text_x, row1_y - 2.0f), ImVec2(rx - 8.0f, row1_y + 18.0f), true);
                if (!artist.empty()) {
                    dl->AddText(f_reg, 15.0f, ImVec2(text_x, row1_y), IM_COL32(230, 236, 245, 255), artist.c_str());
                    ImVec2 a_sz = f_reg->CalcTextSizeA(15.0f, FLT_MAX, 0.0f, artist.c_str());
                    float title_x = text_x + a_sz.x + 10.0f;
                    dl->AddText(f_bld, 16.0f, ImVec2(title_x, row1_y), IM_COL32(255, 255, 255, 255), title.c_str());
                } else {
                    dl->AddText(f_bld, 16.0f, ImVec2(text_x, row1_y), IM_COL32(255, 255, 255, 255), title.c_str());
                }
                dl->PopClipRect();

                // Linha 2 de Telemetria: BPM (com ponto), Tom Musical, Tempo Restante, Tempo Decorrido e Key Shift
                // Protegida com PushClipRect para nunca colidir ou desenhar sobre os botões KEY SYNC e MASTER
                dl->PushClipRect(ImVec2(text_x, row2_y - 2.0f), ImVec2(rx - 6.0f, row2_y + 20.0f), true);
                float max_row2_x = rx - 8.0f;

                double eff_b = (deck.bpm > 20.0) ? (deck.bpm * (1.0 + deck.pitch_percent * 0.01)) : 126.0;
                char bpm_buf[32];
                snprintf(bpm_buf, sizeof(bpm_buf), "%.2f", eff_b);
                for (char* p = bpm_buf; *p; ++p) { if (*p == ',') *p = '.'; }

                if (bpm_editing_deck == deck.deck_id && bpm_edit_from_header) {
                    ImGui::SetCursorScreenPos(ImVec2(text_x - 2.0f, row2_y - 2.0f));
                    ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0.06f, 0.09f, 0.14f, 0.98f));
                    ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.0f, 0.70f, 1.0f, 1.0f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 3.0f);
                    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(3.0f, 1.0f));
                    ImGui::PushItemWidth(52.0f);

                    if (bpm_edit_focus_needed) {
                        ImGui::SetKeyboardFocusHere();
                        bpm_edit_focus_needed = false;
                    }

                    char inp_h_id[32]; snprintf(inp_h_id, sizeof(inp_h_id), "##BpmHdrInput_%d", deck.deck_id);
                    bool enter = ImGui::InputText(inp_h_id, bpm_edit_buf, sizeof(bpm_edit_buf),
                        ImGuiInputTextFlags_EnterReturnsTrue | ImGuiInputTextFlags_AutoSelectAll);

                    if (enter || (!ImGui::IsItemActive() && ImGui::IsMouseClicked(0))) {
                        float target = (float)atof(bpm_edit_buf);
                        if (target >= 20.0f && target <= 300.0f) {
                            applyManualBpm(deck, target, ImGui::GetIO().KeyShift);
                        }
                        bpm_editing_deck = -1;
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_Escape)) {
                        bpm_editing_deck = -1;
                    }

                    ImGui::PopItemWidth();
                    ImGui::PopStyleVar(2);
                    ImGui::PopStyleColor(3);
                } else {
                    dl->AddText(f_bld, 14.0f, ImVec2(text_x, row2_y), IM_COL32(255, 255, 255, 255), bpm_buf);
                    ImGui::SetCursorScreenPos(ImVec2(text_x - 2.0f, row2_y - 2.0f));
                    char h_btn_id[32]; snprintf(h_btn_id, sizeof(h_btn_id), "##HdrBpmBtn_%d", deck.deck_id);
                    if (ImGui::InvisibleButton(h_btn_id, ImVec2(48.0f, 18.0f))) {
                        bpm_editing_deck = deck.deck_id;
                        bpm_edit_from_header = true;
                        snprintf(bpm_edit_buf, sizeof(bpm_edit_buf), "%.2f", eff_b);
                        bpm_edit_focus_needed = true;
                    }
                    if (ImGui::IsItemHovered()) {
                        dl->AddRect(ImVec2(text_x - 2.0f, row2_y - 2.0f), ImVec2(text_x + 48.0f, row2_y + 16.0f), IM_COL32(0, 160, 255, 180), 2.0f);
                        if (ImGui::IsMouseDoubleClicked(0)) {
                            deck.pitch_percent = 0.0f;
                            deck.sync_active = false;
                        }
                        ImGui::SetTooltip("BPM: %.2f (Clique para digitar / 2-clique reseta)", eff_b);
                    }
                }
                float cur_tx = text_x + 52.0f;

                std::string k_str = deck.getEffectiveKey();
                size_t slash = k_str.find(" / ");
                if (slash != std::string::npos) k_str = k_str.substr(0, slash);
                if (cur_tx + 28.0f < max_row2_x) {
                    dl->AddText(f_bld, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(255, 255, 255, 255), k_str.c_str());
                    cur_tx += 30.0f;
                }

                double rem_sec = deck.getRemainingTimeSec();
                int r_m = (int)rem_sec / 60, r_s = (int)rem_sec % 60, r_ms = (int)((rem_sec - std::floor(rem_sec)) * 10);
                char rem_buf[32];
                snprintf(rem_buf, sizeof(rem_buf), "-%02d:%02d.%d", r_m, r_s, r_ms);
                for (char* p = rem_buf; *p; ++p) { if (*p == ',') *p = '.'; }
                if (cur_tx + 58.0f < max_row2_x) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(255, 255, 255, 255), rem_buf);
                    cur_tx += 62.0f;
                }

                double elap_sec = deck.getElapsedTimeSec();
                int e_m = (int)elap_sec / 60, e_s = (int)elap_sec % 60, e_ms = (int)((elap_sec - std::floor(elap_sec)) * 10);
                char elap_buf[32];
                snprintf(elap_buf, sizeof(elap_buf), "%02d:%02d.%d", e_m, e_s, e_ms);
                for (char* p = elap_buf; *p; ++p) { if (*p == ',') *p = '.'; }
                if (cur_tx + 54.0f < max_row2_x) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(125, 136, 150, 255), elap_buf);
                    cur_tx += 56.0f;
                }

                // Widget Interativo de Key Shift: <  4A  ±0  > (só exibe se houver espaço confortável)
                if (cur_tx + 72.0f < max_row2_x) {
                    ImGui::SetCursorScreenPos(ImVec2(cur_tx, row2_y - 2.0f));
                    char ks_dn_id[32]; snprintf(ks_dn_id, sizeof(ks_dn_id), "<##KS_DN_%d", deck.deck_id);
                    if (ImGui::SmallButton(ks_dn_id)) {
                        deck.key_shift_semitones--;
                    }
                    cur_tx += 17.0f;

                    char ks_buf[32];
                    int ks = deck.key_shift_semitones;
                    if (ks > 0) snprintf(ks_buf, sizeof(ks_buf), "%s +%d", k_str.c_str(), ks);
                    else if (ks < 0) snprintf(ks_buf, sizeof(ks_buf), "%s %d", k_str.c_str(), ks);
                    else snprintf(ks_buf, sizeof(ks_buf), "%s \xc2\xb1\x30", k_str.c_str()); // ±0
                    dl->AddText(f_reg, 13.0f, ImVec2(cur_tx, row2_y), IM_COL32(220, 230, 245, 255), ks_buf);
                    cur_tx += 44.0f;

                    ImGui::SetCursorScreenPos(ImVec2(cur_tx, row2_y - 2.0f));
                    char ks_up_id[32]; snprintf(ks_up_id, sizeof(ks_up_id), ">##KS_UP_%d", deck.deck_id);
                    if (ImGui::SmallButton(ks_up_id)) {
                        deck.key_shift_semitones++;
                    }
                }
                dl->PopClipRect();
            } else {
                // Deck Vazio: Idêntico ao Deck 2 do Rekordbox (Image 2) com proteção de clip rect
                dl->PushClipRect(ImVec2(text_x, row1_y - 2.0f), ImVec2(rx - 6.0f, row2_y + 20.0f), true);
                dl->AddText(f_reg, 15.0f, ImVec2(text_x, row1_y), IM_COL32(85, 95, 110, 255), "Not Loaded.");
                float cur_tx = text_x;
                dl->AddText(f_bld, 14.0f, ImVec2(cur_tx, row2_y), IM_COL32(75, 85, 100, 255), "128.00");
                cur_tx += 52.0f;
                if (cur_tx + 28.0f < rx - 8.0f) {
                    dl->AddText(f_bld, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(75, 85, 100, 255), "8A");
                    cur_tx += 30.0f;
                }
                if (cur_tx + 58.0f < rx - 8.0f) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(60, 68, 80, 255), "-00:00.0");
                    cur_tx += 62.0f;
                }
                if (cur_tx + 54.0f < rx - 8.0f) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(60, 68, 80, 255), "00:00.0");
                    cur_tx += 56.0f;
                }
                if (cur_tx + 72.0f < rx - 8.0f) {
                    dl->AddText(f_reg, 13.0f, ImVec2(cur_tx, row2_y), IM_COL32(60, 68, 80, 255), "<  8A \xc2\xb1\x30  >");
                }
                dl->PopClipRect();
            }

            // 6. MINI OVERVIEW WAVEFORM STRIP (Idêntica ao Rekordbox - Sobe no eixo +)
            float over_y = p_min.y + 44.0f;
            float over_h = 24.0f;
            ImGui::SetCursorScreenPos(ImVec2(p_min.x + 4.0f, over_y));
            renderMiniOverviewStrip(deck, w - 8.0f, over_h, theme_col);

            // 3. CORPO INFERIOR DO DECK (PIONEER DDJ / REKORDBOX 2-TIER ERGONOMIC ARCHITECTURE)
            float body_y = over_y + over_h + 6.0f;
            float body_h = total_h - (body_y - p_min.y) - 4.0f;

            float margin_x = 4.0f;
            float gap_x = 4.0f;
            float usable_w = w - margin_x * 2.0f;

            // Split vertical do corpo:
            // TIER SUPERIOR (Loop, Jogwheel, Pitch Fader): ~125px
            float upper_h = std::clamp(body_h - 78.0f, 110.0f, 130.0f);
            // TIER INFERIOR (CUE/PLAY + 8 Performance Pads): ~76px
            float lower_y = body_y + upper_h + 4.0f;
            float lower_h = body_h - upper_h - 6.0f;

            float left_w = 52.0f;
            float fader_w = 64.0f;
            float center_w = usable_w - left_w - fader_w - gap_x * 2.0f;
            float j_sz = std::min(center_w - 6.0f, upper_h - 6.0f);

            // =========================================================================
            // TIER SUPERIOR: LOOP + SLIP/Q (ESQ) | JOGWHEEL (CENTRO) | PITCH FADER (DIR)
            // =========================================================================
            float cur_left_x = p_min.x + margin_x;

            // 1. Bloco de Botões Auxiliares Pioneer Rekordbox 1:1 (Loop, 1/2X, 2X, IN, OUT, SLIP, Q, INT)
            renderRekordboxAuxiliaryControlBlock(deck, ImVec2(cur_left_x, body_y + 2.0f), left_w, upper_h - 4.0f, theme_col);

            // 2. JOGWHEEL Centralizado no espaco do meio do Tier Superior
            float jog_x = cur_left_x + left_w + gap_x + (center_w - j_sz) * 0.5f;
            float jog_y = body_y + (upper_h - j_sz) * 0.5f;
            renderRekordboxJogwheel(deck, ImVec2(jog_x, jog_y), j_sz, theme_col);

            // 3. PITCH FADER na extrema direita do Tier Superior
            float fader_x = p_min.x + w - margin_x - fader_w;
            renderRekordboxPitchFaderWidget(deck, ImVec2(fader_x, body_y + 2.0f), ImVec2(fader_w, upper_h - 4.0f), theme_col);

            // =========================================================================
            // TIER INFERIOR: CUE / PLAY (ESQ) + 8 PERFORMANCE PADS AMPLOS (CENTRO/DIR)
            // =========================================================================
            float t_cx = cur_left_x + left_w * 0.5f;
            float r_btn = 15.0f;
            float cue_cy = lower_y + 17.0f;
            float play_cy = cue_cy + 34.0f;

            bool at_cue = (std::abs(deck.current_frame - deck.cue_frame) <= deck.sample_rate * 0.04);
            bool blink_phase = ((int)(ImGui::GetTime() * 4.0) % 2 == 0);

            bool cue_lit = false;
            ImU32 cue_ring_col = IM_COL32(255, 140, 0, 255);
            if (deck.cue_active) {
                cue_lit = true;
                cue_ring_col = IM_COL32(255, 185, 40, 255);
            } else if (!deck.is_playing) {
                if (at_cue) {
                    cue_lit = true;
                    cue_ring_col = IM_COL32(255, 145, 0, 255);
                } else {
                    cue_lit = blink_phase;
                    cue_ring_col = blink_phase ? IM_COL32(255, 145, 0, 255) : IM_COL32(75, 45, 15, 160);
                }
            } else {
                cue_lit = false;
                cue_ring_col = IM_COL32(110, 75, 25, 160);
            }

            renderPioneerRoundButton("CUE", ImVec2(t_cx, cue_cy), r_btn, cue_ring_col, IM_COL32(18, 14, 8, 255), cue_lit,
                [&]() { deck.pressCue(); },
                [&]() { deck.releaseCue(); }
            );

            bool play_lit = false;
            ImU32 play_ring_col = IM_COL32(0, 240, 90, 255);
            if (deck.is_playing && !deck.cue_active) {
                play_lit = true;
                play_ring_col = IM_COL32(0, 255, 100, 255);
            } else {
                // Pausado ou em Cue Audition: PLAY pisca verde convidando o DJ
                play_lit = blink_phase;
                play_ring_col = blink_phase ? IM_COL32(0, 240, 90, 255) : IM_COL32(15, 65, 35, 160);
            }

            renderPioneerRoundButton("PLAY", ImVec2(t_cx, play_cy), r_btn, play_ring_col, IM_COL32(8, 18, 12, 255), play_lit,
                [&]() { deck.togglePlay(); }
            );

            // 4. PERFORMANCE PADS amplos preenchendo todo o restante do Tier Inferior
            float pads_x = cur_left_x + left_w + gap_x;
            float pads_w = (p_min.x + w - margin_x) - pads_x;
            renderRekordboxPads(deck, ImVec2(pads_x, lower_y), pads_w, lower_h, engine);

            ImGui::PopID();
        }

        // =========================================================================================
        // WAVE CENTRAL DE ANÁLISE DE FREQUÊNCIAS (COMBINADA / SOBREPOSTA D1 + D2)
        // Posicionada no centro do console, logo acima dos controles do Mixer Central
        // =========================================================================
        void renderCentralFrequencyWaveform(KuroAudio::DJEngine& engine, float w, float h) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();

            int left_id  = ddj_hardware.getActiveLeftDeck();
            int right_id = ddj_hardware.getActiveRightDeck();
            KuroAudio::DJDeck& deck1 = engine.decks[left_id];
            KuroAudio::DJDeck& deck2 = engine.decks[right_id];

            // 1. Moldura e Fundo Obsidian Club Standard
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(10, 12, 17, 255), 3.0f);
            dl->AddRect(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(34, 44, 60, 240), 3.0f, 0, 1.0f);

            // 2. Barra de Título Superior da Wave Central (14px)
            float hdr_h = 14.0f;
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + hdr_h), IM_COL32(16, 20, 28, 255), 3.0f, ImDrawFlags_RoundCornersTop);
            dl->AddLine(ImVec2(pos.x, pos.y + hdr_h), ImVec2(pos.x + w, pos.y + hdr_h), IM_COL32(28, 36, 48, 200), 1.0f);

            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
            dl->AddText(f_bld, 10.5f, ImVec2(pos.x + 5.0f, pos.y + 1.0f), IM_COL32(140, 165, 195, 240), "FREQ MIX");

            // Indicador Central de Decks: D1 (Ciano) + D2 (Âmbar)
            float mid_x = pos.x + w * 0.5f;
            dl->AddText(f_bld, 10.5f, ImVec2(mid_x - 26.0f, pos.y + 1.0f), IM_COL32(0, 245, 212, 255), "D1");
            dl->AddText(ImVec2(mid_x - 8.0f, pos.y + 0.5f), IM_COL32(180, 195, 215, 220), "+");
            dl->AddText(f_bld, 10.5f, ImVec2(mid_x + 6.0f, pos.y + 1.0f), IM_COL32(255, 170, 0, 255), "D2");

            // Indicador de Status de Sincronia / Frequência na direita
            bool both_playing = (deck1.is_playing.load() && deck2.is_playing.load());
            if (both_playing) {
                double bpm_diff = std::abs(deck1.bpm - deck2.bpm);
                if (bpm_diff < 0.15) {
                    dl->AddText(f_bld, 10.0f, ImVec2(pos.x + w - 44.0f, pos.y + 1.0f), IM_COL32(0, 240, 120, 255), "SYNC OK");
                } else {
                    dl->AddText(f_bld, 10.0f, ImVec2(pos.x + w - 40.0f, pos.y + 1.0f), IM_COL32(255, 180, 0, 255), "PHASE");
                }
            } else {
                dl->AddText(f_bld, 10.0f, ImVec2(pos.x + w - 42.0f, pos.y + 1.0f), IM_COL32(90, 110, 140, 200), "ANALYSIS");
            }

            // 3. Área de Exibição da Waveform (Altura = h - hdr_h - 2px)
            float wave_y = pos.y + hdr_h + 1.0f;
            float wave_h = h - hdr_h - 2.0f;
            float mid_y  = wave_y + wave_h * 0.5f;
            float max_half_h = (wave_h * 0.5f) - 2.0f;

            // Fundo preto puro e linha de centro neutra
            dl->AddRectFilled(ImVec2(pos.x + 1.0f, wave_y), ImVec2(pos.x + w - 1.0f, wave_y + wave_h), IM_COL32(0, 0, 0, 255));
            dl->AddLine(ImVec2(pos.x + 1.0f, mid_y), ImVec2(pos.x + w - 1.0f, mid_y), IM_COL32(24, 32, 45, 160), 1.0f);

            // Tempo e Sincronização de Hertz (Zero-Jitter)
            DeckVisualHertzSync& vs1 = vis_sync[deck1.deck_id];
            DeckVisualHertzSync& vs2 = vis_sync[deck2.deck_id];

            double ref_bpm = (deck1.is_playing.load() && deck1.bpm > 20.0) ? deck1.bpm :
                             ((deck2.is_playing.load() && deck2.bpm > 20.0) ? deck2.bpm :
                             ((deck1.bpm > 20.0) ? deck1.bpm : 126.0));
            double seconds_per_bar = (60.0 / ref_bpm) * 4.0;
            double window_sec = 4.0 * seconds_per_bar; // 4 compassos para clareza máxima de mixagem
            if (window_sec < 0.5) window_sec = 0.5;

            double window_f1 = window_sec * deck1.sample_rate;
            double start_f1  = vs1.smooth_frame - window_f1 * 0.5;
            double window_f2 = window_sec * deck2.sample_rate;
            double start_f2  = vs2.smooth_frame - window_f2 * 0.5;

            // Grade Mestre Única (Downbeats 1.1 e Batidas)
            if (deck1.bpm > 20.0 && deck1.sample_rate > 1000.0) {
                double beat_len1 = (60.0 / deck1.bpm) * deck1.sample_rate;
                if (beat_len1 > 10.0) {
                    int b_s = (int)std::floor((start_f1 - deck1.first_beat_frame) / beat_len1);
                    int b_e = (int)std::ceil((start_f1 + window_f1 - deck1.first_beat_frame) / beat_len1);
                    for (int b = b_s; b <= b_e; b++) {
                        double bf = deck1.first_beat_frame + (double)b * beat_len1;
                        float bx = pos.x + (float)((bf - start_f1) / window_f1) * w;
                        if (bx >= pos.x + 1.0f && bx <= pos.x + w - 1.0f) {
                            if (b % 4 == 0) {
                                dl->AddLine(ImVec2(bx, wave_y), ImVec2(bx, wave_y + wave_h), IM_COL32(255, 30, 50, 180), 1.2f);
                            } else {
                                dl->AddLine(ImVec2(bx, wave_y), ImVec2(bx, wave_y + wave_h), IM_COL32(140, 160, 190, 35), 1.0f);
                            }
                        }
                    }
                }
            }

            // Geração de detalhes
            deck1.generateDetailedWaveformIfNeeded();
            deck2.generateDetailedWaveformIfNeeded();

            // Fatores de EQ reais dos knobs da controladora
            float eq_l1 = std::clamp(deck1.eq_low,  0.0f, 2.5f);
            float eq_m1 = std::clamp(deck1.eq_mid,  0.0f, 2.5f);
            float eq_h1 = std::clamp(deck1.eq_high, 0.0f, 2.5f);

            float eq_l2 = std::clamp(deck2.eq_low,  0.0f, 2.5f);
            float eq_m2 = std::clamp(deck2.eq_mid,  0.0f, 2.5f);
            float eq_h2 = std::clamp(deck2.eq_high, 0.0f, 2.5f);

            float col_step = 1.0f;
            int num_cols = std::max(1, (int)(w / col_step));
            double f_per_c1 = window_f1 / (double)num_cols;
            double f_per_c2 = window_f2 / (double)num_cols;
            size_t sz1 = deck1.detailed_waveform.size();
            size_t sz2 = deck2.detailed_waveform.size();
            size_t tot1 = deck1.buffer_l.size();
            size_t tot2 = deck2.buffer_l.size();

            for (int x = 0; x < num_cols; x++) {
                float cur_x = pos.x + (float)x * col_step;

                // Amostragem Deck 1 (Ciano Elétrico #00f5d4)
                float amp1 = 0.0f, core1 = 0.0f;
                ImU32 col_out1 = 0, col_cr1 = 0;
                double f1 = start_f1 + (double)x * f_per_c1;
                if (f1 >= 0.0 && f1 < (double)tot1 && sz1 > 0) {
                    double bin1 = f1 / (double)KuroAudio::DJDeck::DETAILED_WAVE_STEP;
                    size_t b0 = (size_t)std::clamp(std::floor(bin1), 0.0, (double)(sz1 - 1));
                    size_t b1 = std::min(b0 + 1, sz1 - 1);
                    float fr = (float)(bin1 - (double)b0);
                    float st = fr * fr * (3.0f - 2.0f * fr);

                    const auto& p0 = deck1.detailed_waveform[b0];
                    const auto& p1 = deck1.detailed_waveform[b1];

                    float l = (p0.low  + (p1.low  - p0.low)  * st) * eq_l1;
                    float m = (p0.mid  + (p1.mid  - p0.mid)  * st) * eq_m1;
                    float h_val = (p0.high + (p1.high - p0.high) * st) * eq_h1;

                    float eff = (l * 0.50f + m * 0.35f + h_val * 0.25f);
                    if (eff > 0.002f) {
                        float norm = std::clamp((eff - 0.002f) / (1.0f - 0.002f), 0.0f, 1.0f);
                        amp1 = std::clamp(std::pow(norm, 1.02f) * max_half_h, 0.8f, max_half_h);
                        core1 = amp1 * (0.38f * std::clamp(eq_l1, 0.15f, 1.6f));

                        computeRekordboxRGB(waveform_color_mode, l, m, h_val, eff, 1.0f, col_out1, col_cr1);
                    }
                }

                // Amostragem Deck 2 (Rekordbox Palette #ffaa00)
                float amp2 = 0.0f, core2 = 0.0f;
                ImU32 col_out2 = 0, col_cr2 = 0;
                double f2 = start_f2 + (double)x * f_per_c2;
                if (f2 >= 0.0 && f2 < (double)tot2 && sz2 > 0) {
                    double bin2 = f2 / (double)KuroAudio::DJDeck::DETAILED_WAVE_STEP;
                    size_t b0 = (size_t)std::clamp(std::floor(bin2), 0.0, (double)(sz2 - 1));
                    size_t b1 = std::min(b0 + 1, sz2 - 1);
                    float fr = (float)(bin2 - (double)b0);
                    float st = fr * fr * (3.0f - 2.0f * fr);

                    const auto& p0 = deck2.detailed_waveform[b0];
                    const auto& p1 = deck2.detailed_waveform[b1];

                    float l = (p0.low  + (p1.low  - p0.low)  * st) * eq_l2;
                    float m = (p0.mid  + (p1.mid  - p0.mid)  * st) * eq_m2;
                    float h_val = (p0.high + (p1.high - p0.high) * st) * eq_h2;

                    float eff = (l * 0.50f + m * 0.35f + h_val * 0.25f);
                    if (eff > 0.002f) {
                        float norm = std::clamp((eff - 0.002f) / (1.0f - 0.002f), 0.0f, 1.0f);
                        amp2 = std::clamp(std::pow(norm, 1.02f) * max_half_h, 0.8f, max_half_h);
                        core2 = amp2 * (0.38f * std::clamp(eq_l2, 0.15f, 1.6f));

                        int d2_col = (waveform_color_mode == 0) ? 4 : (waveform_color_mode == 2 ? 0 : 2);
                        computeRekordboxRGB(d2_col, l, m, h_val, eff, 1.0f, col_out2, col_cr2);
                    }
                }

                // Hierarquia de Amplitude e Fusão Inteligente
                if (amp1 < 0.8f && amp2 < 0.8f) {
                    dl->AddLine(ImVec2(cur_x, mid_y), ImVec2(cur_x + 1.0f, mid_y), IM_COL32(24, 32, 45, 140), 1.0f);
                } else if (amp1 >= 0.8f && amp2 < 0.8f) {
                    dl->AddLine(ImVec2(cur_x, mid_y - amp1), ImVec2(cur_x, mid_y + amp1), col_out1, 1.0f);
                    if (core1 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core1), ImVec2(cur_x, mid_y + core1), col_cr1, 1.0f);
                } else if (amp2 >= 0.8f && amp1 < 0.8f) {
                    dl->AddLine(ImVec2(cur_x, mid_y - amp2), ImVec2(cur_x, mid_y + amp2), col_out2, 1.0f);
                    if (core2 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core2), ImVec2(cur_x, mid_y + core2), col_cr2, 1.0f);
                } else {
                    // Ambos com som: A maior amplitude envolve a menor
                    if (amp1 >= amp2) {
                        dl->AddLine(ImVec2(cur_x, mid_y - amp1), ImVec2(cur_x, mid_y + amp1), col_out1, 1.0f);
                        dl->AddLine(ImVec2(cur_x, mid_y - amp2), ImVec2(cur_x, mid_y + amp2), IM_COL32(255, 150, 20, 255), 1.0f);
                        if (core1 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core1), ImVec2(cur_x, mid_y + core1), col_cr1, 1.0f);
                        if (core2 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core2), ImVec2(cur_x, mid_y + core2), col_cr2, 1.0f);
                    } else {
                        dl->AddLine(ImVec2(cur_x, mid_y - amp2), ImVec2(cur_x, mid_y + amp2), col_out2, 1.0f);
                        dl->AddLine(ImVec2(cur_x, mid_y - amp1), ImVec2(cur_x, mid_y + amp1), IM_COL32(0, 230, 255, 255), 1.0f);
                        if (core2 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core2), ImVec2(cur_x, mid_y + core2), col_cr2, 1.0f);
                        if (core1 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core1), ImVec2(cur_x, mid_y + core1), col_cr1, 1.0f);
                    }
                }
            }

            // 4. Agulha Central Playhead Branca com Triângulos
            dl->AddLine(ImVec2(mid_x, wave_y), ImVec2(mid_x, wave_y + wave_h), IM_COL32(255, 255, 255, 255), 1.0f);
            dl->AddLine(ImVec2(mid_x, wave_y), ImVec2(mid_x, wave_y + wave_h), IM_COL32(0, 220, 255, 50), 3.0f);
            dl->AddTriangleFilled(ImVec2(mid_x - 3.5f, wave_y), ImVec2(mid_x + 3.5f, wave_y), ImVec2(mid_x, wave_y + 4.5f), IM_COL32(0, 245, 212, 255));
            dl->AddTriangleFilled(ImVec2(mid_x - 3.5f, wave_y + wave_h), ImVec2(mid_x + 3.5f, wave_y + wave_h), ImVec2(mid_x, wave_y + wave_h - 4.5f), IM_COL32(255, 170, 0, 255));

            // 5. Interatividade de Mouse na Wave Central
            ImGui::SetCursorScreenPos(pos);
            ImGui::InvisibleButton("##CentralFreqWaveBtn", ImVec2(w, h));
            if (ImGui::IsItemHovered()) {
                ImGui::SetTooltip("WAVE CENTRAL DE ANÁLISE DE FREQUÊNCIAS (D1 + D2)\n"
                                  "• Ciano = Deck 1 | Âmbar = Deck 2\n"
                                  "• Reativo em tempo real aos Knobs de EQ (Low/Mid/High) e Sound Color FX\n"
                                  "• A faixa dominante envolve externamente a sobreposta");
            }
        }

        void renderRekordboxCenterMixer(KuroAudio::DJEngine& engine) {
            float w = ImGui::GetContentRegionAvail().x;
            float h = ImGui::GetContentRegionAvail().y;
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();

            // Fundo escuro oficial Rekordbox #121418
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(18, 20, 24, 255), 4.0f);
            dl->AddRect(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(32, 38, 48, 220), 4.0f, 0, 1.0f);

            // =========================================================================
            // WAVE CENTRAL DE ANÁLISE DE FREQUÊNCIAS (COMBINADA / SOBREPOSTA D1 + D2)
            // =========================================================================
            float central_wave_h = std::clamp(h * 0.14f, 38.0f, 65.0f);
            ImGui::SetCursorScreenPos(ImVec2(pos.x + 4.0f, pos.y + 4.0f));
            renderCentralFrequencyWaveform(engine, w - 8.0f, central_wave_h);

            // Divisor fino entre a Wave Central e os Controles do Mixer
            float div_y = pos.y + central_wave_h + 6.0f;
            dl->AddLine(ImVec2(pos.x + 4.0f, div_y), ImVec2(pos.x + w - 4.0f, div_y), IM_COL32(36, 44, 58, 220), 1.0f);

            int left_id = ddj_hardware.getActiveLeftDeck();
            int right_id = ddj_hardware.getActiveRightDeck();
            KuroAudio::DJDeck& deck_l = engine.decks[left_id];
            KuroAudio::DJDeck& deck_r = engine.decks[right_id];

            float ch_w = (w - 12.0f) * 0.5f;

            // Seção inferior (Crossfader + Fone + Channel Assign)
            float bot_sec_h = 50.0f;
            float bot_sec_y = pos.y + h - bot_sec_h - 4.0f;

            // Linha vertical divisória entre os dois canais (estilo Rekordbox 1:1)
            dl->AddLine(ImVec2(pos.x + w * 0.5f, div_y + 2.0f), ImVec2(pos.x + w * 0.5f, bot_sec_y - 4.0f), IM_COL32(40, 48, 60, 200), 1.0f);

            // Espaço vertical útil para os canais do mixer
            float avail_ctrl_h = bot_sec_y - div_y - 8.0f;
            bool compact_mixer = (avail_ctrl_h < 245.0f);

            auto drawRekordboxKnob = [&](const char* id, const char* label, float* p_val, float v_min, float v_max, float def_val, float cx, float cy, float radius) {
                ImVec2 center = ImVec2(cx, cy);
                ImVec2 b_min = ImVec2(cx - radius - 3.0f, cy - radius - 3.0f);
                ImGui::SetCursorScreenPos(b_min);
                ImGui::InvisibleButton(id, ImVec2(radius * 2.0f + 6.0f, radius * 2.0f + 6.0f));
                bool is_active = ImGui::IsItemActive();
                bool is_hovered = ImGui::IsItemHovered();

                if (is_active && ImGui::GetIO().MouseDelta.y != 0.0f) {
                    float step = (v_max - v_min) / 160.0f;
                    *p_val -= ImGui::GetIO().MouseDelta.y * step;
                    *p_val = std::clamp(*p_val, v_min, v_max);
                }
                if (is_hovered && ImGui::GetIO().MouseWheel != 0.0f) {
                    *p_val += ImGui::GetIO().MouseWheel * ((v_max - v_min) / 30.0f);
                    *p_val = std::clamp(*p_val, v_min, v_max);
                }
                if (is_hovered && ImGui::IsMouseDoubleClicked(0)) {
                    *p_val = def_val;
                }

                float norm = (*p_val - v_min) / std::max(0.0001f, (v_max - v_min));
                norm = std::clamp(norm, 0.0f, 1.0f);
                float ang = (-140.0f + norm * 280.0f) * ((float)M_PI / 180.0f) - (float)M_PI * 0.5f;

                // Corpo do knob (Dark Rekordbox Cap)
                dl->AddCircleFilled(center, radius + 1.0f, IM_COL32(10, 12, 16, 255), 24);
                dl->AddCircle(center, radius + 1.0f, is_active ? IM_COL32(0, 140, 240, 255) : (is_hovered ? IM_COL32(70, 85, 110, 255) : IM_COL32(38, 44, 55, 220)), 24, 1.2f);
                dl->AddCircleFilled(center, radius - 1.0f, IM_COL32(24, 28, 36, 255), 24);

                // Indicador radial branco de precisão
                ImVec2 p_in = ImVec2(center.x + std::cos(ang) * (radius * 0.22f), center.y + std::sin(ang) * (radius * 0.22f));
                ImVec2 p_out = ImVec2(center.x + std::cos(ang) * (radius - 1.2f), center.y + std::sin(ang) * (radius - 1.2f));
                dl->AddLine(p_in, p_out, IM_COL32(255, 255, 255, 255), 2.0f);

                // Texto do label diretamente abaixo do knob
                ImVec2 sz_l = ImGui::CalcTextSize(label);
                dl->AddText(ImVec2(center.x - sz_l.x * 0.5f, center.y + radius + 1.0f), IM_COL32(185, 200, 220, 240), label);
            };

            auto drawRekordboxFader = [&](const char* id, float* p_val, float cx, float top_y, float fader_h, float vu_val, float vu_x) {
                float bot_y = top_y + fader_h;
                float mid_y = top_y + fader_h * 0.5f;

                ImGui::SetCursorScreenPos(ImVec2(cx - 12.0f, top_y));
                ImGui::InvisibleButton(id, ImVec2(24.0f, fader_h));
                bool is_active = ImGui::IsItemActive();
                bool is_hovered = ImGui::IsItemHovered();

                if (is_active) {
                    float my = ImGui::GetIO().MousePos.y;
                    float norm = 1.0f - ((my - top_y) / fader_h);
                    *p_val = std::clamp(norm, 0.0f, 1.0f);
                }
                if (is_hovered && ImGui::GetIO().MouseWheel != 0.0f) {
                    *p_val += ImGui::GetIO().MouseWheel * 0.05f;
                    *p_val = std::clamp(*p_val, 0.0f, 1.0f);
                }
                if (is_hovered && ImGui::IsMouseDoubleClicked(0)) {
                    *p_val = 1.0f; // 0 dB
                }

                float norm = std::clamp(*p_val, 0.0f, 1.0f);

                // 1. Ranhuras de calibração horizontais cinza (Top, Mid, Bottom)
                dl->AddLine(ImVec2(cx - 9.0f, top_y), ImVec2(cx + 9.0f, top_y), IM_COL32(80, 90, 105, 220), 1.2f);
                dl->AddLine(ImVec2(cx - 6.0f, mid_y), ImVec2(cx + 6.0f, mid_y), IM_COL32(65, 75, 90, 180), 1.0f);
                dl->AddLine(ImVec2(cx - 9.0f, bot_y), ImVec2(cx + 9.0f, bot_y), IM_COL32(80, 90, 105, 220), 1.2f);

                // 2. Trilha vertical azul vibrante Rekordbox (#0070e0)
                dl->AddLine(ImVec2(cx, top_y), ImVec2(cx, bot_y), IM_COL32(0, 112, 224, 255), 2.2f);

                // 3. Cap do fader metálico horizontal com linha central branca
                float cap_y = bot_y - norm * fader_h;
                dl->AddRectFilled(ImVec2(cx - 10.0f, cap_y - 3.5f), ImVec2(cx + 10.0f, cap_y + 3.5f), IM_COL32(40, 48, 60, 255), 1.5f);
                dl->AddRect(ImVec2(cx - 10.0f, cap_y - 3.5f), ImVec2(cx + 10.0f, cap_y + 3.5f), IM_COL32(80, 95, 115, 240), 1.5f, 0, 1.0f);
                dl->AddLine(ImVec2(cx - 8.0f, cap_y), ImVec2(cx + 8.0f, cap_y), IM_COL32(255, 255, 255, 255), 1.5f);

                // 4. VU Meter LED ao lado do fader
                float vu_w = 3.0f;
                dl->AddRectFilled(ImVec2(vu_x, top_y), ImVec2(vu_x + vu_w, bot_y), IM_COL32(6, 8, 12, 255));
                int segs = 14;
                float seg_h = fader_h / (float)segs;
                int lit_segs = (int)(std::clamp(vu_val, 0.0f, 1.0f) * (float)segs);
                for (int s = 0; s < segs; s++) {
                    float sy = bot_y - (float)(s + 1) * seg_h;
                    bool lit = (s < lit_segs);
                    ImU32 sc = IM_COL32(0, 220, 255, 240);
                    if (s >= 12) sc = IM_COL32(255, 30, 45, 255);
                    else if (s >= 9) sc = IM_COL32(255, 175, 0, 255);
                    if (!lit) sc = IM_COL32(15, 22, 32, 160);
                    dl->AddRectFilled(ImVec2(vu_x, sy + 0.5f), ImVec2(vu_x + vu_w, sy + seg_h - 0.5f), sc, 0.5f);
                }
            };

            auto drawMixerStrip = [&](KuroAudio::DJDeck& deck, int id, float start_x) {
                bool is_cue = (id == 0) ? engine.getCueDeckA() : engine.getCueDeckB();
                auto toggleCue = [&]() {
                    if (id == 0) engine.setCueDeckA(!is_cue);
                    else engine.setCueDeckB(!is_cue);
                };

                if (compact_mixer) {
                    // =====================================================================
                    // MODO COMPACTO / TALL WAVES: FADERS NA LATERAL DOS KNOBS!
                    // =====================================================================
                    float k_r = 7.5f;
                    float k_step = std::clamp((avail_ctrl_h - 26.0f) / 4.0f, 21.0f, 28.0f);
                    float knobs_cx, fader_cx, vu_x;

                    if (id == 0) {
                        // Deck 1 (Esquerda): Fader na extrema esquerda, Knobs à direita voltados ao centro
                        fader_cx = start_x + 16.0f;
                        vu_x = fader_cx + 12.0f;
                        knobs_cx = start_x + ch_w - 22.0f;
                    } else {
                        // Deck 2 (Direita): Knobs à esquerda voltados ao centro, Fader na extrema direita
                        knobs_cx = start_x + 22.0f;
                        fader_cx = start_x + ch_w - 16.0f;
                        vu_x = fader_cx - 15.0f;
                    }

                    // 1. Os 4 Knobs de EQ (TRIM, HIGH, MID, LOW)
                    float cy = div_y + 8.0f;
                    char t_id[32]; snprintf(t_id, sizeof(t_id), "##RekTrim_%d", id);
                    drawRekordboxKnob(t_id, "TRIM", &deck.gain, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    cy += k_step;
                    char h_id[32]; snprintf(h_id, sizeof(h_id), "##RekHigh_%d", id);
                    drawRekordboxKnob(h_id, "HIGH", &deck.eq_high, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    cy += k_step;
                    char m_id[32]; snprintf(m_id, sizeof(m_id), "##RekMid_%d", id);
                    drawRekordboxKnob(m_id, "MID", &deck.eq_mid, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    cy += k_step;
                    char l_id[32]; snprintf(l_id, sizeof(l_id), "##RekLow_%d", id);
                    drawRekordboxKnob(l_id, "LOW", &deck.eq_low, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    // 2. Botão CUE diretamente abaixo do knob LOW
                    float cue_y = cy + 13.0f;
                    float cue_w = 32.0f;
                    float cue_h = 16.0f;
                    ImVec2 cue_min = ImVec2(knobs_cx - cue_w * 0.5f, cue_y);
                    ImVec2 cue_max = ImVec2(knobs_cx + cue_w * 0.5f, cue_y + cue_h);

                    ImGui::SetCursorScreenPos(cue_min);
                    char cb_id[32]; snprintf(cb_id, sizeof(cb_id), "##RekCueBtn_%d", id);
                    if (ImGui::InvisibleButton(cb_id, ImVec2(cue_w, cue_h))) {
                        toggleCue();
                    }
                    dl->AddRectFilled(cue_min, cue_max, is_cue ? IM_COL32(180, 80, 0, 255) : IM_COL32(22, 26, 34, 255), 2.0f);
                    dl->AddRect(cue_min, cue_max, is_cue ? IM_COL32(255, 160, 20, 255) : IM_COL32(45, 54, 68, 220), 2.0f, 0, 1.0f);
                    ImVec2 sz_cue = ImGui::CalcTextSize("CUE");
                    dl->AddText(ImVec2(cue_min.x + (cue_w - sz_cue.x) * 0.5f, cue_min.y + 1.0f), is_cue ? IM_COL32(255, 255, 255, 255) : IM_COL32(200, 215, 235, 240), "CUE");

                    // 3. Fader de Volume na Lateral (ocupando toda a altura ao lado dos knobs)
                    float fader_top_y = div_y + 8.0f;
                    float fader_h = std::clamp(avail_ctrl_h - 16.0f, 65.0f, 130.0f);
                    char f_id[32]; snprintf(f_id, sizeof(f_id), "##RekFader_%d", id);
                    drawRekordboxFader(f_id, &deck.volume, fader_cx, fader_top_y, fader_h, deck.vu_meter, vu_x);

                } else {
                    // =====================================================================
                    // MODO VERTICAL PADRÃO (Janela Alta / Waves Normais): Faders abaixo dos Knobs
                    // =====================================================================
                    float ch_cx = start_x + ch_w * 0.5f;
                    float k_r = 9.0f;
                    float k_step = std::clamp((avail_ctrl_h - 110.0f) / 4.0f, 28.0f, 35.0f);
                    float cy = div_y + 10.0f;

                    // 1. TRIM
                    char t_id[32]; snprintf(t_id, sizeof(t_id), "##RekTrim_%d", id);
                    drawRekordboxKnob(t_id, "TRIM", &deck.gain, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 2. HIGH
                    cy += k_step;
                    char h_id[32]; snprintf(h_id, sizeof(h_id), "##RekHigh_%d", id);
                    drawRekordboxKnob(h_id, "HIGH", &deck.eq_high, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 3. MID
                    cy += k_step;
                    char m_id[32]; snprintf(m_id, sizeof(m_id), "##RekMid_%d", id);
                    drawRekordboxKnob(m_id, "MID", &deck.eq_mid, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 4. LOW
                    cy += k_step;
                    char l_id[32]; snprintf(l_id, sizeof(l_id), "##RekLow_%d", id);
                    drawRekordboxKnob(l_id, "LOW", &deck.eq_low, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 5. CUE BUTTON
                    cy += (k_step * 0.9f);
                    float cue_btn_w = 36.0f;
                    float cue_btn_h = 18.0f;
                    ImVec2 cue_min = ImVec2(ch_cx - cue_btn_w * 0.5f, cy);
                    ImVec2 cue_max = ImVec2(ch_cx + cue_btn_w * 0.5f, cy + cue_btn_h);

                    ImGui::SetCursorScreenPos(cue_min);
                    char cb_id[32]; snprintf(cb_id, sizeof(cb_id), "##RekCueBtn_%d", id);
                    if (ImGui::InvisibleButton(cb_id, ImVec2(cue_btn_w, cue_btn_h))) {
                        toggleCue();
                    }
                    dl->AddRectFilled(cue_min, cue_max, is_cue ? IM_COL32(180, 80, 0, 255) : IM_COL32(22, 26, 34, 255), 2.0f);
                    dl->AddRect(cue_min, cue_max, is_cue ? IM_COL32(255, 160, 20, 255) : IM_COL32(45, 54, 68, 220), 2.0f, 0, 1.0f);
                    ImVec2 sz_cue = ImGui::CalcTextSize("CUE");
                    dl->AddText(ImVec2(cue_min.x + (cue_btn_w - sz_cue.x) * 0.5f, cue_min.y + 2.0f), is_cue ? IM_COL32(255, 255, 255, 255) : IM_COL32(200, 215, 235, 240), "CUE");

                    // 6. CHANNEL FADER & VU METER
                    cy += cue_btn_h + 8.0f;
                    float fader_h = std::clamp(bot_sec_y - cy - 8.0f, 40.0f, 95.0f);
                    char f_id[32]; snprintf(f_id, sizeof(f_id), "##RekFader_%d", id);
                    drawRekordboxFader(f_id, &deck.volume, ch_cx, cy, fader_h, deck.vu_meter, ch_cx + 18.0f);
                }
            };

            drawMixerStrip(deck_l, 0, pos.x + 4.0f);
            drawMixerStrip(deck_r, 1, pos.x + 4.0f + ch_w + 4.0f);

            // 7. SEÇÃO INFERIOR DO MIXER (Headphones, Channel Assign, Crossfader - Totalmente Harmonizado e Sem Overlap)
            auto& routing = KuroAudio::DJAudioRouting::getInstance();

            // Linha divisoria sutil acima da secao do Crossfader
            dl->AddLine(ImVec2(pos.x + 8.0f, bot_sec_y - 2.0f), ImVec2(pos.x + w - 8.0f, bot_sec_y - 2.0f), IM_COL32(36, 44, 58, 180), 1.0f);

            // Row 1: Headphone Icon + Mix/Level Sliders (Esq) + Crossfader Curve & Channel Assign [1][2] (Dir)
            ImVec2 hp_icon_pos = ImVec2(pos.x + 8.0f, bot_sec_y + 3.0f);
            dl->AddCircle(ImVec2(hp_icon_pos.x + 5.0f, hp_icon_pos.y + 6.0f), 4.5f, IM_COL32(180, 195, 215, 240), 16, 1.2f);
            dl->AddRectFilled(ImVec2(hp_icon_pos.x + 1.5f, hp_icon_pos.y + 6.0f), ImVec2(hp_icon_pos.x + 4.5f, hp_icon_pos.y + 10.5f), IM_COL32(180, 195, 215, 240), 1.0f);
            dl->AddRectFilled(ImVec2(hp_icon_pos.x + 5.5f, hp_icon_pos.y + 6.0f), ImVec2(hp_icon_pos.x + 8.5f, hp_icon_pos.y + 10.5f), IM_COL32(180, 195, 215, 240), 1.0f);

            float hp_mix = routing.getCueMix();
            ImGui::SetCursorScreenPos(ImVec2(pos.x + 22.0f, bot_sec_y + 2.0f));
            ImGui::PushItemWidth(34.0f);
            if (ImGui::SliderFloat("##HPMix", &hp_mix, 0.0f, 1.0f, "")) routing.setCueMix(hp_mix);
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Fone: Cue / Master Mix");
            ImGui::PopItemWidth();

            float hp_gain = routing.getHeadphoneGain();
            ImGui::SameLine(0, 3.0f);
            ImGui::PushItemWidth(34.0f);
            if (ImGui::SliderFloat("##HPGain", &hp_gain, 0.0f, 1.5f, "")) routing.setHeadphoneGain(hp_gain);
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Fone: Volume Level");
            ImGui::PopItemWidth();

            // Curva do Crossfader (Botao seletor central: Smooth / Sharp)
            float crv_x = pos.x + w * 0.5f - 11.0f;
            int cur_crv = engine.getCrossfaderCurve();
            const char* crv_symbol = (cur_crv == 0 ? "~" : (cur_crv == 1 ? "^" : "|_"));
            dl->AddRectFilled(ImVec2(crv_x, bot_sec_y + 2.0f), ImVec2(crv_x + 22.0f, bot_sec_y + 17.0f), IM_COL32(22, 28, 38, 255), 2.0f);
            dl->AddRect(ImVec2(crv_x, bot_sec_y + 2.0f), ImVec2(crv_x + 22.0f, bot_sec_y + 17.0f), IM_COL32(46, 58, 76, 200), 2.0f, 0, 1.0f);
            ImVec2 crv_sz = ImGui::CalcTextSize(crv_symbol);
            dl->AddText(ImVec2(crv_x + (22.0f - crv_sz.x) * 0.5f, bot_sec_y + 2.0f), IM_COL32(0, 200, 255, 240), crv_symbol);
            ImGui::SetCursorScreenPos(ImVec2(crv_x, bot_sec_y + 2.0f));
            if (ImGui::InvisibleButton("##RekXFCurve", ImVec2(22.0f, 15.0f))) {
                engine.setCrossfaderCurve((cur_crv + 1) % 3);
            }
            if (ImGui::IsItemHovered()) {
                const char* crv_names[] = { "Linear / Suave (House/Techno)", "Ingreme / Acentuada (Mix rapido)", "Corte Rapido / Scratch (Hip-Hop/Turntablism)" };
                ImGui::SetTooltip("Curva do Crossfader: %s\n(Clique para alternar)", crv_names[cur_crv % 3]);
            }

            // Channel assign matrix [1] [2] na extrema direita da Row 1
            float ass_x = pos.x + w - 44.0f;
            auto chAssBtn = [&](const char* lbl, bool act, ImVec2 bp, auto on_click) {
                dl->AddRectFilled(bp, ImVec2(bp.x + 18.0f, bp.y + 15.0f), act ? IM_COL32(0, 112, 224, 255) : IM_COL32(20, 25, 34, 255), 2.0f);
                dl->AddRect(bp, ImVec2(bp.x + 18.0f, bp.y + 15.0f), act ? IM_COL32(255, 255, 255, 200) : IM_COL32(40, 50, 65, 200), 2.0f, 0, 1.0f);
                ImVec2 tsz = ImGui::CalcTextSize(lbl);
                dl->AddText(ImVec2(bp.x + (18.0f - tsz.x) * 0.5f, bp.y + 0.5f), act ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 175, 195, 240), lbl);
                ImGui::SetCursorScreenPos(bp);
                char bid[32]; snprintf(bid, sizeof(bid), "##ChAss_%s", lbl);
                if (ImGui::InvisibleButton(bid, ImVec2(18.0f, 15.0f))) on_click();
            };

            chAssBtn("1", left_id == 0, ImVec2(ass_x, bot_sec_y + 2.0f), [&]() { ddj_hardware.setActiveLeftDeck(0); });
            chAssBtn("2", right_id == 1, ImVec2(ass_x + 22.0f, bot_sec_y + 2.0f), [&]() { ddj_hardware.setActiveRightDeck(1); });

            // Row 2: O CROSSFADER EM SI (Elemento Inferior Definitivo - Totalmente Visivel e Centralizado)
            float xf_y = bot_sec_y + 32.0f;
            float xf_rail_l = pos.x + 16.0f;
            float xf_rail_r = pos.x + w - 16.0f;
            float xf_rail_w = xf_rail_r - xf_rail_l;
            float xf_cx = pos.x + w * 0.5f;

            // Fundo escuro rebaixado do rasgo do crossfader
            dl->AddRectFilled(ImVec2(xf_rail_l - 2.0f, xf_y - 3.0f), ImVec2(xf_rail_r + 2.0f, xf_y + 3.0f), IM_COL32(8, 10, 14, 255), 2.0f);
            // Trilho metalico
            dl->AddLine(ImVec2(xf_rail_l, xf_y), ImVec2(xf_rail_r, xf_y), IM_COL32(50, 60, 78, 255), 2.0f);
            // Marcacao central de 50/50 (Center White Tick)
            dl->AddLine(ImVec2(xf_cx, xf_y - 7.0f), ImVec2(xf_cx, xf_y + 7.0f), IM_COL32(200, 215, 235, 255), 1.5f);
            // Limites laterais
            dl->AddLine(ImVec2(xf_rail_l, xf_y - 5.0f), ImVec2(xf_rail_l, xf_y + 5.0f), IM_COL32(90, 105, 125, 255), 1.2f);
            dl->AddLine(ImVec2(xf_rail_r, xf_y - 5.0f), ImVec2(xf_rail_r, xf_y + 5.0f), IM_COL32(90, 105, 125, 255), 1.2f);

            // Cap metalico do crossfader Pioneer com linha branca
            float xf_val = engine.getCrossfader();
            float cap_x = xf_rail_l + xf_val * xf_rail_w;
            dl->AddRectFilled(ImVec2(cap_x - 8.0f, xf_y - 9.0f), ImVec2(cap_x + 8.0f, xf_y + 9.0f), IM_COL32(38, 46, 58, 255), 2.5f);
            dl->AddRect(ImVec2(cap_x - 8.0f, xf_y - 9.0f), ImVec2(cap_x + 8.0f, xf_y + 9.0f), IM_COL32(85, 105, 130, 240), 2.5f, 0, 1.0f);
            dl->AddLine(ImVec2(cap_x, xf_y - 7.0f), ImVec2(cap_x, xf_y + 7.0f), IM_COL32(255, 255, 255, 255), 1.5f);

            ImGui::SetCursorScreenPos(ImVec2(xf_rail_l - 6.0f, xf_y - 12.0f));
            if (ImGui::InvisibleButton("##RekXFTrack", ImVec2(xf_rail_w + 12.0f, 24.0f))) {
                float mx = ImGui::GetIO().MousePos.x - xf_rail_l;
                engine.setCrossfader(std::clamp(mx / xf_rail_w, 0.0f, 1.0f));
            }
            if (ImGui::IsItemActive()) {
                float mx = ImGui::GetIO().MousePos.x - xf_rail_l;
                engine.setCrossfader(std::clamp(mx / xf_rail_w, 0.0f, 1.0f));
            }
            if (ImGui::IsItemHovered()) {
                if (ImGui::IsMouseDoubleClicked(0)) {
                    engine.setCrossfader(0.5f);
                }
                ImGui::SetTooltip("Crossfader (%.0f%% / 2-clique centraliza no meio)", xf_val * 100.0f);
            }
        }

