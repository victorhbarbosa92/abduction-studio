        void applyManualBpm(KuroAudio::DJDeck& deck, float target_bpm, bool shift_or_alt) {
            if (target_bpm < 20.0f || target_bpm > 300.0f) return;
            if (deck.bpm > 20.0 && !shift_or_alt) {
                float needed_pitch = (float)(((target_bpm / deck.bpm) - 1.0) * 100.0);
                if (std::abs(needed_pitch) <= deck.pitch_range) {
                    deck.pitch_percent = needed_pitch;
                } else {
                    if (std::abs(needed_pitch) <= 10.0f) deck.pitch_range = 10.0f;
                    else if (std::abs(needed_pitch) <= 16.0f) deck.pitch_range = 16.0f;
                    else if (std::abs(needed_pitch) <= 100.0f) deck.pitch_range = 100.0f;
                    else {
                        deck.bpm = target_bpm;
                        deck.pitch_percent = 0.0f;
                        deck.sync_active = false;
                        return;
                    }
                    deck.pitch_percent = needed_pitch;
                }
            } else {
                deck.bpm = target_bpm;
                deck.pitch_percent = 0.0f;
            }
            deck.sync_active = false;
        }

