                        double cur_pos = preview_player.getPosition();
                        double dur = preview_player.getDuration();
                        if (dur <= 0.1) dur = 30.0;
                        float progress = (float)std::clamp(cur_pos / dur, 0.0, 1.0);

                        float wave_x = info_x;
                        float wave_y = card_pos.y + 24.0f;
                        float wave_w = card_w - 280.0f;
                        float wave_h = 18.0f;

                        dl->AddRectFilled(ImVec2(wave_x, wave_y), ImVec2(wave_x + wave_w, wave_y + wave_h), IM_COL32(5, 7, 12, 220), 3.0f);
                        const auto& peaks = preview_player.getWaveformPeaks();
                        int n_bars = (int)peaks.size();
                        if (n_bars > 0) {
                            float bar_step = wave_w / (float)n_bars;
                            float bar_w = std::max(1.5f, bar_step - 1.0f);
                            for (int b = 0; b < n_bars; b++) {
                                float bx = wave_x + b * bar_step;
                                float bh = peaks[b] * (wave_h - 4.0f);
                                float by = wave_y + (wave_h - bh) * 0.5f;
                                float bar_ratio = (float)b / (float)n_bars;
                                bool played = (bar_ratio <= progress);
                                ImU32 col_bar = played ? 
                                    IM_COL32((int)(0 + 255 * bar_ratio), (int)(245 * (1.0f - bar_ratio * 0.6f)), 220, 240) :
                                    IM_COL32(65, 80, 105, 110);
                                dl->AddRectFilled(ImVec2(bx, by), ImVec2(bx + bar_w, by + bh), col_bar, 1.0f);
