        // ═════════════════════════════════════════════════════════════════════════════════
        // PIONEER DIGITAL CONSOLE BEAT STEPPER: [ ◄ |  1/2  | ► ] (Cápsula Integrada OLED)
        // ═════════════════════════════════════════════════════════════════════════════════
        static bool renderPioneerBeatStepper(const char* id_prefix, int s_idx, int* p_beat_idx, int max_idx, 
                                             const char* disp_text, ImVec2 pos, ImVec2 size, ImU32 accent_col = IM_COL32(0, 229, 255, 255)) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImGuiIO& io = ImGui::GetIO();
            bool changed = false;

            float w = size.x;
            float h = size.y;
            float btn_w = 13.0f;
            float oled_w = std::max(16.0f, w - btn_w * 2.0f);

            // 1. Chassi da Cápsula Integrada estilo Pioneer CDJ / DJM
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(8, 10, 15, 255), 2.5f);
            dl->AddRect(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(38, 48, 64, 220), 2.5f, 0, 1.0f);

            // Separadores verticais sutis entre as seções da cápsula
            dl->AddLine(ImVec2(pos.x + btn_w, pos.y + 1.0f), ImVec2(pos.x + btn_w, pos.y + h - 1.0f), IM_COL32(28, 36, 48, 200), 1.0f);
            dl->AddLine(ImVec2(pos.x + btn_w + oled_w, pos.y + 1.0f), ImVec2(pos.x + btn_w + oled_w, pos.y + h - 1.0f), IM_COL32(28, 36, 48, 200), 1.0f);

            // 2. Botão Esquerdo: Seta de Decremento ◄ (Triângulo Vetorial Anti-aliased)
            ImVec2 l_pos = pos;
            ImGui::SetCursorScreenPos(l_pos);
            char l_id[64]; snprintf(l_id, sizeof(l_id), "##ps_dec_%s_%d", id_prefix, s_idx);
            ImGui::InvisibleButton(l_id, ImVec2(btn_w, h));
            bool l_hovered = ImGui::IsItemHovered();
            bool l_active = ImGui::IsItemActive();
            if (ImGui::IsItemClicked(0)) {
                if (*p_beat_idx > 0) {
                    (*p_beat_idx)--;
                    changed = true;
                }
            }

            if (l_hovered) {
                dl->AddRectFilled(l_pos, ImVec2(l_pos.x + btn_w, l_pos.y + h), 
                                  l_active ? IM_COL32(0, 180, 255, 90) : IM_COL32(255, 255, 255, 30), 2.0f);
            }

            // Triângulo ◄
            float cy = pos.y + h * 0.5f;
            float tri_h = 3.2f;
            float tri_w = 4.0f;
            float tri_cx = l_pos.x + btn_w * 0.5f;
            ImU32 tri_col_l = (*p_beat_idx > 0) ? (l_hovered ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 185, 215, 220)) 
                                                : IM_COL32(65, 75, 90, 160);
            dl->AddTriangleFilled(ImVec2(tri_cx - tri_w * 0.5f, cy),
                                  ImVec2(tri_cx + tri_w * 0.5f, cy - tri_h),
                                  ImVec2(tri_cx + tri_w * 0.5f, cy + tri_h),
                                  tri_col_l);

            // 3. Display Central OLED (Fundo Preto Profundo com Texto Ciano / Âmbar Glow)
            ImVec2 oled_pos = ImVec2(pos.x + btn_w, pos.y);
            dl->AddRectFilled(oled_pos, ImVec2(oled_pos.x + oled_w, oled_pos.y + h), IM_COL32(4, 5, 8, 255));

            ImVec2 txt_sz = ImGui::CalcTextSize(disp_text);
            dl->AddText(ImVec2(oled_pos.x + (oled_w - txt_sz.x) * 0.5f, oled_pos.y + (h - txt_sz.y) * 0.5f),
                        accent_col, disp_text);

            // Suporte a mouse wheel no display OLED para scrub intuitivo de frações
            ImGui::SetCursorScreenPos(oled_pos);
            char oled_id[64]; snprintf(oled_id, sizeof(oled_id), "##ps_scrub_%s_%d", id_prefix, s_idx);
            ImGui::InvisibleButton(oled_id, ImVec2(oled_w, h));
            if (ImGui::IsItemHovered()) {
                if (io.MouseWheel > 0.0f && *p_beat_idx < max_idx - 1) {
                    (*p_beat_idx)++;
                    changed = true;
                } else if (io.MouseWheel < 0.0f && *p_beat_idx > 0) {
                    (*p_beat_idx)--;
                    changed = true;
                }
            }

            // 4. Botão Direito: Seta de Incremento ► (Triângulo Vetorial Anti-aliased)
            ImVec2 r_pos = ImVec2(pos.x + btn_w + oled_w, pos.y);
            ImGui::SetCursorScreenPos(r_pos);
            char r_id[64]; snprintf(r_id, sizeof(r_id), "##ps_inc_%s_%d", id_prefix, s_idx);
            ImGui::InvisibleButton(r_id, ImVec2(btn_w, h));
            bool r_hovered = ImGui::IsItemHovered();
            bool r_active = ImGui::IsItemActive();
            if (ImGui::IsItemClicked(0)) {
                if (*p_beat_idx < max_idx - 1) {
                    (*p_beat_idx)++;
                    changed = true;
                }
            }

            if (r_hovered) {
                dl->AddRectFilled(r_pos, ImVec2(r_pos.x + btn_w, r_pos.y + h), 
                                  r_active ? IM_COL32(0, 180, 255, 90) : IM_COL32(255, 255, 255, 30), 2.0f);
            }

            // Triângulo ►
            float tri_rcx = r_pos.x + btn_w * 0.5f;
            ImU32 tri_col_r = (*p_beat_idx < max_idx - 1) ? (r_hovered ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 185, 215, 220)) 
                                                          : IM_COL32(65, 75, 90, 160);
            dl->AddTriangleFilled(ImVec2(tri_rcx + tri_w * 0.5f, cy),
                                  ImVec2(tri_rcx - tri_w * 0.5f, cy - tri_h),
                                  ImVec2(tri_rcx - tri_w * 0.5f, cy + tri_h),
                                  tri_col_r);

            return changed;
        }

        // Renderizador de Unidade Beat FX Individual (FX1 ou FX2 - 100% Autêntico Rekordbox / Pioneer Digital)
        void renderRekordboxFXUnit(KuroAudio::DJEngine& engine, KuroAudio::DJBeatFXUnit& fx_unit, const char* unit_name, 
                                   ImVec2 pos, float unit_w, float unit_h, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();

            // 1. Título da Unidade (ex: "FX1" ou "FX2")
            dl->AddText(g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont(), 
                        14.0f, ImVec2(pos.x + 6.0f, pos.y + 14.0f), 
                        IM_COL32(230, 235, 245, 240), unit_name);

            // 2. Matriz de Atribuição de Canais (6 botões em 2x3: [1][2][S] / [3][4][M])
            float m_start_x = pos.x + 32.0f;
            float btn_w = 17.0f;
            float btn_h = 16.0f;
            float gap_x = 2.0f;
            float gap_y = 2.0f;

            struct ChDef {
                const char* lbl;
                int ch_id;
                int col;
                int row;
                const char* tip;
            };

            const ChDef ch_defs[6] = {
                { "1", 0, 0, 0, "Atribuir FX ao Deck 1" },
                { "2", 1, 1, 0, "Atribuir FX ao Deck 2" },
                { "S", 2, 2, 0, "Atribuir FX ao Sampler" },
                { "3", 3, 0, 1, "Atribuir FX ao Deck 3" },
                { "4", 4, 1, 1, "Atribuir FX ao Deck 4" },
                { "M", 5, 2, 1, "Atribuir FX ao Master" }
            };

            for (int c = 0; c < 6; c++) {
                const auto& cd = ch_defs[c];
                bool is_active = (fx_unit.channel_assign == cd.ch_id);
                ImVec2 b_pos = ImVec2(m_start_x + cd.col * (btn_w + gap_x), pos.y + 6.0f + cd.row * (btn_h + gap_y));

                ImU32 bg_c = is_active ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = is_active ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                ImU32 txt_c = is_active ? IM_COL32(255, 255, 255, 255) : IM_COL32(165, 178, 195, 240);

                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), brd_c, 2.0f);

                ImVec2 t_sz = ImGui::CalcTextSize(cd.lbl);
                dl->AddText(ImVec2(b_pos.x + (btn_w - t_sz.x) * 0.5f, b_pos.y + (btn_h - t_sz.y) * 0.5f), txt_c, cd.lbl);

                ImGui::SetCursorScreenPos(b_pos);
                char bid[32]; snprintf(bid, sizeof(bid), "##ChMtx_%s_%d", unit_name, cd.ch_id);
                if (ImGui::InvisibleButton(bid, ImVec2(btn_w, btn_h))) {
                    fx_unit.channel_assign = cd.ch_id;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("%s", cd.tip);
            }

            // 3. Seletor de Modo: [...] Multi-FX vs [•] Single-FX
            float mode_x = m_start_x + 3.0f * (btn_w + gap_x) + 3.0f;
            float mode_w = 18.0f;

            // Botão [...] Multi-FX
            {
                bool is_multi = (fx_unit.fx_mode == 0);
                ImVec2 b_pos = ImVec2(mode_x, pos.y + 6.0f);
                ImU32 bg_c = is_multi ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = is_multi ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), brd_c, 2.0f);
                
                // 3 pontos horizontais
                float cy = b_pos.y + btn_h * 0.5f;
                float dot_r = 1.2f;
                ImU32 dot_c = is_multi ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 175, 195, 230);
                dl->AddCircleFilled(ImVec2(b_pos.x + 4.5f, cy), dot_r, dot_c);
                dl->AddCircleFilled(ImVec2(b_pos.x + 9.0f, cy), dot_r, dot_c);
                dl->AddCircleFilled(ImVec2(b_pos.x + 13.5f, cy), dot_r, dot_c);

                ImGui::SetCursorScreenPos(b_pos);
                char mbid[32]; snprintf(mbid, sizeof(mbid), "##ModeMulti_%s", unit_name);
                if (ImGui::InvisibleButton(mbid, ImVec2(mode_w, btn_h))) {
                    fx_unit.fx_mode = 0;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Modo Multi-FX (Rack de 4 Slots Independentes)");
            }

            // Botão [•] Single-FX
            {
                bool is_single = (fx_unit.fx_mode == 1);
                ImVec2 b_pos = ImVec2(mode_x, pos.y + 6.0f + btn_h + gap_y);
                ImU32 bg_c = is_single ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = is_single ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), brd_c, 2.0f);

                // 1 ponto central
                float cy = b_pos.y + btn_h * 0.5f;
                ImU32 dot_c = is_single ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 175, 195, 230);
                dl->AddCircleFilled(ImVec2(b_pos.x + mode_w * 0.5f, cy), 1.6f, dot_c);

                ImGui::SetCursorScreenPos(b_pos);
                char sbid[32]; snprintf(sbid, sizeof(sbid), "##ModeSingle_%s", unit_name);
                if (ImGui::InvisibleButton(sbid, ImVec2(mode_w, btn_h))) {
                    fx_unit.fx_mode = 1;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Modo Single-FX (Controle Master Detalhado)");
            }

            // 4. Slots de Efeitos (Multi-FX ou Single-FX)
            static const float s_fractions[] = { 0.0625f, 0.125f, 0.25f, 0.5f, 0.75f, 1.0f, 2.0f, 4.0f, 8.0f, 16.0f };
            static const char* s_frac_labels[] = { "1/16", "1/8", "1/4", "1/2", "3/4", "1", "2", "4", "8", "16" };
            static const int s_num_fractions = 10;

            float slots_start_x = mode_x + mode_w + 5.0f;
            float auto_tap_w = 42.0f;
            float right_pad = 4.0f;
            float at_x = pos.x + unit_w - auto_tap_w - right_pad;
            float avail_slots_w = (at_x - 6.0f) - slots_start_x;

            if (fx_unit.fx_mode == 0) {
                // MULTI-FX: 4 Slots Elegantes estilo Console Pioneer
                float slot_w = std::clamp(std::floor((avail_slots_w - 9.0f) / 4.0f), 70.0f, 120.0f);

                for (int s = 0; s < 4; s++) {
                    float sx = slots_start_x + s * (slot_w + 3.0f);
                    auto& slot = fx_unit.multi_slots[s];

                    // ─── Linha 1 (Superior): Botão Iluminado ON/OFF + Dropdown Seletor FX ───
                    float on_w = 23.0f;
                    float drop_w = std::max(20.0f, slot_w - on_w - 2.0f);

                    // 1.1 Botão ON/OFF Iluminado estilo Pioneer
                    ImVec2 on_pos = ImVec2(sx, pos.y + 6.0f);
                    ImU32 on_bg = slot.enabled ? IM_COL32(0, 110, 220, 240) : IM_COL32(18, 22, 30, 240);
                    ImU32 on_brd = slot.enabled ? IM_COL32(0, 230, 255, 255) : IM_COL32(40, 48, 62, 200);
                    ImU32 on_txt = slot.enabled ? IM_COL32(255, 255, 255, 255) : IM_COL32(120, 135, 155, 220);

                    dl->AddRectFilled(on_pos, ImVec2(on_pos.x + on_w, on_pos.y + 18.0f), on_bg, 2.0f);
                    dl->AddRect(on_pos, ImVec2(on_pos.x + on_w, on_pos.y + 18.0f), on_brd, 2.0f);
                    if (slot.enabled) {
                        dl->AddRect(ImVec2(on_pos.x - 1.0f, on_pos.y - 1.0f), 
                                    ImVec2(on_pos.x + on_w + 1.0f, on_pos.y + 19.0f), 
                                    IM_COL32(0, 200, 255, 70), 3.0f);
                    }

                    ImVec2 on_sz = ImGui::CalcTextSize("ON");
                    dl->AddText(ImVec2(on_pos.x + (on_w - on_sz.x) * 0.5f, on_pos.y + (18.0f - on_sz.y) * 0.5f), on_txt, "ON");

                    ImGui::SetCursorScreenPos(on_pos);
                    char on_id[32]; snprintf(on_id, sizeof(on_id), "##OnBtn_%s_%d", unit_name, s);
                    if (ImGui::InvisibleButton(on_id, ImVec2(on_w, 18.0f))) {
                        slot.enabled = !slot.enabled;
                        if (slot.enabled) fx_unit.enabled = true;
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Ligar/Desligar Slot %d (%s)", s + 1, slot.enabled ? "ATIVO" : "BYPASS");

                    // 1.2 Botão Dropdown Seletor FX
                    ImGui::SetCursorScreenPos(ImVec2(sx + on_w + 2.0f, pos.y + 6.0f));
                    char btn_lbl[64];
                    const char* fx_name = KuroAudio::DJBeatFXUnit::getFXName(slot.type);
                    snprintf(btn_lbl, sizeof(btn_lbl), "%s v##s_%s_%d", fx_name, unit_name, s);

                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.08f, 0.10f, 0.14f, 0.95f));
                    ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.24f, 0.29f, 0.38f, 0.85f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.95f, 0.95f, 1.0f, 1.0f));
                    if (ImGui::Button(btn_lbl, ImVec2(drop_w, 18.0f))) {
                        char popup_id[64];
                        snprintf(popup_id, sizeof(popup_id), "##FXPop_%s_%d", unit_name, s);
                        ImGui::OpenPopup(popup_id);
                    }
                    ImGui::PopStyleColor(3);

                    char popup_id[64];
                    snprintf(popup_id, sizeof(popup_id), "##FXPop_%s_%d", unit_name, s);
                    renderRekordboxFXPopup(popup_id, &slot.type);

                    // ─── Linha 2 (Inferior): Knob Rotativo Metálico + Stepper de Batida Pioneer ───
                    // Knob: pos.y + 27.0f, sem texto embaixo (show_value_text = false) para ajuste perfeito ao rack
                    ImVec2 k_pos = ImVec2(sx, pos.y + 27.0f);
                    ImGui::SetCursorScreenPos(k_pos);
                    char kid[32]; snprintf(kid, sizeof(kid), "##k_%s_%d", unit_name, s);
                    if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(kid, &slot.dry_wet, 0.0f, 1.0f, 7.0f,
                                                                        ImVec4(0.0f, 0.75f, 1.0f, 1.0f), "%.0f%%", 0.0f, false, false, false, false, false)) {
                        slot.enabled = (slot.dry_wet > 0.005f);
                        if (slot.enabled) fx_unit.enabled = true;
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Depth/Nível Slot %d: %.0f%%", s + 1, slot.dry_wet * 100.0f);

                    // Stepper: cápsula integrada com OLED central a partir de sx + 28.0f (2px de folga do knob)
                    const char* frac_text = (slot.beat_idx >= 0 && slot.beat_idx < s_num_fractions) ? s_frac_labels[slot.beat_idx] : "1";
                    char disp_txt[32];
                    bool is_mod = (slot.type == KuroAudio::DJBeatFXUnit::FX_ENIGMA_JET || 
                                   slot.type == KuroAudio::DJBeatFXUnit::FX_MOBIUS_SAW ||
                                   slot.type == KuroAudio::DJBeatFXUnit::FX_MOBIUS_TRI);
                    if (is_mod && slot.beat_fraction >= 1.0f) {
                        snprintf(disp_txt, sizeof(disp_txt), "+%s", frac_text);
                    } else {
                        snprintf(disp_txt, sizeof(disp_txt), "%s", frac_text);
                    }

                    float stepper_x = sx + 28.0f;
                    float stepper_w = std::max(20.0f, slot_w - 28.0f);
                    ImU32 accent_col = is_mod ? IM_COL32(255, 175, 25, 255) : IM_COL32(0, 229, 255, 255);

                    if (renderPioneerBeatStepper(unit_name, s, &slot.beat_idx, s_num_fractions, disp_txt, 
                                                ImVec2(stepper_x, pos.y + 27.0f), ImVec2(stepper_w, 18.0f), accent_col)) {
                        slot.beat_fraction = s_fractions[slot.beat_idx];
                    }
                }
            } else {
                // SINGLE-FX: Controles Master
                float s_w = std::clamp(avail_slots_w * 0.40f, 110.0f, 150.0f);
                ImGui::SetCursorScreenPos(ImVec2(slots_start_x, pos.y + 6.0f));
                char sbtn_lbl[64];
                snprintf(sbtn_lbl, sizeof(sbtn_lbl), "%s v##s_single_%s", KuroAudio::DJBeatFXUnit::getFXName(fx_unit.type), unit_name);
                if (ImGui::Button(sbtn_lbl, ImVec2(s_w, 20.0f))) {
                    char popup_id[64]; snprintf(popup_id, sizeof(popup_id), "##FXPopSingle_%s", unit_name);
                    ImGui::OpenPopup(popup_id);
                }
                char popup_id[64]; snprintf(popup_id, sizeof(popup_id), "##FXPopSingle_%s", unit_name);
                renderRekordboxFXPopup(popup_id, &fx_unit.type);

                // Knobs DEPTH & TIME
                float k_start_x = slots_start_x + s_w + 10.0f;
                dl->AddText(ImVec2(k_start_x, pos.y + 10.0f), IM_COL32(140, 160, 185, 220), "DEPTH");
                ImGui::SetCursorScreenPos(ImVec2(k_start_x + 44.0f, pos.y + 7.0f));
                char kdid[32]; snprintf(kdid, sizeof(kdid), "##k_depth_%s", unit_name);
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(kdid, &fx_unit.dry_wet, 0.0f, 1.0f, 8.0f,
                                                                    ImVec4(0.0f, 0.75f, 1.0f, 1.0f), "%.0f%%", 0.0f, false, false, false, false, false)) {
                    fx_unit.enabled = (fx_unit.dry_wet > 0.005f);
                }

                float k_time_x = k_start_x + 95.0f;
                dl->AddText(ImVec2(k_time_x, pos.y + 10.0f), IM_COL32(140, 160, 185, 220), "TIME");
                ImGui::SetCursorScreenPos(ImVec2(k_time_x + 40.0f, pos.y + 7.0f));
                static float dummy_time = 0.5f;
                char ktid[32]; snprintf(ktid, sizeof(ktid), "##k_time_%s", unit_name);
                KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(ktid, &dummy_time, 0.0f, 1.0f, 8.0f,
                                                                    ImVec4(0.0f, 0.75f, 1.0f, 1.0f), "%.2f", 0.5f, false, false, false, false, false);
            }

            // 5. Botoeira AUTO e TAP (Empilhados na extremidade direita)
            // Botão [ AUTO ] (Pioneer Neon Blue se ativo)
            {
                ImVec2 b_pos = ImVec2(at_x, pos.y + 8.0f);
                ImU32 bg_c = fx_unit.auto_bpm ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = fx_unit.auto_bpm ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                ImU32 txt_c = fx_unit.auto_bpm ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 175, 195, 220);

                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), brd_c, 2.0f);

                ImVec2 t_sz = ImGui::CalcTextSize("AUTO");
                dl->AddText(ImVec2(b_pos.x + (auto_tap_w - t_sz.x) * 0.5f, b_pos.y + (btn_h - t_sz.y) * 0.5f), txt_c, "AUTO");

                ImGui::SetCursorScreenPos(b_pos);
                char abid[32]; snprintf(abid, sizeof(abid), "##AutoBtn_%s", unit_name);
                if (ImGui::InvisibleButton(abid, ImVec2(auto_tap_w, btn_h))) {
                    fx_unit.auto_bpm = !fx_unit.auto_bpm;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Sincronização Automática ao BPM do Deck");
            }

            // Botão [ TAP ]
            {
                ImVec2 b_pos = ImVec2(at_x, pos.y + 8.0f + btn_h + gap_y);
                ImU32 bg_c = IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = IM_COL32(40, 48, 62, 220);
                ImU32 txt_c = IM_COL32(165, 178, 195, 240);

                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), brd_c, 2.0f);

                ImVec2 t_sz = ImGui::CalcTextSize("TAP");
                dl->AddText(ImVec2(b_pos.x + (auto_tap_w - t_sz.x) * 0.5f, b_pos.y + (btn_h - t_sz.y) * 0.5f), txt_c, "TAP");

                ImGui::SetCursorScreenPos(b_pos);
                char tbid[32]; snprintf(tbid, sizeof(tbid), "##TapBtn_%s", unit_name);
                if (ImGui::InvisibleButton(tbid, ImVec2(auto_tap_w, btn_h))) {
                    fx_unit.auto_bpm = false;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Tap Tempo: Ajuste manual de tempo no ritmo da música");
            }
        }

        void renderRekordboxFXBar(KuroAudio::DJEngine& engine, float w) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();
            float h = KuroUI::UIScaleManager::Scale(56.0f);

            // Fundo escuro do rack de performance #0b0d12 com linhas de chassi
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(11, 13, 18, 255));
            dl->AddLine(ImVec2(pos.x, pos.y), ImVec2(pos.x + w, pos.y), IM_COL32(26, 32, 44, 255), 1.0f);
            dl->AddLine(ImVec2(pos.x, pos.y + h - 1.0f), ImVec2(pos.x + w, pos.y + h - 1.0f), IM_COL32(22, 27, 36, 255), 1.0f);

            // Seção Central CFX (Largura compacta e harmoniosa para liberar espaço aos Beat FX)
            float center_w = std::clamp(w * 0.20f, 220.0f, 260.0f);
            float wing_w = (w - center_w) * 0.5f;

            // Linhas verticais divisorias sutis entre as 3 ilhas funcionais
            dl->AddLine(ImVec2(pos.x + wing_w, pos.y + 4.0f), ImVec2(pos.x + wing_w, pos.y + h - 4.0f), IM_COL32(32, 40, 54, 180), 1.0f);
            dl->AddLine(ImVec2(pos.x + wing_w + center_w, pos.y + 4.0f), ImVec2(pos.x + wing_w + center_w, pos.y + h - 4.0f), IM_COL32(32, 40, 54, 180), 1.0f);

            // ═════════════════════════════════════════════════════════════════════
            // 1. ALA ESQUERDA: FX 1 UNIT (Pioneer Rekordbox Oficial)
            // ═════════════════════════════════════════════════════════════════════
            renderRekordboxFXUnit(engine, engine.beat_fx, "FX1", pos, wing_w, h, ImVec4(0.0f, 0.90f, 1.0f, 1.0f));

            // ═════════════════════════════════════════════════════════════════════
            // 2. ALA CENTRAL: SOUND COLOR FX CONSOLE (CFX HUB COM PULSACAO GLOW)
            // ═════════════════════════════════════════════════════════════════════
            {
                float cfx_x = pos.x + wing_w;
                float cfx_center_cx = cfx_x + center_w * 0.5f;

                // Titulo do Console
                ImVec2 t_sz = ImGui::CalcTextSize("SOUND COLOR FX (CFX)");
                dl->AddText(ImVec2(cfx_center_cx - t_sz.x * 0.5f, pos.y + 2.0f), IM_COL32(135, 155, 180, 220), "SOUND COLOR FX (CFX)");

                // Calculo de pulsacao luminosa dinamica no ritmo do Master BPM
                double cur_bpm = (engine.decks[0].is_playing.load()) ? (engine.decks[0].bpm * (1.0 + engine.decks[0].pitch_percent * 0.01)) : 128.0;
                if (cur_bpm <= 0.0) cur_bpm = 128.0;
                float bpm_hz = (float)(cur_bpm / 60.0);
                float pulse = (std::sin((float)ImGui::GetTime() * bpm_hz * 2.0f * (float)M_PI) + 1.0f) * 0.5f;

                // Botoeira com as 4 cores de assinatura: FILTER, CRUSH, NOISE, SPACE
                float btn_w = 46.0f;
                float btn_h = 15.0f;
                float btn_gap = 2.0f;
                float total_btns_w = btn_w * 4.0f + btn_gap * 3.0f;
                float btn_start_x = cfx_center_cx - total_btns_w * 0.5f;
                float btn_y = pos.y + 14.0f;

                struct CfxDef {
                    int mode_idx;
                    const char* name;
                    ImU32 sig_col;
                    ImVec4 text_col;
                };

                const CfxDef cfx_defs[4] = {
                    { 0, "FILTER", IM_COL32(0, 229, 255, 255),   ImVec4(0.0f, 0.90f, 1.0f, 1.0f) }, // Ciano Eletrico
                    { 2, "CRUSH",  IM_COL32(255, 107, 0, 255),   ImVec4(1.0f, 0.50f, 0.10f, 1.0f) }, // Laranja Fogo
                    { 1, "NOISE",  IM_COL32(56, 189, 248, 255),  ImVec4(0.60f, 0.85f, 1.0f, 1.0f) }, // Azul Gelo / Prata
                    { 3, "SPACE",  IM_COL32(168, 85, 247, 255),  ImVec4(0.80f, 0.50f, 1.0f, 1.0f) }  // Roxo Ultravioleta
                };

                for (int i = 0; i < 4; i++) {
                    const auto& def = cfx_defs[i];
                    bool is_active = (rekordbox_cfx_type == def.mode_idx);
                    ImVec2 b_pos = ImVec2(btn_start_x + i * (btn_w + btn_gap), btn_y);

                    if (is_active) {
                        float glow_expand = 1.5f + pulse * 2.0f;
                        int glow_alpha = (int)(45 + 75 * pulse);
                        ImU32 glow_halo = (def.sig_col & 0x00FFFFFF) | (((int)(20 + 30 * pulse) & 0xFF) << 24);
                        ImU32 glow_ring = (def.sig_col & 0x00FFFFFF) | ((glow_alpha & 0xFF) << 24);

                        dl->AddRectFilled(ImVec2(b_pos.x - glow_expand, b_pos.y - glow_expand),
                                          ImVec2(b_pos.x + btn_w + glow_expand, b_pos.y + btn_h + glow_expand),
                                          glow_halo, 4.0f);
                        dl->AddRect(ImVec2(b_pos.x - 1.0f, b_pos.y - 1.0f),
                                    ImVec2(b_pos.x + btn_w + 1.0f, b_pos.y + btn_h + 1.0f),
                                    glow_ring, 3.0f, 0, 1.2f);
                    }

                    ImU32 bg_c = is_active ? IM_COL32(18, 24, 34, 255) : IM_COL32(14, 17, 24, 220);
                    dl->AddRectFilled(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), bg_c, 2.0f);
                    dl->AddRect(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), 
                                is_active ? def.sig_col : (def.sig_col & 0x00FFFFFF | 0x65000000), 2.0f, 0, is_active ? 1.5f : 1.0f);

                    ImVec2 str_sz = ImGui::CalcTextSize(def.name);
                    dl->AddText(ImVec2(b_pos.x + (btn_w - str_sz.x) * 0.5f, b_pos.y + (btn_h - str_sz.y) * 0.5f),
                                is_active ? IM_COL32(255, 255, 255, 255) : ImGui::GetColorU32(def.text_col), def.name);

                    ImGui::SetCursorScreenPos(b_pos);
                    char bid[32]; snprintf(bid, sizeof(bid), "##CfxBtn_%d", def.mode_idx);
                    if (ImGui::InvisibleButton(bid, ImVec2(btn_w, btn_h))) {
                        rekordbox_cfx_type = def.mode_idx;
                        engine.decks[0].sound_color_fx_mode = def.mode_idx;
                        engine.decks[1].sound_color_fx_mode = def.mode_idx;
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Sound Color FX: Ativar %s no mixer", def.name);
                }

                // 3 Knobs Centrais: CH 1 COLOR | CFX PARAM | CH 2 COLOR
                float knob_r = 6.5f;
                float knob_y = pos.y + 31.0f;
                float item_col_w = 68.0f;
                float cfx_items_start_x = cfx_center_cx - (item_col_w * 3.0f) * 0.5f;

                // Knob 1: CH 1 COLOR (Ciano Bipolar)
                float it1_x = cfx_items_start_x;
                dl->AddText(ImVec2(it1_x + 2.0f, knob_y + 2.0f), IM_COL32(0, 215, 245, 240), "CH 1");
                ImGui::SetCursorScreenPos(ImVec2(it1_x + 34.0f, knob_y));
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob("##Ch1ColorKnob", &engine.decks[0].filter_bipolar, 
                                                                    0.0f, 1.0f, knob_r, ImVec4(0.0f, 0.85f, 1.0f, 1.0f), 
                                                                    "%.2f", 0.5f, true, false, false, false, false)) {
                    engine.decks[0].updateSoundColorFX();
                }

                // Knob 2: CFX PARAM (Branco Frio - Ressonância / Profundidade Pioneer)
                float it2_x = it1_x + item_col_w;
                dl->AddText(ImVec2(it2_x + 2.0f, knob_y + 2.0f), IM_COL32(230, 240, 255, 240), "PARAM");
                ImGui::SetCursorScreenPos(ImVec2(it2_x + 40.0f, knob_y));
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob("##CfxParamKnob", &rekordbox_cfx_param, 
                                                                    0.0f, 1.0f, knob_r, ImVec4(0.95f, 0.95f, 1.0f, 1.0f), 
                                                                    "%.2f", 0.5f, false, false, false, false, false)) {
                    engine.decks[0].sound_color_param = rekordbox_cfx_param;
                    engine.decks[1].sound_color_param = rekordbox_cfx_param;
                    engine.decks[0].updateSoundColorFX();
                    engine.decks[1].updateSoundColorFX();
                }

                // Knob 3: CH 2 COLOR (Ambar Bipolar)
                float it3_x = it2_x + item_col_w;
                dl->AddText(ImVec2(it3_x + 2.0f, knob_y + 2.0f), IM_COL32(255, 160, 20, 240), "CH 2");
                ImGui::SetCursorScreenPos(ImVec2(it3_x + 34.0f, knob_y));
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob("##Ch2ColorKnob", &engine.decks[1].filter_bipolar, 
                                                                    0.0f, 1.0f, knob_r, ImVec4(1.0f, 0.65f, 0.0f, 1.0f), 
                                                                    "%.2f", 0.5f, true, false, false, false, false)) {
                    engine.decks[1].updateSoundColorFX();
                }
            }

            // ═════════════════════════════════════════════════════════════════════
            // 3. ALA DIREITA: FX 2 UNIT (Pioneer Rekordbox Oficial)
            // ═════════════════════════════════════════════════════════════════════
            float fx2_start_x = pos.x + wing_w + center_w;
            renderRekordboxFXUnit(engine, engine.beat_fx2, "FX2", ImVec2(fx2_start_x, pos.y), wing_w, h, ImVec4(1.0f, 0.65f, 0.0f, 1.0f));

            ImGui::SetCursorScreenPos(ImVec2(pos.x, pos.y + h));
            ImGui::Dummy(ImVec2(w, 2.0f));
        }

        void renderRekordboxJogwheel(KuroAudio::DJDeck& deck, ImVec2 top_left, float size, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            float radius = size * 0.5f;
            ImVec2 center = ImVec2(top_left.x + radius, top_left.y + radius);

            // 1. Chassi externo / aro metalico escovado estilo Pioneer CDJ-3000 / DDJ
            dl->AddCircleFilled(center, radius, IM_COL32(14, 17, 24, 255), 64);
            dl->AddCircle(center, radius, IM_COL32(36, 44, 58, 255), 64, 1.5f);
            dl->AddCircle(center, radius - 2.0f, IM_COL32(22, 28, 38, 255), 64, 1.0f);

            // Chanfros / ranhuras radiais do rim tátil externo (grip de pitch bend)
            int num_ticks = 48;
            for (int t = 0; t < num_ticks; t++) {
                float ang = (float)t / (float)num_ticks * 2.0f * (float)M_PI;
                ImVec2 p_in = ImVec2(center.x + std::cos(ang) * (radius - 5.0f), center.y + std::sin(ang) * (radius - 5.0f));
                ImVec2 p_out = ImVec2(center.x + std::cos(ang) * (radius - 2.0f), center.y + std::sin(ang) * (radius - 2.0f));
                dl->AddLine(p_in, p_out, IM_COL32(50, 62, 80, 180), 1.0f);
            }

            // 2. Disco de Vinil / Acrilico Central (com textura de aneis concentricos)
            float r_platter = radius - 8.0f;
            dl->AddCircleFilled(center, r_platter, IM_COL32(10, 12, 16, 255), 64);
            dl->AddCircle(center, r_platter * 0.90f, IM_COL32(25, 30, 40, 140), 64, 1.0f);
            dl->AddCircle(center, r_platter * 0.78f, IM_COL32(20, 26, 36, 120), 64, 1.0f);
            dl->AddCircle(center, r_platter * 0.65f, IM_COL32(25, 32, 44, 140), 64, 1.0f);

            // 3. DISPLAY LCD CENTRAL ON-JOG (Autêntico Rekordbox CDJ-3000 / DDJ-1000 - Proporção Ampla)
            float hub_r = r_platter * 0.65f;

            // Moldura chanfrada de alumínio grafite escuro e bezel metálico
            dl->AddCircleFilled(center, hub_r + 3.5f, IM_COL32(26, 32, 44, 255), 64);
            dl->AddCircle(center, hub_r + 3.5f, IM_COL32(65, 80, 105, 255), 64, 1.2f);
            dl->AddCircleFilled(center, hub_r, IM_COL32(4, 5, 8, 255), 64);

            // Anel externo de rotação e posição da agulha (Blue Arc Ring)
            float track_ring_r = hub_r - 4.5f;
            dl->AddCircle(center, track_ring_r, IM_COL32(16, 24, 38, 255), 64, 2.5f);

            // Arco azul de rotação do prato (Playhead Rotation)
            float rot_ang = deck.jog_visual_angle;
            float arc_len = 1.35f * (float)M_PI;
            int arc_segs = 24;
            for (int s = 0; s < arc_segs; s++) {
                float a0 = rot_ang - arc_len + (float)s / (float)arc_segs * arc_len;
                float a1 = rot_ang - arc_len + (float)(s + 1) / (float)arc_segs * arc_len;
                float alpha = (float)(s + 1) / (float)arc_segs;
                ImU32 c_arc = IM_COL32(0, 160, 255, (int)(255.0f * alpha));
                ImVec2 p0 = ImVec2(center.x + std::cos(a0) * track_ring_r, center.y + std::sin(a0) * track_ring_r);
                ImVec2 p1 = ImVec2(center.x + std::cos(a1) * track_ring_r, center.y + std::sin(a1) * track_ring_r);
                dl->AddLine(p0, p1, c_arc, 2.8f);
            }

            // Indicador da agulha do Rekordbox: Marcador Vermelho/Laranja na cabeça do arco
            ImVec2 needle_head = ImVec2(center.x + std::cos(rot_ang) * track_ring_r, center.y + std::sin(rot_ang) * track_ring_r);
            dl->AddCircleFilled(needle_head, 3.5f, IM_COL32(255, 45, 55, 255), 16);
            ImVec2 needle_in = ImVec2(center.x + std::cos(rot_ang) * (track_ring_r - 5.5f), center.y + std::sin(rot_ang) * (track_ring_r - 5.5f));
            dl->AddLine(needle_head, needle_in, IM_COL32(255, 50, 60, 255), 2.0f);

            // 4. TELEMETRIA DIGITAL E CONTROLES INTERATIVOS NO CENTRO DO LCD ON-JOG (Prioridade Total para Clicks)
            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
            ImFont* f_reg = g_font_rekordbox_regular ? g_font_rekordbox_regular : ImGui::GetFont();
            float hub_scale = std::clamp(hub_r / 56.0f, 0.60f, 1.15f);

            // 4.1. Label "BPM" no topo do LCD
            const char* lbl_bpm = "BPM";
            float sz_lbl_font = std::clamp(11.0f * hub_scale, 8.5f, 11.5f);
            ImVec2 sz_lbl = f_bld->CalcTextSizeA(sz_lbl_font, FLT_MAX, 0.0f, lbl_bpm);
            float bpm_lbl_y = center.y - hub_r * 0.66f;
            dl->AddText(f_bld, sz_lbl_font, ImVec2(center.x - sz_lbl.x * 0.5f, bpm_lbl_y), IM_COL32(185, 195, 215, 230), lbl_bpm);

            // 4.2. Dígitos Principais do BPM em destaque e Caixa de Edição Manual de Texto (Rekordbox Style)
            double eff_bpm = (deck.bpm > 20.0) ? (deck.bpm * (1.0 + deck.pitch_percent * 0.01)) : 126.00;
            char bpm_main[16];
            char bpm_dec[8];
            int bpm_int_part = (int)eff_bpm;
            int bpm_frac_part = (int)std::round((eff_bpm - (double)bpm_int_part) * 100.0);
            if (bpm_frac_part >= 100) { bpm_int_part++; bpm_frac_part = 0; }
            snprintf(bpm_main, sizeof(bpm_main), "%d", bpm_int_part);
            snprintf(bpm_dec, sizeof(bpm_dec), ".%02d", bpm_frac_part);

            float sz_main_font = std::clamp(hub_r * 0.38f, 15.0f, 25.0f);
            float sz_dec_font = sz_main_font * 0.72f;
            ImVec2 sz_m = f_bld->CalcTextSizeA(sz_main_font, FLT_MAX, 0.0f, bpm_main);
            ImVec2 sz_d = f_bld->CalcTextSizeA(sz_dec_font, FLT_MAX, 0.0f, bpm_dec);
            float total_bpm_w = sz_m.x + sz_d.x;

            float bpm_val_y = center.y - hub_r * 0.42f;
            float bpm_main_x = center.x - total_bpm_w * 0.5f;
            float bpm_dec_x = bpm_main_x + sz_m.x;
            float bpm_dec_y = bpm_val_y + (sz_m.y - sz_d.y) * 0.5f + 1.0f;

            if (bpm_editing_deck == deck.deck_id && !bpm_edit_from_header) {
                // Caixa de texto editável estilo Rekordbox
                float in_w = std::clamp(hub_r * 1.35f, 72.0f, 96.0f);
                float in_h = std::clamp(sz_main_font + 6.0f, 22.0f, 28.0f);
                ImVec2 in_pos = ImVec2(center.x - in_w * 0.5f, bpm_val_y - 3.0f);
                ImGui::SetCursorScreenPos(in_pos);

                ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0.06f, 0.08f, 0.12f, 0.98f));
                ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.0f, 0.65f, 1.0f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 3.0f);
                ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(4.0f, 2.0f));
                ImGui::PushItemWidth(in_w);

                if (bpm_edit_focus_needed) {
                    ImGui::SetKeyboardFocusHere();
                    bpm_edit_focus_needed = false;
                }

                char inp_id[32]; snprintf(inp_id, sizeof(inp_id), "##BpmJogInput_%d", deck.deck_id);
                bool enter = ImGui::InputText(inp_id, bpm_edit_buf, sizeof(bpm_edit_buf), 
                    ImGuiInputTextFlags_EnterReturnsTrue | ImGuiInputTextFlags_AutoSelectAll);

                if (enter || (!ImGui::IsItemActive() && ImGui::IsMouseClicked(0))) {
                    float val = (float)atof(bpm_edit_buf);
                    if (val >= 20.0f && val <= 300.0f) {
                        applyManualBpm(deck, val, ImGui::GetIO().KeyShift);
                    }
                    bpm_editing_deck = -1;
                }
                if (ImGui::IsKeyPressed(ImGuiKey_Escape)) {
                    bpm_editing_deck = -1;
                }

                ImGui::PopItemWidth();
                ImGui::PopStyleVar(2);
                ImGui::PopStyleColor(3);
            } else {
                // Renderiza Dígitos do BPM com texto
                dl->AddText(f_bld, sz_main_font, ImVec2(bpm_main_x, bpm_val_y), IM_COL32(255, 255, 255, 255), bpm_main);
                dl->AddText(f_bld, sz_dec_font, ImVec2(bpm_dec_x, bpm_dec_y), IM_COL32(240, 245, 255, 255), bpm_dec);

                // Botão Interativo sobre o BPM para abrir a caixa de texto
                char bbpm_id[32]; snprintf(bbpm_id, sizeof(bbpm_id), "##JogBpmClick_%d", deck.deck_id);
                ImGui::SetCursorScreenPos(ImVec2(bpm_main_x - 4.0f, bpm_val_y - 2.0f));
                if (ImGui::InvisibleButton(bbpm_id, ImVec2(total_bpm_w + 8.0f, sz_main_font + 4.0f))) {
                    bpm_editing_deck = deck.deck_id;
                    bpm_edit_from_header = false;
                    snprintf(bpm_edit_buf, sizeof(bpm_edit_buf), "%.2f", eff_bpm);
                    bpm_edit_focus_needed = true;
                }
                if (ImGui::IsItemHovered()) {
                    dl->AddRect(ImVec2(bpm_main_x - 3.0f, bpm_val_y - 1.0f), ImVec2(bpm_dec_x + sz_d.x + 3.0f, bpm_val_y + sz_main_font + 1.0f), IM_COL32(0, 160, 255, 180), 2.0f);
                    if (ImGui::IsMouseDoubleClicked(0)) {
                        deck.pitch_percent = 0.0f;
                        deck.sync_active = false;
                    }
                    ImGui::SetTooltip("BPM: %.2f (Clique para digitar / 2-clique reseta pitch)", eff_bpm);
                }

                // Menu de Contexto ao Clicar com Botão Direito no BPM
                char bpm_ctx_id[32]; snprintf(bpm_ctx_id, sizeof(bpm_ctx_id), "##BpmJogCtx_%d", deck.deck_id);
                if (ImGui::BeginPopupContextItem(bbpm_id, ImGuiPopupFlags_MouseButtonRight)) {
                    ImGui::TextColored(ImVec4(0, 0.8f, 1, 1), "Ajustes Rápidos de BPM (Deck %d)", deck.deck_id + 1);
                    ImGui::Separator();
                    if (ImGui::MenuItem("Editar BPM Manualmente...")) {
                        bpm_editing_deck = deck.deck_id;
                        bpm_edit_from_header = false;
                        snprintf(bpm_edit_buf, sizeof(bpm_edit_buf), "%.2f", eff_bpm);
                        bpm_edit_focus_needed = true;
                    }
                    if (ImGui::MenuItem("Dobrar BPM (x2)")) {
                        deck.bpm = std::clamp(deck.bpm * 2.0, 40.0, 300.0);
                        deck.sync_active = false;
                    }
                    if (ImGui::MenuItem("Dividir BPM (/2)")) {
                        deck.bpm = std::clamp(deck.bpm * 0.5, 40.0, 300.0);
                        deck.sync_active = false;
                    }
                    if (ImGui::MenuItem("Resetar Pitch para 0.00%")) {
                        deck.pitch_percent = 0.0f;
                        deck.sync_active = false;
                    }
                    ImGui::EndPopup();
                }
            }

            // 4.3. Linha de Pitch % e Range (ex: "0.0% ±16%")
            char pitch_val_str[32];
            if (std::abs(deck.pitch_percent) < 0.04f) {
                snprintf(pitch_val_str, sizeof(pitch_val_str), "0.0%%");
            } else {
                snprintf(pitch_val_str, sizeof(pitch_val_str), "%+.1f%%", deck.pitch_percent);
            }
            for (char* p = pitch_val_str; *p; ++p) { if (*p == ',') *p = '.'; }
            
            const char* range_str = (deck.pitch_range >= 90.0f) ? "WIDE" : (deck.pitch_range >= 15.0f ? "±16%" : (deck.pitch_range >= 9.0f ? "±10%" : "±6%"));
            float sz_l3_font = std::clamp(12.0f * hub_scale, 9.0f, 12.0f);
            ImVec2 sz_pv = f_bld->CalcTextSizeA(sz_l3_font, FLT_MAX, 0.0f, pitch_val_str);
            ImVec2 sz_rg = f_bld->CalcTextSizeA(sz_l3_font, FLT_MAX, 0.0f, range_str);
            float line3_gap = std::max(3.0f, 5.0f * hub_scale);
            float line3_total_w = sz_pv.x + line3_gap + sz_rg.x;
            float line3_y = center.y + hub_r * 0.04f;
            float line3_x = center.x - line3_total_w * 0.5f;

            dl->AddText(f_bld, sz_l3_font, ImVec2(line3_x, line3_y), (std::abs(deck.pitch_percent) < 0.02f) ? IM_COL32(0, 240, 120, 255) : IM_COL32(245, 245, 252, 255), pitch_val_str);
            dl->AddText(f_bld, sz_l3_font, ImVec2(line3_x + sz_pv.x + line3_gap, line3_y), (deck.pitch_range >= 15.0f) ? IM_COL32(255, 42, 52, 255) : IM_COL32(230, 235, 245, 240), range_str);

            // Botão invisível interativo na linha de Range para alternar faixa de pitch
            char brg_id[32]; snprintf(brg_id, sizeof(brg_id), "##JogRange_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(ImVec2(line3_x - 6.0f, line3_y - 2.0f));
            if (ImGui::InvisibleButton(brg_id, ImVec2(line3_total_w + 12.0f, sz_l3_font + 4.0f))) {
                if (deck.pitch_range < 8.0f) deck.pitch_range = 10.0f;
                else if (deck.pitch_range < 12.0f) deck.pitch_range = 16.0f;
                else if (deck.pitch_range < 20.0f) deck.pitch_range = 100.0f;
                else deck.pitch_range = 6.0f;
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Pitch Range: Clique para alternar (±6%%, ±10%%, ±16%%, WIDE)");

            // 4.4. Botões Interativos [-] e [+] Responsivos e Nítidos (Submetidos ANTES do platter)
            float btn_w = std::clamp(hub_r * 0.46f, 20.0f, 28.0f);
            float btn_h = std::clamp(hub_r * 0.34f, 16.0f, 22.0f);
            float btn_gap = std::clamp(hub_r * 0.10f, 4.0f, 8.0f);
            float btn_y = center.y + hub_r * 0.38f;
            ImVec2 b_minus_min = ImVec2(center.x - btn_w - btn_gap * 0.5f, btn_y);
            ImVec2 b_minus_max = ImVec2(b_minus_min.x + btn_w, b_minus_min.y + btn_h);
            ImVec2 b_plus_min  = ImVec2(center.x + btn_gap * 0.5f, btn_y);
            ImVec2 b_plus_max  = ImVec2(b_plus_min.x + btn_w, b_plus_min.y + btn_h);

            // Submete Botão [-]
            char bm_id[32]; snprintf(bm_id, sizeof(bm_id), "##JogMinus_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(b_minus_min);
            ImGui::InvisibleButton(bm_id, ImVec2(btn_w, btn_h));
            bool hover_minus  = ImGui::IsItemHovered();
            bool active_minus = ImGui::IsItemActive();
            if (ImGui::IsItemClicked(0)) {
                if (deck.bpm > 20.0) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent - 0.1f, -deck.pitch_range, deck.pitch_range);
                } else {
                    deck.bpm = std::clamp(deck.bpm - 0.5, 40.0, 250.0);
                }
                deck.sync_active = false;
            }
            if (active_minus && ImGui::GetIO().MouseDownDuration[0] > 0.18f) {
                if (deck.bpm > 20.0) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent - 0.02f, -deck.pitch_range, deck.pitch_range);
                } else {
                    deck.bpm = std::clamp(deck.bpm - 0.1, 40.0, 250.0);
                }
                deck.sync_active = false;
            }
            if (hover_minus) {
                float mw = ImGui::GetIO().MouseWheel;
                if (mw != 0.0f) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent + mw * 0.04f, -deck.pitch_range, deck.pitch_range);
                    deck.sync_active = false;
                }
                ImGui::SetTooltip("Diminuir Pitch / BPM (-0.1%% / Segure para deslizar contínuo)");
            }

            // Submete Botão [+]
            char bp_id[32]; snprintf(bp_id, sizeof(bp_id), "##JogPlus_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(b_plus_min);
            ImGui::InvisibleButton(bp_id, ImVec2(btn_w, btn_h));
            bool hover_plus  = ImGui::IsItemHovered();
            bool active_plus = ImGui::IsItemActive();
            if (ImGui::IsItemClicked(0)) {
                if (deck.bpm > 20.0) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent + 0.1f, -deck.pitch_range, deck.pitch_range);
                } else {
                    deck.bpm = std::clamp(deck.bpm + 0.5, 40.0, 250.0);
                }
                deck.sync_active = false;
            }
            if (active_plus && ImGui::GetIO().MouseDownDuration[0] > 0.18f) {
                if (deck.bpm > 20.0) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent + 0.02f, -deck.pitch_range, deck.pitch_range);
                } else {
                    deck.bpm = std::clamp(deck.bpm + 0.1, 40.0, 250.0);
                }
                deck.sync_active = false;
            }
            if (hover_plus) {
                float mw = ImGui::GetIO().MouseWheel;
                if (mw != 0.0f) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent + mw * 0.04f, -deck.pitch_range, deck.pitch_range);
                    deck.sync_active = false;
                }
                ImGui::SetTooltip("Aumentar Pitch / BPM (+0.1%% / Segure para deslizar contínuo)");
            }

            // Renderização Visual do Botão [-] (Idêntico ao Rekordbox - Cantos arredondados, fundo cinza escuro, glow no hover)
