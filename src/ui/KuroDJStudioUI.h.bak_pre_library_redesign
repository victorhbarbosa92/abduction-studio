        }

        void renderRekordboxAuxiliaryControlBlock(KuroAudio::DJDeck& deck, ImVec2 pos, float w, float h, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();

            // Helper de botão tátil Pioneer Rekordbox com micro-chanfro e LED de status
            auto drawTactileBtn = [&](const char* id, const char* label, ImVec2 b_pos, ImVec2 b_size, 
                                      bool is_active, ImU32 active_border, ImU32 active_bg, ImU32 active_txt, 
                                      std::function<void()> on_click, const char* tooltip = nullptr, 
                                      bool has_led = false, ImU32 led_col = 0) {
                ImVec2 b_max = ImVec2(b_pos.x + b_size.x, b_pos.y + b_size.y);
                ImGui::SetCursorScreenPos(b_pos);
                if (ImGui::InvisibleButton(id, b_size)) {
                    if (on_click) on_click();
                }
                bool is_held = ImGui::IsItemActive();
                bool is_hov = ImGui::IsItemHovered();

                ImU32 bg = is_active ? active_bg : (is_hov ? IM_COL32(32, 40, 52, 255) : IM_COL32(18, 22, 30, 255));
                if (is_held) bg = IM_COL32(45, 56, 75, 255);

                ImU32 border = is_active ? active_border : (is_hov ? IM_COL32(65, 85, 115, 240) : IM_COL32(36, 46, 62, 220));

                dl->AddRectFilled(b_pos, b_max, bg, 2.5f);
                dl->AddRect(b_pos, b_max, border, 2.5f, 0, 1.0f);

                // Linha de chanfro superior tátil (3D bevel)
                dl->AddLine(ImVec2(b_pos.x + 1.5f, b_pos.y + 1.0f), ImVec2(b_max.x - 1.5f, b_pos.y + 1.0f), 
                            is_active ? IM_COL32(255, 255, 255, 50) : IM_COL32(255, 255, 255, 20), 1.0f);

                // Texto centralizado
                ImU32 txt_col = is_active ? active_txt : (is_hov ? IM_COL32(245, 250, 255, 255) : IM_COL32(175, 190, 210, 240));
                ImVec2 t_sz = ImGui::CalcTextSize(label);
                dl->AddText(ImVec2(b_pos.x + (b_size.x - t_sz.x) * 0.5f, b_pos.y + (b_size.y - t_sz.y) * 0.5f), txt_col, label);

                // Indicador LED de status (Pioneer status pip)
                if (has_led) {
                    float led_r = 1.8f;
                    ImVec2 led_center = ImVec2(b_max.x - 4.5f, b_pos.y + 4.5f);
                    if (is_active) {
                        dl->AddCircleFilled(led_center, led_r + 1.2f, (led_col & 0x00FFFFFF) | 0x55000000);
                        dl->AddCircleFilled(led_center, led_r, led_col);
                    } else {
                        dl->AddCircleFilled(led_center, led_r, IM_COL32(12, 16, 22, 255));
                        dl->AddCircle(led_center, led_r, IM_COL32(40, 50, 68, 200), 0, 0.8f);
                    }
                }

                if (tooltip && is_hov) {
                    ImGui::SetTooltip("%s", tooltip);
                }
            };

            float cur_y = pos.y;
            float row_w = w;
            float half_w = (w - 2.0f) * 0.5f;

            // 1. TIER 1: DISPLAY OLED DE BEAT LOOP (Interativo, com glow âmbar de loop ativo)
            float disp_h = 22.0f;
            ImVec2 disp_min = ImVec2(pos.x, cur_y);
            ImVec2 disp_max = ImVec2(pos.x + row_w, cur_y + disp_h);

            ImGui::SetCursorScreenPos(disp_min);
            char disp_id[32]; snprintf(disp_id, sizeof(disp_id), "##LpDisp_%d", deck.deck_id);
            if (ImGui::InvisibleButton(disp_id, ImVec2(row_w, disp_h))) {
                deck.toggleLoop(deck.loop_beats > 0.0 ? deck.loop_beats : 4.0);
            }
            if (ImGui::IsItemHovered()) {
                ImGui::SetTooltip("Display de Loop (%.0f Beats)\n• Clique para alternar Loop Ativo\n• Âmbar = Loop Ativo", deck.loop_beats);
            }

            dl->AddRectFilled(disp_min, disp_max, deck.loop_active ? IM_COL32(35, 22, 4, 255) : IM_COL32(8, 10, 14, 255), 2.5f);
            dl->AddRect(disp_min, disp_max, deck.loop_active ? IM_COL32(255, 170, 0, 255) : IM_COL32(36, 46, 62, 220), 2.5f, 0, 1.2f);

            char loop_txt[16];
            if (deck.loop_beats >= 1.0) snprintf(loop_txt, sizeof(loop_txt), "%.0f", deck.loop_beats);
            else snprintf(loop_txt, sizeof(loop_txt), "1/%.0f", 1.0 / std::max(0.001, deck.loop_beats));
            ImVec2 sz_lp = ImGui::CalcTextSize(loop_txt);
            dl->AddText(ImVec2(pos.x + (row_w - sz_lp.x) * 0.5f, cur_y + 3.0f), deck.loop_active ? IM_COL32(255, 200, 40, 255) : IM_COL32(245, 250, 255, 255), loop_txt);

            cur_y += disp_h + 3.0f;

            // 2. TIER 2: BOTOES DE DIVISAO / MULTIPLICACAO DE LOOP (< 1/2X | 2X >)
            float step_h = 18.0f;
            char id_dec[32]; snprintf(id_dec, sizeof(id_dec), "##LpHalv_%d", deck.deck_id);
            drawTactileBtn(id_dec, "<", ImVec2(pos.x, cur_y), ImVec2(half_w, step_h),
                           false, 0, 0, 0, [&]() { deck.loopHalve(); }, "Reduzir Loop pela metade (1/2X)");

            char id_inc[32]; snprintf(id_inc, sizeof(id_inc), "##LpDoub_%d", deck.deck_id);
            drawTactileBtn(id_inc, ">", ImVec2(pos.x + half_w + 2.0f, cur_y), ImVec2(half_w, step_h),
                           false, 0, 0, 0, [&]() { deck.loopDouble(); }, "Dobrar tamanho do Loop (2X)");

            cur_y += step_h + 3.0f;

            // 3. TIER 3: LOOP IN / LOOP OUT (PIONEER CDJ-3000 / REKORDBOX 1:1)
            char id_in[32]; snprintf(id_in, sizeof(id_in), "##LpIn_%d", deck.deck_id);
            drawTactileBtn(id_in, "IN", ImVec2(pos.x, cur_y), ImVec2(half_w, step_h),
                           deck.loop_active, IM_COL32(255, 170, 0, 255), IM_COL32(45, 28, 6, 255), IM_COL32(255, 205, 45, 255),
                           [&]() { deck.toggleLoop(deck.loop_beats > 0.0 ? deck.loop_beats : 4.0); deck.setLoopIn(); },
                           "Loop IN / 4-Beat Auto Loop (Entrada do Loop)", true, IM_COL32(255, 170, 0, 255));

            char id_out[32]; snprintf(id_out, sizeof(id_out), "##LpOut_%d", deck.deck_id);
            drawTactileBtn(id_out, "OUT", ImVec2(pos.x + half_w + 2.0f, cur_y), ImVec2(half_w, step_h),
                           deck.loop_active, IM_COL32(255, 170, 0, 255), IM_COL32(45, 28, 6, 255), IM_COL32(255, 205, 45, 255),
                           [&]() { if (deck.loop_active) { deck.loop_active = false; } else { deck.setLoopOut(); } },
                           "Loop OUT / Exit (Saída do Loop)", true, IM_COL32(255, 170, 0, 255));

            cur_y += step_h + 3.0f;

            // 4. TIER 4: SLIP MODE & QUANTIZE (Q) COM LEDS DE STATUS DEDICADOS
            char id_slip[32]; snprintf(id_slip, sizeof(id_slip), "##LpSlip_%d", deck.deck_id);
            const char* slip_lbl = deck.is_slipping ? "⚡SLIP" : "SLIP";
            ImU32 slip_bg = deck.is_slipping ? IM_COL32(70, 35, 4, 255) : IM_COL32(42, 24, 6, 255);
            drawTactileBtn(id_slip, slip_lbl, ImVec2(pos.x, cur_y), ImVec2(half_w, step_h),
                           deck.slip_mode, IM_COL32(255, 150, 0, 255), slip_bg, IM_COL32(255, 185, 30, 255),
                           [&]() { deck.slip_mode = !deck.slip_mode; },
                           "SLIP MODE (Pioneer CDJ-3000):\nMantém a música correndo no fundo durante Scratch, Loops ou Hot Cues.",
                           true, IM_COL32(255, 160, 0, 255));

            char id_q[32]; snprintf(id_q, sizeof(id_q), "##LpQuant_%d", deck.deck_id);
            drawTactileBtn(id_q, "Q", ImVec2(pos.x + half_w + 2.0f, cur_y), ImVec2(half_w, step_h),
                           deck.quantize_active, IM_COL32(0, 230, 118, 255), IM_COL32(8, 42, 22, 255), IM_COL32(0, 255, 130, 255),
                           [&]() { deck.quantize_active = !deck.quantize_active; },
                           "QUANTIZE (Q):\nSincroniza automaticamente Loops, Cues e Hot Cues na batida da Grid.",
                           true, IM_COL32(0, 230, 118, 255));

            cur_y += step_h + 3.0f;

            // 5. TIER 5: MODO DE REPRODUÇÃO (INT ▾ - PIONEER INTERNAL ENGINE)
            float int_h = 16.0f;
            char id_int[32]; snprintf(id_int, sizeof(id_int), "##LpInt_%d", deck.deck_id);
            drawTactileBtn(id_int, "INT v", ImVec2(pos.x, cur_y), ImVec2(row_w, int_h),
                           false, 0, 0, 0, nullptr,
                           "Modo de Reprodução: INTERNAL (INT)\n• Motor digital de alta fidelidade Pioneer Rekordbox");
        }

        void renderRekordboxLoopBox(KuroAudio::DJDeck& deck, ImVec2 pos, float w) {
