                    if (is_sel) {
                        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.25f, 0.75f, 1.0f, 1.0f));
                    }
                    if (ImGui::Selectable(label, is_sel, 0, ImVec2(150.0f, 18.0f))) {
                        *target_type = i;
                        ImGui::CloseCurrentPopup();
                    }
                    if (is_sel) ImGui::PopStyleColor();
                }

                // Divisor sutil entre os blocos da coluna direita
                ImGui::Dummy(ImVec2(0, 3.0f));
                ImGui::Separator();
                ImGui::Dummy(ImVec2(0, 3.0f));

                // Bloco Inferior (9 Efeitos: 26..34)
                for (int i = 26; i < KuroAudio::DJBeatFXUnit::FX_COUNT; i++) {
                    bool is_sel = (*target_type == i);
                    char label[64];
                    snprintf(label, sizeof(label), "%s%s##pop_%s_%d", is_sel ? ICON_FA_CHECK " " : "  ", KuroAudio::DJBeatFXUnit::getFXName(i), popup_id, i);
                    if (is_sel) {
                        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.25f, 0.75f, 1.0f, 1.0f));
                    }
                    if (ImGui::Selectable(label, is_sel, 0, ImVec2(150.0f, 18.0f))) {
                        *target_type = i;
                        ImGui::CloseCurrentPopup();
                    }
                    if (is_sel) ImGui::PopStyleColor();
