            ImGui::PushStyleVar(ImGuiStyleVar_ChildBorderSize, 1.0f);

            if (ImGui::BeginChild("##SamplerRack_Drawer", ImVec2(total_w, KuroUI::UIScaleManager::Scale(78.0f)), true)) {
                ImGui::TextColored(ImVec4(0.85f, 0.40f, 1.0f, 1.0f), ICON_FA_DRUM " SAMPLER ONE-SHOT PERFORMANCE RACK (PIONEER TORAIZ / REKORDBOX)");
                ImGui::SameLine();
                ImGui::TextColored(ImVec4(0.55f, 0.65f, 0.75f, 1.0f), "• Atalhos: Teclas [1] a [8] no Teclado Numérico");
                ImGui::SameLine(total_w - 70);
                if (ImGui::SmallButton("OCULTAR")) show_sampler_rack = false;

                float btn_w = (total_w - 24.0f - 7.0f * 6.0f) / 8.0f;
                for (int s = 0; s < 8; s++) {
                    ImGui::PushID(s);
                    bool is_pl = engine.samplers[s].is_playing;
                    if (is_pl) {
                        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(1.0f, 0.2f, 0.8f, 1.0f));
                        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                    } else {
                        ImVec4 s_cols[8] = {
                            ImVec4(0.12f, 0.20f, 0.35f, 0.85f), ImVec4(0.10f, 0.30f, 0.30f, 0.85f),
                            ImVec4(0.35f, 0.10f, 0.15f, 0.85f), ImVec4(0.35f, 0.20f, 0.05f, 0.85f),
                            ImVec4(0.20f, 0.10f, 0.35f, 0.85f), ImVec4(0.30f, 0.15f, 0.30f, 0.85f),
                            ImVec4(0.35f, 0.15f, 0.05f, 0.85f), ImVec4(0.15f, 0.25f, 0.20f, 0.85f)
                        };
                        ImGui::PushStyleColor(ImGuiCol_Button, s_cols[s % 8]);
                        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.85f, 0.95f, 1.0f, 1.0f));
                    }

                    char pad_str[32];
                    snprintf(pad_str, sizeof(pad_str), "[%d] %s", s + 1, engine.samplers[s].name.c_str());
                    if (ImGui::Button(pad_str, ImVec2(btn_w, 36.0f))) {
                        engine.triggerSampler(s);
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Disparar Sample %s instantaneamente (Slot %d)", engine.samplers[s].name.c_str(), s + 1);

                    ImGui::PopStyleColor(2);
                    if (s < 7) ImGui::SameLine(0, 6.0f);
                    ImGui::PopID();
                }
            }
            ImGui::EndChild();
            ImGui::PopStyleVar(2);
            ImGui::PopStyleColor(2);
        }

