            ImU32 col_bd_minus = active_minus ? IM_COL32(180, 230, 255, 255) : (hover_minus ? IM_COL32(0, 210, 255, 255) : IM_COL32(56, 68, 88, 220));
            dl->AddRectFilled(b_minus_min, b_minus_max, col_bg_minus, 4.0f);
            dl->AddRect(b_minus_min, b_minus_max, col_bd_minus, 4.0f, 0, hover_minus ? 1.5f : 1.0f);
            float my_bar = b_minus_min.y + btn_h * 0.5f;
            float line_pad_x = std::clamp(btn_w * 0.24f, 4.0f, 8.0f);
            dl->AddLine(ImVec2(b_minus_min.x + line_pad_x, my_bar), ImVec2(b_minus_max.x - line_pad_x, my_bar), IM_COL32(255, 255, 255, 255), 2.2f);

            // Renderização Visual do Botão [+] (Idêntico ao Rekordbox)
            ImU32 col_bg_plus = active_plus ? IM_COL32(0, 140, 240, 255) : (hover_plus ? IM_COL32(46, 58, 76, 255) : IM_COL32(26, 32, 42, 255));
            ImU32 col_bd_plus = active_plus ? IM_COL32(180, 230, 255, 255) : (hover_plus ? IM_COL32(0, 210, 255, 255) : IM_COL32(56, 68, 88, 220));
            dl->AddRectFilled(b_plus_min, b_plus_max, col_bg_plus, 4.0f);
            dl->AddRect(b_plus_min, b_plus_max, col_bd_plus, 4.0f, 0, hover_plus ? 1.5f : 1.0f);
            float py_bar = b_plus_min.y + btn_h * 0.5f;
            float px_bar = b_plus_min.x + btn_w * 0.5f;
            float line_pad_y = std::clamp(btn_h * 0.22f, 3.5f, 6.0f);
            dl->AddLine(ImVec2(b_plus_min.x + line_pad_x, py_bar), ImVec2(b_plus_max.x - line_pad_x, py_bar), IM_COL32(255, 255, 255, 255), 2.2f);
            dl->AddLine(ImVec2(px_bar, b_plus_min.y + line_pad_y), ImVec2(px_bar, b_plus_max.y - line_pad_y), IM_COL32(255, 255, 255, 255), 2.2f);

            // 5. INTERAÇÃO DO PLATTER EXTERNO E SCRATCH (Submetido após os botões para garantir prioridade aos botões do LCD)
            char j_id[32];
            snprintf(j_id, sizeof(j_id), "##RekordboxJogPlatter_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(top_left);
            ImGui::InvisibleButton(j_id, ImVec2(size, size));

            // Drag & Drop Target no Jogwheel
            if (ImGui::BeginDragDropTarget()) {
                if (const ImGuiPayload* payload = ImGui::AcceptDragDropPayload("DND_DJ_TRACK_ID")) {
                    const char* dropped_id = (const char*)payload->Data;
                    auto* ptr = KuroAudio::DJLibraryManager::getInstance().getTrackById(dropped_id);
                    if (ptr && current_engine) {
                        if (ptr->is_downloaded) spotify_service.loadLibraryTrack(*ptr, deck.deck_id, *current_engine);
                        else spotify_service.downloadLibraryTrackAsync(*ptr, deck.deck_id, *current_engine);
                    }
                }
                dl->AddCircle(center, radius + 2.0f, ImGui::ColorConvertFloat4ToU32(theme_col), 64, 3.0f);
                ImGui::EndDragDropTarget();
            }

            bool jog_hovered = ImGui::IsItemHovered();
            bool jog_active  = ImGui::IsItemActive();

            if (jog_active) {
                ImVec2 mouse = ImGui::GetMousePos();
                ImVec2 delta = ImGui::GetIO().MouseDelta;
                float dist_sq = (mouse.x - center.x) * (mouse.x - center.x) + (mouse.y - center.y) * (mouse.y - center.y);
                float dist = std::sqrt(dist_sq);

                // Scratch e Nudge só operam ESTRITAMENTE FORA do display LCD central (dist >= hub_r - 2.0f)
                if (dist >= hub_r - 2.0f && dist <= radius + 10.0f) {
                    float ang_delta = (delta.x * (mouse.y - center.y) - delta.y * (mouse.x - center.x)) / (dist_sq + 120.0f);
                    if (dist < r_platter * 0.95f) {
                        if (deck.vinyl_mode) {
                            deck.jog_touch = true;
                            deck.motor_stopped = true;
                        }
                        float rot_delta = ang_delta * 0.16f;
                        deck.target_scratch_velocity = std::clamp(rot_delta * 3.2f, -3.0f, 3.0f);
                        deck.scratch_active_ticks = 4;
                        deck.jog_visual_angle += rot_delta;

                        if (!deck.is_playing) {
                            double frames_delta = (double)rot_delta * (deck.sample_rate * 0.10);
                            if (ImGui::GetIO().KeyShift) frames_delta *= 4.0;
                            deck.current_frame = std::clamp(deck.current_frame + frames_delta, 0.0, (double)deck.buffer_l.size());
                        }
                    } else {
                        float rot_delta = ang_delta * 0.035f;
                        deck.jog_pitch_bend = std::clamp(deck.jog_pitch_bend + rot_delta, -0.35f, 0.35f);
                        deck.jog_visual_angle += rot_delta;
                    }
                }
            } else if (jog_hovered && ImGui::IsMouseReleased(0)) {
                deck.jog_touch = false;
                deck.motor_stopped = false;
            } else if (!jog_active && !jog_hovered && deck.jog_touch) {
                deck.jog_touch = false;
                deck.motor_stopped = false;
            }

            // Indicador de Slip / Motor Stop ao redor do LCD
            if (deck.jog_touch || deck.motor_stopped) {
                dl->AddCircle(center, hub_r - 1.0f, IM_COL32(255, 30, 60, 240), 48, 2.0f);
            }
        }

