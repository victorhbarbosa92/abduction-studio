        void init(KuroAudio::DJEngine* engine) {
            ddj_hardware.setEngine(engine);
            ddj_hardware.autoConnect();

            // Carrega Hot Cues salvos anteriormente
            if (engine) engine->loadHotCues();

            // Etapa 3: Carrega a base local de artistas seguidos no Radar
            loadFollowedArtists();
            
            // Varredura cirúrgica de todas as músicas locais baixadas para os Crates / Vertentes
            try {
                KuroAudio::DJLibraryManager::getInstance().scanLocalTracks("scratch/tracks");
            } catch (const std::exception& e) {
                std::cerr << "[KuroDJStudioUI] Erro ao escanear faixas: " << e.what() << std::endl;
            } catch (...) {
                std::cerr << "[KuroDJStudioUI] Erro desconhecido ao escanear faixas." << std::endl;
            }

            // Carrega faixas cacheadas de buscas online se existirem
            try {
                if (std::filesystem::exists("scratch/tracks/search_results.tsv")) {
                    spotify_service.parseSearchResultsTsv("scratch/tracks/search_results.tsv");
                }
            } catch (...) {}
            
            // Navegação de playlist pelo jog com shift
            ddj_hardware.setBrowseCallback([this](int delta) {
                auto active_fid = KuroAudio::DJLibraryManager::getInstance().getActiveFolderId();
                auto tracks = KuroAudio::DJLibraryManager::getInstance().getTracksForFolder(active_fid);
                if (!tracks.empty()) {
                    if (delta > 0) {
                        selected_track_idx = (selected_track_idx + 1) % (int)tracks.size();
                    } else if (delta < 0) {
                        selected_track_idx = (selected_track_idx - 1 + (int)tracks.size()) % (int)tracks.size();
                    }
                }
            });
        }

        static bool DrawRotaryKnob(const char* label, float* p_value, float v_min, float v_max, float radius, ImVec4 theme_col, const char* unit_fmt = "%.1fx", float default_val = 1.0f) {
            ImGuiIO& io = ImGui::GetIO();
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();
            
            float total_w = radius * 2.0f + 16.0f;
            float total_h = radius * 2.0f + 18.0f;
            
            ImGui::InvisibleButton(label, ImVec2(total_w, total_h));
            bool is_hovered = ImGui::IsItemHovered();
            bool is_active = ImGui::IsItemActive();
            
            if (is_active && io.MouseDelta.y != 0.0f) {
                float step = (v_max - v_min) * 0.006f;
                *p_value -= io.MouseDelta.y * step;
                *p_value = std::clamp(*p_value, v_min, v_max);
            }
            if (is_hovered && io.MouseWheel != 0.0f) {
                float step = (v_max - v_min) * 0.03f;
                *p_value += io.MouseWheel * step;
                *p_value = std::clamp(*p_value, v_min, v_max);
            }
            if (is_hovered && ImGui::IsMouseDoubleClicked(0)) {
                *p_value = default_val;
            }
            
            ImVec2 center = ImVec2(pos.x + total_w * 0.5f, pos.y + radius + 9.0f);
            
            std::string disp_label = label;
            size_t hash_pos = disp_label.find("##");
            if (hash_pos != std::string::npos) disp_label = disp_label.substr(0, hash_pos);
            
            ImVec2 text_sz = ImGui::CalcTextSize(disp_label.c_str());
            dl->AddText(ImVec2(center.x - text_sz.x * 0.5f, pos.y - 2.0f), is_hovered ? ImGui::GetColorU32(theme_col) : IM_COL32(185, 200, 220, 240), disp_label.c_str());
            
            float angle_min = 0.75f * (float)M_PI;
            float angle_max = 2.25f * (float)M_PI;
            float norm = (*p_value - v_min) / (v_max - v_min);
            norm = std::clamp(norm, 0.0f, 1.0f);
            float angle_val = angle_min + norm * (angle_max - angle_min);
            
            // Trilho inativo
            dl->PathArcTo(center, radius + 2.0f, angle_min, angle_max, 16);
            dl->PathStroke(IM_COL32(28, 36, 50, 255), 0, 2.0f);
            
            // Arco de valor ativo
            dl->PathArcTo(center, radius + 2.0f, angle_min, angle_val, 16);
            dl->PathStroke(ImGui::GetColorU32(theme_col), 0, 2.0f);
            
            // Corpo metálico chanfrado do knob
            dl->AddCircleFilled(center, radius, IM_COL32(18, 22, 30, 255), 20);
            dl->AddCircle(center, radius, is_hovered ? ImGui::GetColorU32(theme_col) : IM_COL32(50, 62, 85, 255), 20, 1.0f);
            dl->AddCircleFilled(center, radius * 0.85f, IM_COL32(26, 32, 44, 255), 16);
            
            // Notch indicador de rotação
            ImVec2 pointer_p = ImVec2(center.x + std::cos(angle_val) * (radius * 0.75f), center.y + std::sin(angle_val) * (radius * 0.75f));
            dl->AddLine(center, pointer_p, ImGui::GetColorU32(theme_col), 1.8f);
            dl->AddCircleFilled(pointer_p, 1.3f, IM_COL32(255, 255, 255, 255));
            
            if (is_hovered || is_active) {
                char val_buf[32];
                snprintf(val_buf, sizeof(val_buf), unit_fmt, *p_value);
                ImGui::SetTooltip("%s: %s", disp_label.c_str(), val_buf);
            }
            
            return is_active;
        }

        static void DrawSegmentedVUMeter(ImDrawList* dl, ImVec2 pos, ImVec2 size, float level) {
            int num_segs = 12;
            float gap = 1.5f;
            float seg_h = (size.y - (num_segs - 1) * gap) / num_segs;
            
            dl->AddRectFilled(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(10, 14, 20, 255), 2.0f);
            dl->AddRect(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(30, 42, 60, 200), 2.0f, 0, 1.0f);
            
            int active_segs = (int)(std::clamp(level, 0.0f, 1.0f) * (float)num_segs + 0.5f);
            
            for (int i = 0; i < num_segs; i++) {
                int seg_idx = num_segs - 1 - i;
                float y_top = pos.y + seg_idx * (seg_h + gap);
                float y_bot = y_top + seg_h;
                
                bool is_lit = (i < active_segs);
                ImU32 col;
                if (i < 8) {
                    col = is_lit ? IM_COL32(0, 245, 140, 255) : IM_COL32(0, 45, 25, 150);
                } else if (i < 10) {
                    col = is_lit ? IM_COL32(255, 195, 0, 255) : IM_COL32(65, 48, 0, 150);
                } else {
                    col = is_lit ? IM_COL32(255, 45, 65, 255) : IM_COL32(65, 10, 15, 150);
                }
                dl->AddRectFilled(ImVec2(pos.x + 1.0f, y_top), ImVec2(pos.x + size.x - 1.0f, y_bot), col, 1.0f);
            }
        }

        void render(KuroAudio::DJEngine& engine, bool* p_open = nullptr) {
            if (p_open && !*p_open) return;
            is_open = true;
            current_engine = &engine;

            // Auto-reconexão da DDJ-200
            if (!ddj_hardware.isConnected()) {
                static double last_retry = 0.0;
                double now = ImGui::GetTime();
                if (now - last_retry > 4.0) {
                    last_retry = now;
                    ddj_hardware.autoConnect(&engine);
                }
            }

            // Atualiza cargas assíncronas do Spotify para os Decks
            spotify_service.pollPendingLoads(engine);

            // Notificações automáticas de calibração de Grid de qualquer deck
            for (int d = 0; d < 4; d++) {
                if (!engine.decks[d].grid_status_msg.empty()) {
                    grid_process_status = engine.decks[d].grid_status_msg;
                    grid_process_status_timer = 5.0f;
                    engine.decks[d].grid_status_msg.clear();
                }
            }

            // LEDs do hardware DDJ-200 sincronizados com os Decks ativos
            int active_l = ddj_hardware.getActiveLeftDeck();
            int active_r = ddj_hardware.getActiveRightDeck();
            auto get_hw_cue_led = [](const KuroAudio::DJDeck& d) -> bool {
                if (d.cue_active) return true;
                if (!d.is_playing) {
                    bool at_c = (std::abs(d.current_frame - d.cue_frame) <= d.sample_rate * 0.04);
                    return at_c ? true : (((int)(ImGui::GetTime() * 4.0) % 2 == 0));
                }
                return false;
            };
            ddj_hardware.updateDeckLED(active_l, engine.decks[active_l].is_playing, get_hw_cue_led(engine.decks[active_l]), engine.decks[active_l].sync_active);
            ddj_hardware.updateDeckLED(active_r, engine.decks[active_r].is_playing, get_hw_cue_led(engine.decks[active_r]), engine.decks[active_r].sync_active);
            ddj_hardware.updatePadLEDs(active_l, engine.decks[active_l].pad_mode, engine.decks[active_l].hot_cues);
            ddj_hardware.updatePadLEDs(active_r, engine.decks[active_r].pad_mode, engine.decks[active_r].hot_cues);

            // =====================================================================
            // TECLAS DE ATALHO INTERATIVAS (REKORDBOX / PIONEER ERGONOMIC MAPPING)
            // =====================================================================
            if (!ImGui::GetIO().WantTextInput) {
                // Guia de Atalhos Rápido (F1)
                if (ImGui::IsKeyPressed(ImGuiKey_F1, false)) {
                    show_shortcuts_help_modal = !show_shortcuts_help_modal;
                }

                // -------------------------------------------------------------
                // 1. DECK 1 (ESQUERDA - MÃO ESQUERDA)
                // -------------------------------------------------------------
                // Play / Pause: Espaço ou Z
                if (ImGui::IsKeyPressed(ImGuiKey_Space, false) || ImGui::IsKeyPressed(ImGuiKey_Z, false)) {
                    engine.decks[active_l].togglePlay(&engine.decks[engine.getMasterDeckId()]);
                }
                // CUE: C (Segurar para pré-escutar, soltar para retornar ao Cue)
                if (ImGui::IsKeyPressed(ImGuiKey_C, false)) engine.decks[active_l].pressCue();
                if (ImGui::IsKeyReleased(ImGuiKey_C)) engine.decks[active_l].releaseCue();

                // BEAT SYNC & MASTER TEMPO
                if (ImGui::IsKeyPressed(ImGuiKey_S, false) && !ImGui::GetIO().KeyShift) {
                    engine.toggleSync(active_l, active_r);
                }
                if (ImGui::IsKeyPressed(ImGuiKey_M, false) && !ImGui::GetIO().KeyShift) {
                    engine.decks[active_l].key_sync_active = !engine.decks[active_l].key_sync_active;
                }

                // HOT CUES 1 a 4: Teclas numéricas 1, 2, 3, 4 (Shift deleta)
                if (!ImGui::GetIO().KeyCtrl && !ImGui::GetIO().KeyAlt) {
                    if (ImGui::IsKeyPressed(ImGuiKey_1, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_l].deleteHotCue(0);
                        else { if (engine.decks[active_l].hot_cues[0].active) engine.decks[active_l].jumpToHotCue(0); else engine.decks[active_l].setHotCue(0); }
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_2, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_l].deleteHotCue(1);
                        else { if (engine.decks[active_l].hot_cues[1].active) engine.decks[active_l].jumpToHotCue(1); else engine.decks[active_l].setHotCue(1); }
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_3, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_l].deleteHotCue(2);
                        else { if (engine.decks[active_l].hot_cues[2].active) engine.decks[active_l].jumpToHotCue(2); else engine.decks[active_l].setHotCue(2); }
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_4, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_l].deleteHotCue(3);
                        else { if (engine.decks[active_l].hot_cues[3].active) engine.decks[active_l].jumpToHotCue(3); else engine.decks[active_l].setHotCue(3); }
                    }
                }

                // AUTO BEAT LOOP (P) & FRAÇÕES ([ e ]) DECK 1
                if (ImGui::IsKeyPressed(ImGuiKey_P, false) && !ImGui::GetIO().KeyShift) {
                    engine.decks[active_l].toggleLoop(engine.decks[active_l].loop_beats > 0.0 ? engine.decks[active_l].loop_beats : 4.0);
                }
                if (ImGui::IsKeyPressed(ImGuiKey_LeftBracket, false) && !ImGui::GetIO().KeyShift) {
                    engine.decks[active_l].loopHalve();
                }
                if (ImGui::IsKeyPressed(ImGuiKey_RightBracket, false) && !ImGui::GetIO().KeyShift) {
                    engine.decks[active_l].loopDouble();
                }
                if (ImGui::IsKeyPressed(ImGuiKey_I, false)) engine.decks[active_l].setLoopIn();
                if (ImGui::IsKeyPressed(ImGuiKey_O, false)) engine.decks[active_l].toggleLoop(engine.decks[active_l].loop_beats);

                // MUTE / SOLO DE STEMS DECK 1 (Q = Drums, W = Vocals, E = Instruments, T = Stem Mode)
                if (ImGui::IsKeyPressed(ImGuiKey_Q, false) && !ImGui::GetIO().KeyShift && !ImGui::GetIO().KeyCtrl) engine.decks[active_l].stem_mute_drums = !engine.decks[active_l].stem_mute_drums;
                if (ImGui::IsKeyPressed(ImGuiKey_W, false) && !ImGui::GetIO().KeyShift && !ImGui::GetIO().KeyCtrl) engine.decks[active_l].stem_mute_vocals = !engine.decks[active_l].stem_mute_vocals;
                if (ImGui::IsKeyPressed(ImGuiKey_E, false) && !ImGui::GetIO().KeyShift && !ImGui::GetIO().KeyCtrl) engine.decks[active_l].stem_mute_inst = !engine.decks[active_l].stem_mute_inst;
                if (ImGui::IsKeyPressed(ImGuiKey_T, false)) engine.decks[active_l].stem_mode = !engine.decks[active_l].stem_mode;

                // NUDGE / PITCH BEND DECK 1 (Setas Esquerda / Direita)
                if (ImGui::IsKeyDown(ImGuiKey_LeftArrow)) engine.decks[active_l].jog_pitch_bend = -0.06f;
                if (ImGui::IsKeyDown(ImGuiKey_RightArrow)) engine.decks[active_l].jog_pitch_bend = 0.06f;

                // -------------------------------------------------------------
                // 2. DECK 2 (DIREITA - MÃO DIREITA / TECLADO NUMÉRICO)
                // -------------------------------------------------------------
                // Play / Pause: Enter, Keypad Enter ou L
                if (ImGui::IsKeyPressed(ImGuiKey_Enter, false) || ImGui::IsKeyPressed(ImGuiKey_KeypadEnter, false) || ImGui::IsKeyPressed(ImGuiKey_L, false)) {
                    engine.decks[active_r].togglePlay(&engine.decks[engine.getMasterDeckId()]);
                }
                // CUE DECK 2: K ou Keypad 0 (Segurar para pré-escutar, soltar para retornar ao Cue)
                if (ImGui::IsKeyPressed(ImGuiKey_K, false) || ImGui::IsKeyPressed(ImGuiKey_Keypad0, false)) {
                    engine.decks[active_r].pressCue();
                }
                if (ImGui::IsKeyReleased(ImGuiKey_K) || ImGui::IsKeyReleased(ImGuiKey_Keypad0)) {
                    engine.decks[active_r].releaseCue();
                }

                // BEAT SYNC & MASTER TEMPO DECK 2
                if ((ImGui::IsKeyPressed(ImGuiKey_S, false) && ImGui::GetIO().KeyShift) || ImGui::IsKeyPressed(ImGuiKey_J, false)) {
                    engine.toggleSync(active_r, active_l);
                }
                if (ImGui::IsKeyPressed(ImGuiKey_M, false) && ImGui::GetIO().KeyShift) {
                    engine.decks[active_r].key_sync_active = !engine.decks[active_r].key_sync_active;
                }

                // HOT CUES DECK 2: Teclas 7 a 0 ou Keypad 1 a 4
                if (!ImGui::GetIO().KeyCtrl && !ImGui::GetIO().KeyAlt) {
                    if (ImGui::IsKeyPressed(ImGuiKey_7, false) || ImGui::IsKeyPressed(ImGuiKey_Keypad1, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_r].deleteHotCue(0);
                        else { if (engine.decks[active_r].hot_cues[0].active) engine.decks[active_r].jumpToHotCue(0); else engine.decks[active_r].setHotCue(0); }
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_8, false) || ImGui::IsKeyPressed(ImGuiKey_Keypad2, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_r].deleteHotCue(1);
                        else { if (engine.decks[active_r].hot_cues[1].active) engine.decks[active_r].jumpToHotCue(1); else engine.decks[active_r].setHotCue(1); }
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_9, false) || ImGui::IsKeyPressed(ImGuiKey_Keypad3, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_r].deleteHotCue(2);
                        else { if (engine.decks[active_r].hot_cues[2].active) engine.decks[active_r].jumpToHotCue(2); else engine.decks[active_r].setHotCue(2); }
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_0, false) || ImGui::IsKeyPressed(ImGuiKey_Keypad4, false)) {
                        if (ImGui::GetIO().KeyShift) engine.decks[active_r].deleteHotCue(3);
                        else { if (engine.decks[active_r].hot_cues[3].active) engine.decks[active_r].jumpToHotCue(3); else engine.decks[active_r].setHotCue(3); }
                    }
                }

                // AUTO BEAT LOOP DECK 2 (Shift + P, Shift + [ , Shift + ])
                if (ImGui::IsKeyPressed(ImGuiKey_P, false) && ImGui::GetIO().KeyShift) {
                    engine.decks[active_r].toggleLoop(engine.decks[active_r].loop_beats > 0.0 ? engine.decks[active_r].loop_beats : 4.0);
                }
                if (ImGui::IsKeyPressed(ImGuiKey_LeftBracket, false) && ImGui::GetIO().KeyShift) {
                    engine.decks[active_r].loopHalve();
                }
                if (ImGui::IsKeyPressed(ImGuiKey_RightBracket, false) && ImGui::GetIO().KeyShift) {
                    engine.decks[active_r].loopDouble();
                }

                // STEMS DECK 2 (Shift + Q, Shift + W, Shift + E)
                if (ImGui::IsKeyPressed(ImGuiKey_Q, false) && ImGui::GetIO().KeyShift) engine.decks[active_r].stem_mute_drums = !engine.decks[active_r].stem_mute_drums;
                if (ImGui::IsKeyPressed(ImGuiKey_W, false) && ImGui::GetIO().KeyShift) engine.decks[active_r].stem_mute_vocals = !engine.decks[active_r].stem_mute_vocals;
                if (ImGui::IsKeyPressed(ImGuiKey_E, false) && ImGui::GetIO().KeyShift) engine.decks[active_r].stem_mute_inst = !engine.decks[active_r].stem_mute_inst;
                if (ImGui::IsKeyPressed(ImGuiKey_Y, false)) engine.decks[active_r].stem_mode = !engine.decks[active_r].stem_mode;

                // NUDGE / PITCH BEND DECK 2 (Setas Cima / Baixo)
                if (ImGui::IsKeyDown(ImGuiKey_UpArrow)) engine.decks[active_r].jog_pitch_bend = 0.06f;
                if (ImGui::IsKeyDown(ImGuiKey_DownArrow)) engine.decks[active_r].jog_pitch_bend = -0.06f;

                // -------------------------------------------------------------
                // 3. MIXER & CROSSFADER CORTES RÁPIDOS
                // -------------------------------------------------------------
                if (ImGui::GetIO().KeyAlt) {
                    if (ImGui::IsKeyPressed(ImGuiKey_A, false)) engine.setCrossfader(0.0f); // Cut Deck 1
                    if (ImGui::IsKeyPressed(ImGuiKey_D, false)) engine.setCrossfader(1.0f); // Cut Deck 2
                    if (ImGui::IsKeyPressed(ImGuiKey_X, false)) engine.setCrossfader(0.5f); // Center
                }

                // Censor / Slip Reverse via tecla R (Hold to reverse)
                if (ImGui::IsKeyDown(ImGuiKey_R)) {
                    if (!engine.decks[active_l].censor_active) engine.decks[active_l].triggerCensor();
                } else if (ImGui::IsKeyReleased(ImGuiKey_R)) {
                    if (engine.decks[active_l].censor_active) engine.decks[active_l].releaseCensor();
                }

                // Quantize toggle via tecla U
                if (ImGui::IsKeyPressed(ImGuiKey_U, false)) {
                    engine.decks[active_l].quantize_active = !engine.decks[active_l].quantize_active;
                    engine.decks[active_r].quantize_active = !engine.decks[active_r].quantize_active;
                }

                // Slip Mode toggle via tecla L (Deck 1) ou Shift+L (Deck 2)
                if (ImGui::IsKeyPressed(ImGuiKey_L, false) && !ImGui::GetIO().KeyCtrl && !ImGui::GetIO().KeyAlt) {
                    int target_d = ImGui::GetIO().KeyShift ? active_r : active_l;
                    engine.decks[target_d].slip_mode = !engine.decks[target_d].slip_mode;
                    KuroUtils::Log(std::string("[DJ Engine] SLIP MODE ") + (engine.decks[target_d].slip_mode ? "ON" : "OFF") + " Deck " + std::to_string(target_d + 1));
                }

                // Reposicionamento Instantâneo da Beatgrid via Teclado (Padrão Pioneer / Rekordbox):
                // Tecla G: Fixar Beat 1.1 na posição atual da agulha (Deck 1 ou Shift+G para Deck 2)
                if (ImGui::IsKeyPressed(ImGuiKey_G, false)) {
                    int target_d = ImGui::GetIO().KeyShift ? active_r : active_l;
                    auto& d = engine.decks[target_d];
                    double beat_len = (d.bpm > 20.0 && d.sample_rate > 1000.0) ? (60.0 * d.sample_rate / d.bpm) : (d.sample_rate * 0.5);
                    double red = std::fmod(d.current_frame, beat_len);
                    if (red < 0.0) red += beat_len;
                    d.first_beat_frame = red;
                    KuroAudio::DJGridEngine::getInstance().setFirstBeatMarker(target_d, d.first_beat_frame, d.sample_rate);
                }

                // Alt + Setas: Nudge fino da Beatgrid (±1ms ou Shift ±10ms)
                if (ImGui::GetIO().KeyAlt) {
                    double ms = ImGui::GetIO().KeyShift ? 10.0 : 1.0;
                    if (ImGui::IsKeyPressed(ImGuiKey_LeftArrow, true)) {
                        auto& d = engine.decks[active_l];
                        KuroAudio::DJGridEngine::getInstance().nudgeGrid(active_l, -ms, d.sample_rate);
                        d.first_beat_frame = KuroAudio::DJGridEngine::getInstance().getGridData(active_l).first_beat_frame;
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_RightArrow, true)) {
                        auto& d = engine.decks[active_l];
                        KuroAudio::DJGridEngine::getInstance().nudgeGrid(active_l, ms, d.sample_rate);
                        d.first_beat_frame = KuroAudio::DJGridEngine::getInstance().getGridData(active_l).first_beat_frame;
                    }
                }

                // Alternar Tela Cheia (F11)
                if (ImGui::IsKeyPressed(ImGuiKey_F11, false)) is_fullscreen = !is_fullscreen;
            }


            ImGuiViewport* viewport = ImGui::GetMainViewport();
            if (is_fullscreen) {
                ImGui::SetNextWindowPos(viewport->Pos);
                ImGui::SetNextWindowSize(viewport->Size);
            } else {
                ImVec2 target_sz = ImVec2(viewport->Size.x * 0.96f, (viewport->Size.y - 70.0f) * 0.96f);
                ImVec2 target_pos = ImVec2(viewport->Pos.x + viewport->Size.x * 0.02f, viewport->Pos.y + 70.0f);
                
                ImGuiWindow* win = ImGui::FindWindowByName("##AbductionDJStudioPro");
                if (!win || win->Size.x > viewport->Size.x || win->Size.y > viewport->Size.y) {
                    ImGui::SetNextWindowSize(target_sz, ImGuiCond_Always);
                    ImGui::SetNextWindowPos(target_pos, ImGuiCond_Always);
                } else {
                    ImGui::SetNextWindowSize(target_sz, ImGuiCond_FirstUseEver);
                    ImGui::SetNextWindowPos(target_pos, ImGuiCond_FirstUseEver);
                }
                ImGui::SetNextWindowSizeConstraints(ImVec2(800, 440), ImVec2(viewport->Size.x, viewport->Size.y));
            }

            ImGui::PushStyleColor(ImGuiCol_WindowBg, col_bg_dark);
            ImGui::PushStyleColor(ImGuiCol_Border, col_border);
            ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, is_fullscreen ? 0.0f : 8.0f);
            ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.0f);
            ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(8.0f, 6.0f));

            ImGuiWindowFlags flags = ImGuiWindowFlags_NoCollapse;
            if (is_fullscreen) {
                flags |= ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoTitleBar;
            }

            if (ImGui::Begin("##AbductionDJStudioPro", p_open, flags)) {

                // ============================================================
                // CONCEITO 1 — REKORDBOX PRO LAYOUT
                // TOP 30%  : HUD (1 linha) + Toolbar+PhaseMeter (1 linha) + 2x Waveforms
                // BODY 70% : LEFT DECK (39%) | MIXER (22%) | RIGHT DECK (39%)
                // BOTTOM   : Biblioteca sempre visível
                // ============================================================

                // Atalhos globais para Sampler One-Shot (Teclas Keypad 1 a 8 se não estiver digitando em busca)
                if (!ImGui::GetIO().WantTextInput) {
                    for (int s = 0; s < 8; s++) {
                        if (ImGui::IsKeyPressed((ImGuiKey)(ImGuiKey_Keypad1 + s), false)) {
                            engine.triggerSampler(s);
                        }
                    }
                }

                // --- 1. TOP HUD (REKORDBOX OFICIAL 1:1) ---
                renderRekordboxTopBar(engine, p_open);

                if (show_rekordbox_fx_bar) {
                    float fx_w = ImGui::GetContentRegionAvail().x;
                    renderRekordboxFXBar(engine, fx_w);
                }

                if (show_grid_edit_drawer) {
                    float gw = ImGui::GetContentRegionAvail().x;
                    renderGridEditDrawer(engine, gw);
                }

                // Atalho de Teclado SPACE: Alterna largura da Gaveta Lateral (Modo Performance ⇄ Modo Navegação Ampla)
                if (!ImGui::GetIO().WantTextInput && ImGui::IsKeyPressed(ImGuiKey_Space, false)) {
                    if (!side_drawer_ui.is_open) {
                        side_drawer_ui.is_open = true;
                    } else {
                        side_drawer_ui.drawer_width = (side_drawer_ui.drawer_width > 520.0f) ? 410.0f : 620.0f;
                    }
                }

                // --- 2. CÁLCULO DE DIMENSÕES: O LAYOUT PRINCIPAL (GAVETA ATÉ O TOPO + WAVEFORMS & DECKS) ---
                float total_w       = ImGui::GetContentRegionAvail().x;
                float total_avail_h = ImGui::GetContentRegionAvail().y;

                float bottom_extra_h = 0.0f;
                if (show_export_modal) bottom_extra_h += KuroUI::UIScaleManager::Scale(136.0f);
                if (show_sampler_rack) bottom_extra_h += KuroUI::UIScaleManager::Scale(150.0f);

                float bottom_bar_h = KuroUI::UIScaleManager::Scale(26.0f);
                float full_height_h = total_avail_h - bottom_extra_h - bottom_bar_h - 4.0f;
                if (full_height_h < 400.0f) full_height_h = 400.0f;

                // Cálculo de Larguras com Respeito ao Splitter
                float drawer_w = 0.0f;
                float splitter_w = 0.0f;
                if (side_drawer_ui.is_open) {
                    side_drawer_ui.drawer_width = std::clamp(side_drawer_ui.drawer_width, side_drawer_ui.min_width, total_w * 0.65f);
                    drawer_w = side_drawer_ui.drawer_width;
                    splitter_w = side_drawer_ui.splitter_w;
                } else {
                    drawer_w = 26.0f; // Faixa de aba recolhida
                    splitter_w = 0.0f;
                }
                float decks_area_w = total_w - drawer_w - splitter_w - 4.0f;

                // Altura das Waveforms dentro da coluna principal
                ImGuiViewport* vp_curr = ImGui::GetMainViewport();
                float wave_ratio = (vp_curr->Size.y < 820.0f) ? 0.200f : 0.230f;
                if (!wf_height_user_adjusted) {
                    waveform_height = std::clamp(vp_curr->Size.y * wave_ratio, 140.0f, 220.0f);
                }
                float wave_h_px = KuroUI::UIScaleManager::Scale(waveform_height);
                float decks_body_h = full_height_h - wave_h_px - 4.0f;
                if (decks_body_h < 260.0f) {
                    decks_body_h = 260.0f;
                    wave_h_px = full_height_h - decks_body_h - 4.0f;
                }

                auto renderDecksAndMixer = [&](float area_w, float area_h) {
                    float gap_px = KuroUI::UIScaleManager::Scale(4.0f);
                    float mixer_w = std::clamp(area_w * 0.17f,
                                                 KuroUI::UIScaleManager::Scale(160.0f),
                                                 KuroUI::UIScaleManager::Scale(210.0f));
                    float deck_w = (area_w - mixer_w - gap_px * 2.0f) * 0.5f;

                    ImGuiWindowFlags child_flags = 0;
                    ImVec4 col_left  = (active_l == 0 ? col_deck_1 : col_deck_3);
                    ImVec4 col_right = (active_r == 1 ? col_deck_2 : col_deck_4);

                    // DECK ESQUERDO REKORDBOX 1:1
                    ImGui::BeginChild("##DeckLeft_Child", ImVec2(deck_w, area_h), false, child_flags);
                    renderRekordboxDeckPanel(engine.decks[active_l], 0, col_left, engine);
                    ImGui::EndChild();

                    ImGui::SameLine(0, gap_px);

                    // MIXER CENTRAL REKORDBOX 1:1 (com wave central de frequência sobreposta)
                    ImGui::BeginChild("##Mixer_Child", ImVec2(mixer_w, area_h), false, child_flags);
                    renderRekordboxCenterMixer(engine);
                    ImGui::EndChild();

                    ImGui::SameLine(0, gap_px);

                    // DECK DIREITO REKORDBOX 1:1
                    ImGui::BeginChild("##DeckRight_Child", ImVec2(deck_w, area_h), false, child_flags);
                    renderRekordboxDeckPanel(engine.decks[active_r], 1, col_right, engine);
                    ImGui::EndChild();
                };

                auto renderWaveformsAndDecksColumn = [&](float area_w, float area_h) {
                    ImGui::BeginChild("##WaveformsAndDecksColumn", ImVec2(area_w, area_h), false, ImGuiWindowFlags_NoScrollbar);

                    // 1. WAVEFORMS EMPILHADAS (DECK 1 + DECK 2)
                    renderStackedRekordboxWaveforms(engine, area_w, wave_h_px);

                    // Separador fino
                    {
                        ImDrawList* dl = ImGui::GetWindowDrawList();
                        ImVec2 sep_pos = ImGui::GetCursorScreenPos();
                        dl->AddLine(sep_pos, ImVec2(sep_pos.x + area_w, sep_pos.y),
                                    IM_COL32(24, 30, 42, 220), 1.0f);
                        ImGui::Dummy(ImVec2(area_w, 2.0f));
                    }

                    // 2. CORPO DOS DECKS + MIXER CENTRAL
                    renderDecksAndMixer(area_w, decks_body_h);

                    ImGui::EndChild();
                };

                // Renderização: A Gaveta Lateral vai até o topo (junto com waveforms e decks)
                if (side_drawer_ui.dock_left) {
                    if (side_drawer_ui.is_open) {
                        side_drawer_ui.render(engine, spotify_service, full_height_h);
                        ImGui::SameLine(0, 0);
                        side_drawer_ui.renderSplitter(full_height_h);
                        ImGui::SameLine(0, 4.0f);
                    } else {
                        side_drawer_ui.renderCollapsedStrip(full_height_h);
                        ImGui::SameLine(0, 4.0f);
                    }
                    renderWaveformsAndDecksColumn(decks_area_w, full_height_h);
                } else {
                    renderWaveformsAndDecksColumn(decks_area_w, full_height_h);
                    ImGui::SameLine(0, 4.0f);
                    if (side_drawer_ui.is_open) {
                        side_drawer_ui.renderSplitter(full_height_h);
                        ImGui::SameLine(0, 0);
                        side_drawer_ui.render(engine, spotify_service, full_height_h);
                    } else {
                        side_drawer_ui.renderCollapsedStrip(full_height_h);
                    }
                }

                // Sincronização de comandos e abertura de Fontes pela Gaveta Lateral
                if (side_drawer_ui.request_open_cloud_hub) {
                    side_drawer_ui.request_open_cloud_hub = false;
                    show_search_modal = true;
                    focus_search_modal = true;
                }
                if (side_drawer_ui.request_open_sources_track) {
                    side_drawer_ui.request_open_sources_track = false;
                    show_search_modal = true;
                    search_modal_view = 1;
                    selected_source_track_id = side_drawer_ui.request_track_id;
                    selected_source_track_title = side_drawer_ui.request_track_title;
                    selected_source_track_artist = side_drawer_ui.request_track_artist;
                    spotify_service.searchSourcesAsync(selected_source_track_id, selected_source_track_title, selected_source_track_artist);
                }

                // --- 4. BARRA INFERIOR REKORDBOX (LOGO + PAD MODE TABS) ---
                renderRekordboxBottomBar(engine, total_w);

                // --- 6. PEN DRIVE USB ---
                if (show_export_modal) {
                    ImGui::Dummy(ImVec2(total_w, 2.0f));
                    renderUSBExportDrawer(engine);
                }

                // --- 7. SAMPLER PERFORMANCE RACK (ONE-SHOT 8 SLOTS) ---
                if (show_sampler_rack) {
                    ImGui::Dummy(ImVec2(total_w, 2.0f));
                    renderSamplerRack(engine);
                }

                // Auto-registro contínuo de faixas no histórico de Setlist (> 15 segundos tocando)
                for (int d = 0; d < 4; d++) {
                    if (engine.decks[d].is_playing.load() && engine.decks[d].getElapsedTimeSec() >= 15.0) {
                        engine.logTrackPlayed(engine.decks[d].track_title, engine.decks[d].track_artist, engine.decks[d].bpm, engine.decks[d].getEffectiveKey());
                        static std::string last_marked[4];
                        if (last_marked[d] != engine.decks[d].track_title) {
                            last_marked[d] = engine.decks[d].track_title;
                            KuroAudio::DJLibraryManager::getInstance().markTrackPlayed(engine.decks[d].track_title);
                        }
                    }
                }

                // --- 8. MODAIS POPUP ---
                renderLibraryModal(engine);
                renderSearchModal(engine);
                renderSourcesModal(engine);
                renderCamelotRadarModal(engine);
                renderRecordingsModal(engine);
                renderSetlistModal(engine);
                renderEditMetadataModal();
                renderDeleteConfirmModal();
                renderExitConfirmModal(engine, p_open);
                renderMidiLearnModal(engine);
                renderShortcutsHelpModal();
                DJAudioRoutingModal::render();
            }
            ImGui::End();

            ImGui::PopStyleVar(3);
            ImGui::PopStyleColor(2);
        }

    private:
        void renderTopHUD(KuroAudio::DJEngine& engine, bool* p_open) {
            float avail_w = ImGui::GetContentRegionAvail().x;
            
            // --- SELETOR DE MODO REKORDBOX 7 (PERFORMANCE vs EXPORT) ---
            bool is_perf = (rekordbox_app_mode == 0);
            bool is_exp = (rekordbox_app_mode == 1);
            ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 4.0f);
            ImGui::PushStyleColor(ImGuiCol_Button, is_perf ? ImVec4(0.00f, 0.55f, 0.85f, 0.95f) : ImVec4(0.08f, 0.12f, 0.18f, 0.85f));
            ImGui::PushStyleColor(ImGuiCol_Text, is_perf ? ImVec4(1.0f, 1.0f, 1.0f, 1.0f) : ImVec4(0.6f, 0.7f, 0.8f, 1.0f));
            if (ImGui::Button(ICON_FA_HEADPHONES " PERFORMANCE")) {
                rekordbox_app_mode = 0;
                show_export_modal = false;
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Modo PERFORMANCE: Mixagem ao vivo com CDJ-3000 Decks, Mixer DJM e Waveforms stacked");
            ImGui::PopStyleColor(2);

            ImGui::SameLine(0, 3);
            ImGui::PushStyleColor(ImGuiCol_Button, is_exp ? ImVec4(0.85f, 0.50f, 0.05f, 0.95f) : ImVec4(0.08f, 0.12f, 0.18f, 0.85f));
            ImGui::PushStyleColor(ImGuiCol_Text, is_exp ? ImVec4(1.0f, 1.0f, 1.0f, 1.0f) : ImVec4(0.6f, 0.7f, 0.8f, 1.0f));
            if (ImGui::Button(ICON_FA_FLOPPY_DISK " EXPORT")) {
                rekordbox_app_mode = 1;
                show_playlist_drawer = true;
                show_export_modal = true;
                detected_drives = KuroAudio::DJExportService::scanDrives();
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Modo EXPORT: Preparação de Pen Drive USB para CDJ-3000 / XDJ, ajuste de Beatgrid, Hot Cues e Smart Crates");
            ImGui::PopStyleColor(2);
            ImGui::PopStyleVar();

            ImGui::SameLine(0, 10);

            // Status Pioneer DDJ Hardware (Auto-detecção DDJ-400, DDJ-FLX4, DDJ-200)
            bool hw_ok = ddj_hardware.isConnected();
            std::string ctrl_name = ddj_hardware.getControllerModelName();
            if (hw_ok) {
                ImGui::TextColored(ImVec4(0.0f, 1.0f, 0.5f, 1.0f), ICON_FA_PLUG_CIRCLE_CHECK " %s (4-DECKS)", ctrl_name.c_str());
            } else {
                ImGui::TextColored(ImVec4(1.0f, 0.6f, 0.0f, 1.0f), ICON_FA_PLUG_CIRCLE_EXCLAMATION " %s OFF", ctrl_name.c_str());
                ImGui::SameLine();
                if (ImGui::SmallButton("Reconectar")) {
                    ddj_hardware.autoConnect(&engine);
                }
            }

            // Seletores Rápidos de Decks Ativos no HUD
            ImGui::SameLine(0, 10);
            int left_deck = ddj_hardware.getActiveLeftDeck();
            int right_deck = ddj_hardware.getActiveRightDeck();
            
            ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "LEFT:");
            ImGui::SameLine();
            if (ImGui::SmallButton(left_deck == 0 ? "[*] 1" : " 1 ")) ddj_hardware.setActiveLeftDeck(0);
            ImGui::SameLine(0, 2);
            if (ImGui::SmallButton(left_deck == 2 ? "[*] 3" : " 3 ")) ddj_hardware.setActiveLeftDeck(2);

            ImGui::SameLine(0, 8);
            ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "RIGHT:");
            ImGui::SameLine();
            if (ImGui::SmallButton(right_deck == 1 ? "[*] 2" : " 2 ")) ddj_hardware.setActiveRightDeck(1);
            ImGui::SameLine(0, 2);
            if (ImGui::SmallButton(right_deck == 3 ? "[*] 4" : " 4 ")) ddj_hardware.setActiveRightDeck(3);

            ImGui::SameLine(0, 14);
            ImGui::TextColored(ImVec4(1.0f, 1.0f, 1.0f, 1.0f), "BPM:");
            ImGui::SameLine();
            double l_eff = engine.decks[left_deck].bpm * (1.0 + engine.decks[left_deck].pitch_percent * 0.01);
            double r_eff = engine.decks[right_deck].bpm * (1.0 + engine.decks[right_deck].pitch_percent * 0.01);
            bool l_master = engine.isMasterDeck(left_deck);
            bool r_master = engine.isMasterDeck(right_deck);
            ImGui::TextColored(l_master ? ImVec4(1.0f, 0.82f, 0.10f, 1.0f) : col_deck_1, "D%d: %.2f%s", left_deck + 1, l_eff, l_master ? " [MASTER]" : "");
            ImGui::SameLine(0, 6);
            ImGui::TextColored(r_master ? ImVec4(1.0f, 0.82f, 0.10f, 1.0f) : col_deck_2, "D%d: %.2f%s", right_deck + 1, r_eff, r_master ? " [MASTER]" : "");
            if (engine.decks[left_deck].sync_active || engine.decks[right_deck].sync_active) {
                ImGui::SameLine(0, 6);
                ImGui::TextColored(ImVec4(0.0f, 1.0f, 0.9f, 1.0f), ICON_FA_BOLT " [SYNC LOCKED]");
            }

            // Sincronização Bi-direcional contínua de rotação física e LEDs da Pioneer DDJ-200
            if (hw_ok) {
                ddj_hardware.updateJogwheelFeedback(engine.decks[left_deck], engine.decks[right_deck]);
            }

            // Ações do Topo: Músicas / Busca / Pen Drive / Playlist / Limpar / Tela Cheia / Sair
            float right_actions_w = 690.0f;
            if (avail_w > 980.0f) {
                ImGui::SameLine(std::max(ImGui::GetCursorPosX() + 16.0f, avail_w - right_actions_w));
            } else {
                ImGui::SameLine(0, 8);
            }

            // Botão Master Recording [● REC] (Lossless WAV 32-bit Float)
            bool rec_on = engine.isRecording();
            if (rec_on) {
                float pulse = (std::sin((float)ImGui::GetTime() * 10.0f) + 1.0f) * 0.5f;
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.85f + pulse * 0.15f, 0.05f, 0.05f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                int rec_sec = (int)engine.getRecordSeconds();
                int rec_h = rec_sec / 3600;
                int rec_m = (rec_sec % 3600) / 60;
                int rec_s = rec_sec % 60;
                char rec_lbl[48];
                snprintf(rec_lbl, sizeof(rec_lbl), ICON_FA_CIRCLE " REC %02d:%02d:%02d", rec_h, rec_m, rec_s);
                if (ImGui::Button(rec_lbl)) {
                    engine.toggleRecording();
                }
                if (ImGui::IsItemHovered()) {
                    ImGui::SetTooltip("Gravando Master ao vivo: %s\nClique para finalizar a gravação WAV", engine.getRecordingPath().c_str());
                }
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.20f, 0.08f, 0.10f, 0.90f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 0.40f, 0.40f, 1.0f));
                if (ImGui::Button(ICON_FA_CIRCLE " REC")) {
                    engine.toggleRecording();
                }
                if (ImGui::IsItemHovered()) {
                    ImGui::SetTooltip("Iniciar gravação em tempo real da saída Master para WAV 32-bit Float (scratch/recordings/)");
                }
            }
            ImGui::PopStyleColor(2);

            ImGui::SameLine(0, 4);

            // Botão Gravações Master (Abre modal de gerenciamento de sets gravados)
            ImGui::PushStyleColor(ImGuiCol_Button, show_recordings_modal ? ImVec4(0.85f, 0.15f, 0.35f, 1.0f) : ImVec4(0.24f, 0.12f, 0.28f, 0.90f));
            if (ImGui::Button(ICON_FA_COMPACT_DISC " SETS")) {
                show_recordings_modal = !show_recordings_modal;
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Abrir central de gravações Master gravadas ao vivo (scratch/recordings/)");
            ImGui::PopStyleColor();

            ImGui::SameLine(0, 4);

            // Botão SAMPLER (Rack One-Shot de 8 slots)
            ImGui::PushStyleColor(ImGuiCol_Button, show_sampler_rack ? ImVec4(0.70f, 0.20f, 0.85f, 1.0f) : ImVec4(0.22f, 0.12f, 0.28f, 0.90f));
            if (ImGui::Button(ICON_FA_DRUM " SAMPLER")) {
                show_sampler_rack = !show_sampler_rack;
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Abrir Rack de 8 Samplers One-Shot (Airhorn, Sirene, Laser, Sub Drop)");
            ImGui::PopStyleColor();

            ImGui::SameLine(0, 4);

            // Botão Saídas de Áudio (Configuração descomplicada Mestre / Retorno Fone)
            auto& devMgr = KuroAudio::DJAudioDeviceManager::getInstance();
            std::string audio_btn_lbl = std::string(ICON_FA_HEADPHONES) + " SAÍDAS";
            ImGui::PushStyleColor(ImGuiCol_Button, devMgr.show_routing_modal ? ImVec4(0.00f, 0.75f, 0.85f, 1.0f) : ImVec4(0.12f, 0.20f, 0.32f, 0.90f));
            if (ImGui::Button(audio_btn_lbl.c_str())) {
                devMgr.show_routing_modal = !devMgr.show_routing_modal;
                if (devMgr.show_routing_modal) {
                    devMgr.rescanDevices();
                }
            }
            if (ImGui::IsItemHovered()) {
                std::string tip = "Configurar Saídas de Áudio (Mestre & Retorno/Fone):\n";
                tip += "Modo: " + std::string(devMgr.getModeTitle(devMgr.routing_mode)) + "\n";
                tip += "Mestre: " + devMgr.master_device_name + "\n";
                if (devMgr.routing_mode == KuroAudio::DJRoutingMode::DUAL_DEVICE) {
                    tip += "Retorno: " + devMgr.cue_device_name;
                }
                ImGui::SetTooltip("%s", tip.c_str());
            }
            ImGui::PopStyleColor();

            ImGui::SameLine(0, 4);

            // Botão Músicas (Abre pasta do Explorer)
            ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.14f, 0.24f, 0.38f, 0.90f));
            if (ImGui::Button(ICON_FA_FOLDER_OPEN " MÚSICAS")) {
#ifdef _WIN32
                ShellExecuteA(NULL, "open", "scratch\\tracks", NULL, NULL, SW_SHOW);
#endif
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Abrir pasta de músicas baixadas (scratch/tracks) no Windows Explorer");
            ImGui::PopStyleColor();

            ImGui::SameLine(0, 4);

            // Botão Abduzir / Streaming Hub
            int nuvem_pct = (int)spotify_service.getDownloadProgressPct();
            std::string nuvem_label = spotify_service.isDownloading() 
                ? (nuvem_pct > 0 ? (std::string(ICON_FA_BOLT) + " " + std::to_string(nuvem_pct) + "%") : (std::string(ICON_FA_BOLT) + " ..."))
                : (std::string(ICON_FA_SHUTTLE_SPACE) + " ABDUZIR");
            ImGui::PushStyleColor(ImGuiCol_Button, show_search_modal ? ImVec4(0.00f, 0.75f, 0.85f, 1.0f) : (spotify_service.isDownloading() ? ImVec4(0.48f, 0.22f, 0.05f, 0.95f) : ImVec4(0.12f, 0.32f, 0.44f, 0.95f)));
            if (ImGui::Button(nuvem_label.c_str())) {
                show_search_modal = !show_search_modal;
                if (show_search_modal) focus_search_modal = true;
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("ABDUCTION STUDIO // MASTER SOURCE MATRIX:\nBuscador de fontes de áudio e abdução em alta fidelidade");
            ImGui::PopStyleColor();

            ImGui::SameLine(0, 4);

            // Botão Pen Drive Export
            ImGui::PushStyleColor(ImGuiCol_Button, show_export_modal ? ImVec4(0.0f, 0.7f, 0.8f, 1.0f) : ImVec4(0.12f, 0.28f, 0.40f, 0.9f));
            if (ImGui::Button(ICON_FA_FLOPPY_DISK " USB")) {
                show_export_modal = !show_export_modal;
                if (show_export_modal) detected_drives = KuroAudio::DJExportService::scanDrives();
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Exportar Playlists e Hot Cues para Pen Drive USB (CDJ-3000 / Rekordbox)");
            ImGui::PopStyleColor();

