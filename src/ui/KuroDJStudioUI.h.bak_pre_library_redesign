                    ImGui::TextColored(KuroAudio::getPhaseColorVec4(3), "4. Desfecho Épico (85-100%%):");
                    ImGui::SameLine();
                    ImGui::Text("Resolução melódica inesquecível. Mudança para tons maiores (Modo B) para fechar com chave de ouro.");

                    ImGui::Spacing();
                    ImGui::Separator();
                    ImGui::Spacing();

                    // 2. RADAR HARMÔNICO DE PRÓXIMA MÚSICA
                    std::string ref_track_name = "Nenhuma selecionada";
                    if (active_set && !active_set->items.empty()) {
                        const auto& last_item = active_set->items.back();
                        radar_ref_track_id = last_item.track_id;
                        radar_ref_key = last_item.key;
                        radar_ref_bpm = last_item.bpm;
                        ref_track_name = last_item.title;
                    }

                    ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.20f, 1.0f), ICON_FA_COMPASS " RADAR HARMÔNICO DE PRÓXIMA FAIXA");
                    ImGui::TextColored(ImVec4(0.7f, 0.8f, 0.9f, 1.0f), "Baseado na faixa atual: '%s' (%.1f BPM | %s)", ref_track_name.c_str(), radar_ref_bpm, radar_ref_key.c_str());

                    // Filtros por fase de energia
                    ImGui::Text("Fase do Set:");
                    ImGui::SameLine();
                    if (ImGui::SmallButton(radar_target_phase == -1 ? "[Todas]" : "Todas")) radar_target_phase = -1;
                    ImGui::SameLine();
                    if (ImGui::SmallButton(radar_target_phase == 0 ? "[1. Abertura]" : "1. Abertura")) radar_target_phase = 0;
                    ImGui::SameLine();
                    if (ImGui::SmallButton(radar_target_phase == 1 ? "[2. Build-Up]" : "2. Build-Up")) radar_target_phase = 1;
                    ImGui::SameLine();
                    if (ImGui::SmallButton(radar_target_phase == 2 ? "[3. Peak Time]" : "3. Peak Time")) radar_target_phase = 2;
                    ImGui::SameLine();
                    if (ImGui::SmallButton(radar_target_phase == 3 ? "[4. Desfecho]" : "4. Desfecho")) radar_target_phase = 3;

                    ImGui::Separator();

                    auto suggestions = setlist_mgr.getRadarSuggestions(radar_ref_track_id, radar_ref_key, radar_ref_bpm, radar_target_phase, 6);
                    if (suggestions.empty()) {
                        ImGui::TextDisabled("Nenhuma recomendação compatível no momento.");
                    } else {
                        for (size_t s = 0; s < suggestions.size(); s++) {
                            const auto& sug = suggestions[s];
                            ImGui::PushID((int)(s + 5000));

                            // Score Badge
                            ImVec4 sc_col = ImVec4(0.0f, 1.0f, 0.5f, 1.0f);
                            if (sug.match_score < 80) sc_col = ImVec4(1.0f, 0.85f, 0.2f, 1.0f);
                            ImGui::TextColored(sc_col, "[%d%% MATCH]", sug.match_score);

                            ImGui::SameLine(0, 6.0f);
                            ImGui::TextColored(ImVec4(1.0f, 1.0f, 1.0f, 1.0f), "%s", sug.track.title.c_str());
                            ImGui::SameLine(0, 4.0f);
                            ImGui::TextColored(ImVec4(0.6f, 0.7f, 0.8f, 1.0f), "- %s", sug.track.artist.c_str());

                            ImGui::SameLine(col_w - 90.0f);
                            ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.2f, 1.0f), "%.1f BPM", sug.track.bpm);

                            // Dica de Mixagem Profissional
                            ImGui::TextColored(ImVec4(0.35f, 0.85f, 1.00f, 0.95f), "  ↳ %s", sug.mixing_advice.c_str());

                            // Ação Rápida: Encaixar no Setlist
                            if (ImGui::SmallButton(ICON_FA_PLUS " Encaixar no Setlist")) {
                                setlist_mgr.addTrackToActiveSetlist(sug.track, sug.suggested_phase, sug.mixing_advice);
                                toast_message = "Faixa encaixada com sucesso!";
                                toast_timer = 3.0f;
                            }
                            ImGui::SameLine(0, 8.0f);
                            int left_id = ddj_hardware.getActiveLeftDeck();
                            int right_id = ddj_hardware.getActiveRightDeck();
                            char b1[16]; snprintf(b1, sizeof(b1), "DECK %d", left_id + 1);
                            if (ImGui::SmallButton(b1)) {
                                KuroAudio::DJLibraryTrack copy_trk = sug.track;
                                spotify_service.loadLibraryTrack(copy_trk, left_id, engine);
                            }
                            ImGui::SameLine(0, 4.0f);
                            char b2[16]; snprintf(b2, sizeof(b2), "DECK %d", right_id + 1);
                            if (ImGui::SmallButton(b2)) {
                                KuroAudio::DJLibraryTrack copy_trk = sug.track;
                                spotify_service.loadLibraryTrack(copy_trk, right_id, engine);
                            }

                            ImGui::Separator();
                            ImGui::PopID();
                        }
                    }

                    ImGui::EndChild();
                    ImGui::PopStyleColor();
                }

                // ── MODAL: RENOMEAR CRATE / SETLIST ──
                if (show_rename_folder_dialog) {
                    ImGui::OpenPopup("Renomear Crate##Modal");
                }
                if (ImGui::BeginPopupModal("Renomear Crate##Modal", &show_rename_folder_dialog, ImGuiWindowFlags_AlwaysAutoResize)) {
                    ImGui::TextColored(ImVec4(0.0f, 0.9f, 0.8f, 1.0f), ICON_FA_PEN " Renomear Pasta ou Setlist");
                    ImGui::InputText("##RenameInput", rename_folder_name_buf, sizeof(rename_folder_name_buf));
                    ImGui::Spacing();
                    if (ImGui::Button("SALVAR", ImVec2(100, 26))) {
                        if (strlen(rename_folder_name_buf) > 0) {
                            lib_mgr.renameFolder(rename_folder_target_id, rename_folder_name_buf);
                            setlist_mgr.renameSetlist(rename_folder_target_id, rename_folder_name_buf);
                            show_rename_folder_dialog = false;
                        }
                    }
                    ImGui::SameLine();
                    if (ImGui::Button("CANCELAR", ImVec2(100, 26))) {
                        show_rename_folder_dialog = false;
                    }
                    ImGui::EndPopup();
                }

                // ── MODAL: NOVO SETLIST ──
                if (show_new_setlist_dialog) {
                    ImGui::OpenPopup("Novo DJ Setlist##Modal");
                }
                if (ImGui::BeginPopupModal("Novo DJ Setlist##Modal", &show_new_setlist_dialog, ImGuiWindowFlags_AlwaysAutoResize)) {
                    ImGui::TextColored(ImVec4(0.85f, 0.40f, 0.95f, 1.0f), ICON_FA_HEADPHONES " Criar Novo DJ Setlist Personalizado");
                    ImGui::Text("Nome do Setlist / Show:");
                    ImGui::InputText("##NewSetlistName", new_setlist_name_buf, sizeof(new_setlist_name_buf));
                    ImGui::Spacing();
                    if (ImGui::Button("CRIAR SETLIST", ImVec2(120, 26))) {
                        if (strlen(new_setlist_name_buf) > 0) {
                            setlist_mgr.createSetlist(new_setlist_name_buf);
                            new_setlist_name_buf[0] = '\0';
                            library_modal_tab = 1;
                            show_new_setlist_dialog = false;
                        }
                    }
                    ImGui::SameLine();
                    if (ImGui::Button("CANCELAR", ImVec2(100, 26))) {
                        show_new_setlist_dialog = false;
                    }
                    ImGui::EndPopup();
                }

                // ── MODAL: RESULTADO DA ANÁLISE CIRÚRGICA DE ÁUDIO (REKORDBOX STYLE) ──
                if (show_analysis_result_modal) {
                    ImGui::OpenPopup("🔬 ANÁLISE CIRÚRGICA CONCLUÍDA##Modal");
                }
                if (ImGui::BeginPopupModal("🔬 ANÁLISE CIRÚRGICA CONCLUÍDA##Modal", &show_analysis_result_modal, ImGuiWindowFlags_AlwaysAutoResize)) {
                    ImGui::TextColored(ImVec4(0.00f, 0.96f, 0.83f, 1.0f), ICON_FA_MICROSCOPE " RE-LEITURA CIRÚRGICA DE ÁUDIO REKORDBOX++");
                    ImGui::Text("Faixa: \"%s - %s\"", last_analysis_result.title.c_str(), last_analysis_result.artist.c_str());
                    ImGui::Separator();
                    ImGui::Spacing();

                    ImGui::BulletText("BPM Cirúrgico: %.1f BPM (detectado por autocorrelação de transientes)", last_analysis_result.exact_bpm);
                    ImGui::BulletText("Tom & Camelot: [%s] %s (analisado por chromagram FFT 8192)", 
                                      last_analysis_result.camelot_key.getCamelotCode().c_str(), last_analysis_result.key.c_str());
                    ImGui::BulletText("Marco Zero 1.1 da Beatgrid: Frame %.0f (%.3f segundos)", 
                                      last_analysis_result.downbeat_frame, last_analysis_result.downbeat_sec);
                    ImGui::BulletText("Índice de Energia Dinâmica (RMS): %.1f / 10.0 (%s)", 
                                      last_analysis_result.dynamic_energy_rating,
                                      (last_analysis_result.dynamic_energy_rating >= 8.0f ? "Peak Time / Máxima Intensidade" : 
                                      (last_analysis_result.dynamic_energy_rating >= 6.0f ? "Build-Up / Condução" : "Warm-Up / Abertura")));
                    ImGui::BulletText("Sub-Grave Fundamental (Kick): %.1f Hz", last_analysis_result.kick_fundamental_hz);

                    ImGui::Spacing();
                    ImGui::TextColored(ImVec4(0.3f, 1.0f, 0.6f, 1.0f), "✔ Beatgrid e metadados calibrados e salvos com sucesso na biblioteca!");
                    ImGui::Spacing();
                    ImGui::Separator();
                    ImGui::Spacing();

                    int left_id = ddj_hardware.getActiveLeftDeck();
                    int right_id = ddj_hardware.getActiveRightDeck();
                    char b_d1[32]; snprintf(b_d1, sizeof(b_d1), "CARREGAR NO DECK %d", left_id + 1);
                    if (ImGui::Button(b_d1, ImVec2(160, 28))) {
                        auto* tp = lib_mgr.getTrackById(last_analysis_result.track_id);
                        if (tp) spotify_service.loadLibraryTrack(*tp, left_id, engine);
                        show_analysis_result_modal = false;
                    }
                    ImGui::SameLine();
                    char b_d2[32]; snprintf(b_d2, sizeof(b_d2), "CARREGAR NO DECK %d", right_id + 1);
                    if (ImGui::Button(b_d2, ImVec2(160, 28))) {
                        auto* tp = lib_mgr.getTrackById(last_analysis_result.track_id);
                        if (tp) spotify_service.loadLibraryTrack(*tp, right_id, engine);
                        show_analysis_result_modal = false;
                    }
                    ImGui::SameLine();
                    if (ImGui::Button("OK / CONCLUÍDO", ImVec2(120, 28))) {
                        show_analysis_result_modal = false;
                    }
                    ImGui::EndPopup();
                }

                // Rodapé do Modal
                ImGui::Spacing();
                ImGui::TextColored(ImVec4(0.5f, 0.6f, 0.7f, 1.0f), "Dica: Clique com o botão direito em qualquer música para Reanálise Rekordbox, Edição ou Encaixe no Setlist.");
                ImGui::SameLine(ImGui::GetWindowWidth() - 110.0f);
                if (ImGui::Button("FECHAR", ImVec2(90, 24))) {
                    show_library_modal = false;
                }
            }
            ImGui::End();

            ImGui::PopStyleVar(2);
            ImGui::PopStyleColor(2);
        }
    };

} // namespace KuroUI
