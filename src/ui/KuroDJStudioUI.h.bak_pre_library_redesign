                    ImGui::TableSetupColumn("Vertente", ImGuiTableColumnFlags_WidthFixed, 115.0f);
                    ImGui::TableSetupColumn("BPM", ImGuiTableColumnFlags_WidthFixed, 55.0f);
                    ImGui::TableSetupColumn("Tom & Camelot", ImGuiTableColumnFlags_WidthFixed, 140.0f);
                    ImGui::TableSetupColumn("Duração", ImGuiTableColumnFlags_WidthFixed, 50.0f);
                    ImGui::TableSetupColumn("Carregar nos Decks", ImGuiTableColumnFlags_WidthFixed, 180.0f);
                    ImGui::TableHeadersRow();

                    for (int i = 0; i < (int)track_list.size(); i++) {
                        auto& t = track_list[i];
                        ImGui::TableNextRow();

                        int loaded_deck = -1;
                        for (int dd = 0; dd < 4; dd++) {
                            if (!engine.decks[dd].buffer_l.empty() && engine.decks[dd].track_title == t.title) { loaded_deck = dd; break; }
                        }
                        double row_dur = t.duration_sec;
                        if (loaded_deck >= 0 && engine.decks[loaded_deck].duration_sec > 1.0) row_dur = engine.decks[loaded_deck].duration_sec;

                        // 1. Capa
                        ImGui::TableSetColumnIndex(0);
                        GLuint tex_id = (GLuint)t.gl_tex_id;
                        if (tex_id == 0) {
                            std::string rgba_p = t.local_rgba_path;
                            if (rgba_p.empty()) {
                                auto candidate = KuroAudio::getTracksDirectory() / ("track_" + t.id + ".rgba");
                                std::error_code ec;
                                if (std::filesystem::exists(candidate, ec)) {
                                    rgba_p = candidate.string();
                                }
                            }
                            if (!rgba_p.empty()) {
                                tex_id = KuroAudio::SpotifyDJService::UploadRGBATexture(rgba_p);
                                if (tex_id != 0) {
                                    t.gl_tex_id = (unsigned int)tex_id;
                                    KuroAudio::DJLibraryManager::getInstance().setTrackTexture(t.id, (unsigned int)tex_id);
                                } else {
                                    t.gl_tex_id = 0xFFFFFFFF;
                                    KuroAudio::DJLibraryManager::getInstance().setTrackTexture(t.id, 0xFFFFFFFF);
                                }
                            } else {
                                t.gl_tex_id = 0xFFFFFFFF;
                                KuroAudio::DJLibraryManager::getInstance().setTrackTexture(t.id, 0xFFFFFFFF);
                            }
                        }
                        if (tex_id != 0 && tex_id != 0xFFFFFFFF) {
                            ImGui::Image((ImTextureID)(intptr_t)tex_id, ImVec2(26, 26));
                        } else {
                            ImGui::TextColored(ImVec4(0.40f, 0.55f, 0.70f, 1.0f), ICON_FA_COMPACT_DISC);
                        }

                        // 2. Título & Artista (com indicador de reprodução nos Decks)
                        ImGui::TableSetColumnIndex(1);
                        std::string sel_label = "##RowSelect_" + t.id;
                        bool is_sel = (selected_track_idx == i || context_track_id == t.id);
                        if (ImGui::Selectable(sel_label.c_str(), is_sel, ImGuiSelectableFlags_SpanAllColumns | ImGuiSelectableFlags_AllowOverlap, ImVec2(0, 22.0f))) {
                            selected_track_idx = i;
                            context_track_id = t.id;
                        }
                        if (ImGui::IsItemHovered()) {
                            side_drawer_ui.setHoveredTrack(t.id, t.key, t.bpm, t.title, t.artist);
                        }

                        // Arrastar e Soltar (Drag & Drop) da Biblioteca para os Decks
                        if (ImGui::BeginDragDropSource(ImGuiDragDropFlags_SourceAllowNullID)) {
                            ImGui::SetDragDropPayload("DND_DJ_TRACK_ID", t.id.c_str(), t.id.size() + 1);
                            ImGui::TextColored(ImVec4(0.0f, 0.95f, 1.0f, 1.0f), ICON_FA_COMPACT_DISC " %s", t.title.c_str());
                            ImGui::TextColored(ImVec4(0.7f, 0.8f, 0.9f, 1.0f), "• %s (%.1f BPM - %s)", t.artist.c_str(), t.bpm, t.key.c_str());
                            ImGui::EndDragDropSource();
                        }

                        // Duplo clique carrega no deck ativo/inativo
                        if (ImGui::IsItemHovered() && ImGui::IsMouseDoubleClicked(ImGuiMouseButton_Left)) {
                            int target_d = engine.decks[left_id].is_playing ? right_id : left_id;
                            if (t.is_downloaded) {
                                spotify_service.loadLibraryTrack(t, target_d, engine);
                            } else {
                                spotify_service.downloadLibraryTrackAsync(t, target_d, engine);
                            }
                        }

                        // Menu de Contexto Completo do Botão Direito em qualquer ponto da Linha
                        if (ImGui::BeginPopupContextItem(("TrackRowContext_" + t.id).c_str())) {
                            context_track_id = t.id;
                            selected_track_idx = i;

                            ImGui::TextColored(ImVec4(0.00f, 0.96f, 0.83f, 1.0f), ICON_FA_COMPACT_DISC " %s", t.title.c_str());
                            ImGui::TextColored(ImVec4(0.65f, 0.75f, 0.85f, 1.0f), "• %s (%s - %.1f BPM)", t.artist.c_str(), t.key.c_str(), t.bpm);
                            ImGui::Separator();

                            // 1. Editar Metadados (F2)
                            if (ImGui::MenuItem(ICON_FA_PEN_TO_SQUARE " Editar Metadados (F2)")) {
                                strncpy(edit_title_buf, t.title.c_str(), sizeof(edit_title_buf) - 1);
                                strncpy(edit_artist_buf, t.artist.c_str(), sizeof(edit_artist_buf) - 1);
                                edit_bpm = t.bpm;
                                strncpy(edit_key_buf, t.key.c_str(), sizeof(edit_key_buf) - 1);
                                strncpy(edit_subgenre_buf, t.subgenre.c_str(), sizeof(edit_subgenre_buf) - 1);
                                show_edit_meta_modal = true;
                            }

                            // 2. Copiar Faixa (Ctrl+C)
                            if (ImGui::MenuItem(ICON_FA_COPY " Copiar Faixa (Ctrl+C)")) {
                                clipboard_track = t;
                                has_clipboard_track = true;
                            }

                            // 3. Colar Faixa (Ctrl+V)
                            if (has_clipboard_track) {
                                std::string paste_txt = ICON_FA_PASTE " Colar Faixa Copiada: " + clipboard_track.title;
                                if (ImGui::MenuItem(paste_txt.c_str())) {
                                    clipboard_track.folder_id = lib_mgr.getActiveFolderId();
                                    lib_mgr.addOrUpdateTrack(clipboard_track);
                                }
                            }

                            // 4. Duplicar Faixa
                            if (ImGui::MenuItem(ICON_FA_CLONE " Duplicar Faixa")) {
                                lib_mgr.duplicateTrack(t.id);
                            }

                            // 5. Excluir da Biblioteca (Del)
                            if (ImGui::MenuItem(ICON_FA_TRASH_CAN " Excluir da Biblioteca (Del)")) {
                                show_delete_confirm_modal = true;
                            }

                            ImGui::Separator();

                            // 6. Carregar nos Decks
                            char m_l[48], m_r[48];
                            snprintf(m_l, sizeof(m_l), ICON_FA_ARROW_DOWN " Carregar no Deck %d", left_id + 1);
                            snprintf(m_r, sizeof(m_r), ICON_FA_ARROW_DOWN " Carregar no Deck %d", right_id + 1);
                            if (ImGui::MenuItem(m_l)) {
                                if (t.is_downloaded) spotify_service.loadLibraryTrack(t, left_id, engine);
                                else spotify_service.downloadLibraryTrackAsync(t, left_id, engine);
                            }
                            if (ImGui::MenuItem(m_r)) {
                                if (t.is_downloaded) spotify_service.loadLibraryTrack(t, right_id, engine);
                                else spotify_service.downloadLibraryTrackAsync(t, right_id, engine);
                            }

                            // 7. Preview no Fone de Ouvido
                            if (ImGui::MenuItem(ICON_FA_HEADPHONES " Ouvir no Fone (Preview)")) {
                                std::string src = t.local_wav_path;
                                if (src.empty()) src = t.preview_url;
                                KuroAudio::DJPreviewPlayer::getInstance().play(src, t.id, t.title, t.artist);
                            }

                            // 8. Trocar Fonte / Versão Limpa no Kuro Cloud
                            if (ImGui::MenuItem(ICON_FA_SATELLITE_DISH " Trocar Fonte / Versão Limpa (Kuro Cloud)")) {
                                spotify_service.searchSourcesAsync(t.id, t.title, t.artist);
                            }

                            // 9. Mostrar no Windows Explorer
                            if (ImGui::MenuItem(ICON_FA_FOLDER_OPEN " Mostrar no Windows Explorer")) {
                                std::string p_show = t.local_wav_path;
                                if (p_show.empty()) p_show = KuroAudio::getTracksDirectory().string();
                                std::string cmd = "explorer.exe /select,\"" + p_show + "\"";
                                system(cmd.c_str());
                            }

                            ImGui::Separator();

                            // 10. Mover para Pasta
                            if (ImGui::BeginMenu("Mover para Pasta")) {
                                for (const auto& fo : folders) {
                                    if (ImGui::MenuItem(fo.name.c_str())) {
                                        lib_mgr.moveTrackToFolder(t.id, fo.id);
                                    }
                                }
                                ImGui::EndMenu();
                            }

                            // 11. Alterar Vertente
                            if (ImGui::BeginMenu("Alterar Vertente")) {
                                const char* genres[] = { "Progressive Psytrance", "Psytrance / Full-On", "Tech House", "Acid Techno", "Melodic Techno" };
                                for (const char* g : genres) {
                                    if (ImGui::MenuItem(g)) {
                                        lib_mgr.setTrackSubgenre(t.id, g);
                                    }
                                }
                                ImGui::EndMenu();
                            }

                            ImGui::EndPopup();
                        }

                        // Texto do Título & Artista (renderizado sobre a linha selecionável)
                        ImGui::SameLine(0, 4);
                        ImGui::TextColored(ImVec4(1.0f, 1.0f, 1.0f, 1.0f), "%s", t.title.c_str());
                        ImGui::SameLine();
                        ImGui::TextColored(ImVec4(0.55f, 0.65f, 0.75f, 1.0f), "• %s", t.artist.c_str());

                        if (loaded_deck >= 0) {
                            static const ImVec4 deck_cols[4] = { ImVec4(0.00f,0.95f,1.00f,1.0f), ImVec4(1.00f,0.65f,0.00f,1.0f), ImVec4(0.30f,0.55f,1.00f,1.0f), ImVec4(1.00f,0.25f,0.85f,1.0f) };
                            ImGui::SameLine(0, 6);
                            ImGui::TextColored(deck_cols[loaded_deck], "[DECK %d]", loaded_deck + 1);
                        }
                        if (t.has_played) {
                            ImGui::SameLine(0, 6);
                            ImGui::TextColored(ImVec4(0.30f, 1.00f, 0.45f, 1.0f), "[TOCADA]");
                        }

                        // 3. Vertente
                        ImGui::TableSetColumnIndex(2);
                        ImVec4 sg_col = ImVec4(0.80f, 0.85f, 0.90f, 1.0f);
                        if (t.subgenre.find("Progressive Psy") != std::string::npos) sg_col = ImVec4(0.00f, 0.96f, 0.83f, 1.0f);
                        else if (t.subgenre.find("Psytrance") != std::string::npos)  sg_col = ImVec4(0.85f, 0.40f, 1.00f, 1.0f);
                        else if (t.subgenre.find("Tech House") != std::string::npos) sg_col = ImVec4(1.00f, 0.75f, 0.20f, 1.0f);
                        else if (t.subgenre.find("Acid") != std::string::npos)       sg_col = ImVec4(0.25f, 1.00f, 0.45f, 1.0f);
                        else if (t.subgenre.find("Melodic") != std::string::npos)    sg_col = ImVec4(0.40f, 0.75f, 1.00f, 1.0f);

                        ImGui::TextColored(sg_col, "%s", t.subgenre.c_str());

                        // 4. BPM
                        ImGui::TableSetColumnIndex(3);
                        ImGui::TextColored(col_deck_1, "%.1f", t.bpm);

                        // 5. Tom & Camelot com Badge Harmônico
                        ImGui::TableSetColumnIndex(4);
                        KuroAudio::CamelotKey trk_ck = KuroAudio::DJHarmonicEngine::parseKey(t.key);
                        unsigned int w_col = KuroAudio::DJHarmonicEngine::getCamelotWheelColor(trk_ck.number);
                        unsigned int b_col = KuroAudio::DJHarmonicEngine::getCompatibilityBadgeColor(ref_key, t.key);
                        std::string b_txt = KuroAudio::DJHarmonicEngine::getCompatibilityBadgeText(ref_key, t.key);

                        ImGui::PushStyleColor(ImGuiCol_Text, (ImU32)w_col);
                        ImGui::Text("%s", trk_ck.getCamelotCode().c_str());
                        ImGui::PopStyleColor();

                        ImGui::SameLine(0, 4);
                        ImGui::PushStyleColor(ImGuiCol_Text, (ImU32)b_col);
                        ImGui::Text("[%s]", b_txt.c_str());
                        ImGui::PopStyleColor();

                        if (ImGui::IsItemHovered()) {
                            ImGui::SetTooltip("Tom: %s | Camelot: %s (%s)\nCompatibilidade com Deck %d (%s): %s", 
                                              t.key.c_str(), trk_ck.getCamelotCode().c_str(), trk_ck.musical_key.c_str(), 
                                              (engine.decks[left_id].is_playing.load() ? left_id + 1 : right_id + 1), ref_key.c_str(), b_txt.c_str());
                        }

                        // 6. Duração
                        ImGui::TableSetColumnIndex(5);
                        int min = (int)row_dur / 60;
                        int sec = (int)row_dur % 60;
                        ImGui::TextColored(ImVec4(0.70f, 0.70f, 0.70f, 1.0f), "%02d:%02d", min, sec);

                        // 7. Ações Carregar & Touch Preview Fone
                        ImGui::TableSetColumnIndex(6);
                        ImGui::PushID(i);
                        auto& safety = KuroAudio::DJLiveSafety::getInstance();

                        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.00f, 0.45f, 0.55f, 0.85f));
                        char btn_l[32];
                        snprintf(btn_l, sizeof(btn_l), ICON_FA_ARROW_DOWN " DECK %d", left_id + 1);
                        if (ImGui::SmallButton(t.is_downloading ? "Baixando..." : btn_l)) {
                            if (!safety.canLoadTrack(engine.decks[left_id])) {
                                KuroUtils::Log("[LIVE SAFETY] Carga bloqueada no Deck " + std::to_string(left_id + 1) + ": Deck tocando com volume aberto na pista!");
                            } else {
                                if (t.is_downloaded) {
                                    spotify_service.loadLibraryTrack(t, left_id, engine);
                                } else {
                                    spotify_service.downloadLibraryTrackAsync(t, left_id, engine);
                                }
                            }
                        }
                        ImGui::PopStyleColor();

                        ImGui::SameLine(0, 4);

                        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.55f, 0.28f, 0.00f, 0.85f));
                        char btn_r[32];
                        snprintf(btn_r, sizeof(btn_r), ICON_FA_ARROW_DOWN " DECK %d", right_id + 1);
                        if (ImGui::SmallButton(t.is_downloading ? "Baixando..." : btn_r)) {
                            if (!safety.canLoadTrack(engine.decks[right_id])) {
                                KuroUtils::Log("[LIVE SAFETY] Carga bloqueada no Deck " + std::to_string(right_id + 1) + ": Deck tocando com volume aberto na pista!");
                            } else {
                                if (t.is_downloaded) {
                                    spotify_service.loadLibraryTrack(t, right_id, engine);
                                } else {
                                    spotify_service.downloadLibraryTrackAsync(t, right_id, engine);
                                }
                            }
                        }
                        ImGui::PopStyleColor();

                        ImGui::SameLine(0, 4);

                        // Touch Preview (Pioneer CDJ-3000): Pré-escuta no fone CUE sem carregar
                        auto& touch_cue = KuroAudio::DJTouchPreviewCue::getInstance();
                        bool is_prev = touch_cue.isTouchPreviewActive() && (touch_cue.getPreviewTrackId() == t.id);
                        ImGui::PushStyleColor(ImGuiCol_Button, is_prev ? ImVec4(0.0f, 0.95f, 0.5f, 0.95f) : ImVec4(0.14f, 0.18f, 0.24f, 0.85f));
                        ImGui::PushStyleColor(ImGuiCol_Text, is_prev ? ImVec4(0, 0, 0, 1) : ImVec4(0.8f, 0.9f, 1.0f, 1.0f));
                        char btn_prev[32]; snprintf(btn_prev, sizeof(btn_prev), "%s##Prev_%d", is_prev ? "■" : "▶ FONE", (int)i);
                        if (ImGui::SmallButton(btn_prev)) {
                            if (is_prev) {
                                touch_cue.stopTouchPreview();
                            } else {
                                std::string src = t.local_wav_path;
                                if (src.empty()) src = t.preview_url;
                                touch_cue.startTouchPreview(src, t.id, t.title);
                            }
                        }
                        if (ImGui::IsItemHovered()) ImGui::SetTooltip("Touch Preview (Pioneer CDJ-3000): Pré-escutar faixa instantaneamente nos fones de ouvido");
                        ImGui::PopStyleColor(2);

                        ImGui::PopID();
                    }
                    // Menu de Contexto ao Clicar com Botão Direito na Área Vazia da Tabela
                    if (ImGui::BeginPopupContextWindow("BibliotecaWindowContext", ImGuiPopupFlags_MouseButtonRight | ImGuiPopupFlags_NoOpenOverItems)) {
                        ImGui::TextColored(ImVec4(0.00f, 0.95f, 0.85f, 1.0f), ICON_FA_BOOK " BIBLIOTECA MUSICAL");
                        ImGui::Separator();
                        if (has_clipboard_track) {
                            std::string paste_txt = ICON_FA_PASTE " Colar Faixa: " + clipboard_track.title + " (Ctrl+V)";
                            if (ImGui::MenuItem(paste_txt.c_str())) {
                                clipboard_track.folder_id = lib_mgr.getActiveFolderId();
                                lib_mgr.addOrUpdateTrack(clipboard_track);
                            }
                        } else {
                            ImGui::TextDisabled(ICON_FA_PASTE " Colar Faixa (Nenhuma copiada)");
                        }
                        if (ImGui::MenuItem(ICON_FA_FOLDER_PLUS " Nova Pasta na Biblioteca")) {
                            show_new_folder_dialog = true;
                        }
                        if (ImGui::MenuItem(ICON_FA_FOLDER_OPEN " Abrir Pasta de Músicas no Explorer")) {
                            system("start explorer.exe scratch\\tracks");
                        }
                        ImGui::EndPopup();
                    }

                    ImGui::EndTable();
                }
            }

            ImGui::EndChild();

            // Atalhos de Teclado no Modo DJ para a Biblioteca (Ctrl+C, Ctrl+V, Del, F2)
            if (ImGui::IsWindowHovered(ImGuiHoveredFlags_RootAndChildWindows)) {
                // Ctrl+C: Copiar
                if (ImGui::GetIO().KeyCtrl && ImGui::IsKeyPressed(ImGuiKey_C)) {
                    if (!context_track_id.empty()) {
                        auto* p = lib_mgr.getTrackById(context_track_id);
                        if (p) {
                            clipboard_track = *p;
                            has_clipboard_track = true;
                        }
                    }
                }
                // Ctrl+V: Colar
                if (ImGui::GetIO().KeyCtrl && ImGui::IsKeyPressed(ImGuiKey_V) && has_clipboard_track) {
                    clipboard_track.folder_id = lib_mgr.getActiveFolderId();
                    lib_mgr.addOrUpdateTrack(clipboard_track);
                }
                // Del: Excluir
                if (ImGui::IsKeyPressed(ImGuiKey_Delete)) {
                    if (!context_track_id.empty()) {
                        show_delete_confirm_modal = true;
                    }
                }
                // F2: Editar Metadados
                if (ImGui::IsKeyPressed(ImGuiKey_F2)) {
                    if (!context_track_id.empty()) {
                        auto* p = lib_mgr.getTrackById(context_track_id);
                        if (p) {
                            strncpy(edit_title_buf, p->title.c_str(), sizeof(edit_title_buf)-1);
                            strncpy(edit_artist_buf, p->artist.c_str(), sizeof(edit_artist_buf)-1);
                            edit_bpm = p->bpm;
                            strncpy(edit_key_buf, p->key.c_str(), sizeof(edit_key_buf)-1);
                            strncpy(edit_subgenre_buf, p->subgenre.c_str(), sizeof(edit_subgenre_buf)-1);
                            show_edit_meta_modal = true;
                        }
                    }
                }
            }

            // Modal Criar Nova Pasta
            if (show_new_folder_dialog) {
                ImGui::OpenPopup("Nova Pasta DJ##Modal");
            }
            if (ImGui::BeginPopupModal("Nova Pasta DJ##Modal", &show_new_folder_dialog, ImGuiWindowFlags_AlwaysAutoResize)) {
                ImGui::TextColored(ImVec4(0.00f, 0.96f, 0.83f, 1.0f), ICON_FA_FOLDER_PLUS " Criar Nova Pasta na Biblioteca");
                ImGui::Text("Digite o nome da pasta para organizar suas faixas:");
                ImGui::SetNextItemWidth(260);
                ImGui::InputText("##NewCrateNameInput", new_folder_name_buf, sizeof(new_folder_name_buf));
                ImGui::Spacing();
                if (ImGui::Button("Criar Pasta", ImVec2(120, 0))) {
                    if (strlen(new_folder_name_buf) > 0) {
                        KuroAudio::DJLibraryManager::getInstance().createCustomFolder(new_folder_name_buf);
                        new_folder_name_buf[0] = '\0';
                        show_new_folder_dialog = false;
                    }
                }
                ImGui::SameLine();
                if (ImGui::Button("Cancelar", ImVec2(100, 0))) {
                    show_new_folder_dialog = false;
                }
                ImGui::EndPopup();
            }

            ImGui::EndChild();
            ImGui::PopStyleVar();
            ImGui::PopStyleColor(2);
        }

        
        // =========================================================================
        // REKORDBOX 7 OFICIAL 1:1 VISUAL ENGINE (PERFORMANCE MODE 2-DECKS)
        // =========================================================================

        void renderRekordboxTopBar(KuroAudio::DJEngine& engine, bool* p_open) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();
            float w = ImGui::GetContentRegionAvail().x;
            float h = KuroUI::UIScaleManager::Scale(26.0f);

            // Fundo Sleek Obsidian #0c0f14 com linha divisoria inferior #1a222d
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(12, 15, 20, 255));
            dl->AddLine(ImVec2(pos.x, pos.y + h - 1.0f), ImVec2(pos.x + w, pos.y + h - 1.0f), IM_COL32(26, 34, 45, 255), 1.0f);

            // ── Helper para Capsulas Profissionais de Hardware ──────────────────
            auto capsuleBtn = [&](const char* id, const char* label, bool active, ImU32 act_border, ImU32 act_text, const char* tooltip, auto on_click) {
                ImVec2 b_pos = ImGui::GetCursorScreenPos();
                ImVec2 t_sz = ImGui::CalcTextSize(label);
                float bw = std::max(28.0f, t_sz.x + 12.0f);
                float bh = 20.0f;
                
                ImU32 bg_col = active ? IM_COL32(18, 24, 34, 255) : IM_COL32(14, 17, 22, 220);
                ImU32 border_col = active ? act_border : IM_COL32(32, 40, 52, 180);
                ImU32 text_col = active ? act_text : IM_COL32(150, 165, 185, 230);
                
                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + bw, b_pos.y + bh), bg_col, 4.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + bw, b_pos.y + bh), border_col, 4.0f, 0, active ? 1.5f : 1.0f);
                if (active) {
                    dl->AddRect(ImVec2(b_pos.x - 1, b_pos.y - 1), ImVec2(b_pos.x + bw + 1, b_pos.y + bh + 1), 
                                (act_border & 0x00FFFFFF) | 0x25000000, 5.0f, 0, 1.0f);
                }
                dl->AddText(ImVec2(b_pos.x + (bw - t_sz.x) * 0.5f, b_pos.y + (bh - t_sz.y) * 0.5f), text_col, label);

                ImGui::InvisibleButton(id, ImVec2(bw, bh));
                if (ImGui::IsItemClicked(0)) on_click();
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("%s", tooltip);
                ImGui::SameLine(0, 4.0f);
            };

            // ── 1. ALA ESQUERDA: CAPSULAS DE WORKSPACE ──────────────────────────
            ImGui::SetCursorScreenPos(ImVec2(pos.x + 6.0f, pos.y + 3.0f));

            // [PERFORMANCE]
            bool is_perf = (rekordbox_app_mode == 0);
            capsuleBtn("##TopCapsulePerf", "PERFORMANCE", is_perf, IM_COL32(0, 229, 255, 255), IM_COL32(235, 250, 255, 255),
                       "Modo PERFORMANCE: Mixagem ao vivo profissional multi-deck e waveforms stacked", [&]() {
                rekordbox_app_mode = (rekordbox_app_mode == 0 ? 1 : 0);
                if (rekordbox_app_mode == 1) {
                    show_playlist_drawer = true;
                    show_export_modal = true;
                } else {
                    show_export_modal = false;
                }
            });

