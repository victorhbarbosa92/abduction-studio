        // =========================================================================
        // PIONEER CDJ-3000 / REKORDBOX DUAL PHASE METER (4-BAR / 16-BEAT & ZERO PHASE NEEDLE)
        // =========================================================================
        void renderCDJ3000PhaseMeter(KuroAudio::DJEngine& engine, float w, float h) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();

            int left_id = ddj_hardware.getActiveLeftDeck();
            int right_id = ddj_hardware.getActiveRightDeck();
            KuroAudio::DJDeck& deck_l = engine.decks[left_id];
            KuroAudio::DJDeck& deck_r = engine.decks[right_id];

            ImU32 col_bg = IM_COL32(5, 7, 11, 240);
            ImU32 col_border_u32 = IM_COL32(22, 32, 46, 220);

            // Fundo da barra do Phase Meter
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), col_bg, 4.0f);
            dl->AddRect(pos, ImVec2(pos.x + w, pos.y + h), col_border_u32, 4.0f, 0, 1.0f);

            float center_x = pos.x + w * 0.5f;

            // Largura do Zero Phase Indicator central
            float center_meter_w = KuroUI::UIScaleManager::Scale(160.0f);
            float lane_w = (w - center_meter_w - 24.0f) * 0.5f;

            // --- DECK ESQUERDO: 4 BARS / 16 BEATS SEGMENTADOS (CIANO) ---
            int bar_l = 1, beat_l = 1;
            float prog_l = 0.0f;
            deck_l.getBeatPhaseInfo(bar_l, beat_l, prog_l);

            ImVec4 theme_l = (left_id == 0 ? col_deck_1 : col_deck_3);
            ImU32 col_l_bright = ImGui::GetColorU32(theme_l);
            ImU32 col_l_dim = IM_COL32(12, 36, 48, 180);

            float start_lx = pos.x + 8.0f;
            char lbl_l[48];
            snprintf(lbl_l, sizeof(lbl_l), "DECK %d  BAR %02d.%d", left_id + 1, bar_l, beat_l);
            dl->AddText(ImVec2(start_lx, pos.y + 3.0f), col_l_bright, lbl_l);

            // 16 blocos (4 compassos de 4 batidas)
            float blocks_y = pos.y + h - 13.0f;
            float block_h = 7.0f;
            float block_gap = 2.0f;
            float bar_gap = 5.0f;
            float total_gaps = (12 * block_gap) + (3 * bar_gap);
            float single_block_w = (lane_w - total_gaps) / 16.0f;

            float cur_bx = start_lx;
            for (int b = 0; b < 16; b++) {
                int this_bar = (b / 4) + 1;
                int this_beat = (b % 4) + 1;
                bool is_current = (deck_l.is_playing.load() && this_bar == bar_l && this_beat == beat_l);
                bool is_past = (this_bar < bar_l) || (this_bar == bar_l && this_beat < beat_l);

                ImU32 b_col = is_current ? col_l_bright : (is_past ? IM_COL32(0, 140, 180, 200) : col_l_dim);
                if (is_current) {
                    dl->AddRectFilled(ImVec2(cur_bx - 1, blocks_y - 2), ImVec2(cur_bx + single_block_w + 1, blocks_y + block_h + 2), IM_COL32(0, 255, 255, 90), 2.0f);
                }
                dl->AddRectFilled(ImVec2(cur_bx, blocks_y), ImVec2(cur_bx + single_block_w, blocks_y + block_h), b_col, 1.0f);

                cur_bx += single_block_w + block_gap;
                if ((b + 1) % 4 == 0) cur_bx += (bar_gap - block_gap);
            }

            // --- CENTRO: ZERO PHASE SYNC NEEDLE (PIONEER CDJ-3000) ---
            float c_box_left = center_x - center_meter_w * 0.5f;
            float c_box_right = center_x + center_meter_w * 0.5f;
            dl->AddRectFilled(ImVec2(c_box_left, pos.y + 3.0f), ImVec2(c_box_right, pos.y + h - 3.0f), IM_COL32(8, 12, 18, 255), 3.0f);
            dl->AddRect(ImVec2(c_box_left, pos.y + 3.0f), ImVec2(c_box_right, pos.y + h - 3.0f), IM_COL32(30, 44, 60, 200), 3.0f, 0, 1.0f);

            // Linha central ZERO
            dl->AddLine(ImVec2(center_x, pos.y + 4.0f), ImVec2(center_x, pos.y + h - 4.0f), IM_COL32(90, 110, 135, 180), 1.0f);

            // Indicador de Defasagem de Fase
            float phase_diff = deck_r.sync_phase_diff; // -0.5 a +0.5
            if (left_id == engine.getMasterDeckId()) {
                phase_diff = deck_r.sync_phase_diff;
            } else if (right_id == engine.getMasterDeckId()) {
                phase_diff = -deck_l.sync_phase_diff;
            }

            bool in_phase = (std::abs(phase_diff) < 0.04f);
            bool both_playing = (deck_l.is_playing.load() && deck_r.is_playing.load());

            if (both_playing) {
                float max_deflection = (center_meter_w * 0.5f) - 10.0f;
                float needle_x = center_x + std::clamp(phase_diff * 2.0f, -1.0f, 1.0f) * max_deflection;

                if (in_phase) {
                    float pulse = (std::sin((float)ImGui::GetTime() * 12.0f) + 1.0f) * 0.5f;
                    ImU32 col_green_neon = IM_COL32(0, 255, 140, 255);
                    dl->AddRectFilled(ImVec2(needle_x - 3.0f, pos.y + 5.0f), ImVec2(needle_x + 3.0f, pos.y + h - 5.0f), col_green_neon, 2.0f);
                    dl->AddRect(ImVec2(needle_x - 6.0f, pos.y + 4.0f), ImVec2(needle_x + 6.0f, pos.y + h - 4.0f), IM_COL32(0, 255, 140, (int)(80 + pulse * 100)), 3.0f, 0, 1.5f);
                    const char* txt = "IN PHASE";
                    ImVec2 t_sz = ImGui::CalcTextSize(txt);
                    dl->AddText(ImVec2(center_x - t_sz.x * 0.5f, pos.y + 4.0f), col_green_neon, txt);
                } else {
                    ImU32 col_warn = IM_COL32(255, 170, 0, 255);
                    dl->AddRectFilled(ImVec2(needle_x - 2.5f, pos.y + 6.0f), ImVec2(needle_x + 2.5f, pos.y + h - 6.0f), col_warn, 2.0f);
                    char diff_str[24];
                    snprintf(diff_str, sizeof(diff_str), "%+.2f BEAT", phase_diff);
                    ImVec2 t_sz = ImGui::CalcTextSize(diff_str);
                    dl->AddText(ImVec2(center_x - t_sz.x * 0.5f, pos.y + 4.0f), col_warn, diff_str);
                }
            } else {
                const char* txt = "BEAT PHASE";
                ImVec2 t_sz = ImGui::CalcTextSize(txt);
                dl->AddText(ImVec2(center_x - t_sz.x * 0.5f, pos.y + 4.0f), IM_COL32(110, 135, 165, 200), txt);
                dl->AddCircleFilled(ImVec2(center_x, pos.y + h - 9.0f), 2.5f, IM_COL32(60, 80, 105, 220));
            }

            // --- DECK DIREITO: 4 BARS / 16 BEATS SEGMENTADOS (ÂMBAR) ---
            int bar_r = 1, beat_r = 1;
            float prog_r = 0.0f;
            deck_r.getBeatPhaseInfo(bar_r, beat_r, prog_r);

            ImVec4 theme_r = (right_id == 1 ? col_deck_2 : col_deck_4);
            ImU32 col_r_bright = ImGui::GetColorU32(theme_r);
            ImU32 col_r_dim = IM_COL32(48, 32, 10, 180);

            float start_rx = c_box_right + 8.0f;
            char lbl_r[48];
            snprintf(lbl_r, sizeof(lbl_r), "DECK %d  BAR %02d.%d", right_id + 1, bar_r, beat_r);
            dl->AddText(ImVec2(start_rx, pos.y + 3.0f), col_r_bright, lbl_r);

            cur_bx = start_rx;
            for (int b = 0; b < 16; b++) {
                int this_bar = (b / 4) + 1;
                int this_beat = (b % 4) + 1;
                bool is_current = (deck_r.is_playing.load() && this_bar == bar_r && this_beat == beat_r);
                bool is_past = (this_bar < bar_r) || (this_bar == bar_r && this_beat < beat_r);

                ImU32 b_col = is_current ? col_r_bright : (is_past ? IM_COL32(200, 120, 0, 200) : col_r_dim);
                if (is_current) {
                    dl->AddRectFilled(ImVec2(cur_bx - 1, blocks_y - 2), ImVec2(cur_bx + single_block_w + 1, blocks_y + block_h + 2), IM_COL32(255, 160, 0, 90), 2.0f);
                }
                dl->AddRectFilled(ImVec2(cur_bx, blocks_y), ImVec2(cur_bx + single_block_w, blocks_y + block_h), b_col, 1.0f);

                cur_bx += single_block_w + block_gap;
                if ((b + 1) % 4 == 0) cur_bx += (bar_gap - block_gap);
            }

            ImGui::Dummy(ImVec2(w, h));
        }

