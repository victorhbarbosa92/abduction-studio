        void renderMiniOverviewStrip(KuroAudio::DJDeck& deck, float w, float h, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();

            // 1. Chassi escuro estilo Pioneer CDJ-3000 / Rekordbox Overview #0a0d12
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(8, 10, 14, 255), 2.0f);
            dl->AddRect(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(24, 30, 42, 220), 2.0f, 0, 1.0f);

            // Baseline no fundo inferior (Padrão 1:1 Rekordbox - Sobe apenas no eixo +)
            float base_y = pos.y + h - 2.5f;
            dl->AddLine(ImVec2(pos.x, base_y), ImVec2(pos.x + w, base_y), IM_COL32(32, 42, 58, 255), 1.0f);

            double duration = deck.duration_sec;
            double cur_pos_sec = (deck.sample_rate > 0.0) ? (deck.current_frame / deck.sample_rate) : 0.0;
            float play_norm = (duration > 0.0) ? (float)std::clamp(cur_pos_sec / duration, 0.0, 1.0) : 0.0f;
            float play_x = pos.x + play_norm * w;

            // 2. Ticks discretos de minutos na linha de base Rekordbox (1m, 2m, 3m...)
            if (duration > 30.0) {
                int total_mins = (int)(duration / 60.0);
                for (int m = 1; m <= total_mins; m++) {
                    float tick_x = pos.x + (float)((m * 60.0) / duration) * w;
                    if (tick_x >= pos.x + 2.0f && tick_x <= pos.x + w - 2.0f) {
                        dl->AddLine(ImVec2(tick_x, base_y - 2.5f), ImVec2(tick_x, base_y + 1.5f), IM_COL32(95, 115, 145, 200), 1.0f);
                    }
                }
            }

            // 3. Região Sombreada de Loop Ativo (Âmbar translúcido ancorado na linha de base)
            if (deck.loop_active && deck.loop_length_frames > 0 && duration > 0.0) {
                double l_start_sec = deck.loop_start_frame / deck.sample_rate;
                double l_end_sec = (deck.loop_start_frame + deck.loop_length_frames) / deck.sample_rate;
                float lx1 = pos.x + (float)std::clamp(l_start_sec / duration, 0.0, 1.0) * w;
                float lx2 = pos.x + (float)std::clamp(l_end_sec / duration, 0.0, 1.0) * w;
                if (lx2 - lx1 < 2.0f) lx2 = lx1 + 2.0f;
                dl->AddRectFilled(ImVec2(lx1, pos.y + 1.0f), ImVec2(lx2, base_y), IM_COL32(255, 170, 0, 75));
                dl->AddLine(ImVec2(lx1, pos.y + 1.0f), ImVec2(lx1, base_y), IM_COL32(255, 190, 30, 240), 1.5f);
                dl->AddLine(ImVec2(lx2, pos.y + 1.0f), ImVec2(lx2, base_y), IM_COL32(255, 190, 30, 240), 1.5f);
            }

            // 4. Waveform 3-Band Rekordbox Unipolar (Sobe apenas no eixo + de base_y para cima)
            deck.generateDetailedWaveformIfNeeded();
            size_t detailed_sz = deck.detailed_waveform.size();
            size_t peaks_sz = deck.overview_peaks.size();

            if (detailed_sz > 0 || peaks_sz > 0) {
                float max_h_amp = h - 4.5f;

                for (float x = pos.x; x < pos.x + w; x += 1.0f) {
                    float norm_x = (x - pos.x) / w;
                    double t_sec = norm_x * duration;
                    bool is_past = (t_sec < cur_pos_sec);
                    float dim_factor = is_past ? 0.48f : 1.0f; // Atenuação do trecho já tocado padrão Rekordbox

                    float p_tot = 0.0f, l = 0.0f, m = 0.0f, hi = 0.0f;

                    if (detailed_sz > 0) {
                        size_t d_idx = (size_t)std::clamp((double)norm_x * (double)detailed_sz, 0.0, (double)(detailed_sz - 1));
                        const auto& pt = deck.detailed_waveform[d_idx];
                        p_tot = pt.peak;
                        l = pt.low;
                        m = pt.mid;
                        hi = pt.high;
                    } else if (peaks_sz > 0) {
                        size_t p_idx = (size_t)std::clamp((double)norm_x * (double)peaks_sz, 0.0, (double)(peaks_sz - 1));
                        p_tot = deck.overview_peaks[p_idx];
                        l = (p_idx < deck.overview_low.size()) ? deck.overview_low[p_idx] : 0.0f;
                        m = (p_idx < deck.overview_mid.size()) ? deck.overview_mid[p_idx] : 0.0f;
                        hi = (p_idx < deck.overview_high.size()) ? deck.overview_high[p_idx] : 0.0f;
                    }

                    if (p_tot < 0.003f) {
                        continue;
                    }

                    float p_shaped = std::pow(std::clamp(p_tot, 0.0f, 1.0f), 0.88f);
                    float val = std::clamp(p_shaped * max_h_amp, 1.0f, max_h_amp);

                    ImU32 col_line, col_core;
                    computeRekordboxRGB(waveform_color_mode, l, m, hi, p_tot, dim_factor, col_line, col_core);

                    // Padrão Rekordbox: Sobe apenas no eixo + a partir da linha de base
                    dl->AddLine(ImVec2(x, base_y), ImVec2(x, base_y - val), col_line, 1.0f);

                    // Núcleo brilhante (Luminous highlight Rekordbox)
                    float core_v = val * 0.45f;
                    if (core_v >= 1.0f) {
                        dl->AddLine(ImVec2(x, base_y), ImVec2(x, base_y - core_v), col_core, 1.0f);
                    }
                }
            }

            // 5. Marcadores de Hot Cues (A-H) e Memory Cues
            for (int c = 0; c < 8; c++) {
                if (deck.hot_cues[c].active && duration > 0.0) {
                    float cue_x = pos.x + (float)(deck.hot_cues[c].time_sec / duration) * w;
                    if (cue_x >= pos.x && cue_x <= pos.x + w) {
                        ImU32 c_col = deck.hot_cues[c].color_rgba;
                        dl->AddLine(ImVec2(cue_x, pos.y), ImVec2(cue_x, base_y), c_col, 1.2f);
                        // Triângulo indicador na barra superior
                        dl->AddTriangleFilled(ImVec2(cue_x - 3.0f, pos.y), ImVec2(cue_x + 3.0f, pos.y), ImVec2(cue_x, pos.y + 4.5f), c_col);
                    }
                }
            }

            // Memory Cues (ticks vermelhos / âmbar)
            for (const auto& mc : deck.memory_cues) {
                if (duration > 0.0) {
                    float mx = pos.x + (float)(mc.time_sec / duration) * w;
                    if (mx >= pos.x && mx <= pos.x + w) {
                        dl->AddTriangleFilled(ImVec2(mx - 2.5f, pos.y), ImVec2(mx + 2.5f, pos.y), ImVec2(mx, pos.y + 3.5f), mc.color);
                    }
                }
            }

            // 6. Playhead Needle (Padrão Oficial Rekordbox: Linha Branca Vertical + Triângulo Laranja Apontando para Cima)
            if (duration > 0.0) {
                float px = std::clamp(play_x, pos.x, pos.x + w);
                // Linha vertical branca
                dl->AddLine(ImVec2(px, pos.y), ImVec2(px, base_y), IM_COL32(255, 255, 255, 255), 1.0f);
                // Triângulo laranja apontando para cima na linha de base (Rekordbox Image 2)
                dl->AddTriangleFilled(ImVec2(px, base_y - 6.5f), ImVec2(px - 3.5f, base_y + 1.5f), ImVec2(px + 3.5f, base_y + 1.5f), IM_COL32(255, 140, 0, 255));

                // Ghost Playhead no Overview Strip (Posição virtual em avanço de Slip Mode)
                if (deck.is_slipping && deck.sample_rate > 1000.0) {
                    float g_px = pos.x + (float)((deck.slip_virtual_frame / deck.sample_rate) / duration) * w;
                    g_px = std::clamp(g_px, pos.x, pos.x + w);
                    float pulse = (std::sin((float)ImGui::GetTime() * 14.0f) + 1.0f) * 0.5f;
                    ImU32 g_col = (deck.deck_id == 0) ? IM_COL32(0, 245, 212, (int)(180 + pulse * 75)) : IM_COL32(255, 170, 0, (int)(180 + pulse * 75));
                    ImU32 g_fill = (deck.deck_id == 0) ? IM_COL32(0, 220, 255, (int)(40 + pulse * 30)) : IM_COL32(255, 140, 0, (int)(40 + pulse * 30));

                    // Faixa sombreada conectando playhead atual ao ghost no overview
                    float rx1 = std::min(px, g_px);
                    float rx2 = std::max(px, g_px);
                    if (rx2 - rx1 > 1.0f) {
                        dl->AddRectFilled(ImVec2(rx1, pos.y), ImVec2(rx2, base_y), g_fill);
                    }

                    // Linha e triângulo holográfico fantasma no topo
                    dl->AddLine(ImVec2(g_px, pos.y), ImVec2(g_px, base_y), g_col, 1.5f);
                    dl->AddTriangleFilled(ImVec2(g_px, pos.y + 6.0f), ImVec2(g_px - 3.5f, pos.y), ImVec2(g_px + 3.5f, pos.y), g_col);
                }
            }


            // 7. Needle Search Interativo (Clique ou Arraste Contínuo de Busca)
            char strip_btn_id[32];
            snprintf(strip_btn_id, sizeof(strip_btn_id), "##NeedleSearchStrip_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(pos);
            ImGui::InvisibleButton(strip_btn_id, ImVec2(w, h));

            bool strip_active = ImGui::IsItemActive();
            bool strip_clicked = ImGui::IsItemClicked(0);
            bool strip_hovered = ImGui::IsItemHovered();

            if ((strip_active || strip_clicked) && duration > 0.0) {
                float mouse_x = ImGui::GetMousePos().x - pos.x;
                float progress = std::clamp(mouse_x / w, 0.0f, 1.0f);
                deck.current_frame = progress * duration * deck.sample_rate;
            }

            if (strip_hovered && duration > 0.0) {
                float mouse_x = ImGui::GetMousePos().x - pos.x;
                float hover_prog = std::clamp(mouse_x / w, 0.0f, 1.0f);
                double hover_sec = hover_prog * duration;
                int h_m = (int)hover_sec / 60;
                int h_s = (int)hover_sec % 60;
                int h_ms = (int)((hover_sec - std::floor(hover_sec)) * 10.0);
                double rem_sec = duration - hover_sec;
                int rm_m = (int)rem_sec / 60;
                int rm_s = (int)rem_sec % 60;
                ImGui::SetTooltip("Needle Search: %02d:%02d.%d (-%02d:%02d) | Clique ou arraste para saltar", h_m, h_s, h_ms, rm_m, rm_s);
            }

            ImGui::SetCursorScreenPos(ImVec2(pos.x, pos.y + h));
        }

        // Renderiza o Vinilzao Analogico Gigante com Display Digital LCD Central e Marcador Giratorio
        void renderGiantVinylTurntable(KuroAudio::DJDeck& deck, ImVec2 top_left, float size, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            float radius = size * 0.5f;
            ImVec2 center = ImVec2(top_left.x + radius, top_left.y + radius);

            // 1. Chassi circular e Anel Neon Externo (Glow)
            dl->AddCircleFilled(center, radius, IM_COL32(10, 12, 16, 255), 64);
            dl->AddCircle(center, radius, ImGui::GetColorU32(theme_col), 64, 3.5f);
            dl->AddCircle(center, radius * 0.98f, ImGui::GetColorU32(ImVec4(theme_col.x, theme_col.y, theme_col.z, 0.35f)), 64, 2.0f);

            // 2. Pontos Estroboscopicos da Borda
            int num_dots = 42;
            for (int d = 0; d < num_dots; d++) {
                float da = (float)d * (2.0f * (float)M_PI / num_dots);
                float dot_r = radius * 0.94f;
                ImVec2 dot_pos = ImVec2(center.x + std::cos(da) * dot_r, center.y + std::sin(da) * dot_r);
                dl->AddCircleFilled(dot_pos, 1.8f, IM_COL32(180, 205, 230, 160));
            }

            // 3. Ranhuras concentricas de vinil (Micro-Grooves)
            dl->AddCircleFilled(center, radius * 0.90f, IM_COL32(12, 14, 18, 255), 64);
            for (float gr = 0.46f; gr < 0.88f; gr += 0.04f) {
                dl->AddCircle(center, radius * gr, IM_COL32(34, 38, 48, 130), 48, 1.0f);
            }

            // 4. Efeito de Reflexo Especular de Luz Radial
            float a1 = deck.jog_visual_angle;
            float a2 = a1 + (float)M_PI;
            ImVec2 s1 = ImVec2(center.x + std::cos(a1) * radius * 0.88f, center.y + std::sin(a1) * radius * 0.88f);
            ImVec2 s2 = ImVec2(center.x + std::cos(a2) * radius * 0.88f, center.y + std::sin(a2) * radius * 0.88f);
            dl->AddLine(center, s1, IM_COL32(255, 255, 255, 35), 2.5f);
            dl->AddLine(center, s2, IM_COL32(255, 255, 255, 35), 2.5f);

            // 5. ROTULO CENTRAL REDONDO DO VINIL / DISPLAY DIGITAL LCD (BPM + PITCH)
            float label_radius = radius * 0.42f;
            dl->AddCircleFilled(center, label_radius, IM_COL32(8, 11, 16, 255), 48);
            dl->AddCircle(center, label_radius, ImGui::GetColorU32(theme_col), 48, 2.5f);
            dl->AddCircle(center, label_radius * 0.88f, ImGui::GetColorU32(ImVec4(theme_col.x, theme_col.y, theme_col.z, 0.45f)), 48, 1.5f);

            // Telemetria digital central: BPM e Pitch LCD
            double eff_bpm = deck.bpm * (1.0 + deck.pitch_percent * 0.01);
            char bpm_buf[24];
            snprintf(bpm_buf, sizeof(bpm_buf), "%.1f", eff_bpm > 10.0 ? eff_bpm : 128.0);
            ImVec2 sz_bpm = ImGui::CalcTextSize(bpm_buf);
            dl->AddText(ImVec2(center.x - sz_bpm.x * 0.5f, center.y - 12.0f), IM_COL32(255, 255, 255, 255), bpm_buf);

            char pitch_buf[24];
            snprintf(pitch_buf, sizeof(pitch_buf), "%+.1f%%", deck.pitch_percent);
            ImVec2 sz_pitch = ImGui::CalcTextSize(pitch_buf);
            dl->AddText(ImVec2(center.x - sz_pitch.x * 0.5f, center.y + 1.0f), ImGui::GetColorU32(theme_col), pitch_buf);

            // Pino Central Metalico (Spindle)
            dl->AddCircleFilled(center, 4.0f, IM_COL32(210, 220, 230, 255), 16);

            // Marcador visual de rotacao do prato / agulha fonocaptora com ponta destacada
            float needle_angle = deck.jog_visual_angle;
            ImVec2 mark_inner = ImVec2(center.x + std::cos(needle_angle) * (label_radius + 4.0f),
                                       center.y + std::sin(needle_angle) * (label_radius + 4.0f));
            ImVec2 mark_pos = ImVec2(center.x + std::cos(needle_angle) * (radius * 0.84f),
                                     center.y + std::sin(needle_angle) * (radius * 0.84f));
            dl->AddLine(mark_inner, mark_pos, IM_COL32(230, 240, 255, 230), 2.2f);
            dl->AddCircleFilled(mark_pos, 4.5f, IM_COL32(255, 255, 255, 255), 16);
            dl->AddCircleFilled(mark_pos, 2.5f, ImGui::GetColorU32(theme_col), 16);

            // Agulha Holográfica Fantasma de Rotação (Slip Mode Ghost Needle)
            if (deck.is_slipping && deck.sample_rate > 1000.0) {
                float ghost_angle = (float)(deck.slip_virtual_frame * (2.0 * M_PI * 33.33333 / (std::max(1000.0, deck.sample_rate) * 60.0)));
                ImVec2 g_inner = ImVec2(center.x + std::cos(ghost_angle) * (label_radius + 4.0f),
                                        center.y + std::sin(ghost_angle) * (label_radius + 4.0f));
                ImVec2 g_pos = ImVec2(center.x + std::cos(ghost_angle) * (radius * 0.84f),
                                      center.y + std::sin(ghost_angle) * (radius * 0.84f));
                float pulse = (std::sin((float)ImGui::GetTime() * 12.0f) + 1.0f) * 0.5f;
                ImU32 g_col = ImGui::ColorConvertFloat4ToU32(ImVec4(theme_col.x, theme_col.y, theme_col.z, 0.70f + pulse * 0.30f));
                dl->AddLine(g_inner, g_pos, g_col, 2.0f);
                dl->AddCircle(g_pos, 5.0f, g_col, 16, 1.5f);
                dl->AddCircleFilled(g_pos, 2.5f, IM_COL32(255, 255, 255, 230), 16);
            }


            // 6. Braco Fonocaptor (Tonearm)
            ImVec2 arm_pivot = ImVec2(top_left.x + size - 15.0f, top_left.y + 20.0f);
            dl->AddCircleFilled(arm_pivot, 10.0f, IM_COL32(75, 85, 100, 255), 24);
            dl->AddCircle(arm_pivot, 10.0f, IM_COL32(150, 165, 185, 255), 24, 1.5f);

            float song_progress = (deck.duration_sec > 0.0) ? (float)((deck.current_frame / deck.sample_rate) / deck.duration_sec) : 0.0f;
            song_progress = std::clamp(song_progress, 0.0f, 1.0f);
            float stylus_dist = radius * 0.85f - song_progress * (radius * 0.40f);
            ImVec2 stylus_pos = ImVec2(center.x + stylus_dist * 0.7f, center.y + stylus_dist * 0.7f);

            dl->AddLine(arm_pivot, stylus_pos, IM_COL32(180, 195, 210, 255), 3.0f);
            dl->AddRectFilled(ImVec2(stylus_pos.x - 4, stylus_pos.y - 6), ImVec2(stylus_pos.x + 8, stylus_pos.y + 6), IM_COL32(230, 40, 60, 255), 2.0f);
            dl->AddCircleFilled(stylus_pos, 2.0f, IM_COL32(255, 255, 255, 255));

            // 7. Interacao de Mouse no Vinil (Scratch e Nudge)
            ImGui::SetCursorScreenPos(top_left);
            char jog_btn_id[32];
            snprintf(jog_btn_id, sizeof(jog_btn_id), "##VinylTurntable_%d", deck.deck_id);
            if (ImGui::InvisibleButton(jog_btn_id, ImVec2(size, size))) {}

            bool hovered = ImGui::IsItemHovered();
            bool active = ImGui::IsItemActive();

            if (active) {
                ImVec2 mouse = ImGui::GetMousePos();
                ImVec2 delta = ImGui::GetIO().MouseDelta;
                float dist = std::hypot(mouse.x - center.x, mouse.y - center.y);

                if (dist < radius * 0.90f) { // Platter Scratch
                    deck.jog_touch = true;
                    float rot_delta = (delta.x * (mouse.y - center.y) - delta.y * (mouse.x - center.x)) * 0.003f;
                    deck.target_scratch_velocity = rot_delta * 3.5f;
                    deck.scratch_active_ticks = 4;
                    deck.jog_visual_angle += rot_delta;
                } else if (dist < radius * 1.15f) { // Rim Nudge
                    float rot_delta = (delta.x * (mouse.y - center.y) - delta.y * (mouse.x - center.x)) * 0.001f;
                    deck.jog_pitch_bend += rot_delta;
                    deck.jog_visual_angle += rot_delta;
                }
            } else if (hovered && ImGui::IsMouseReleased(0)) {
                deck.jog_touch = false;
            } else if (!active && !hovered && deck.jog_touch) {
                deck.jog_touch = false;
            }
        }

        void renderPerformancePads(KuroAudio::DJDeck& deck, float w, ImVec4 theme_col, KuroAudio::DJEngine& engine) {
            const char* modes[] = { "HOT CUE", "SAMPLER", "BEAT LOOP", "PAD FX" };
            ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "PAD MODE:");
            ImGui::SameLine();
            for (int m = 0; m < 4; m++) {
                bool is_cur = (deck.pad_mode == m);
                if (is_cur) ImGui::PushStyleColor(ImGuiCol_Button, theme_col);
                else ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.10f, 0.14f, 0.20f, 0.8f));

                if (ImGui::Button(modes[m], ImVec2(58, 17))) {
                    deck.pad_mode = m;
                }
                ImGui::PopStyleColor();
                ImGui::SameLine(0, 4);
            }
            ImGui::NewLine();

            float pad_w = (w - 24.0f) * 0.25f;
            float pad_h = 19.0f;

            for (int i = 0; i < 8; i++) {
                ImGui::PushID(i);
                uint32_t col = deck.hot_cues[i].color_rgba;
                bool is_active = (deck.pad_mode == 0) ? deck.hot_cues[i].active : (deck.pad_mode == 1 ? true : false);

                if (is_active) {
                    ImVec4 pad_c = ImColor(col);
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(pad_c.x * 0.6f, pad_c.y * 0.6f, pad_c.z * 0.6f, 0.9f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                } else {
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.15f, 0.20f, 0.7f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.5f, 0.5f, 0.5f, 1.0f));
                }

                char lbl[32];
                if (deck.pad_mode == 0) {
                    snprintf(lbl, sizeof(lbl), is_active ? "CUE %d" : "[ %d ]", i + 1);
                } else if (deck.pad_mode == 1) {
                    snprintf(lbl, sizeof(lbl), "%s", engine.samplers[i].name.c_str());
                } else if (deck.pad_mode == 2) {
                    snprintf(lbl, sizeof(lbl), "1/%d B", (int)std::pow(2, 3 - i));
                } else {
                    snprintf(lbl, sizeof(lbl), "FX %d", i + 1);
                }

                if (ImGui::Button(lbl, ImVec2(pad_w, pad_h))) {
                    if (deck.pad_mode == 0) deck.jumpToHotCue(i);
                    else if (deck.pad_mode == 1) engine.triggerSampler(i);
                    else if (deck.pad_mode == 2) deck.toggleLoop(std::pow(2.0, (double)(i - 2)));
                    else engine.beat_fx.enabled = !engine.beat_fx.enabled;
                }

                if (deck.pad_mode == 0 && ImGui::IsItemClicked(1)) {
                    deck.deleteHotCue(i);
                }

                ImGui::PopStyleColor(2);
                ImGui::PopID();

                if ((i + 1) % 4 != 0) ImGui::SameLine(0, 4);
            }
        }

