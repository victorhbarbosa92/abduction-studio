                            st.artist = rf.artist;
                            st.album = rf.album;
                            st.bpm = rf.bpm;
                            st.key = rf.key;
                            st.subgenre = rf.subgenre;
                            st.local_rgba_path = rf.local_rgba;
                            st.local_wav_path = rf.local_wav;
                            openSourceMatrix(st);
