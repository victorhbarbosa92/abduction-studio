        void renderSamplerRack(KuroAudio::DJEngine& engine) {
            float total_w = ImGui::GetContentRegionAvail().x;
            ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.04f, 0.06f, 0.09f, 0.98f));
            ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.70f, 0.20f, 0.85f, 0.90f));
