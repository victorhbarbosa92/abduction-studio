        // =========================================================================
        // MODAL CENTRAL DE GRAVAÇÕES MASTER (SCRATCH/RECORDINGS/)
        // =========================================================================
        void renderRecordingsModal(KuroAudio::DJEngine& engine) {
            if (!show_recordings_modal) return;

            if (!ImGui::IsPopupOpen("📁 CENTRAL DE GRAVAÇÕES MASTER (LIVE SETS)##RecordingsModal")) {
                ImGui::OpenPopup("📁 CENTRAL DE GRAVAÇÕES MASTER (LIVE SETS)##RecordingsModal");
            }

            ImGuiViewport* vp = ImGui::GetMainViewport();
            ImVec2 msz = ImVec2(740.0f, 440.0f);
            ImGui::SetNextWindowPos(ImVec2(vp->Pos.x + (vp->Size.x - msz.x) * 0.5f, vp->Pos.y + (vp->Size.y - msz.y) * 0.5f), ImGuiCond_Appearing);
            ImGui::SetNextWindowSize(msz, ImGuiCond_Appearing);

            ImGui::PushStyleColor(ImGuiCol_PopupBg, ImVec4(0.05f, 0.07f, 0.11f, 0.98f));
            ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(1.00f, 0.25f, 0.45f, 0.90f));
            ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 8.0f);
            ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.5f);

            if (ImGui::BeginPopupModal("📁 CENTRAL DE GRAVAÇÕES MASTER (LIVE SETS)##RecordingsModal", &show_recordings_modal, ImGuiWindowFlags_NoCollapse)) {
                ImGui::TextColored(ImVec4(1.0f, 0.35f, 0.55f, 1.0f), ICON_FA_COMPACT_DISC " GRAVAÇÕES WAV MASTER 32-BIT IEEE FLOAT");
                ImGui::SameLine(ImGui::GetContentRegionAvail().x - 140);
                if (ImGui::Button(ICON_FA_FOLDER_OPEN " Abrir Pasta")) {
#ifdef _WIN32
                    ShellExecuteA(NULL, "open", "scratch\\recordings", NULL, NULL, SW_SHOW);
#endif
                }
                ImGui::Separator();

                namespace fs = std::filesystem;
                std::string rec_dir = "scratch/recordings";
                std::vector<fs::directory_entry> rec_files;
                if (fs::exists(rec_dir)) {
                    try {
                        for (const auto& entry : fs::directory_iterator(rec_dir)) {
                            try {
                                if (entry.is_regular_file() && KuroAudio::safeExtension(entry.path()) == ".wav") {
                                    rec_files.push_back(entry);
                                }
                            } catch (...) {}
                        }
                    } catch (...) {}
                    std::sort(rec_files.begin(), rec_files.end(), [](const fs::directory_entry& a, const fs::directory_entry& b) {
                        std::error_code ec;
                        return fs::last_write_time(a, ec) > fs::last_write_time(b, ec);
                    });
                }

                if (rec_files.empty()) {
                    ImGui::Spacing();
                    ImGui::TextColored(ImVec4(0.6f, 0.6f, 0.6f, 1.0f), "Nenhuma gravação encontrada em scratch/recordings/.");
                    ImGui::TextWrapped("Clique no botão [REC MASTER] no topo da tela para gravar seus sets ao vivo.");
                } else {
                    ImGui::BeginChild("RecList", ImVec2(0, -40), true);
                    for (size_t i = 0; i < rec_files.size(); i++) {
                        const auto& file = rec_files[i];
                        std::string fname = KuroAudio::safeFilename(file.path());
                        uintmax_t fsize = file.file_size();
                        double fsize_mb = (double)fsize / (1024.0 * 1024.0);

                        ImGui::PushID((int)i);
                        ImGui::TextColored(ImVec4(0.92f, 0.95f, 1.0f, 1.0f), ICON_FA_FILE_AUDIO " %s", fname.c_str());
                        ImGui::SameLine(ImGui::GetContentRegionAvail().x - 310);
                        ImGui::TextColored(ImVec4(0.0f, 0.85f, 1.0f, 1.0f), "%.2f MB", fsize_mb);

                        ImGui::SameLine(ImGui::GetContentRegionAvail().x - 230);
                        std::string p_str = file.path().string();
                        if (ImGui::SmallButton(ICON_FA_PLAY " Preview")) {
                            KuroAudio::DJPreviewPlayer::getInstance().play(p_str, fname, fname, "Live Set Master");
                        }
                        ImGui::SameLine();
                        if (ImGui::SmallButton("Deck 1")) {
                            engine.deckA.loadTrack(p_str);
                            engine.deckA.track_title = fname;
                            engine.deckA.track_artist = "Live Set Master";
                            show_recordings_modal = false;
                            ImGui::CloseCurrentPopup();
                        }
                        ImGui::SameLine();
                        if (ImGui::SmallButton("Deck 2")) {
                            engine.deckB.loadTrack(p_str);
                            engine.deckB.track_title = fname;
                            engine.deckB.track_artist = "Live Set Master";
                            show_recordings_modal = false;
                            ImGui::CloseCurrentPopup();
                        }

                        ImGui::Separator();
                        ImGui::PopID();
                    }
                    ImGui::EndChild();
                }

                ImGui::Spacing();
                if (ImGui::Button("FECHAR", ImVec2(100, 26))) {
                    show_recordings_modal = false;
                    ImGui::CloseCurrentPopup();
                }

                ImGui::EndPopup();
            }

            ImGui::PopStyleVar(2);
            ImGui::PopStyleColor(2);
        }

