        // MODAL CENTRAL DE SETLIST & HISTÓRICO DE SESSÃO (1001TRACKLISTS / M3U)
        // =========================================================================
        void renderSetlistModal(KuroAudio::DJEngine& engine) {
            if (!show_setlist_modal) return;
            if (!ImGui::IsPopupOpen("📋 HISTÓRICO DE SESSÃO & SETLIST RECORDER##SetlistModal")) {
                ImGui::OpenPopup("📋 HISTÓRICO DE SESSÃO & SETLIST RECORDER##SetlistModal");
            }

            ImGuiViewport* vp = ImGui::GetMainViewport();
            ImVec2 msz = ImVec2(760.0f, 460.0f);
            ImGui::SetNextWindowPos(ImVec2(vp->Pos.x + (vp->Size.x - msz.x) * 0.5f, vp->Pos.y + (vp->Size.y - msz.y) * 0.5f), ImGuiCond_Appearing);
            ImGui::SetNextWindowSize(msz, ImGuiCond_Appearing);

            ImGui::PushStyleColor(ImGuiCol_PopupBg, ImVec4(0.05f, 0.07f, 0.11f, 0.98f));
            ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.85f, 0.45f, 0.05f, 0.95f));
            ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 8.0f);
            ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.5f);

            if (ImGui::BeginPopupModal("📋 HISTÓRICO DE SESSÃO & SETLIST RECORDER##SetlistModal", &show_setlist_modal, ImGuiWindowFlags_NoCollapse)) {
                ImGui::TextColored(ImVec4(1.0f, 0.75f, 0.20f, 1.0f), ICON_FA_LIST_CHECK " HISTÓRICO DE FAIXAS TOCADAS NO SET AO VIVO");
                ImGui::SameLine();
                ImGui::TextColored(ImVec4(0.6f, 0.7f, 0.8f, 1.0f), "(Total: %d faixas registradas)", (int)engine.setlist_history.size());
                ImGui::Separator();

                if (engine.setlist_history.empty()) {
                    ImGui::Spacing();
                    ImGui::TextColored(ImVec4(0.6f, 0.6f, 0.6f, 1.0f), "Nenhuma faixa registrada ainda.");
                    ImGui::TextWrapped("Conforme você toca faixas nos decks por mais de 15 segundos, o sistema registra automaticamente o artista, título, BPM e tom Camelot com o timestamp exato.");
                } else {
                    ImGui::BeginChild("##SetlistScroll", ImVec2(0, -45), true);
                    for (size_t i = 0; i < engine.setlist_history.size(); i++) {
                        const auto& item = engine.setlist_history[i];
                        ImGui::PushID((int)i);
                        ImGui::TextColored(ImVec4(0.0f, 0.85f, 1.0f, 1.0f), "[%s]", item.start_time.c_str());
                        ImGui::SameLine();
                        ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.3f, 1.0f), "#%02d", (int)i + 1);
                        ImGui::SameLine();
                        ImGui::TextColored(ImVec4(0.95f, 0.95f, 1.0f, 1.0f), "%s - %s", item.artist.c_str(), item.title.c_str());
                        ImGui::SameLine(ImGui::GetContentRegionAvail().x - 140);
                        ImGui::TextColored(ImVec4(0.5f, 0.9f, 0.6f, 1.0f), "%.1f BPM", item.bpm);
                        ImGui::SameLine();
                        ImGui::TextColored(ImVec4(0.9f, 0.5f, 0.8f, 1.0f), "[%s]", item.key.c_str());
                        ImGui::Separator();
                        ImGui::PopID();
                    }
                    ImGui::EndChild();
                }

                ImGui::Spacing();
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.45f, 0.30f, 0.95f));
                if (ImGui::Button(ICON_FA_FILE_LINES " EXPORTAR .TXT (1001Tracklists)", ImVec2(240, 30))) {
                    try {
                        std::filesystem::create_directories("scratch/recordings");
                        std::ofstream f("scratch/recordings/setlist_export.txt");
                        if (f.is_open()) {
                            f << engine.exportSetlistTxt();
                            f.close();
#ifdef _WIN32
                            ShellExecuteA(NULL, "open", "scratch\\recordings\\setlist_export.txt", NULL, NULL, SW_SHOW);
#endif
                        }
                    } catch (...) {}
                }
                ImGui::PopStyleColor();

                ImGui::SameLine(0, 8);
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.20f, 0.35f, 0.55f, 0.95f));
                if (ImGui::Button(ICON_FA_LIST " EXPORTAR .M3U (Playlist)", ImVec2(200, 30))) {
                    try {
                        std::filesystem::create_directories("scratch/recordings");
                        std::ofstream f("scratch/recordings/setlist_export.m3u");
                        if (f.is_open()) {
                            f << engine.exportSetlistM3u();
                            f.close();
#ifdef _WIN32
                            ShellExecuteA(NULL, "open", "scratch\\recordings\\setlist_export.m3u", NULL, NULL, SW_SHOW);
#endif
                        }
                    } catch (...) {}
                }
                ImGui::PopStyleColor();

                ImGui::SameLine(ImGui::GetContentRegionAvail().x - 100);
                if (ImGui::Button("FECHAR", ImVec2(90, 30))) {
                    show_setlist_modal = false;
                    ImGui::CloseCurrentPopup();
                }

                ImGui::EndPopup();
            }

            ImGui::PopStyleVar(2);
            ImGui::PopStyleColor(2);
        }

        // =========================================================================
        // MODAL EXPANDIDO DE ALTA FIDELIDADE: NAVEGADOR DE BIBLIOTECA & CRATES
        // =========================================================================
        void renderLibraryModal(KuroAudio::DJEngine& engine) {
            if (!show_library_modal) return;

            ImGuiViewport* vp = ImGui::GetMainViewport();
            float m_w = std::min(1260.0f, vp->Size.x * 0.94f);
            float m_h = std::min(720.0f, vp->Size.y * 0.90f);
            ImGui::SetNextWindowSize(ImVec2(m_w, m_h), ImGuiCond_Appearing);
            ImGui::SetNextWindowPos(ImVec2(vp->Pos.x + (vp->Size.x - m_w) * 0.5f, vp->Pos.y + (vp->Size.y - m_h) * 0.5f), ImGuiCond_Appearing);

            ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.032f, 0.042f, 0.065f, 0.99f));
            ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.00f, 0.85f, 0.75f, 0.90f));
            ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 8.0f);
            ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.5f);

            if (ImGui::Begin(ICON_FA_BOOK " NAVEGADOR DE BIBLIOTECA MUSICAL & CRATES##FullLibraryModal", &show_library_modal, ImGuiWindowFlags_NoCollapse)) {
                auto& lib_mgr = KuroAudio::DJLibraryManager::getInstance();
                auto folders = lib_mgr.getFolders();
                std::string active_fid = lib_mgr.getActiveFolderId();
                std::string active_folder_name = "Todas as Músicas";
                int active_count = 0;
                for (const auto& fo : folders) {
                    if (fo.id == active_fid) {
                        active_folder_name = fo.name;
                        active_count = fo.track_count;
                        break;
                    }
                }

                // Cabeçalho e Ações
                ImGui::AlignTextToFramePadding();
                ImGui::TextColored(ImVec4(0.00f, 0.96f, 0.83f, 1.0f), ICON_FA_BOOK " CRATES & PLAYLISTS");
                ImGui::SameLine(0, 10.0f);
                ImGui::TextColored(ImVec4(0.40f, 0.78f, 1.00f, 0.95f), "[ %s • %d faixas ]", active_folder_name.c_str(), active_count);

                float avail_top = ImGui::GetContentRegionAvail().x;
                ImGui::SameLine(avail_top - 360.0f);
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.10f, 0.35f, 0.45f, 0.85f));
                if (ImGui::SmallButton(ICON_FA_FOLDER_PLUS " + IMPORTAR ÁUDIO")) {
                    std::string local_path = KuroUI::FileDialog::OpenFile("Audio Files (*.wav;*.mp3;*.flac;*.ogg)\0*.wav;*.mp3;*.flac;*.ogg\0All Files (*.*)\0*.*\0");
                    if (!local_path.empty()) {
                        spotify_service.importLocalTrack(local_path);
                    }
                }
                ImGui::PopStyleColor();

                ImGui::SameLine(0, 4.0f);
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.15f, 0.24f, 0.35f, 0.85f));
                if (ImGui::SmallButton(ICON_FA_PLUS " NOVA PASTA")) {
                    show_new_folder_dialog = true;
                }
                ImGui::PopStyleColor();

                ImGui::SameLine(0, 8.0f);
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.45f, 0.12f, 0.15f, 0.90f));
                if (ImGui::SmallButton(ICON_FA_XMARK " FECHAR (ESC)")) {
                    show_library_modal = false;
                }
                ImGui::PopStyleColor();

                ImGui::Separator();

                float left_w = 230.0f;
                float right_w = ImGui::GetContentRegionAvail().x - left_w - 12.0f;
                float content_h = ImGui::GetContentRegionAvail().y - 36.0f;

                // ── PAINEL ESQUERDO: ÁRVORE DE PASTAS & GÊNEROS ──
                ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.018f, 0.024f, 0.038f, 0.95f));
                ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.09f, 0.14f, 0.22f, 0.70f));
                ImGui::BeginChild("##ModalCratesLeft", ImVec2(left_w, content_h), true);
                ImGui::TextColored(ImVec4(0.00f, 0.85f, 0.75f, 1.0f), ICON_FA_FOLDER_TREE " PASTAS & GÊNEROS");
                ImGui::Separator();

                for (const auto& f : folders) {
                    bool is_active = (f.id == active_fid);
                    const char* icon = ICON_FA_FOLDER;
                    ImVec4 f_col = ImVec4(0.80f, 0.85f, 0.92f, 1.0f);

                    if (f.id == "all")             { icon = ICON_FA_MUSIC;             f_col = ImVec4(0.35f, 0.90f, 1.00f, 1.0f); }
                    else if (f.id == "prog_psy")   { icon = ICON_FA_FIRE;              f_col = ImVec4(0.00f, 0.96f, 0.83f, 1.0f); }
                    else if (f.id == "psy_fullon") { icon = ICON_FA_BOLT;              f_col = ImVec4(0.85f, 0.40f, 1.00f, 1.0f); }
                    else if (f.id == "tech_house") { icon = ICON_FA_COMPACT_DISC;     f_col = ImVec4(1.00f, 0.75f, 0.20f, 1.0f); }
                    else if (f.id == "acid_techno"){ icon = ICON_FA_SLIDERS;          f_col = ImVec4(0.25f, 1.00f, 0.45f, 1.0f); }
                    else if (f.id == "melodic_techno"){ icon = ICON_FA_HEADPHONES;    f_col = ImVec4(0.40f, 0.75f, 1.00f, 1.0f); }
                    else if (f.id == "cloud")      { icon = ICON_FA_CLOUD_ARROW_DOWN;  f_col = ImVec4(0.95f, 0.65f, 1.00f, 1.0f); }

                    char label[128];
                    snprintf(label, sizeof(label), "%s %s##m_%s", icon, f.name.c_str(), f.id.c_str());

                    if (is_active) {
                        ImGui::PushStyleColor(ImGuiCol_Header, ImVec4(0.00f, 0.38f, 0.45f, 0.75f));
                        ImGui::PushStyleColor(ImGuiCol_Text, f_col);
                    } else {
                        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.70f, 0.76f, 0.84f, 1.0f));
                    }

                    if (ImGui::Selectable(label, is_active, ImGuiSelectableFlags_SpanAllColumns)) {
                        lib_mgr.setActiveFolderId(f.id);
                    }

                    if (is_active) {
                        ImVec2 item_min = ImGui::GetItemRectMin();
                        ImVec2 item_max = ImGui::GetItemRectMax();
                        ImGui::GetWindowDrawList()->AddRectFilled(item_min, ImVec2(item_min.x + 3.0f, item_max.y), IM_COL32(0, 220, 255, 255));
                    }

                    ImGui::SameLine(left_w - 38.0f);
                    ImGui::TextColored(ImVec4(0.42f, 0.52f, 0.65f, 0.9f), "%d", f.track_count);

                    if (is_active) ImGui::PopStyleColor(2);
                    else ImGui::PopStyleColor(1);
                }
                ImGui::EndChild();
                ImGui::PopStyleColor(2);

                ImGui::SameLine(0, 8.0f);

                // ── PAINEL DIREITO: BARRA DE BUSCA, CHIPS & TABELA ──
                ImGui::BeginChild("##ModalTracksRight", ImVec2(right_w, content_h), false);

                // Linha Superior de Busca
                ImGui::AlignTextToFramePadding();
                ImGui::TextColored(ImVec4(0.50f, 0.75f, 1.0f, 1.0f), ICON_FA_MAGNIFYING_GLASS);
                ImGui::SameLine(0, 4);
                ImGui::PushItemWidth(260);
                if (ImGui::InputTextWithHint("##ModalSearchQueryInput", "Buscar título, artista ou tom...", search_query_buf, sizeof(search_query_buf), ImGuiInputTextFlags_EnterReturnsTrue)) {
                    spotify_service.searchAsync(search_query_buf);
                }
                ImGui::PopItemWidth();

                if (strlen(search_query_buf) > 0) {
                    ImGui::SameLine(0, 2);
                    if (ImGui::SmallButton("✕##ClrSearchModal")) {
                        search_query_buf[0] = '\0';
                    }
                }

                ImGui::SameLine(0, 6);
                if (ImGui::Button(ICON_FA_MAGNIFYING_GLASS " BUSCAR")) {
                    spotify_service.searchAsync(search_query_buf);
                }

                // Chips rápidos de vertentes
                ImGui::SameLine(0, 10);
                auto vchip_m = [&](const char* label, const char* fid, ImVec4 col) {
                    bool is_f_active = (active_fid == fid);
                    if (is_f_active) ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(col.x * 0.35f, col.y * 0.35f, col.z * 0.35f, 0.95f));
                    else ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.10f, 0.14f, 0.20f, 0.85f));
                    ImGui::PushStyleColor(ImGuiCol_Text, col);
                    if (ImGui::SmallButton(label)) {
                        lib_mgr.setActiveFolderId(fid);
                    }
                    ImGui::PopStyleColor(2);
                    ImGui::SameLine(0, 3);
                };
                vchip_m("Prog Psy", "prog_psy", ImVec4(0.00f, 0.96f, 0.83f, 1.0f));
                vchip_m("Full-On", "psy_fullon", ImVec4(0.85f, 0.40f, 1.00f, 1.0f));
                vchip_m("Tech House", "tech_house", ImVec4(1.00f, 0.75f, 0.20f, 1.0f));
                vchip_m("Acid", "acid_techno", ImVec4(0.25f, 1.00f, 0.45f, 1.0f));
                vchip_m("Melodic", "melodic_techno", ImVec4(0.40f, 0.75f, 1.00f, 1.0f));

                // Camelot Radar / Sort
                ImGui::SameLine(0, 10);
                if (harmonic_sort_enabled) {
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.00f, 0.55f, 0.45f, 0.95f));
                    if (ImGui::SmallButton(ICON_FA_ARROW_DOWN_A_Z " CAMELOT SORT: ON")) {
                        harmonic_sort_enabled = false;
                    }
                    ImGui::PopStyleColor();
                } else {
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.18f, 0.22f, 0.28f, 0.90f));
                    if (ImGui::SmallButton(ICON_FA_ARROW_DOWN_A_Z " CAMELOT SORT: OFF")) {
                        harmonic_sort_enabled = true;
                    }
                    ImGui::PopStyleColor();
                }

                ImGui::Separator();

                // Lista de faixas
                auto track_list = lib_mgr.getTracksForFolder(active_fid);
                if (track_list.empty() && active_fid == "cloud") {
                    auto sp_tracks = spotify_service.getTracks();
                    for (const auto& st : sp_tracks) {
                        KuroAudio::DJLibraryTrack lt;
                        lt.id = st.id; lt.title = st.title; lt.artist = st.artist; lt.album = st.album;
                        lt.bpm = st.bpm; lt.key = st.key; lt.duration_sec = st.duration_sec;
                        lt.subgenre = st.subgenre; lt.folder_id = "cloud";
                        lt.artwork_url = st.artwork_url; lt.preview_url = st.preview_url;
                        lt.local_wav_path = st.local_wav_path; lt.local_rgba_path = st.local_rgba_path;
                        lt.is_downloaded = st.is_ready; lt.is_downloading = st.is_downloading;
                        track_list.push_back(lt);
                    }
                }

                if (strlen(search_query_buf) > 0) {
                    std::string q = search_query_buf;
                    std::transform(q.begin(), q.end(), q.begin(), ::tolower);
                    track_list.erase(std::remove_if(track_list.begin(), track_list.end(), [&](const KuroAudio::DJLibraryTrack& trk) {
                        std::string tit = trk.title; std::transform(tit.begin(), tit.end(), tit.begin(), ::tolower);
                        std::string art = trk.artist; std::transform(art.begin(), art.end(), art.begin(), ::tolower);
                        std::string gen = trk.subgenre; std::transform(gen.begin(), gen.end(), gen.begin(), ::tolower);
                        std::string key = trk.key; std::transform(key.begin(), key.end(), key.begin(), ::tolower);
                        char bpm_buf[16]; snprintf(bpm_buf, sizeof(bpm_buf), "%.1f", trk.bpm);
                        return (tit.find(q) == std::string::npos && 
                                art.find(q) == std::string::npos && 
                                gen.find(q) == std::string::npos && 
                                key.find(q) == std::string::npos && 
                                std::string(bpm_buf).find(q) == std::string::npos);
                    }), track_list.end());
                }

                int left_id = ddj_hardware.getActiveLeftDeck();
                int right_id = ddj_hardware.getActiveRightDeck();
                std::string ref_key = engine.decks[left_id].is_playing.load() ? engine.decks[left_id].key_signature : 
                                     (engine.decks[right_id].is_playing.load() ? engine.decks[right_id].key_signature : engine.decks[left_id].key_signature);

                if (harmonic_sort_enabled) {
                    std::stable_sort(track_list.begin(), track_list.end(), [&](auto&& a, auto&& b) -> bool {
                        int sa = KuroAudio::DJHarmonicEngine::getCompatibilityScore(ref_key, a.key);
                        int sb = KuroAudio::DJHarmonicEngine::getCompatibilityScore(ref_key, b.key);
                        return sa > sb;
                    });
                }

                if (track_list.empty()) {
                    ImGui::Spacing();
                    ImGui::TextColored(ImVec4(0.50f, 0.60f, 0.72f, 1.0f), ICON_FA_CIRCLE_INFO " Nenhuma faixa encontrada.");
                } else {
                    if (ImGui::BeginTable("##ModalTrackTable", 7, ImGuiTableFlags_ScrollY | ImGuiTableFlags_RowBg | ImGuiTableFlags_BordersInnerH, ImVec2(0, content_h - 45.0f))) {
                        ImGui::TableSetupColumn("Capa", ImGuiTableColumnFlags_WidthFixed, 38.0f);
                        ImGui::TableSetupColumn("Título e Artista", ImGuiTableColumnFlags_WidthStretch);
                        ImGui::TableSetupColumn("Vertente", ImGuiTableColumnFlags_WidthFixed, 115.0f);
                        ImGui::TableSetupColumn("BPM", ImGuiTableColumnFlags_WidthFixed, 65.0f);
                        ImGui::TableSetupColumn("Tom & Camelot", ImGuiTableColumnFlags_WidthFixed, 135.0f);
                        ImGui::TableSetupColumn("Duração", ImGuiTableColumnFlags_WidthFixed, 55.0f);
                        ImGui::TableSetupColumn("Carregar nos Decks", ImGuiTableColumnFlags_WidthFixed, 220.0f);
                        ImGui::TableHeadersRow();

                        for (int i = 0; i < (int)track_list.size(); i++) {
                            auto& t = track_list[i];
                            ImGui::TableNextRow(0, 32.0f);
                            ImGui::PushID(i);

                            // Coluna 1: Capa
                            ImGui::TableNextColumn();
                            ImGui::TextColored(ImVec4(0.0f, 0.9f, 0.7f, 1.0f), ICON_FA_COMPACT_DISC);

                            // Coluna 2: Título e Artista
                            ImGui::TableNextColumn();
                            ImGui::TextColored(ImVec4(0.95f, 0.95f, 0.98f, 1.0f), "%s", t.title.c_str());
                            ImGui::TextColored(ImVec4(0.55f, 0.65f, 0.78f, 0.9f), "%s", t.artist.c_str());

                            // Coluna 3: Vertente
                            ImGui::TableNextColumn();
                            ImGui::TextColored(ImVec4(0.70f, 0.85f, 1.0f, 0.9f), "%s", t.subgenre.empty() ? "Psytrance" : t.subgenre.c_str());

                            // Coluna 4: BPM
                            ImGui::TableNextColumn();
                            ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.20f, 1.0f), "%.1f", t.bpm);

                            // Coluna 5: Tom & Camelot
                            ImGui::TableNextColumn();
                            KuroAudio::CamelotKey ck = KuroAudio::DJHarmonicEngine::parseKey(t.key);
                            ImVec4 kcol = ImColor(KuroAudio::DJHarmonicEngine::getCamelotWheelColor(ck.number)).Value;
                            ImGui::TextColored(kcol, "[%s] %s", ck.getCamelotCode().c_str(), t.key.c_str());

                            // Coluna 6: Duração
                            ImGui::TableNextColumn();
                            int min = (int)t.duration_sec / 60;
                            int sec = (int)t.duration_sec % 60;
                            ImGui::TextColored(ImVec4(0.6f, 0.7f, 0.8f, 1.0f), "%02d:%02d", min, sec);

                            // Coluna 7: Botões de Carregamento
                            ImGui::TableNextColumn();
                            ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.00f, 0.52f, 0.65f, 0.95f));
                            ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                            char btn_d1[32]; snprintf(btn_d1, sizeof(btn_d1), ICON_FA_ARROW_DOWN " DECK %d", left_id + 1);
                            if (ImGui::SmallButton(t.is_downloading ? "Baixando..." : btn_d1)) {
                                if (t.is_downloaded) {
                                    spotify_service.loadLibraryTrack(t, left_id, engine);
                                } else {
                                    spotify_service.downloadLibraryTrackAsync(t, left_id, engine);
                                }
                            }
                            ImGui::PopStyleColor(2);

                            ImGui::SameLine(0, 6);

                            ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.70f, 0.15f, 0.45f, 0.95f));
                            ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                            char btn_d2[32]; snprintf(btn_d2, sizeof(btn_d2), ICON_FA_ARROW_DOWN " DECK %d", right_id + 1);
                            if (ImGui::SmallButton(t.is_downloading ? "Baixando..." : btn_d2)) {
                                if (t.is_downloaded) {
                                    spotify_service.loadLibraryTrack(t, right_id, engine);
                                } else {
                                    spotify_service.downloadLibraryTrackAsync(t, right_id, engine);
                                }
                            }
                            ImGui::PopStyleColor(2);

                            ImGui::PopID();
                        }
                        ImGui::EndTable();
                    }
                }

                ImGui::EndChild();

                // Rodapé do Modal
                ImGui::Spacing();
                ImGui::TextColored(ImVec4(0.5f, 0.6f, 0.7f, 1.0f), "Dica: Clique em 'DECK 1' ou 'DECK 2' para carregar a música diretamente no motor.");
                ImGui::SameLine(m_w - 110.0f);
                if (ImGui::Button("FECHAR", ImVec2(90, 24))) {
                    show_library_modal = false;
                }
            }
            ImGui::End();

            ImGui::PopStyleVar(2);
            ImGui::PopStyleColor(2);
        }
    };

} // namespace KuroUI
