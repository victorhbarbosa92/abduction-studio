                ImGui::SameLine(std::max(ImGui::GetCursorPosX() + 10.0f, avail_w - right_actions_w));
            } else {
                ImGui::SameLine(0, 8);
            }

            // Botão Master Recording [● REC] (Lossless WAV 32-bit Float)
            bool rec_on = engine.isRecording();
