                    deck.stem_mode = !deck.stem_mode;
                }
                ImGui::PopStyleColor(2);

                auto centerKnob = [&](float r) {
                    float kw = r * 2.0f + 12.0f;
                    float pad = std::max(0.0f, (col_w - kw) * 0.5f);
                    if (pad > 0.0f) ImGui::SetCursorPosX(ImGui::GetCursorPosX() + pad);
                };

                bool voc_muted = deck.stem_mode && deck.stem_mute_vocals;
                bool inst_muted = deck.stem_mode && deck.stem_mute_inst;
                bool drum_muted = deck.stem_mode && deck.stem_mute_drums;
                bool voc_solo = deck.stem_mode && (deck.stem_mute_drums && !deck.stem_mute_vocals && deck.stem_mute_inst);
                bool inst_solo = deck.stem_mode && (deck.stem_mute_drums && deck.stem_mute_vocals && !deck.stem_mute_inst);
                bool drum_solo = deck.stem_mode && (!deck.stem_mute_drums && deck.stem_mute_vocals && deck.stem_mute_inst);
                bool chan_muted = (!deck.stem_mode && deck.volume <= 0.001f);

                if (deck.stem_mode) {
                    centerKnob(knob_r);
                    char k1[32]; snprintf(k1, sizeof(k1), "VOC##%s", pfx);
                    KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(k1, &deck.eq_high, 0.0f, 2.0f, knob_r, ImVec4(1.0f, 0.0f, 0.5f, 1.0f), "VOC %.1fx", 1.0f, false, false, voc_muted, voc_solo);

                    centerKnob(knob_r);
                    char k2[32]; snprintf(k2, sizeof(k2), "INST##%s", pfx);
                    KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(k2, &deck.eq_mid, 0.0f, 2.0f, knob_r, ImVec4(1.0f, 0.7f, 0.0f, 1.0f), "INST %.1fx", 1.0f, false, false, inst_muted, inst_solo);

