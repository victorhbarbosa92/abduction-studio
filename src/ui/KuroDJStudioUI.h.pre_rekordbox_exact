        struct WaveformCache {
            std::vector<WaveformColCache> cols;
            double cached_start_f    = -1e18;
            double cached_window_f   = 0.0;
            int    cached_color_mode = -1;
            int    cached_zoom       = -1;
            int    cached_width      = 0;
            bool   valid             = false;

            bool isValid(double start_f, double window_f, int color_mode, int zoom, int width) const {
                if (!valid || cached_color_mode != color_mode || cached_zoom != zoom || cached_width != width) return false;
                if (std::abs(cached_window_f - window_f) > 1.0) return false;
                double col_size = window_f / (double)std::max(1, width);
                return std::abs(start_f - cached_start_f) < col_size * 2.0;
            }
            void invalidate() { valid = false; }
        };
        WaveformCache wf_cache[4];

