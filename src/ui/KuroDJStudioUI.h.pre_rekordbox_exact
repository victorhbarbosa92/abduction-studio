                ImVec2 sz_m = ImGui::CalcTextSize("MASTER");
                dl->AddText(ImVec2(vu_start.x + (vu_box_w - sz_m.x) * 0.5f, vu_start.y + vu_box_h - 13.0f), IM_COL32(120, 150, 185, 200), "MASTER");

                ImGui::Dummy(ImVec2(vu_box_w, vu_box_h));
            }

            ImGui::NextColumn();

            // 3. Coluna 2: Canal 2 (Direita)
            drawChannelControls(deck_r, 1, theme_r, "B", col_ch_w);

            ImGui::Columns(1);
            ImGui::Spacing();
            ImGui::Separator();
            ImGui::Spacing();

            // =========================================================================
            // BASE DO MIXER: CROSSFADER & FADER START (PIONEER DDJ-400 / REKORDBOX)
            // =========================================================================
            ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "FADER START");
            ImGui::SameLine(0, 6);
            int cur_curve = engine.getCrossfaderCurve();
            const char* curve_lbl = (cur_curve == 0) ? "[SMOOTH]" : ((cur_curve == 1) ? "[SHARP ⚡]" : "[LINEAR]");
            ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.18f, 0.26f, 0.85f));
            ImGui::PushStyleColor(ImGuiCol_Text, (cur_curve == 1) ? ImVec4(1.0f, 0.85f, 0.2f, 1.0f) : ImVec4(0.0f, 0.9f, 1.0f, 1.0f));
            if (ImGui::SmallButton(curve_lbl)) {
                engine.setCrossfaderCurve((cur_curve + 1) % 3);
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Curva do Crossfader: SMOOTH (Equal Power) / SHARP (Scratch) / LINEAR");
            ImGui::PopStyleColor(2);

            ImGui::SameLine(0, 6);
            float cf = engine.getCrossfader();
            float left_used_w = ImGui::CalcTextSize("FADER START").x + ImGui::CalcTextSize(curve_lbl).x + 28.0f;
            float cf_w = w - 16.0f - left_used_w;
            if (KuroUI::KuroDJStudioSkinManager::DrawSkinCrossfader("##SkinCrossfader", &cf, cf_w, KuroUI::UIScaleManager::Scale(20.0f), ImVec4(0.0f, 0.85f, 1.0f, 1.0f))) {
                engine.setCrossfader(cf);
            }
            ImGui::Dummy(ImVec2(1.0f, 4.0f));
        }
