            // 2. Coluna 1: STEREO VU METER Central (Meio)
            {
                ImVec2 vu_start = ImGui::GetCursorScreenPos();
                float vu_box_w = col_vu_w - 4.0f;
                float vu_box_h = KuroUI::UIScaleManager::Scale(240.0f);

                dl->AddRectFilled(vu_start, ImVec2(vu_start.x + vu_box_w, vu_start.y + vu_box_h), IM_COL32(5, 7, 10, 255), 4.0f);
                dl->AddRect(vu_start, ImVec2(vu_start.x + vu_box_w, vu_start.y + vu_box_h), IM_COL32(24, 34, 48, 200), 4.0f, 0, 1.0f);

                ImVec2 sz_vu = ImGui::CalcTextSize("STEREO VU");
                dl->AddText(ImVec2(vu_start.x + (vu_box_w - sz_vu.x) * 0.5f, vu_start.y + 3.0f), IM_COL32(0, 220, 255, 230), "STEREO VU");

                float led_top_y = vu_start.y + 18.0f;
                float led_bottom_y = vu_start.y + vu_box_h - 16.0f;
                float led_total_h = led_bottom_y - led_top_y;
                int num_segs = 20;
                float seg_h = led_total_h / (float)num_segs;
                float bar_w = 6.0f;
                float bar_l_x = vu_start.x + 4.0f;
                float bar_r_x = vu_start.x + vu_box_w - 4.0f - bar_w;
                float text_center_x = vu_start.x + vu_box_w * 0.5f;

                float norm_l = std::clamp(deck_l.vu_meter, 0.0f, 1.0f);
                float norm_r = std::clamp(deck_r.vu_meter, 0.0f, 1.0f);
                int act_l = (int)(norm_l * (float)num_segs);
                int act_r = (int)(norm_r * (float)num_segs);

                const char* db_labels[8] = { "+6", "+3", "0", "-3", "-6", "-10", "-15", "-24" };
                int db_seg_indices[8] = { 19, 17, 15, 13, 11, 8, 4, 1 };

                for (int s = 0; s < num_segs; s++) {
                    float sy = led_bottom_y - (s + 1) * seg_h;
                    ImU32 lit_col, dim_col;
                    if (s < 12) {
                        lit_col = IM_COL32(0, 255, 120, 255);
                        dim_col = IM_COL32(0, 50, 20, 140);
                    } else if (s < 17) {
                        lit_col = IM_COL32(255, 180, 0, 255);
                        dim_col = IM_COL32(60, 40, 0, 140);
                    } else {
                        lit_col = IM_COL32(255, 30, 60, 255);
                        dim_col = IM_COL32(70, 10, 20, 140);
                    }

                    dl->AddRectFilled(ImVec2(bar_l_x, sy), ImVec2(bar_l_x + bar_w, sy + seg_h - 1.5f), (s <= act_l) ? lit_col : dim_col, 1.0f);
                    dl->AddRectFilled(ImVec2(bar_r_x, sy), ImVec2(bar_r_x + bar_w, sy + seg_h - 1.5f), (s <= act_r) ? lit_col : dim_col, 1.0f);
                }

                for (int d = 0; d < 8; d++) {
                    int s_idx = db_seg_indices[d];
                    float sy = led_bottom_y - (s_idx + 1) * seg_h;
                    ImVec2 d_sz = ImGui::CalcTextSize(db_labels[d]);
                    ImU32 txt_col = (d < 2) ? IM_COL32(255, 100, 120, 220) : ((d == 2) ? IM_COL32(255, 200, 0, 230) : IM_COL32(140, 170, 200, 200));
                    dl->AddText(ImVec2(text_center_x - d_sz.x * 0.5f, sy - 1.0f), txt_col, db_labels[d]);
