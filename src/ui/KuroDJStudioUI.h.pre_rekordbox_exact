                        // Texto do Título & Artista (renderizado sobre a linha selecionável)
                        ImGui::SameLine(0, 4);
                        ImGui::TextColored(ImVec4(1.0f, 1.0f, 1.0f, 1.0f), "%s", t.title.c_str());
                        ImGui::SameLine();
                        ImGui::TextColored(ImVec4(0.55f, 0.65f, 0.75f, 1.0f), "• %s", t.artist.c_str());

                        if (loaded_deck >= 0) {
