                                    if (ptr) {
                                        if (ptr->is_downloaded) spotify_service.loadLibraryTrack(*ptr, right_id, engine);
                                        else spotify_service.downloadLibraryTrackAsync(*ptr, right_id, engine);
                                    }
                                }
                                ImGui::PopStyleColor();

                                ImGui::PopID();
                            }
                            ImGui::EndTable();
                        }
                    }
                }

                // --- 4. RODAPÉ DO GERENCIADOR DE DOWNLOADS ---
                ImGui::Spacing();
                ImGui::Separator();
                ImGui::Spacing();

                // Status à esquerda
                ImGui::TextColored(ImVec4(0.00f, 0.96f, 0.83f, 1.0f), ICON_FA_COMPACT_DISC " STATUS:");
                ImGui::SameLine();
                ImGui::TextColored(ImVec4(0.70f, 0.85f, 0.95f, 1.0f), "%s", spotify_service.getStatus().c_str());

