            ImGui::PushItemWidth(190);
            if (ImGui::InputTextWithHint("##SpotifyQuery", "Buscar título, artista ou tom...", search_query_buf, sizeof(search_query_buf), ImGuiInputTextFlags_EnterReturnsTrue)) {
