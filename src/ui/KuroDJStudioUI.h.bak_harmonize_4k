                ImVec2 p1 = ImVec2(draw_center.x + tri_h * 0.85f, draw_center.y);
                ImVec2 p2 = ImVec2(draw_center.x - tri_h * 0.45f, draw_center.y + tri_h);
                dl->AddTriangleFilled(p0, p1, p2, ring_col);
            }
        }

        void saveDeckGridToMeta(KuroAudio::DJDeck& deck, int d_idx, bool show_feedback = true) {
            if (deck.track_path.empty() || deck.bpm < 20.0 || deck.sample_rate < 1000.0) return;

            std::filesystem::path fpath = std::filesystem::u8path(deck.track_path);
            std::filesystem::path meta_path = fpath;
            meta_path.replace_extension(".meta");

            try {
                std::ofstream mf(meta_path);
                if (mf.is_open()) {
                    mf.imbue(std::locale::classic());
                    double offset_ms = (deck.first_beat_frame / deck.sample_rate) * 1000.0;
                    mf << std::fixed << std::setprecision(2);
                    mf << "{\n";
                    mf << "  \"analyzer\": \"qm_dsp_tempotracker\",\n";
                    mf << "  \"bpm\": " << deck.bpm << ",\n";
                    mf << "  \"key\": \"" << deck.key_signature << "\",\n";
                    mf << "  \"first_beat_offset_ms\": " << offset_ms << ",\n";
                    mf << "  \"first_beat_sec\": " << std::setprecision(5) << (deck.first_beat_frame / deck.sample_rate) << ",\n";
                    mf << "  \"first_beat_frame\": " << (int64_t)std::round(deck.first_beat_frame) << ",\n";
                    mf << "  \"total_beats\": " << (int)deck.rekordbox_beats.size() << ",\n";
                    mf << "  \"is_downbeat_exact\": true\n";
                    mf << "}\n";
                }
            } catch (...) {}

            // Atualiza no DJLibraryManager
            KuroAudio::DJLibraryTrack lt;
            lt.local_wav_path = deck.track_path;
            lt.title = deck.track_title;
            lt.artist = deck.track_artist;
            lt.bpm = deck.bpm;
            lt.key = deck.key_signature;
            KuroAudio::DJLibraryManager::getInstance().addOrUpdateTrack(lt);

            if (show_feedback) {
                char status_buf[64];
                snprintf(status_buf, sizeof(status_buf), "GRID SALVO: %.2f BPM (Gravado em disco)", deck.bpm);
                grid_process_status = status_buf;
                grid_process_status_timer = 3.5f;
            }

            KuroUtils::Log("[Beatgrid Editor] Grid salvo permanentemente Deck " + std::to_string(d_idx + 1) + 
                           ": BPM=" + std::to_string(deck.bpm) + " FirstBeatFrame=" + std::to_string((int64_t)deck.first_beat_frame));
        }

        void reprocessDeckGrid(KuroAudio::DJDeck& deck, int d_idx, KuroAudio::DJEngine& engine) {
            if (deck.track_path.empty() || deck.buffer_l.empty()) {
                grid_process_status = "ERRO: Nenhuma faixa carregada no Deck";
                grid_process_status_timer = 3.5f;
                return;
            }

            std::filesystem::path fpath = std::filesystem::u8path(deck.track_path);
            std::filesystem::path meta_path = fpath;
            meta_path.replace_extension(".meta");

            // 1. Apaga arquivo .meta legado se existir para forçar análise limpa do áudio real
            std::error_code ec;
            if (std::filesystem::exists(meta_path, ec)) {
                std::filesystem::remove(meta_path, ec);
            }

            // 2. Executa a análise profunda de áudio e grid do C++ (Bandpass 50-130Hz + Attack Flux + Autocorrelação de sub-amostra)
            deck.analyzeBPMAndGrid(deck.track_path, true);

            // 3. Atualiza o DJGridEngine
            auto& grid_eng = KuroAudio::DJGridEngine::getInstance();
            grid_eng.setBpm(d_idx, deck.bpm);
            grid_eng.setFirstBeatMarker(d_idx, deck.first_beat_frame, deck.sample_rate);
            auto gd = grid_eng.getGridData(d_idx);
            gd.bpm = deck.bpm;
            gd.first_beat_frame = deck.first_beat_frame;
            gd.is_analyzed = true;
            grid_eng.setGridData(d_idx, gd);

            // 4. Se a agulha estava perto do início ou em pause, posiciona no primeiro beat
            deck.cue_frame = deck.first_beat_frame;
            if (!deck.is_playing) {
                deck.current_frame = deck.first_beat_frame;
            }

            // 5. Salva a calibração com alta fidelidade no arquivo .meta
            try {
                std::ofstream mf(meta_path);
                if (mf.is_open()) {
                    mf.imbue(std::locale::classic());
                    double offset_ms = (deck.first_beat_frame / deck.sample_rate) * 1000.0;
                    mf << std::fixed << std::setprecision(2);
                    mf << "{\n";
                    mf << "  \"analyzer\": \"qm_dsp_tempotracker\",\n";
                    mf << "  \"bpm\": " << deck.bpm << ",\n";
                    mf << "  \"key\": \"" << deck.key_signature << "\",\n";
                    mf << "  \"first_beat_offset_ms\": " << offset_ms << ",\n";
                    mf << "  \"first_beat_sec\": " << std::setprecision(5) << (deck.first_beat_frame / deck.sample_rate) << ",\n";
                    mf << "  \"first_beat_frame\": " << (int64_t)std::round(deck.first_beat_frame) << ",\n";
                    mf << "  \"total_beats\": " << (int)deck.rekordbox_beats.size() << ",\n";
                    mf << "  \"is_downbeat_exact\": true\n";
                    mf << "}\n";
                }
            } catch (...) {}

            // 6. Atualiza no DJLibraryManager
            KuroAudio::DJLibraryTrack lt;
            lt.local_wav_path = deck.track_path;
            lt.title = deck.track_title;
            lt.artist = deck.track_artist;
            lt.bpm = deck.bpm;
            lt.key = deck.key_signature;
            KuroAudio::DJLibraryManager::getInstance().addOrUpdateTrack(lt);

            char status_buf[64];
            snprintf(status_buf, sizeof(status_buf), "GRID OK: %.2f BPM (Beat 1.1 cravado)", deck.bpm);
            grid_process_status = status_buf;
            grid_process_status_timer = 5.0f;

            KuroUtils::Log("[Beatgrid Editor] Deck " + std::to_string(d_idx + 1) + " reprocessado com sucesso: BPM=" + std::to_string(deck.bpm) + " FirstBeatFrame=" + std::to_string((int64_t)deck.first_beat_frame));
        }

