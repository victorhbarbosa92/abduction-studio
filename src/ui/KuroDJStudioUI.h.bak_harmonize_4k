                                } else {
                                    std::string p = rf.local_wav.empty() ? ("scratch/tracks/track_" + rf.id + ".wav") : rf.local_wav;
                                    if (!std::filesystem::exists(p)) p = "scratch/test_astrix.wav";
                                    engine.decks[right_id].loadTrack(p);
                                    engine.decks[right_id].track_title = rf.title;
                                    engine.decks[right_id].track_artist = rf.artist;
                                    if (!rf.key.empty()) {
                                        engine.decks[right_id].key_signature = rf.key;
                                    }
                                    if (rf.bpm > 20.0) {
                                        engine.decks[right_id].bpm = rf.bpm;
                                        KuroAudio::DJGridEngine::getInstance().setBpm(right_id, rf.bpm);
                                    }
                                    if (rf.tex != 0 && rf.tex != 0xFFFFFFFF) {
                                        engine.decks[right_id].gl_cover_texture = rf.tex;
                                        engine.decks[right_id].has_cover_texture = true;
                                        engine.decks[right_id].cover_art_path = rf.local_rgba;
                                    } else if (!rf.local_rgba.empty()) {
                                        GLuint ctex = KuroAudio::SpotifyDJService::UploadRGBATexture(rf.local_rgba);
                                        if (ctex != 0) {
                                            rf.tex = ctex;
                                            engine.decks[right_id].gl_cover_texture = ctex;
                                            engine.decks[right_id].has_cover_texture = true;
                                            engine.decks[right_id].cover_art_path = rf.local_rgba;
                                        }
                                    }
                                }
                            }
                            ImGui::PopStyleColor();
                        }
                        ImGui::PopID();
                    }
                    ImGui::EndTable();
                }
            }
        }

