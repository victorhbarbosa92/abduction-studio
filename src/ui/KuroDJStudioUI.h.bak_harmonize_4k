            renderCentralFrequencyWaveform(engine, w - 8.0f, central_wave_h);

            // =========================================================================
            // BARRA SUPERIOR DE MONITORAMENTO DE FONES (HEADPHONE CUE SECTION)
            // Fica no topo do mixer onde há amplo espaço visual e acesso direto estilo Pioneer DJM
            // =========================================================================
            float hp_sec_y = pos.y + central_wave_h + 7.0f;
            float hp_sec_h = 22.0f;
            ImVec2 hp_rect_min = ImVec2(pos.x + 4.0f, hp_sec_y);
            ImVec2 hp_rect_max = ImVec2(pos.x + w - 4.0f, hp_sec_y + hp_sec_h);
            dl->AddRectFilled(hp_rect_min, hp_rect_max, IM_COL32(14, 18, 24, 255), 2.5f);
            dl->AddRect(hp_rect_min, hp_rect_max, IM_COL32(35, 44, 58, 220), 2.5f, 0, 1.0f);

            auto& routing = KuroAudio::DJAudioRouting::getInstance();
            ImFont* f_hp = g_font_control_small ? g_font_control_small : (g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont());

            // 1. Ícone de Fone (Abre janela de roteamento)
            ImVec2 hp_icon_pos = ImVec2(hp_rect_min.x + 6.0f, hp_sec_y + 3.0f);
            dl->AddCircle(ImVec2(hp_icon_pos.x + 5.0f, hp_icon_pos.y + 6.0f), 4.5f, IM_COL32(0, 220, 255, 255), 16, 1.2f);
            dl->AddRectFilled(ImVec2(hp_icon_pos.x + 1.5f, hp_icon_pos.y + 6.0f), ImVec2(hp_icon_pos.x + 4.5f, hp_icon_pos.y + 10.5f), IM_COL32(0, 220, 255, 255), 1.0f);
            dl->AddRectFilled(ImVec2(hp_icon_pos.x + 5.5f, hp_icon_pos.y + 6.0f), ImVec2(hp_icon_pos.x + 8.5f, hp_icon_pos.y + 10.5f), IM_COL32(0, 220, 255, 255), 1.0f);
            ImGui::SetCursorScreenPos(ImVec2(hp_icon_pos.x - 2.0f, hp_sec_y + 2.0f));
            if (ImGui::InvisibleButton("##HpIconRoutingBtn", ImVec2(15.0f, 18.0f))) {
                auto& devMgr = KuroAudio::DJAudioDeviceManager::getInstance();
                devMgr.show_routing_modal = !devMgr.show_routing_modal;
                if (devMgr.show_routing_modal) devMgr.rescanDevices();
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Configurar Saídas de Áudio / Fone (Clique para abrir)");

            // 2. Slider Fone MIX
            float hp_mix = routing.getCueMix();
            ImGui::SetCursorScreenPos(ImVec2(hp_rect_min.x + 24.0f, hp_sec_y + 3.0f));
            ImGui::PushItemWidth(34.0f);
            if (ImGui::SliderFloat("##HPMix", &hp_mix, 0.0f, 1.0f, "")) routing.setCueMix(hp_mix);
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Fone Cue / Master Mix: %.0f%% Master", hp_mix * 100.0f);
            ImGui::PopItemWidth();

            // 3. Slider Fone VOL (Gain)
            float hp_gain = routing.getHeadphoneGain();
            ImGui::SetCursorScreenPos(ImVec2(hp_rect_min.x + 63.0f, hp_sec_y + 3.0f));
            ImGui::PushItemWidth(34.0f);
            if (ImGui::SliderFloat("##HPGain", &hp_gain, 0.0f, 1.5f, "")) routing.setHeadphoneGain(hp_gain);
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Volume dos Fones: %.0f%%", hp_gain * 100.0f);
            ImGui::PopItemWidth();

            // 4. Botão [MASTER CUE] (M)
            float mst_w = 26.0f;
            float mst_h = 16.0f;
            float mst_x = hp_rect_max.x - mst_w - 4.0f;
            float mst_y = hp_sec_y + 3.0f;
            bool mst_cue = engine.getCueMaster();
            dl->AddRectFilled(ImVec2(mst_x, mst_y), ImVec2(mst_x + mst_w, mst_y + mst_h),
                              mst_cue ? IM_COL32(235, 130, 20, 255) : IM_COL32(22, 28, 38, 255), 2.0f);
            dl->AddRect(ImVec2(mst_x, mst_y), ImVec2(mst_x + mst_w, mst_y + mst_h),
                        mst_cue ? IM_COL32(255, 195, 45, 255) : IM_COL32(46, 58, 76, 200), 2.0f, 0, 1.0f);
            ImVec2 mc_sz = f_hp->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "M");
            dl->AddText(f_hp, 11.0f, ImVec2(mst_x + (mst_w - mc_sz.x) * 0.5f, mst_y + (mst_h - mc_sz.y) * 0.5f),
                        mst_cue ? IM_COL32(255, 255, 255, 255) : IM_COL32(180, 195, 215, 240), "M");
            ImGui::SetCursorScreenPos(ImVec2(mst_x, mst_y));
            if (ImGui::InvisibleButton("##RekMasterCueBtn", ImVec2(mst_w, mst_h))) {
                engine.setCueMaster(!mst_cue);
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("MASTER CUE (M): Enviar sinal do Master para os fones de ouvido");

            // Divisor fino entre a Seção de Fone e os Canais do Mixer
            float div_y = hp_sec_y + hp_sec_h + 5.0f;
            dl->AddLine(ImVec2(pos.x + 4.0f, div_y), ImVec2(pos.x + w - 4.0f, div_y), IM_COL32(36, 44, 58, 220), 1.0f);

            int left_id = ddj_hardware.getActiveLeftDeck();
            int right_id = ddj_hardware.getActiveRightDeck();
            KuroAudio::DJDeck& deck_l = engine.decks[left_id];
            KuroAudio::DJDeck& deck_r = engine.decks[right_id];

            float ch_w = (w - 12.0f) * 0.5f;

            // Seção inferior (Crossfader + Channel Assign)
            float bot_sec_h = 48.0f;
            float bot_sec_y = pos.y + h - bot_sec_h - 4.0f;

            // Linha vertical divisória entre os dois canais (estilo Rekordbox 1:1)
            dl->AddLine(ImVec2(pos.x + w * 0.5f, div_y + 2.0f), ImVec2(pos.x + w * 0.5f, bot_sec_y - 4.0f), IM_COL32(40, 48, 60, 200), 1.0f);

            // Espaço vertical útil para os canais do mixer
            float avail_ctrl_h = bot_sec_y - div_y - 8.0f;
            bool compact_mixer = (avail_ctrl_h < 170.0f);

            auto drawRekordboxKnob = [&](const char* id, const char* label, float* p_val, float v_min, float v_max, float def_val, float cx, float cy, float radius, float gr_lin = 1.0f, bool is_comp = false) {
                ImVec2 center = ImVec2(cx, cy);
                ImVec2 b_min = ImVec2(cx - radius - 3.0f, cy - radius - 3.0f);
                ImGui::SetCursorScreenPos(b_min);
                ImGui::InvisibleButton(id, ImVec2(radius * 2.0f + 6.0f, radius * 2.0f + 6.0f));
                bool is_active = ImGui::IsItemActive();
                bool is_hovered = ImGui::IsItemHovered();

                if (is_active && ImGui::GetIO().MouseDelta.y != 0.0f) {
                    float step = (v_max - v_min) / 160.0f;
                    *p_val -= ImGui::GetIO().MouseDelta.y * step;
                    *p_val = std::clamp(*p_val, v_min, v_max);
                }
                if (is_hovered && ImGui::GetIO().MouseWheel != 0.0f) {
                    *p_val += ImGui::GetIO().MouseWheel * ((v_max - v_min) / 30.0f);
                    *p_val = std::clamp(*p_val, v_min, v_max);
                }
                if (is_hovered && ImGui::IsMouseDoubleClicked(0)) {
                    *p_val = def_val;
                }
                if (is_hovered && is_comp) {
                    float gr_db = (gr_lin > 0.001f) ? (20.0f * std::log10(gr_lin)) : 0.0f;
                    ImGui::SetTooltip("PIONEER COMP (Compressor de Canal DJM-V10 / DJM-A9)\n"
                                      "• Valor: %.0f%%\n"
                                      "• Redução de Ganho (GR): %.1f dB\n"
                                      "• Encorpa graves e médios preservando o punch dos kicks\n"
                                      "• Duplo clique para resetar (Bypass)", (*p_val) * 100.0f, gr_db);
                }

                float norm = (*p_val - v_min) / std::max(0.0001f, (v_max - v_min));
                norm = std::clamp(norm, 0.0f, 1.0f);
                float ang = (-140.0f + norm * 280.0f) * ((float)M_PI / 180.0f) - (float)M_PI * 0.5f;

                // Anel LED de Compressão Dinâmica Âmbar Pioneer (DJM-V10 / DJM-A9 Style)
                if (is_comp) {
                    // Anel base sutil ao redor do knob
                    dl->AddCircle(center, radius + 2.5f, IM_COL32(35, 25, 15, 180), 24, 1.5f);
                    
                    float comp_intensity = std::clamp((1.0f - gr_lin) * 3.5f, 0.0f, 1.0f);
                    if (comp_intensity > 0.01f) {
                        // LED de redução de ganho pulsando em cor âmbar Pioneer intensa
                        ImU32 amber_glow = IM_COL32(255, 150, 20, (int)(110.0f + comp_intensity * 145.0f));
                        dl->AddCircle(center, radius + 2.5f, amber_glow, 24, 2.0f);
                        ImVec2 led_pos = ImVec2(center.x + radius + 3.5f, center.y - radius + 1.0f);
                        dl->AddCircleFilled(led_pos, 2.0f, amber_glow);
                    } else if (*p_val > 0.01f) {
                        // Engatado mas sem atingir o threshold: anel âmbar sutil
                        dl->AddCircle(center, radius + 2.5f, IM_COL32(180, 100, 20, 120), 24, 1.2f);
                    }
                }

                // Corpo do knob (Dark Rekordbox Cap)
                dl->AddCircleFilled(center, radius + 1.0f, IM_COL32(10, 12, 16, 255), 24);
                dl->AddCircle(center, radius + 1.0f, is_active ? IM_COL32(0, 140, 240, 255) : (is_hovered ? IM_COL32(70, 85, 110, 255) : IM_COL32(38, 44, 55, 220)), 24, 1.2f);
                dl->AddCircleFilled(center, radius - 1.0f, IM_COL32(24, 28, 36, 255), 24);

                // Indicador radial de precisão (Âmbar Pioneer quando COMP > 0, Branco caso contrário)
                ImU32 ptr_col = (is_comp && *p_val > 0.01f) ? IM_COL32(255, 175, 45, 255) : IM_COL32(255, 255, 255, 255);
                ImVec2 p_in = ImVec2(center.x + std::cos(ang) * (radius * 0.22f), center.y + std::sin(ang) * (radius * 0.22f));
                ImVec2 p_out = ImVec2(center.x + std::cos(ang) * (radius - 1.2f), center.y + std::sin(ang) * (radius - 1.2f));
                dl->AddLine(p_in, p_out, ptr_col, 2.0f);

                // Texto do label diretamente abaixo do knob
                ImFont* f_lbl = g_font_control_small ? g_font_control_small : (g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont());
                ImVec2 sz_l = f_lbl->CalcTextSizeA(10.0f, FLT_MAX, 0.0f, label);
                ImU32 text_col = is_comp ? IM_COL32(255, 170, 50, 240) : IM_COL32(185, 200, 220, 240);
                dl->AddText(f_lbl, 10.0f, ImVec2(center.x - sz_l.x * 0.5f, center.y + radius + 1.0f), text_col, label);
            };

            auto drawRekordboxFader = [&](const char* id, float* p_val, float cx, float top_y, float fader_h, float vu_val, float vu_x) {
                float bot_y = top_y + fader_h;
                float mid_y = top_y + fader_h * 0.5f;

                ImGui::SetCursorScreenPos(ImVec2(cx - 12.0f, top_y));
                ImGui::InvisibleButton(id, ImVec2(24.0f, fader_h));
                bool is_active = ImGui::IsItemActive();
                bool is_hovered = ImGui::IsItemHovered();

                if (is_active) {
                    float my = ImGui::GetIO().MousePos.y;
                    float norm = 1.0f - ((my - top_y) / fader_h);
                    *p_val = std::clamp(norm, 0.0f, 1.0f);
                }
                if (is_hovered && ImGui::GetIO().MouseWheel != 0.0f) {
                    *p_val += ImGui::GetIO().MouseWheel * 0.05f;
                    *p_val = std::clamp(*p_val, 0.0f, 1.0f);
                }
                if (is_hovered && ImGui::IsMouseDoubleClicked(0)) {
                    *p_val = 1.0f; // 0 dB
                }

                float norm = std::clamp(*p_val, 0.0f, 1.0f);

                // 1. Ranhuras de calibração horizontais cinza (Top, Mid, Bottom)
                dl->AddLine(ImVec2(cx - 9.0f, top_y), ImVec2(cx + 9.0f, top_y), IM_COL32(80, 90, 105, 220), 1.2f);
                dl->AddLine(ImVec2(cx - 6.0f, mid_y), ImVec2(cx + 6.0f, mid_y), IM_COL32(65, 75, 90, 180), 1.0f);
                dl->AddLine(ImVec2(cx - 9.0f, bot_y), ImVec2(cx + 9.0f, bot_y), IM_COL32(80, 90, 105, 220), 1.2f);

                // 2. Trilha vertical azul vibrante Rekordbox (#0070e0)
                dl->AddLine(ImVec2(cx, top_y), ImVec2(cx, bot_y), IM_COL32(0, 112, 224, 255), 2.2f);

                // 3. Cap do fader metálico horizontal com linha central branca
                float cap_y = bot_y - norm * fader_h;
                dl->AddRectFilled(ImVec2(cx - 10.0f, cap_y - 3.5f), ImVec2(cx + 10.0f, cap_y + 3.5f), IM_COL32(40, 48, 60, 255), 1.5f);
                dl->AddRect(ImVec2(cx - 10.0f, cap_y - 3.5f), ImVec2(cx + 10.0f, cap_y + 3.5f), IM_COL32(80, 95, 115, 240), 1.5f, 0, 1.0f);
                dl->AddLine(ImVec2(cx - 8.0f, cap_y), ImVec2(cx + 8.0f, cap_y), IM_COL32(255, 255, 255, 255), 1.5f);

                // 4. VU Meter LED ao lado do fader
                float vu_w = 3.0f;
                dl->AddRectFilled(ImVec2(vu_x, top_y), ImVec2(vu_x + vu_w, bot_y), IM_COL32(6, 8, 12, 255));
                int segs = 14;
                float seg_h = fader_h / (float)segs;
                int lit_segs = (int)(std::clamp(vu_val, 0.0f, 1.0f) * (float)segs);
                for (int s = 0; s < segs; s++) {
                    float sy = bot_y - (float)(s + 1) * seg_h;
                    bool lit = (s < lit_segs);
                    ImU32 sc = IM_COL32(0, 220, 255, 240);
                    if (s >= 12) sc = IM_COL32(255, 30, 45, 255);
                    else if (s >= 9) sc = IM_COL32(255, 175, 0, 255);
                    if (!lit) sc = IM_COL32(15, 22, 32, 160);
                    dl->AddRectFilled(ImVec2(vu_x, sy + 0.5f), ImVec2(vu_x + vu_w, sy + seg_h - 0.5f), sc, 0.5f);
                }
            };

            auto drawMixerStrip = [&](KuroAudio::DJDeck& deck, int id, float start_x) {
                bool is_cue = (id == 0) ? engine.getCueDeckA() : engine.getCueDeckB();
                auto toggleCue = [&]() {
                    if (id == 0) engine.setCueDeckA(!is_cue);
                    else engine.setCueDeckB(!is_cue);
                };

                if (compact_mixer) {
                    // =====================================================================
                    // MODO COMPACTO / TALL WAVES: FADERS NA LATERAL DOS KNOBS!
                    // =====================================================================
                    float knobs_cx, fader_cx, vu_x;

                    if (id == 0) {
                        // Deck 1 (Esquerda): Fader na extrema esquerda, Knobs à direita voltados ao centro
                        fader_cx = start_x + 16.0f;
                        vu_x = fader_cx + 12.0f;
                        knobs_cx = start_x + ch_w - 22.0f;
                    } else {
                        // Deck 2 (Direita): Knobs à esquerda voltados ao centro, Fader na extrema direita
                        knobs_cx = start_x + 22.0f;
                        fader_cx = start_x + ch_w - 16.0f;
                        vu_x = fader_cx - 15.0f;
                    }

                    // 1. Botão CUE FIXO NA BASE DO MIXER (Sem sobreposição aos knobs)
                    float cue_w = 34.0f;
                    float cue_h = 16.0f;
                    float cue_y = bot_sec_y - cue_h - 5.0f; // Fixo no fundo do canal antes do crossfader
                    ImVec2 cue_min = ImVec2(knobs_cx - cue_w * 0.5f, cue_y);
                    ImVec2 cue_max = ImVec2(knobs_cx + cue_w * 0.5f, cue_y + cue_h);

                    ImGui::SetCursorScreenPos(cue_min);
                    char cb_id[32]; snprintf(cb_id, sizeof(cb_id), "##RekCueBtn_%d", id);
                    if (ImGui::InvisibleButton(cb_id, ImVec2(cue_w, cue_h))) {
                        toggleCue();
                    }
                    dl->AddRectFilled(cue_min, cue_max, is_cue ? IM_COL32(180, 80, 0, 255) : IM_COL32(22, 26, 34, 255), 2.0f);
                    dl->AddRect(cue_min, cue_max, is_cue ? IM_COL32(255, 160, 20, 255) : IM_COL32(45, 54, 68, 220), 2.0f, 0, 1.0f);
                    ImVec2 sz_cue = ImGui::CalcTextSize("CUE");
                    dl->AddText(ImVec2(cue_min.x + (cue_w - sz_cue.x) * 0.5f, cue_min.y + 1.0f), is_cue ? IM_COL32(255, 255, 255, 255) : IM_COL32(200, 215, 235, 240), "CUE");

                    // 2. Os 5 Knobs (TRIM, COMP, HIGH, MID, LOW) distribuídos acima do CUE
                    float max_low_cy = cue_y - 20.0f; // Margem segura: o label "LOW" fica totalmente acima do CUE
                    float trim_cy = div_y + 8.0f;
                    float k_step = std::clamp((max_low_cy - trim_cy) / 4.0f, 15.0f, 25.0f);
                    float k_r = (k_step < 18.0f) ? 5.8f : 6.5f;

                    float cy = trim_cy;
                    char t_id[32]; snprintf(t_id, sizeof(t_id), "##RekTrim_%d", id);
                    drawRekordboxKnob(t_id, "TRIM", &deck.gain, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    cy += k_step;
                    char c_id[32]; snprintf(c_id, sizeof(c_id), "##RekComp_%d", id);
                    drawRekordboxKnob(c_id, "COMP", &deck.comp, 0.0f, 1.0f, 0.0f, knobs_cx, cy, k_r, deck.compressor.gain_reduction, true);

                    cy += k_step;
                    char h_id[32]; snprintf(h_id, sizeof(h_id), "##RekHigh_%d", id);
                    drawRekordboxKnob(h_id, "HIGH", &deck.eq_high, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    cy += k_step;
                    char m_id[32]; snprintf(m_id, sizeof(m_id), "##RekMid_%d", id);
                    drawRekordboxKnob(m_id, "MID", &deck.eq_mid, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    cy += k_step;
                    char l_id[32]; snprintf(l_id, sizeof(l_id), "##RekLow_%d", id);
                    drawRekordboxKnob(l_id, "LOW", &deck.eq_low, 0.0f, 2.0f, 1.0f, knobs_cx, cy, k_r);

                    // 3. Fader de Volume na Lateral (alinhado do topo até a base do botão CUE)
                    float fader_top_y = div_y + 8.0f;
                    float fader_bot_y = bot_sec_y - 5.0f;
                    float fader_h = std::clamp(fader_bot_y - fader_top_y, 50.0f, 160.0f);
                    char f_id[32]; snprintf(f_id, sizeof(f_id), "##RekFader_%d", id);
                    drawRekordboxFader(f_id, &deck.volume, fader_cx, fader_top_y, fader_h, deck.vu_meter, vu_x);

                } else {
                    // =====================================================================
                    // MODO VERTICAL PADRÃO (Janela Alta / Waves Normais): Faders abaixo dos Knobs
                    // =====================================================================
                    float ch_cx = start_x + ch_w * 0.5f;
                    float k_r = 8.5f;
                    float k_step = std::clamp((avail_ctrl_h - 110.0f) / 5.0f, 23.0f, 30.0f);
                    float cy = div_y + 10.0f;

                    // 1. TRIM
                    char t_id[32]; snprintf(t_id, sizeof(t_id), "##RekTrim_%d", id);
                    drawRekordboxKnob(t_id, "TRIM", &deck.gain, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 2. COMP (Pioneer DJM-V10 / DJM-A9)
                    cy += k_step;
                    char c_id[32]; snprintf(c_id, sizeof(c_id), "##RekComp_%d", id);
                    drawRekordboxKnob(c_id, "COMP", &deck.comp, 0.0f, 1.0f, 0.0f, ch_cx, cy, k_r, deck.compressor.gain_reduction, true);

                    // 3. HIGH
                    cy += k_step;
                    char h_id[32]; snprintf(h_id, sizeof(h_id), "##RekHigh_%d", id);
                    drawRekordboxKnob(h_id, "HIGH", &deck.eq_high, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 4. MID
                    cy += k_step;
                    char m_id[32]; snprintf(m_id, sizeof(m_id), "##RekMid_%d", id);
                    drawRekordboxKnob(m_id, "MID", &deck.eq_mid, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 5. LOW
                    cy += k_step;
                    char l_id[32]; snprintf(l_id, sizeof(l_id), "##RekLow_%d", id);
                    drawRekordboxKnob(l_id, "LOW", &deck.eq_low, 0.0f, 2.0f, 1.0f, ch_cx, cy, k_r);

                    // 6. CUE BUTTON (Sem sobrepor o label do LOW)
                    cy += k_r + 14.0f;
                    float cue_btn_w = 36.0f;
                    float cue_btn_h = 16.0f;
                    ImVec2 cue_min = ImVec2(ch_cx - cue_btn_w * 0.5f, cy);
                    ImVec2 cue_max = ImVec2(ch_cx + cue_btn_w * 0.5f, cy + cue_btn_h);

                    ImGui::SetCursorScreenPos(cue_min);
                    char cb_id[32]; snprintf(cb_id, sizeof(cb_id), "##RekCueBtn_%d", id);
                    if (ImGui::InvisibleButton(cb_id, ImVec2(cue_btn_w, cue_btn_h))) {
                        toggleCue();
                    }
                    dl->AddRectFilled(cue_min, cue_max, is_cue ? IM_COL32(180, 80, 0, 255) : IM_COL32(22, 26, 34, 255), 2.0f);
                    dl->AddRect(cue_min, cue_max, is_cue ? IM_COL32(255, 160, 20, 255) : IM_COL32(45, 54, 68, 220), 2.0f, 0, 1.0f);
                    ImVec2 sz_cue = ImGui::CalcTextSize("CUE");
                    dl->AddText(ImVec2(cue_min.x + (cue_btn_w - sz_cue.x) * 0.5f, cue_min.y + 2.0f), is_cue ? IM_COL32(255, 255, 255, 255) : IM_COL32(200, 215, 235, 240), "CUE");

                    // 7. CHANNEL FADER & VU METER
                    float fader_top_y = cy + cue_btn_h + 8.0f;
                    float fader_h = std::clamp(bot_sec_y - fader_top_y - 8.0f, 35.0f, 95.0f);
                    char f_id[32]; snprintf(f_id, sizeof(f_id), "##RekFader_%d", id);
                    drawRekordboxFader(f_id, &deck.volume, ch_cx, fader_top_y, fader_h, deck.vu_meter, ch_cx + 18.0f);
                }
            };

            drawMixerStrip(deck_l, 0, pos.x + 4.0f);
            drawMixerStrip(deck_r, 1, pos.x + 4.0f + ch_w + 4.0f);

            // 7. SEÇÃO INFERIOR DO MIXER: EXCLUSIVA PARA O CROSSFADER E ATRIBUIÇÃO (SEM FONES)
            // Linha divisoria sutil acima da secao do Crossfader
            dl->AddLine(ImVec2(pos.x + 8.0f, bot_sec_y - 2.0f), ImVec2(pos.x + w - 8.0f, bot_sec_y - 2.0f), IM_COL32(36, 44, 58, 180), 1.0f);

            // =========================================================================
            // LINHA DE CONTROLE DO CROSSFADER: [1] (ESQ) | CURVA (CENTRO) | [2] (DIR)
            // =========================================================================
            float row_ctrl_y = bot_sec_y + 4.0f;
            ImFont* f_ctrl = g_font_control_small ? g_font_control_small : (g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont());
            float btn_h = 16.0f;

            // [ 1 ] Deck 1 Assign (Lado Esquerdo do Crossfader)
            float ass_1_w = 26.0f;
            float ass_1_x = pos.x + 14.0f;
            bool ass_1_act = (left_id == 0);
            dl->AddRectFilled(ImVec2(ass_1_x, row_ctrl_y), ImVec2(ass_1_x + ass_1_w, row_ctrl_y + btn_h),
                              ass_1_act ? IM_COL32(0, 120, 235, 255) : IM_COL32(20, 26, 36, 255), 2.5f);
            dl->AddRect(ImVec2(ass_1_x, row_ctrl_y), ImVec2(ass_1_x + ass_1_w, row_ctrl_y + btn_h),
                        ass_1_act ? IM_COL32(0, 215, 255, 240) : IM_COL32(45, 55, 72, 200), 2.5f, 0, 1.0f);
            ImVec2 sz_1 = f_ctrl->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "1");
            dl->AddText(f_ctrl, 11.0f, ImVec2(ass_1_x + (ass_1_w - sz_1.x) * 0.5f, row_ctrl_y + (btn_h - sz_1.y) * 0.5f),
                        ass_1_act ? IM_COL32(255, 255, 255, 255) : IM_COL32(165, 180, 200, 240), "1");
            ImGui::SetCursorScreenPos(ImVec2(ass_1_x, row_ctrl_y));
            if (ImGui::InvisibleButton("##ChAss_1", ImVec2(ass_1_w, btn_h))) {
                ddj_hardware.setActiveLeftDeck(0);
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Crossfader Assign: Atribuir Deck 1 ao lado esquerdo");

            // Curva do Crossfader (Centro: Smooth ~ / Sharp ^ / Cut |_)
            float crv_w = 32.0f;
            float crv_x = pos.x + (w - crv_w) * 0.5f;
            int cur_crv = engine.getCrossfaderCurve();
            const char* crv_symbol = (cur_crv == 0 ? "~" : (cur_crv == 1 ? "^" : "|_"));
            dl->AddRectFilled(ImVec2(crv_x, row_ctrl_y), ImVec2(crv_x + crv_w, row_ctrl_y + btn_h), IM_COL32(20, 26, 36, 255), 2.5f);
            dl->AddRect(ImVec2(crv_x, row_ctrl_y), ImVec2(crv_x + crv_w, row_ctrl_y + btn_h), IM_COL32(45, 55, 72, 200), 2.5f, 0, 1.0f);
            ImVec2 crv_sz = f_ctrl->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, crv_symbol);
            dl->AddText(f_ctrl, 11.0f, ImVec2(crv_x + (crv_w - crv_sz.x) * 0.5f, row_ctrl_y + (btn_h - crv_sz.y) * 0.5f), IM_COL32(0, 200, 255, 240), crv_symbol);
            ImGui::SetCursorScreenPos(ImVec2(crv_x, row_ctrl_y));
            if (ImGui::InvisibleButton("##RekXFCurve", ImVec2(crv_w, btn_h))) {
                engine.setCrossfaderCurve((cur_crv + 1) % 3);
            }
            if (ImGui::IsItemHovered()) {
                const char* crv_names[] = { "Linear / Suave (House/Techno)", "Íngreme / Acentuada (Mix rápido)", "Corte Rápido / Scratch (Hip-Hop/Turntablism)" };
                ImGui::SetTooltip("Curva do Crossfader: %s\n(Clique para alternar)", crv_names[cur_crv % 3]);
            }

            // [ 2 ] Deck 2 Assign (Lado Direito do Crossfader)
            float ass_2_w = 26.0f;
            float ass_2_x = pos.x + w - ass_2_w - 14.0f;
            bool ass_2_act = (right_id == 1);
            dl->AddRectFilled(ImVec2(ass_2_x, row_ctrl_y), ImVec2(ass_2_x + ass_2_w, row_ctrl_y + btn_h),
                              ass_2_act ? IM_COL32(220, 120, 0, 255) : IM_COL32(20, 26, 36, 255), 2.5f);
            dl->AddRect(ImVec2(ass_2_x, row_ctrl_y), ImVec2(ass_2_x + ass_2_w, row_ctrl_y + btn_h),
                        ass_2_act ? IM_COL32(255, 185, 30, 240) : IM_COL32(45, 55, 72, 200), 2.5f, 0, 1.0f);
            ImVec2 sz_2 = f_ctrl->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "2");
            dl->AddText(f_ctrl, 11.0f, ImVec2(ass_2_x + (ass_2_w - sz_2.x) * 0.5f, row_ctrl_y + (btn_h - sz_2.y) * 0.5f),
                        ass_2_act ? IM_COL32(255, 255, 255, 255) : IM_COL32(165, 180, 200, 240), "2");
            ImGui::SetCursorScreenPos(ImVec2(ass_2_x, row_ctrl_y));
            if (ImGui::InvisibleButton("##ChAss_2", ImVec2(ass_2_w, btn_h))) {
                ddj_hardware.setActiveRightDeck(1);
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Crossfader Assign: Atribuir Deck 2 ao lado direito");

            // =========================================================================
            // CROSSFADER (TRILHO INFERIOR DEDICADO, RESPIRO TOTAL)
            // =========================================================================
            float xf_y = bot_sec_y + 27.0f;
            float xf_rail_l = pos.x + 14.0f;
            float xf_rail_r = pos.x + w - 14.0f;
            float xf_rail_w = xf_rail_r - xf_rail_l;
            float xf_cx = pos.x + w * 0.5f;

            // Fundo escuro rebaixado do rasgo do crossfader
            dl->AddRectFilled(ImVec2(xf_rail_l - 2.0f, xf_y - 2.5f), ImVec2(xf_rail_r + 2.0f, xf_y + 2.5f), IM_COL32(8, 10, 14, 255), 2.0f);
            // Trilho metalico
            dl->AddLine(ImVec2(xf_rail_l, xf_y), ImVec2(xf_rail_r, xf_y), IM_COL32(50, 60, 78, 255), 1.8f);
            // Marcacao central de 50/50 (Center White Tick)
            dl->AddLine(ImVec2(xf_cx, xf_y - 6.0f), ImVec2(xf_cx, xf_y + 6.0f), IM_COL32(200, 215, 235, 255), 1.5f);
            // Limites laterais
            dl->AddLine(ImVec2(xf_rail_l, xf_y - 4.0f), ImVec2(xf_rail_l, xf_y + 4.0f), IM_COL32(90, 105, 125, 255), 1.2f);
            dl->AddLine(ImVec2(xf_rail_r, xf_y - 4.0f), ImVec2(xf_rail_r, xf_y + 4.0f), IM_COL32(90, 105, 125, 255), 1.2f);

            // Cap metalico do crossfader Pioneer com linha branca
            float xf_val = engine.getCrossfader();
            float cap_x = xf_rail_l + xf_val * xf_rail_w;
            dl->AddRectFilled(ImVec2(cap_x - 7.0f, xf_y - 7.5f), ImVec2(cap_x + 7.0f, xf_y + 7.5f), IM_COL32(38, 46, 58, 255), 2.0f);
            dl->AddRect(ImVec2(cap_x - 7.0f, xf_y - 7.5f), ImVec2(cap_x + 7.0f, xf_y + 7.5f), IM_COL32(85, 105, 130, 240), 2.0f, 0, 1.0f);
            dl->AddLine(ImVec2(cap_x, xf_y - 6.0f), ImVec2(cap_x, xf_y + 6.0f), IM_COL32(255, 255, 255, 255), 1.5f);

            ImGui::SetCursorScreenPos(ImVec2(xf_rail_l - 6.0f, xf_y - 10.0f));
            if (ImGui::InvisibleButton("##RekXFTrack", ImVec2(xf_rail_w + 12.0f, 20.0f))) {
                float mx = ImGui::GetIO().MousePos.x - xf_rail_l;
                engine.setCrossfader(std::clamp(mx / xf_rail_w, 0.0f, 1.0f));
            }
            if (ImGui::IsItemActive()) {
                float mx = ImGui::GetIO().MousePos.x - xf_rail_l;
                engine.setCrossfader(std::clamp(mx / xf_rail_w, 0.0f, 1.0f));
            }
            if (ImGui::IsItemHovered()) {
                if (ImGui::IsMouseDoubleClicked(0)) {
                    engine.setCrossfader(0.5f);
                }
                ImGui::SetTooltip("Crossfader (%.0f%% / 2-clique centraliza no meio)", xf_val * 100.0f);
            }
        }

