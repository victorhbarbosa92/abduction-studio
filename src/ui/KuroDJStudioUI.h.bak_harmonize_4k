        void renderPioneerRoundButton(const char* label, ImVec2 center, float radius, ImU32 ring_col, ImU32 bg_col, bool is_active, 
                                      std::function<void()> on_press, std::function<void()> on_release = nullptr) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 top_left = ImVec2(center.x - radius, center.y - radius);
            
            char btn_id[32];
            snprintf(btn_id, sizeof(btn_id), "##PioBtn_%s", label);
            ImGui::SetCursorScreenPos(top_left);
            ImGui::InvisibleButton(btn_id, ImVec2(radius * 2.0f, radius * 2.0f));
            
