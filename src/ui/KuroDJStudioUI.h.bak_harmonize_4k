        // ═════════════════════════════════════════════════════════════════════════════════
        // PIONEER DIGITAL CONSOLE BEAT STEPPER: [ ◄ |  1/2  | ► ] (Cápsula Integrada OLED)
        // ═════════════════════════════════════════════════════════════════════════════════
        static bool renderPioneerBeatStepper(const char* id_prefix, int s_idx, int* p_beat_idx, int max_idx, 
                                             const char* disp_text, ImVec2 pos, ImVec2 size, ImU32 accent_col = IM_COL32(0, 229, 255, 255)) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImGuiIO& io = ImGui::GetIO();
            bool changed = false;

            float w = size.x;
            float h = size.y;
            float btn_w = 13.0f;
            float oled_w = std::max(16.0f, w - btn_w * 2.0f);

            // 1. Chassi da Cápsula Integrada estilo Pioneer CDJ / DJM
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(8, 10, 15, 255), 2.5f);
            dl->AddRect(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(38, 48, 64, 220), 2.5f, 0, 1.0f);

            // Separadores verticais sutis entre as seções da cápsula
            dl->AddLine(ImVec2(pos.x + btn_w, pos.y + 1.0f), ImVec2(pos.x + btn_w, pos.y + h - 1.0f), IM_COL32(28, 36, 48, 200), 1.0f);
            dl->AddLine(ImVec2(pos.x + btn_w + oled_w, pos.y + 1.0f), ImVec2(pos.x + btn_w + oled_w, pos.y + h - 1.0f), IM_COL32(28, 36, 48, 200), 1.0f);

            // 2. Botão Esquerdo: Seta de Decremento ◄ (Triângulo Vetorial Anti-aliased)
            ImVec2 l_pos = pos;
            ImGui::SetCursorScreenPos(l_pos);
            char l_id[64]; snprintf(l_id, sizeof(l_id), "##ps_dec_%s_%d", id_prefix, s_idx);
            ImGui::InvisibleButton(l_id, ImVec2(btn_w, h));
            bool l_hovered = ImGui::IsItemHovered();
            bool l_active = ImGui::IsItemActive();
            if (ImGui::IsItemClicked(0)) {
                if (*p_beat_idx > 0) {
                    (*p_beat_idx)--;
                    changed = true;
                }
            }

            if (l_hovered) {
                dl->AddRectFilled(l_pos, ImVec2(l_pos.x + btn_w, l_pos.y + h), 
                                  l_active ? IM_COL32(0, 180, 255, 90) : IM_COL32(255, 255, 255, 30), 2.0f);
            }

            // Triângulo ◄
            float cy = pos.y + h * 0.5f;
            float tri_h = 3.2f;
            float tri_w = 4.0f;
            float tri_cx = l_pos.x + btn_w * 0.5f;
            ImU32 tri_col_l = (*p_beat_idx > 0) ? (l_hovered ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 185, 215, 220)) 
                                                : IM_COL32(65, 75, 90, 160);
            dl->AddTriangleFilled(ImVec2(tri_cx - tri_w * 0.5f, cy),
                                  ImVec2(tri_cx + tri_w * 0.5f, cy - tri_h),
                                  ImVec2(tri_cx + tri_w * 0.5f, cy + tri_h),
                                  tri_col_l);

            // 3. Display Central OLED (Fundo Preto Profundo com Texto Ciano / Âmbar Glow)
            ImVec2 oled_pos = ImVec2(pos.x + btn_w, pos.y);
            dl->AddRectFilled(oled_pos, ImVec2(oled_pos.x + oled_w, oled_pos.y + h), IM_COL32(4, 5, 8, 255));

            ImVec2 txt_sz = ImGui::CalcTextSize(disp_text);
            dl->AddText(ImVec2(oled_pos.x + (oled_w - txt_sz.x) * 0.5f, oled_pos.y + (h - txt_sz.y) * 0.5f),
                        accent_col, disp_text);

            // Suporte a mouse wheel no display OLED para scrub intuitivo de frações
            ImGui::SetCursorScreenPos(oled_pos);
            char oled_id[64]; snprintf(oled_id, sizeof(oled_id), "##ps_scrub_%s_%d", id_prefix, s_idx);
            ImGui::InvisibleButton(oled_id, ImVec2(oled_w, h));
            if (ImGui::IsItemHovered()) {
                if (io.MouseWheel > 0.0f && *p_beat_idx < max_idx - 1) {
                    (*p_beat_idx)++;
                    changed = true;
                } else if (io.MouseWheel < 0.0f && *p_beat_idx > 0) {
                    (*p_beat_idx)--;
                    changed = true;
                }
            }

            // 4. Botão Direito: Seta de Incremento ► (Triângulo Vetorial Anti-aliased)
            ImVec2 r_pos = ImVec2(pos.x + btn_w + oled_w, pos.y);
            ImGui::SetCursorScreenPos(r_pos);
            char r_id[64]; snprintf(r_id, sizeof(r_id), "##ps_inc_%s_%d", id_prefix, s_idx);
            ImGui::InvisibleButton(r_id, ImVec2(btn_w, h));
            bool r_hovered = ImGui::IsItemHovered();
            bool r_active = ImGui::IsItemActive();
            if (ImGui::IsItemClicked(0)) {
                if (*p_beat_idx < max_idx - 1) {
                    (*p_beat_idx)++;
                    changed = true;
                }
            }

            if (r_hovered) {
                dl->AddRectFilled(r_pos, ImVec2(r_pos.x + btn_w, r_pos.y + h), 
                                  r_active ? IM_COL32(0, 180, 255, 90) : IM_COL32(255, 255, 255, 30), 2.0f);
            }

            // Triângulo ►
            float tri_rcx = r_pos.x + btn_w * 0.5f;
            ImU32 tri_col_r = (*p_beat_idx < max_idx - 1) ? (r_hovered ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 185, 215, 220)) 
                                                          : IM_COL32(65, 75, 90, 160);
            dl->AddTriangleFilled(ImVec2(tri_rcx + tri_w * 0.5f, cy),
                                  ImVec2(tri_rcx - tri_w * 0.5f, cy - tri_h),
                                  ImVec2(tri_rcx - tri_w * 0.5f, cy + tri_h),
                                  tri_col_r);

            return changed;
        }

        // Renderizador de Unidade Beat FX Individual (FX1 ou FX2 - 100% Autêntico Rekordbox / Pioneer Digital)
        void renderRekordboxFXUnit(KuroAudio::DJEngine& engine, KuroAudio::DJBeatFXUnit& fx_unit, const char* unit_name, 
                                   ImVec2 pos, float unit_w, float unit_h, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();

            // 1. Título da Unidade (ex: "FX1" ou "FX2")
            dl->AddText(g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont(), 
                        14.0f, ImVec2(pos.x + 6.0f, pos.y + 14.0f), 
                        IM_COL32(230, 235, 245, 240), unit_name);

            // 2. Matriz de Atribuição de Canais (6 botões em 2x3: [1][2][S] / [3][4][M])
            float m_start_x = pos.x + 32.0f;
            float btn_w = 17.0f;
            float btn_h = 16.0f;
            float gap_x = 2.0f;
            float gap_y = 2.0f;

            struct ChDef {
                const char* lbl;
                int ch_id;
                int col;
                int row;
                const char* tip;
            };

            const ChDef ch_defs[6] = {
                { "1", 0, 0, 0, "Atribuir FX ao Deck 1" },
                { "2", 1, 1, 0, "Atribuir FX ao Deck 2" },
                { "S", 2, 2, 0, "Atribuir FX ao Sampler" },
                { "3", 3, 0, 1, "Atribuir FX ao Deck 3" },
                { "4", 4, 1, 1, "Atribuir FX ao Deck 4" },
                { "M", 5, 2, 1, "Atribuir FX ao Master" }
            };

            for (int c = 0; c < 6; c++) {
                const auto& cd = ch_defs[c];
                bool is_active = (fx_unit.channel_assign == cd.ch_id);
                ImVec2 b_pos = ImVec2(m_start_x + cd.col * (btn_w + gap_x), pos.y + 6.0f + cd.row * (btn_h + gap_y));

                ImU32 bg_c = is_active ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = is_active ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                ImU32 txt_c = is_active ? IM_COL32(255, 255, 255, 255) : IM_COL32(165, 178, 195, 240);

                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), brd_c, 2.0f);

                ImVec2 t_sz = ImGui::CalcTextSize(cd.lbl);
                dl->AddText(ImVec2(b_pos.x + (btn_w - t_sz.x) * 0.5f, b_pos.y + (btn_h - t_sz.y) * 0.5f), txt_c, cd.lbl);

                ImGui::SetCursorScreenPos(b_pos);
                char bid[32]; snprintf(bid, sizeof(bid), "##ChMtx_%s_%d", unit_name, cd.ch_id);
                if (ImGui::InvisibleButton(bid, ImVec2(btn_w, btn_h))) {
                    fx_unit.channel_assign = cd.ch_id;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("%s", cd.tip);
            }

            // 3. Seletor de Modo: [...] Multi-FX vs [•] Single-FX
            float mode_x = m_start_x + 3.0f * (btn_w + gap_x) + 3.0f;
            float mode_w = 18.0f;

            // Botão [...] Multi-FX
            {
                bool is_multi = (fx_unit.fx_mode == 0);
                ImVec2 b_pos = ImVec2(mode_x, pos.y + 6.0f);
                ImU32 bg_c = is_multi ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = is_multi ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), brd_c, 2.0f);
                
                // 3 pontos horizontais
                float cy = b_pos.y + btn_h * 0.5f;
                float dot_r = 1.2f;
                ImU32 dot_c = is_multi ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 175, 195, 230);
                dl->AddCircleFilled(ImVec2(b_pos.x + 4.5f, cy), dot_r, dot_c);
                dl->AddCircleFilled(ImVec2(b_pos.x + 9.0f, cy), dot_r, dot_c);
                dl->AddCircleFilled(ImVec2(b_pos.x + 13.5f, cy), dot_r, dot_c);

                ImGui::SetCursorScreenPos(b_pos);
                char mbid[32]; snprintf(mbid, sizeof(mbid), "##ModeMulti_%s", unit_name);
                if (ImGui::InvisibleButton(mbid, ImVec2(mode_w, btn_h))) {
                    fx_unit.fx_mode = 0;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Modo Multi-FX (Rack de 4 Slots Independentes)");
            }

            // Botão [•] Single-FX
            {
                bool is_single = (fx_unit.fx_mode == 1);
                ImVec2 b_pos = ImVec2(mode_x, pos.y + 6.0f + btn_h + gap_y);
                ImU32 bg_c = is_single ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = is_single ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + mode_w, b_pos.y + btn_h), brd_c, 2.0f);

                // 1 ponto central
                float cy = b_pos.y + btn_h * 0.5f;
                ImU32 dot_c = is_single ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 175, 195, 230);
                dl->AddCircleFilled(ImVec2(b_pos.x + mode_w * 0.5f, cy), 1.6f, dot_c);

                ImGui::SetCursorScreenPos(b_pos);
                char sbid[32]; snprintf(sbid, sizeof(sbid), "##ModeSingle_%s", unit_name);
                if (ImGui::InvisibleButton(sbid, ImVec2(mode_w, btn_h))) {
                    fx_unit.fx_mode = 1;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Modo Single-FX (Controle Master Detalhado)");
            }

            // 4. Slots de Efeitos (Multi-FX ou Single-FX)
            static const float s_fractions[] = { 0.0625f, 0.125f, 0.25f, 0.5f, 0.75f, 1.0f, 2.0f, 4.0f, 8.0f, 16.0f };
            static const char* s_frac_labels[] = { "1/16", "1/8", "1/4", "1/2", "3/4", "1", "2", "4", "8", "16" };
            static const int s_num_fractions = 10;

            float slots_start_x = mode_x + mode_w + 5.0f;
            float auto_tap_w = 42.0f;
            float right_pad = 4.0f;
            float at_x = pos.x + unit_w - auto_tap_w - right_pad;
            float avail_slots_w = (at_x - 6.0f) - slots_start_x;

            if (fx_unit.fx_mode == 0) {
                // MULTI-FX: 4 Slots Elegantes estilo Console Pioneer
                float slot_w = std::clamp(std::floor((avail_slots_w - 9.0f) / 4.0f), 70.0f, 120.0f);

                for (int s = 0; s < 4; s++) {
                    float sx = slots_start_x + s * (slot_w + 3.0f);
                    auto& slot = fx_unit.multi_slots[s];

                    // ─── Linha 1 (Superior): Botão Iluminado ON/OFF + Dropdown Seletor FX ───
                    float on_w = 23.0f;
                    float drop_w = std::max(20.0f, slot_w - on_w - 2.0f);

                    // 1.1 Botão ON/OFF Iluminado estilo Pioneer
                    ImVec2 on_pos = ImVec2(sx, pos.y + 6.0f);
                    ImU32 on_bg = slot.enabled ? IM_COL32(0, 110, 220, 240) : IM_COL32(18, 22, 30, 240);
                    ImU32 on_brd = slot.enabled ? IM_COL32(0, 230, 255, 255) : IM_COL32(40, 48, 62, 200);
                    ImU32 on_txt = slot.enabled ? IM_COL32(255, 255, 255, 255) : IM_COL32(120, 135, 155, 220);

                    dl->AddRectFilled(on_pos, ImVec2(on_pos.x + on_w, on_pos.y + 18.0f), on_bg, 2.0f);
                    dl->AddRect(on_pos, ImVec2(on_pos.x + on_w, on_pos.y + 18.0f), on_brd, 2.0f);
                    if (slot.enabled) {
                        dl->AddRect(ImVec2(on_pos.x - 1.0f, on_pos.y - 1.0f), 
                                    ImVec2(on_pos.x + on_w + 1.0f, on_pos.y + 19.0f), 
                                    IM_COL32(0, 200, 255, 70), 3.0f);
                    }

                    ImVec2 on_sz = ImGui::CalcTextSize("ON");
                    dl->AddText(ImVec2(on_pos.x + (on_w - on_sz.x) * 0.5f, on_pos.y + (18.0f - on_sz.y) * 0.5f), on_txt, "ON");

                    ImGui::SetCursorScreenPos(on_pos);
                    char on_id[32]; snprintf(on_id, sizeof(on_id), "##OnBtn_%s_%d", unit_name, s);
                    if (ImGui::InvisibleButton(on_id, ImVec2(on_w, 18.0f))) {
                        slot.enabled = !slot.enabled;
                        if (slot.enabled) fx_unit.enabled = true;
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Ligar/Desligar Slot %d (%s)", s + 1, slot.enabled ? "ATIVO" : "BYPASS");

                    // 1.2 Botão Dropdown Seletor FX
                    ImGui::SetCursorScreenPos(ImVec2(sx + on_w + 2.0f, pos.y + 6.0f));
                    char btn_lbl[64];
                    const char* fx_name = KuroAudio::DJBeatFXUnit::getFXName(slot.type);
                    snprintf(btn_lbl, sizeof(btn_lbl), "%s v##s_%s_%d", fx_name, unit_name, s);

                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.08f, 0.10f, 0.14f, 0.95f));
                    ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.24f, 0.29f, 0.38f, 0.85f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.95f, 0.95f, 1.0f, 1.0f));
                    if (ImGui::Button(btn_lbl, ImVec2(drop_w, 18.0f))) {
                        char popup_id[64];
                        snprintf(popup_id, sizeof(popup_id), "##FXPop_%s_%d", unit_name, s);
                        ImGui::OpenPopup(popup_id);
                    }
                    ImGui::PopStyleColor(3);

                    char popup_id[64];
                    snprintf(popup_id, sizeof(popup_id), "##FXPop_%s_%d", unit_name, s);
                    renderRekordboxFXPopup(popup_id, &slot.type);

                    // ─── Linha 2 (Inferior): Knob Rotativo Metálico + Stepper de Batida Pioneer ───
                    // Knob: pos.y + 27.0f, sem texto embaixo (show_value_text = false) para ajuste perfeito ao rack
                    ImVec2 k_pos = ImVec2(sx, pos.y + 27.0f);
                    ImGui::SetCursorScreenPos(k_pos);
                    char kid[32]; snprintf(kid, sizeof(kid), "##k_%s_%d", unit_name, s);
                    if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(kid, &slot.dry_wet, 0.0f, 1.0f, 7.0f,
                                                                        ImVec4(0.0f, 0.75f, 1.0f, 1.0f), "%.0f%%", 0.0f, false, false, false, false, false)) {
                        slot.enabled = (slot.dry_wet > 0.005f);
                        if (slot.enabled) fx_unit.enabled = true;
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Depth/Nível Slot %d: %.0f%%", s + 1, slot.dry_wet * 100.0f);

                    // Stepper: cápsula integrada com OLED central a partir de sx + 28.0f (2px de folga do knob)
                    const char* frac_text = (slot.beat_idx >= 0 && slot.beat_idx < s_num_fractions) ? s_frac_labels[slot.beat_idx] : "1";
                    char disp_txt[32];
                    bool is_mod = (slot.type == KuroAudio::DJBeatFXUnit::FX_ENIGMA_JET || 
                                   slot.type == KuroAudio::DJBeatFXUnit::FX_MOBIUS_SAW ||
                                   slot.type == KuroAudio::DJBeatFXUnit::FX_MOBIUS_TRI);
                    if (is_mod && slot.beat_fraction >= 1.0f) {
                        snprintf(disp_txt, sizeof(disp_txt), "+%s", frac_text);
                    } else {
                        snprintf(disp_txt, sizeof(disp_txt), "%s", frac_text);
                    }

                    float stepper_x = sx + 28.0f;
                    float stepper_w = std::max(20.0f, slot_w - 28.0f);
                    ImU32 accent_col = is_mod ? IM_COL32(255, 175, 25, 255) : IM_COL32(0, 229, 255, 255);

                    if (renderPioneerBeatStepper(unit_name, s, &slot.beat_idx, s_num_fractions, disp_txt, 
                                                ImVec2(stepper_x, pos.y + 27.0f), ImVec2(stepper_w, 18.0f), accent_col)) {
                        slot.beat_fraction = s_fractions[slot.beat_idx];
                    }
                }
            } else {
                // SINGLE-FX: Controles Master
                float s_w = std::clamp(avail_slots_w * 0.40f, 110.0f, 150.0f);
                ImGui::SetCursorScreenPos(ImVec2(slots_start_x, pos.y + 6.0f));
                char sbtn_lbl[64];
                snprintf(sbtn_lbl, sizeof(sbtn_lbl), "%s v##s_single_%s", KuroAudio::DJBeatFXUnit::getFXName(fx_unit.type), unit_name);
                if (ImGui::Button(sbtn_lbl, ImVec2(s_w, 20.0f))) {
                    char popup_id[64]; snprintf(popup_id, sizeof(popup_id), "##FXPopSingle_%s", unit_name);
                    ImGui::OpenPopup(popup_id);
                }
                char popup_id[64]; snprintf(popup_id, sizeof(popup_id), "##FXPopSingle_%s", unit_name);
                renderRekordboxFXPopup(popup_id, &fx_unit.type);

                // Knobs DEPTH & TIME
                float k_start_x = slots_start_x + s_w + 10.0f;
                dl->AddText(ImVec2(k_start_x, pos.y + 10.0f), IM_COL32(140, 160, 185, 220), "DEPTH");
                ImGui::SetCursorScreenPos(ImVec2(k_start_x + 44.0f, pos.y + 7.0f));
                char kdid[32]; snprintf(kdid, sizeof(kdid), "##k_depth_%s", unit_name);
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(kdid, &fx_unit.dry_wet, 0.0f, 1.0f, 8.0f,
                                                                    ImVec4(0.0f, 0.75f, 1.0f, 1.0f), "%.0f%%", 0.0f, false, false, false, false, false)) {
                    fx_unit.enabled = (fx_unit.dry_wet > 0.005f);
                }

                float k_time_x = k_start_x + 95.0f;
                dl->AddText(ImVec2(k_time_x, pos.y + 10.0f), IM_COL32(140, 160, 185, 220), "TIME");
                ImGui::SetCursorScreenPos(ImVec2(k_time_x + 40.0f, pos.y + 7.0f));
                static float dummy_time = 0.5f;
                char ktid[32]; snprintf(ktid, sizeof(ktid), "##k_time_%s", unit_name);
                KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob(ktid, &dummy_time, 0.0f, 1.0f, 8.0f,
                                                                    ImVec4(0.0f, 0.75f, 1.0f, 1.0f), "%.2f", 0.5f, false, false, false, false, false);
            }

            // 5. Botoeira AUTO e TAP (Empilhados na extremidade direita)
            // Botão [ AUTO ] (Pioneer Neon Blue se ativo)
            {
                ImVec2 b_pos = ImVec2(at_x, pos.y + 8.0f);
                ImU32 bg_c = fx_unit.auto_bpm ? IM_COL32(0, 115, 245, 255) : IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = fx_unit.auto_bpm ? IM_COL32(50, 160, 255, 255) : IM_COL32(40, 48, 62, 220);
                ImU32 txt_c = fx_unit.auto_bpm ? IM_COL32(255, 255, 255, 255) : IM_COL32(160, 175, 195, 220);

                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), brd_c, 2.0f);

                ImVec2 t_sz = ImGui::CalcTextSize("AUTO");
                dl->AddText(ImVec2(b_pos.x + (auto_tap_w - t_sz.x) * 0.5f, b_pos.y + (btn_h - t_sz.y) * 0.5f), txt_c, "AUTO");

                ImGui::SetCursorScreenPos(b_pos);
                char abid[32]; snprintf(abid, sizeof(abid), "##AutoBtn_%s", unit_name);
                if (ImGui::InvisibleButton(abid, ImVec2(auto_tap_w, btn_h))) {
                    fx_unit.auto_bpm = !fx_unit.auto_bpm;
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Sincronização Automática ao BPM do Deck");
            }

            // Botão [ TAP ]
            {
                ImVec2 b_pos = ImVec2(at_x, pos.y + 8.0f + btn_h + gap_y);
                ImU32 bg_c = IM_COL32(22, 26, 34, 255);
                ImU32 brd_c = IM_COL32(40, 48, 62, 220);
                ImU32 txt_c = IM_COL32(165, 178, 195, 240);

                dl->AddRectFilled(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), bg_c, 2.0f);
                dl->AddRect(b_pos, ImVec2(b_pos.x + auto_tap_w, b_pos.y + btn_h), brd_c, 2.0f);

                ImVec2 t_sz = ImGui::CalcTextSize("TAP");
                dl->AddText(ImVec2(b_pos.x + (auto_tap_w - t_sz.x) * 0.5f, b_pos.y + (btn_h - t_sz.y) * 0.5f), txt_c, "TAP");

                int u_idx = (strcmp(unit_name, "FX 1") == 0) ? 0 : 1;
                if (tap_trackers[u_idx].flash_timer > 0.0f) {
                    tap_trackers[u_idx].flash_timer -= ImGui::GetIO().DeltaTime;
                    bg_c = IM_COL32(255, 170, 0, 255);
                    txt_c = IM_COL32(0, 0, 0, 255);
                }

                ImGui::SetCursorScreenPos(b_pos);
                char tbid[32]; snprintf(tbid, sizeof(tbid), "##TapBtn_%s", unit_name);
                if (ImGui::InvisibleButton(tbid, ImVec2(auto_tap_w, btn_h))) {
                    double now_s = ImGui::GetTime();
                    double tap_bpm = tap_trackers[u_idx].registerTap(now_s);
                    if (tap_bpm > 30.0) {
                        fx_unit.bpm = tap_bpm;
                        fx_unit.auto_bpm = false;
                    } else {
                        fx_unit.auto_bpm = false;
                    }
                }
                if (ImGui::IsItemHovered()) ImGui::SetTooltip("Tap Tempo: Clique no ritmo para calibrar o BPM manualmente (BPM Atual: %.1f)", fx_unit.bpm);
            }
        }

        void renderRekordboxFXBar(KuroAudio::DJEngine& engine, float w) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();
            float h = KuroUI::UIScaleManager::Scale(56.0f);

            // Fundo escuro do rack de performance #0b0d12 com linhas de chassi
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(11, 13, 18, 255));
            dl->AddLine(ImVec2(pos.x, pos.y), ImVec2(pos.x + w, pos.y), IM_COL32(26, 32, 44, 255), 1.0f);
            dl->AddLine(ImVec2(pos.x, pos.y + h - 1.0f), ImVec2(pos.x + w, pos.y + h - 1.0f), IM_COL32(22, 27, 36, 255), 1.0f);

            // Seção Central CFX (Largura compacta e harmoniosa para liberar espaço aos Beat FX)
            float center_w = std::clamp(w * 0.20f, 220.0f, 260.0f);
            float wing_w = (w - center_w) * 0.5f;

            // Linhas verticais divisorias sutis entre as 3 ilhas funcionais
            dl->AddLine(ImVec2(pos.x + wing_w, pos.y + 4.0f), ImVec2(pos.x + wing_w, pos.y + h - 4.0f), IM_COL32(32, 40, 54, 180), 1.0f);
            dl->AddLine(ImVec2(pos.x + wing_w + center_w, pos.y + 4.0f), ImVec2(pos.x + wing_w + center_w, pos.y + h - 4.0f), IM_COL32(32, 40, 54, 180), 1.0f);

            // ═════════════════════════════════════════════════════════════════════
            // 1. ALA ESQUERDA: FX 1 UNIT (Pioneer Rekordbox Oficial)
            // ═════════════════════════════════════════════════════════════════════
            renderRekordboxFXUnit(engine, engine.beat_fx, "FX1", pos, wing_w, h, ImVec4(0.0f, 0.90f, 1.0f, 1.0f));

            // ═════════════════════════════════════════════════════════════════════
            // 2. ALA CENTRAL: SOUND COLOR FX CONSOLE (CFX HUB COM PULSACAO GLOW)
            // ═════════════════════════════════════════════════════════════════════
            {
                float cfx_x = pos.x + wing_w;
                float cfx_center_cx = cfx_x + center_w * 0.5f;

                // Titulo do Console
                ImVec2 t_sz = ImGui::CalcTextSize("SOUND COLOR FX (CFX)");
                dl->AddText(ImVec2(cfx_center_cx - t_sz.x * 0.5f, pos.y + 2.0f), IM_COL32(135, 155, 180, 220), "SOUND COLOR FX (CFX)");

                // Calculo de pulsacao luminosa dinamica no ritmo do Master BPM
                double cur_bpm = (engine.decks[0].is_playing.load()) ? (engine.decks[0].bpm * (1.0 + engine.decks[0].pitch_percent * 0.01)) : 128.0;
                if (cur_bpm <= 0.0) cur_bpm = 128.0;
                float bpm_hz = (float)(cur_bpm / 60.0);
                float pulse = (std::sin((float)ImGui::GetTime() * bpm_hz * 2.0f * (float)M_PI) + 1.0f) * 0.5f;

                // Botoeira com as 4 cores de assinatura: FILTER, CRUSH, NOISE, SPACE
                float btn_w = 46.0f;
                float btn_h = 15.0f;
                float btn_gap = 2.0f;
                float total_btns_w = btn_w * 4.0f + btn_gap * 3.0f;
                float btn_start_x = cfx_center_cx - total_btns_w * 0.5f;
                float btn_y = pos.y + 14.0f;

                struct CfxDef {
                    int mode_idx;
                    const char* name;
                    ImU32 sig_col;
                    ImVec4 text_col;
                };

                const CfxDef cfx_defs[4] = {
                    { 0, "FILTER", IM_COL32(0, 229, 255, 255),   ImVec4(0.0f, 0.90f, 1.0f, 1.0f) }, // Ciano Eletrico
                    { 2, "CRUSH",  IM_COL32(255, 107, 0, 255),   ImVec4(1.0f, 0.50f, 0.10f, 1.0f) }, // Laranja Fogo
                    { 1, "NOISE",  IM_COL32(56, 189, 248, 255),  ImVec4(0.60f, 0.85f, 1.0f, 1.0f) }, // Azul Gelo / Prata
                    { 3, "SPACE",  IM_COL32(168, 85, 247, 255),  ImVec4(0.80f, 0.50f, 1.0f, 1.0f) }  // Roxo Ultravioleta
                };

                for (int i = 0; i < 4; i++) {
                    const auto& def = cfx_defs[i];
                    bool is_active = (rekordbox_cfx_type == def.mode_idx);
                    ImVec2 b_pos = ImVec2(btn_start_x + i * (btn_w + btn_gap), btn_y);

                    if (is_active) {
                        float glow_expand = 1.5f + pulse * 2.0f;
                        int glow_alpha = (int)(45 + 75 * pulse);
                        ImU32 glow_halo = (def.sig_col & 0x00FFFFFF) | (((int)(20 + 30 * pulse) & 0xFF) << 24);
                        ImU32 glow_ring = (def.sig_col & 0x00FFFFFF) | ((glow_alpha & 0xFF) << 24);

                        dl->AddRectFilled(ImVec2(b_pos.x - glow_expand, b_pos.y - glow_expand),
                                          ImVec2(b_pos.x + btn_w + glow_expand, b_pos.y + btn_h + glow_expand),
                                          glow_halo, 4.0f);
                        dl->AddRect(ImVec2(b_pos.x - 1.0f, b_pos.y - 1.0f),
                                    ImVec2(b_pos.x + btn_w + 1.0f, b_pos.y + btn_h + 1.0f),
                                    glow_ring, 3.0f, 0, 1.2f);
                    }

                    ImU32 bg_c = is_active ? IM_COL32(18, 24, 34, 255) : IM_COL32(14, 17, 24, 220);
                    dl->AddRectFilled(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), bg_c, 2.0f);
                    dl->AddRect(b_pos, ImVec2(b_pos.x + btn_w, b_pos.y + btn_h), 
                                is_active ? def.sig_col : (def.sig_col & 0x00FFFFFF | 0x65000000), 2.0f, 0, is_active ? 1.5f : 1.0f);

                    ImVec2 str_sz = ImGui::CalcTextSize(def.name);
                    dl->AddText(ImVec2(b_pos.x + (btn_w - str_sz.x) * 0.5f, b_pos.y + (btn_h - str_sz.y) * 0.5f),
                                is_active ? IM_COL32(255, 255, 255, 255) : ImGui::GetColorU32(def.text_col), def.name);

                    ImGui::SetCursorScreenPos(b_pos);
                    char bid[32]; snprintf(bid, sizeof(bid), "##CfxBtn_%d", def.mode_idx);
                    if (ImGui::InvisibleButton(bid, ImVec2(btn_w, btn_h))) {
                        rekordbox_cfx_type = def.mode_idx;
                        engine.decks[0].sound_color_fx_mode = def.mode_idx;
                        engine.decks[1].sound_color_fx_mode = def.mode_idx;
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Sound Color FX: Ativar %s no mixer", def.name);
                }

                // 3 Knobs Centrais: CH 1 COLOR | CFX PARAM | CH 2 COLOR
                float knob_r = 6.5f;
                float knob_y = pos.y + 31.0f;
                float item_col_w = 68.0f;
                float cfx_items_start_x = cfx_center_cx - (item_col_w * 3.0f) * 0.5f;

                // Knob 1: CH 1 COLOR (Ciano Bipolar)
                float it1_x = cfx_items_start_x;
                dl->AddText(ImVec2(it1_x + 2.0f, knob_y + 2.0f), IM_COL32(0, 215, 245, 240), "CH 1");
                ImGui::SetCursorScreenPos(ImVec2(it1_x + 34.0f, knob_y));
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob("##Ch1ColorKnob", &engine.decks[0].filter_bipolar, 
                                                                    0.0f, 1.0f, knob_r, ImVec4(0.0f, 0.85f, 1.0f, 1.0f), 
                                                                    "%.2f", 0.5f, true, false, false, false, false)) {
                    engine.decks[0].updateSoundColorFX();
                }

                // Knob 2: CFX PARAM (Branco Frio - Ressonância / Profundidade Pioneer)
                float it2_x = it1_x + item_col_w;
                dl->AddText(ImVec2(it2_x + 2.0f, knob_y + 2.0f), IM_COL32(230, 240, 255, 240), "PARAM");
                ImGui::SetCursorScreenPos(ImVec2(it2_x + 40.0f, knob_y));
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob("##CfxParamKnob", &rekordbox_cfx_param, 
                                                                    0.0f, 1.0f, knob_r, ImVec4(0.95f, 0.95f, 1.0f, 1.0f), 
                                                                    "%.2f", 0.5f, false, false, false, false, false)) {
                    engine.decks[0].sound_color_param = rekordbox_cfx_param;
                    engine.decks[1].sound_color_param = rekordbox_cfx_param;
                    engine.decks[0].updateSoundColorFX();
                    engine.decks[1].updateSoundColorFX();
                }

                // Knob 3: CH 2 COLOR (Ambar Bipolar)
                float it3_x = it2_x + item_col_w;
                dl->AddText(ImVec2(it3_x + 2.0f, knob_y + 2.0f), IM_COL32(255, 160, 20, 240), "CH 2");
                ImGui::SetCursorScreenPos(ImVec2(it3_x + 34.0f, knob_y));
                if (KuroUI::KuroDJStudioSkinManager::DrawSkinRotaryKnob("##Ch2ColorKnob", &engine.decks[1].filter_bipolar, 
                                                                    0.0f, 1.0f, knob_r, ImVec4(1.0f, 0.65f, 0.0f, 1.0f), 
                                                                    "%.2f", 0.5f, true, false, false, false, false)) {
                    engine.decks[1].updateSoundColorFX();
                }
            }

            // ═════════════════════════════════════════════════════════════════════
            // 3. ALA DIREITA: FX 2 UNIT (Pioneer Rekordbox Oficial)
            // ═════════════════════════════════════════════════════════════════════
            float fx2_start_x = pos.x + wing_w + center_w;
            renderRekordboxFXUnit(engine, engine.beat_fx2, "FX2", ImVec2(fx2_start_x, pos.y), wing_w, h, ImVec4(1.0f, 0.65f, 0.0f, 1.0f));

            ImGui::SetCursorScreenPos(ImVec2(pos.x, pos.y + h));
            ImGui::Dummy(ImVec2(w, 2.0f));
        }

        void renderRekordboxJogwheel(KuroAudio::DJDeck& deck, ImVec2 top_left, float size, ImVec4 theme_col, bool external_tempo_controls = false) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            float radius = size * 0.5f;
            ImVec2 center = ImVec2(top_left.x + radius, top_left.y + radius);

            // ═════════════════════════════════════════════════════════════════════
            // 1. DINÂMICA DE ÁUDIO, SINCRONIA DE COMPASSO E DETECÇÃO ROBUSTA DE FX
            // ═════════════════════════════════════════════════════════════════════
            float rot_ang = deck.jog_visual_angle;
            float vu = 0.0f;
            if (deck.is_playing && !deck.buffer_l.empty()) {
                int64_t cf = (int64_t)deck.current_frame;
                if (cf >= 0 && cf < (int64_t)deck.buffer_l.size()) {
                    vu = std::clamp(std::abs(deck.buffer_l[cf]) * 2.8f, 0.0f, 1.0f);
                }
            } else if (deck.is_playing) {
                vu = 0.5f + 0.5f * std::sin((float)ImGui::GetTime() * 12.0f);
            }

            // Cálculo do Pulso a Cada Batida (Downbeat / Kick Impact)
            double beat_len_frames = (deck.bpm > 20.0) ? (deck.sample_rate * 60.0 / deck.bpm) : (deck.sample_rate * 0.5);
            double beat_dist = (double)deck.current_frame - (double)deck.first_beat_frame;
            double beat_num = (beat_len_frames > 0.0) ? (beat_dist / beat_len_frames) : 0.0;
            float beat_phase = (float)std::fmod(std::abs(beat_num), 1.0);

            // Ataque instantâneo no início do beat com decaimento exponencial rápido (punch)
            float beat_impact = 0.0f;
            if (deck.is_playing) {
                float decay = std::max(0.0f, 1.0f - beat_phase * 4.2f);
                beat_impact = decay * decay; // Curva quadrática para punch vigoroso
            } else {
                beat_impact = 0.0f;
            }

            // ═════════════════════════════════════════════════════════════════════
            // DETECÇÃO ROBUSTA DO ESTADO DE EFEITO (FX POWER-UP VS NORMAL)
            // ═════════════════════════════════════════════════════════════════════
            bool has_channel_filter = (std::abs(deck.filter_bipolar - 0.5f) > 0.02f);
            bool has_cfx_param = (std::abs(deck.sound_color_param - 0.5f) > 0.02f);
            bool is_slip_or_roll = (deck.slip_mode || deck.roll_capturing);

            // Modos Sound Color FX:
            // 0 = FILTER, 1 = NOISE, 2 = CRUSH, 3 = SPACE, 4 = DUB ECHO, 5 = SWEEP, 6 = PING PONG, 7 = SPIRAL, 8 = REVERB
            int current_cfx_mode = deck.sound_color_fx_mode;
            if (current_cfx_mode < 0) current_cfx_mode = rekordbox_cfx_type;

            // Determinar se estamos no modo FX POWER-UP (com raios) ou MODO NORMAL (com ondas suaves)
            bool is_fx_powerup_active = false;
            int fx_visual_id = -1; // -1 = Normal, 0=LPF, 1=HPF, 2=CRUSH, 3=NOISE, 4=SPACE, 5=DUB ECHO, 6=SWEEP, 7=SLIP

            if (is_slip_or_roll) {
                is_fx_powerup_active = true;
                fx_visual_id = 7; // SLIP / ROLL
            } else if (has_channel_filter || has_cfx_param) {
                is_fx_powerup_active = true;
                if (current_cfx_mode == 0) { // FILTER
                    fx_visual_id = (deck.filter_bipolar < 0.49f) ? 0 : 1; // 0=LPF, 1=HPF
                } else if (current_cfx_mode == 1) {
                    fx_visual_id = 3; // NOISE
                } else if (current_cfx_mode == 2) {
                    fx_visual_id = 2; // CRUSH
                } else if (current_cfx_mode == 3 || current_cfx_mode == 8) {
                    fx_visual_id = 4; // SPACE / REVERB
                } else if (current_cfx_mode == 4 || current_cfx_mode == 6) {
                    fx_visual_id = 5; // DUB ECHO
                } else {
                    fx_visual_id = 6; // SWEEP / OUTROS
                }
            } else if (rekordbox_cfx_type > 0) {
                // Usuário clicou em CRUSH, NOISE ou SPACE no topo do mixer
                is_fx_powerup_active = true;
                if (rekordbox_cfx_type == 1) fx_visual_id = 3; // NOISE
                else if (rekordbox_cfx_type == 2) fx_visual_id = 2; // CRUSH
                else if (rekordbox_cfx_type == 3) fx_visual_id = 4; // SPACE
            }

            // Cores Temáticas de Plasma e Bloom específicas para cada FX
            ImVec4 fx_glow_col1; // Cor principal de plasma
            ImVec4 fx_glow_col2; // Cor secundária de reflexo/faíscas
            float fx_crackle_speed = 36.0f; // Velocidade de jitter dos raios

            if (is_fx_powerup_active) {
                switch (fx_visual_id) {
                    case 0: // FILTER LPF (Graves Magma / Vulcânico)
                        fx_glow_col1 = ImVec4(1.00f, 0.12f, 0.00f, 1.0f); // Vermelho Magma Intenso
                        fx_glow_col2 = ImVec4(1.00f, 0.50f, 0.00f, 1.0f); // Laranja Fogo
                        fx_crackle_speed = 28.0f;
                        break;
                    case 1: // FILTER HPF (Agudos Criogênicos / Gelo)
                        fx_glow_col1 = ImVec4(0.00f, 0.94f, 1.00f, 1.0f); // Ciano Elétrico
                        fx_glow_col2 = ImVec4(0.85f, 0.97f, 1.00f, 1.0f); // Branco Gelo
                        fx_crackle_speed = 52.0f;
                        break;
                    case 2: // CRUSH (Verde Ácido Tóxico / Cyber Glitch)
                        fx_glow_col1 = ImVec4(0.22f, 1.00f, 0.08f, 1.0f); // Verde Ácido Radioativo
                        fx_glow_col2 = ImVec4(0.85f, 1.00f, 0.00f, 1.0f); // Amarelo Neon
                        fx_crackle_speed = 44.0f;
                        break;
                    case 3: // NOISE (Tesla Coil / Descarga Elétrica Branca/Azul)
                        fx_glow_col1 = ImVec4(1.00f, 1.00f, 1.00f, 1.0f); // Branco Puro
                        fx_glow_col2 = ImVec4(0.40f, 0.75f, 1.00f, 1.0f); // Azul Tesla
                        fx_crackle_speed = 60.0f;
                        break;
                    case 4: // SPACE / REVERB (Violeta Cósmico / Nebulosa)
                        fx_glow_col1 = ImVec4(0.68f, 0.08f, 1.00f, 1.0f); // Ultravioleta Profundo
                        fx_glow_col2 = ImVec4(0.95f, 0.25f, 0.85f, 1.0f); // Magenta Nebular
                        fx_crackle_speed = 32.0f;
                        break;
                    case 5: // DUB ECHO (Verde Esmeralda Fluorescente)
                        fx_glow_col1 = ImVec4(0.00f, 1.00f, 0.55f, 1.0f); // Esmeralda Laser
                        fx_glow_col2 = ImVec4(0.00f, 0.90f, 0.85f, 1.0f); // Ciano Menta
                        fx_crackle_speed = 36.0f;
                        break;
                    case 6: // SWEEP (Plasma Solar / Ouro Solar)
                        fx_glow_col1 = ImVec4(1.00f, 0.75f, 0.00f, 1.0f); // Ouro Solar
                        fx_glow_col2 = ImVec4(1.00f, 0.35f, 0.00f, 1.0f); // Âmbar Flare
                        fx_crackle_speed = 40.0f;
                        break;
                    case 7: // SLIP / ROLL (Alerta Laranja / Vermelho Industrial)
                    default:
                        fx_glow_col1 = ImVec4(1.00f, 0.40f, 0.00f, 1.0f);
                        fx_glow_col2 = ImVec4(1.00f, 0.05f, 0.15f, 1.0f);
                        fx_crackle_speed = 48.0f;
                        break;
                }
            } else {
                // MODO NORMAL (SEM EFEITO): Ondas fluidas com identidade nativa elegante do Deck
                if (deck.deck_id == 0) {
                    fx_glow_col1 = ImVec4(0.00f, 0.88f, 1.00f, 1.0f); // Ciano Club Standard
                    fx_glow_col2 = ImVec4(0.40f, 0.15f, 0.95f, 1.0f); // Violeta Neon
                } else {
                    fx_glow_col1 = ImVec4(1.00f, 0.60f, 0.00f, 1.0f); // Âmbar Club Standard
                    fx_glow_col2 = ImVec4(1.00f, 0.15f, 0.25f, 1.0f); // Vermelho Carmesim
                }
            }

            float pulse = deck.is_playing ? (0.65f + 0.55f * beat_impact + 0.35f * vu) : 0.60f;
            if (deck.jog_touch || deck.motor_stopped) pulse = 1.40f;

            // ═════════════════════════════════════════════════════════════════════
            // 2. LATERAIS DA JOG: ONDAS FLUIDAS (NORMAL) VS RAIOS GUITAR HERO (FX)
            // ═════════════════════════════════════════════════════════════════════

            // A CADA BATIDA: Onda de Choque Expansiva em Anel (Shockwave Ripple)
            if (deck.is_playing && beat_impact > 0.01f) {
                float shock_r = radius + 2.0f + beat_phase * 22.0f;
                int shock_alpha = (int)(std::clamp((1.0f - beat_phase) * 165.0f * (0.6f + 0.4f * vu), 0.0f, 225.0f));
                ImU32 shock_col = IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), shock_alpha);
                dl->AddCircle(center, shock_r, shock_col, 64, 1.8f);
                // Anel secundário de dispersão
                float shock_r2 = radius + 1.0f + beat_phase * 12.0f;
                int shock_alpha2 = (int)(shock_alpha * 0.45f);
                dl->AddCircle(center, shock_r2, IM_COL32(255, 255, 255, shock_alpha2), 64, 1.0f);
            }

            if (!is_fx_powerup_active) {
                // ─────────────────────────────────────────────────────────────────
                // ESTADO A: ONDAS NORMAIS NAS LATERAIS DA JOG (FLUIDAS E SUAVES)
                // ─────────────────────────────────────────────────────────────────
                // Faixas harmônicas senoidais contínuas respirando em torno do chassi
                int wave_segs = 84;
                float cur_time = (float)ImGui::GetTime();

                for (int layer = 0; layer < 3; layer++) {
                    float layer_freq = (layer == 0) ? 6.0f : ((layer == 1) ? 9.0f : 12.0f);
                    float layer_speed = (layer == 0) ? 2.5f : ((layer == 1) ? -1.8f : 3.2f);
                    float layer_base_amp = (layer == 0) ? 5.5f : ((layer == 1) ? 3.8f : 2.2f);
                    float layer_amp = layer_base_amp * (0.5f + 0.5f * vu + 0.45f * beat_impact);

                    ImVec4 l_col = (layer % 2 == 0) ? fx_glow_col1 : fx_glow_col2;
                    int base_alpha = (layer == 0) ? (int)(110 * pulse) : ((layer == 1) ? (int)(75 * pulse) : (int)(45 * pulse));
                    int alpha = std::clamp(base_alpha, 15, 230);
                    ImU32 wave_col = IM_COL32((int)(l_col.x*255), (int)(l_col.y*255), (int)(l_col.z*255), alpha);

                    ImVec2 prev_p(0, 0);
                    for (int s = 0; s <= wave_segs; s++) {
                        float a = (float)s / (float)wave_segs * 2.0f * (float)M_PI;
                        float wave_disp = std::sin(a * layer_freq + cur_time * layer_speed + rot_ang * 0.5f) * layer_amp;
                        float r_w = radius + 2.0f + wave_disp;
                        ImVec2 cur_p(center.x + std::cos(a) * r_w, center.y + std::sin(a) * r_w);
                        if (s > 0) {
                            dl->AddLine(prev_p, cur_p, wave_col, (layer == 0) ? 2.0f : 1.4f);
                        }
                        prev_p = cur_p;
                    }
                }
            } else {
                // ─────────────────────────────────────────────────────────────────
                // ESTADO B: POWER-UP ESTILO GUITAR HERO (RAIOS ELÉTRICOS CREPITANTES E ALEATÓRIOS)
                // ─────────────────────────────────────────────────────────────────
                float cur_time = (float)ImGui::GetTime();
                float max_reach = 14.0f + 18.0f * beat_impact + 7.0f * vu;

                // 1. RAIOS PRINCIPAIS ORGÂNICOS COM ESPAÇAMENTO E COMPRIMENTOS TOTALMENTE ALEATÓRIOS
                int num_bolts = 16;
                for (int b = 0; b < num_bolts; b++) {
                    // Deslocamento angular pseudo-aleatório orgânico (não-uniforme)
                    float ang_rnd = std::sin((float)b * 12.9898f + 78.233f) * 0.26f + std::sin((float)b * 37.11f) * 0.10f;
                    float base_ang = (float)b / (float)num_bolts * 2.0f * (float)M_PI + rot_ang * 0.35f + cur_time * 0.85f + ang_rnd;

                    // Comprimento aleatório com oscilação orgânica (uns maiores, outros menores)
                    float len_noise = 0.5f + 0.5f * std::sin((float)b * 27.53f + cur_time * 6.0f);
                    float bolt_len = max_reach * (0.38f + 0.62f * len_noise);

                    float r_start = radius - 1.5f;
                    float r_end   = radius + bolt_len;

                    float cos_a = std::cos(base_ang), sin_a = std::sin(base_ang);
                    float perp_x = -sin_a, perp_y = cos_a;

                    // 5 Vértices fractais quebrados em zigue-zague
                    const int NUM_VERTS = 5;
                    ImVec2 verts[NUM_VERTS];
                    verts[0] = ImVec2(center.x + cos_a * r_start, center.y + sin_a * r_start);
                    verts[NUM_VERTS - 1] = ImVec2(center.x + cos_a * r_end, center.y + sin_a * r_end);

                    for (int k = 1; k < NUM_VERTS - 1; k++) {
                        float frac = (float)k / (float)(NUM_VERTS - 1);
                        float r_k = r_start + (r_end - r_start) * frac;
                        float jitter_phase = cur_time * fx_crackle_speed + (float)b * 13.7f + (float)k * 29.3f;
                        float jitter_amp = (4.0f + 3.8f * beat_impact) * (1.0f - std::abs(frac - 0.5f) * 1.5f);
                        float offset = std::sin(jitter_phase) * jitter_amp;

                        verts[k] = ImVec2(center.x + cos_a * r_k + perp_x * offset,
                                          center.y + sin_a * r_k + perp_y * offset);
                    }

                    // 1. Pass: Bloom Volumétrico Amplo
                    int alpha_bloom = (int)(std::clamp(48.0f * pulse, 15.0f, 95.0f));
                    ImU32 col_bloom = IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), alpha_bloom);
                    for (int k = 0; k < NUM_VERTS - 1; k++) {
                        dl->AddLine(verts[k], verts[k+1], col_bloom, 7.5f);
                    }

                    // 2. Pass: Bainha de Plasma Sólido
                    int alpha_plasma = (int)(std::clamp(210.0f * pulse, 90.0f, 255.0f));
                    ImU32 col_plasma = IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), alpha_plasma);
                    for (int k = 0; k < NUM_VERTS - 1; k++) {
                        dl->AddLine(verts[k], verts[k+1], col_plasma, 3.2f);
                    }

                    // 3. Pass: Núcleo Incandescente Branco Puro (Alta Voltagem)
                    int alpha_core = (int)(std::clamp(245.0f * (0.8f + 0.2f * beat_impact), 160.0f, 255.0f));
                    ImU32 col_core = IM_COL32(255, 255, 255, alpha_core);
                    for (int k = 0; k < NUM_VERTS - 1; k++) {
                        dl->AddLine(verts[k], verts[k+1], col_core, 1.3f);
                    }

                    // Faísca / Centelha na ponta
                    dl->AddCircleFilled(verts[NUM_VERTS - 1], 2.2f, col_core);
                    dl->AddCircle(verts[NUM_VERTS - 1], 3.8f, col_plasma, 12, 1.0f);

                    // Bifurcação secundária (Fork)
                    if ((b + (int)(cur_time * 8.0f)) % 3 != 0) {
                        float fork_ang = base_ang + ((b % 2 == 0) ? 0.35f : -0.35f);
                        float fork_len = bolt_len * 0.50f;
                        ImVec2 fork_end(verts[2].x + std::cos(fork_ang) * fork_len, verts[2].y + std::sin(fork_ang) * fork_len);
                        dl->AddLine(verts[2], fork_end, col_plasma, 2.0f);
                        dl->AddLine(verts[2], fork_end, col_core, 1.0f);
                        dl->AddCircleFilled(fork_end, 1.4f, col_core);
                    }
                }

                // 2. RAIOS PEQUENOS E MICRO-ARCOS ALEATÓRIOS ENTRE OS ESPAÇOS
                int num_micros = 30;
                for (int m = 0; m < num_micros; m++) {
                    float m_jitter = std::sin((float)m * 41.7f + cur_time * 18.0f);
                    // Nem todo micro-arco aparece ao mesmo tempo: eles crepitam e piscam
                    if (m_jitter < -0.20f) continue;

                    float m_ang_noise = std::sin((float)m * 23.4f) * 0.20f;
                    float m_ang = (float)m / (float)num_micros * 2.0f * (float)M_PI + rot_ang * 0.40f + cur_time * 1.4f + m_ang_noise;

                    float m_len = (3.5f + 7.5f * beat_impact + 3.0f * vu) * (0.4f + 0.6f * (0.5f + 0.5f * m_jitter));
                    float r0 = radius - 1.0f;
                    float r1 = radius + m_len;

                    float ca = std::cos(m_ang), sa = std::sin(m_ang);
                    float px = -sa, py = ca;

                    float mid_r = (r0 + r1) * 0.5f;
                    float mid_offset = std::sin(cur_time * 65.0f + (float)m * 17.0f) * 2.5f;

                    ImVec2 p0(center.x + ca * r0, center.y + sa * r0);
                    ImVec2 p_mid(center.x + ca * mid_r + px * mid_offset, center.y + sa * mid_r + py * mid_offset);
                    ImVec2 p1(center.x + ca * r1, center.y + sa * r1);

                    ImU32 col_plasma = IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), (int)(std::clamp(190.0f * pulse, 60.0f, 240.0f)));
                    ImU32 col_core = IM_COL32(255, 255, 255, (int)(std::clamp(230.0f * pulse, 120.0f, 255.0f)));

                    dl->AddLine(p0, p_mid, col_plasma, 2.2f);
                    dl->AddLine(p_mid, p1, col_plasma, 2.2f);
                    dl->AddLine(p0, p_mid, col_core, 1.0f);
                    dl->AddLine(p_mid, p1, col_core, 1.0f);

                    dl->AddCircleFilled(p1, 1.6f, col_core);
                }
            }
            // ═════════════════════════════════════════════════════════════════════
            // 3. CAMADA 3D: SOMBRA PROJETADA E CHASSI DE TITÂNIO CHANFRADO
            // ═════════════════════════════════════════════════════════════════════
            // Drop shadow externa sob o chassi de alumínio
            dl->AddCircle(center, radius + 3.0f, IM_COL32(0, 0, 0, 150), 64, 4.0f);
            dl->AddCircle(center, radius + 1.0f, IM_COL32(0, 0, 0, 200), 64, 2.0f);

            dl->AddCircleFilled(center, radius, IM_COL32(14, 17, 24, 255), 64);
            // Chanfro metálico 3D: luz superior e sombra inferior
            dl->AddCircle(center, radius, IM_COL32(50, 62, 82, 255), 64, 1.8f);
            dl->AddCircle(center, radius - 1.5f, IM_COL32(28, 36, 48, 255), 64, 1.2f);
            // Arco de brilho especular na borda superior
            dl->PathArcTo(center, radius - 0.5f, -0.85f * (float)M_PI, -0.15f * (float)M_PI, 32);
            dl->PathStroke(IM_COL32(130, 155, 195, 180), 0, 1.4f);

            // ═════════════════════════════════════════════════════════════════════
            // 4. CAMADA 3D: RANHURAS RECARTILHADAS (KNURLING TEETH COM RELEVO 3D)
            // ═════════════════════════════════════════════════════════════════════
            int num_teeth = 64;
            for (int t = 0; t < num_teeth; t++) {
                float a = (float)t / (float)num_teeth * 2.0f * (float)M_PI;
                float r_in  = radius - 6.5f;
                float r_out = radius - 2.0f;
                float ca = std::cos(a), sa = std::sin(a);
                float tan_x = -sa * 0.8f;
                float tan_y =  ca * 0.8f;
                // Aresta de luz (esquerda)
                dl->AddLine(ImVec2(center.x + ca*r_in - tan_x, center.y + sa*r_in - tan_y),
                            ImVec2(center.x + ca*r_out - tan_x, center.y + sa*r_out - tan_y),
                            IM_COL32(75, 95, 125, 200), 1.0f);
                // Aresta de sombra (direita)
                dl->AddLine(ImVec2(center.x + ca*r_in + tan_x, center.y + sa*r_in + tan_y),
                            ImVec2(center.x + ca*r_out + tan_x, center.y + sa*r_out + tan_y),
                            IM_COL32(6, 8, 12, 230), 1.0f);
            }

            // ═════════════════════════════════════════════════════════════════════
            // 5. CAMADA 3D: HALO NEON MULTI-PASS (BLOOM + STROBE BARS)
            // ═════════════════════════════════════════════════════════════════════
            float r_halo_out = radius - 7.0f;
            float r_halo_in  = radius - 13.5f;
            float r_halo_mid = (r_halo_out + r_halo_in) * 0.5f;

            // Bloom difuso volumétrico
            int alpha_bloom = (int)(std::clamp(45.0f * pulse, 15.0f, 95.0f));
            dl->AddCircle(center, r_halo_mid, IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), alpha_bloom), 64, 7.0f);

            int halo_bars = 64;
            for (int b = 0; b < halo_bars; b++) {
                float a = (float)b / (float)halo_bars * 2.0f * (float)M_PI;
                float grad_t = 0.5f + 0.5f * std::sin(a + (float)ImGui::GetTime() * 1.2f);
                int cr = (int)(fx_glow_col1.x * (1.0f - grad_t) * 255 + fx_glow_col2.x * grad_t * 255);
                int cg = (int)(fx_glow_col1.y * (1.0f - grad_t) * 255 + fx_glow_col2.y * grad_t * 255);
                int cb = (int)(fx_glow_col1.z * (1.0f - grad_t) * 255 + fx_glow_col2.z * grad_t * 255);

                float wave_mod = 1.0f + 0.85f * std::sin(a * 4.0f + rot_ang * 2.0f) * vu;
                float bar_h = (r_halo_out - r_halo_in) * 0.68f * wave_mod;
                bar_h = std::clamp(bar_h, 2.0f, r_halo_out - r_halo_in);

                ImVec2 pb_in  = ImVec2(center.x + std::cos(a) * r_halo_in, center.y + std::sin(a) * r_halo_in);
                ImVec2 pb_out = ImVec2(center.x + std::cos(a) * (r_halo_in + bar_h), center.y + std::sin(a) * (r_halo_in + bar_h));
                dl->AddLine(pb_in, pb_out, IM_COL32(cr, cg, cb, (int)(std::clamp(190.0f * pulse, 50.0f, 255.0f))), 1.4f);
            }

            dl->AddCircle(center, r_halo_out, IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), (int)(std::clamp(230.0f * pulse, 60.0f, 255.0f))), 64, 1.4f);
            dl->AddCircle(center, r_halo_in, IM_COL32(18, 24, 34, 255), 64, 1.2f);

            // ═════════════════════════════════════════════════════════════════════
            // 6. CAMADA 3D: PRATO DE VINIL FUMÊ REBAIXADO COM REFLEXO ANISOTRÓPICO
            // ═════════════════════════════════════════════════════════════════════
            float r_platter = r_halo_in - 2.0f;
            dl->AddCircleFilled(center, r_platter + 1.0f, IM_COL32(4, 5, 8, 255), 64);
            dl->AddCircleFilled(center, r_platter, IM_COL32(9, 11, 16, 255), 64);

            float groove_steps[] = { 0.96f, 0.90f, 0.84f, 0.78f, 0.72f, 0.65f, 0.58f, 0.51f };
            for (float g_ratio : groove_steps) {
                float r_g = r_platter * g_ratio;
                dl->AddCircle(center, r_g, IM_COL32(26, 36, 50, 140), 64, 1.0f);
            }

            // Leques de luz anisotrópicos giratórios do vinil
            float sheen_a1 = rot_ang + 0.785f;
            float sheen_a2 = rot_ang + 3.926f;
            for (float s_a : { sheen_a1, sheen_a2 }) {
                for (int w = -3; w <= 3; w++) {
                    float sweep = s_a + (float)w * 0.045f;
                    float falloff = 1.0f - (float)std::abs(w) / 4.0f;
                    ImVec2 in_p(center.x + std::cos(sweep) * (r_platter * 0.46f), center.y + std::sin(sweep) * (r_platter * 0.46f));
                    ImVec2 out_p(center.x + std::cos(sweep) * (r_platter * 0.97f), center.y + std::sin(sweep) * (r_platter * 0.97f));
                    dl->AddLine(in_p, out_p, IM_COL32(190, 225, 255, (int)(42.0f * falloff)), 3.5f);
                }
            }

            // ═════════════════════════════════════════════════════════════════════
            // 7. CAMADA 3D: DISPLAY CENTRAL ON-JOG LCD (SEM BPM!)
            // ═════════════════════════════════════════════════════════════════════
            float hub_r = r_platter * 0.48f;
            float hub_scale = std::clamp(hub_r / 44.0f, 0.45f, 1.45f);

            // Bezel de alumínio aeroespacial com anel de chanfro e glow
            dl->AddCircleFilled(center, hub_r + 3.0f, IM_COL32(18, 24, 34, 255), 64);
            dl->AddCircle(center, hub_r + 3.0f, IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), (int)(std::clamp(195.0f * pulse, 60.0f, 255.0f))), 64, 1.5f);
            dl->AddCircleFilled(center, hub_r, IM_COL32(4, 6, 9, 255), 64);

            // Anel orbital de progresso da faixa
            float track_ring_r = hub_r - 3.5f;
            dl->AddCircle(center, track_ring_r, IM_COL32(18, 26, 38, 255), 64, 2.0f);

            // Arco luminoso da agulha (Playhead Arc)
            float arc_len = 1.40f * (float)M_PI;
            int arc_segs = 28;
            for (int s = 0; s < arc_segs; s++) {
                float a0 = rot_ang - arc_len + (float)s / (float)arc_segs * arc_len;
                float a1 = rot_ang - arc_len + (float)(s + 1) / (float)arc_segs * arc_len;
                float alpha = (float)(s + 1) / (float)arc_segs;
                ImU32 c_arc = IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), (int)(255.0f * alpha));
                ImVec2 p0 = ImVec2(center.x + std::cos(a0) * track_ring_r, center.y + std::sin(a0) * track_ring_r);
                ImVec2 p1 = ImVec2(center.x + std::cos(a1) * track_ring_r, center.y + std::sin(a1) * track_ring_r);
                dl->AddLine(p0, p1, c_arc, 2.8f);
            }

            // Cabeça da agulha laser neon com rastro
            ImVec2 needle_head = ImVec2(center.x + std::cos(rot_ang) * track_ring_r, center.y + std::sin(rot_ang) * track_ring_r);
            dl->AddCircleFilled(needle_head, 4.0f, IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), 255), 16);
            dl->AddCircle(needle_head, 5.6f, IM_COL32(255, 255, 255, 220), 16, 1.2f);
            ImVec2 needle_in = ImVec2(center.x + std::cos(rot_ang) * (track_ring_r - 6.0f), center.y + std::sin(rot_ang) * (track_ring_r - 6.0f));
            dl->AddLine(needle_head, needle_in, IM_COL32(255, 255, 255, 255), 2.4f);

            // Spindle central 3D de alumínio usinado
            dl->AddCircleFilled(center, 4.0f, IM_COL32(180, 205, 235, 255), 16);
            dl->AddCircle(center, 4.0f, IM_COL32(40, 52, 70, 255), 16, 1.2f);
            dl->AddCircleFilled(center, 1.8f, IM_COL32(255, 255, 255, 255), 8);

            // Telemetria do visor (SEM BPM CENTRAL!):
            // TOPO: "ABDUCTION" em ciano brilhante
            ImFont* f_ctrl = g_font_control_small ? g_font_control_small : (g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont());
            float sz_top_font = std::clamp(9.5f * hub_scale, 7.5f, 13.0f);
            ImVec2 sz_top = f_ctrl->CalcTextSizeA(sz_top_font, FLT_MAX, 0.0f, "ABDUCTION");
            float top_y = center.y - hub_r * 0.65f;
            dl->AddText(f_ctrl, sz_top_font, ImVec2(center.x - sz_top.x * 0.5f + 1.0f, top_y + 1.0f), IM_COL32(0, 0, 0, 180), "ABDUCTION");
            dl->AddText(f_ctrl, sz_top_font, ImVec2(center.x - sz_top.x * 0.5f, top_y), IM_COL32(0, 240, 255, 240), "ABDUCTION");

            // Ondas holográficas concêntricas no centro reagindo ao beat
            if (deck.is_playing) {
                float wave_pulse_r = (hub_r * 0.32f) * (0.6f + 0.4f * vu);
                dl->AddCircle(center, wave_pulse_r, IM_COL32((int)(fx_glow_col1.x*255), (int)(fx_glow_col1.y*255), (int)(fx_glow_col1.z*255), (int)(110.0f * pulse)), 32, 1.2f);
            }

            // BASE: Notação Harmônica (Camelot / Tom, ex: "0A / Am" ou "8A") em Pílula Neon
            std::string key_str = deck.key_signature.empty() ? "0A / Am" : deck.key_signature;
            if (key_str == "8A") key_str = "0A / Am";
            float sz_key_font = std::clamp(10.5f * hub_scale, 8.5f, 14.0f);
            ImVec2 sz_k = f_ctrl->CalcTextSizeA(sz_key_font, FLT_MAX, 0.0f, key_str.c_str());
            float pill_w = sz_k.x + 12.0f * hub_scale;
            float pill_h = sz_k.y + 4.0f * hub_scale;
            float pill_y = center.y + hub_r * 0.38f;
            ImVec2 p_min_pill(center.x - pill_w * 0.5f, pill_y);
            ImVec2 p_max_pill(center.x + pill_w * 0.5f, pill_y + pill_h);
            dl->AddRectFilled(p_min_pill, p_max_pill, IM_COL32(4, 18, 12, 230), 4.0f);
            dl->AddRect(p_min_pill, p_max_pill, IM_COL32(0, 255, 128, 200), 4.0f, 0, 1.0f);
            dl->AddText(f_ctrl, sz_key_font, ImVec2(center.x - sz_k.x * 0.5f, pill_y + 2.0f * hub_scale), IM_COL32(0, 255, 128, 255), key_str.c_str());

            // Domo de Vidro Convexo do LCD (Reflexo de Lente em Arco Superior)
            dl->PathArcTo(center, hub_r - 2.0f, -0.80f * (float)M_PI, -0.20f * (float)M_PI, 24);
            dl->PathStroke(IM_COL32(255, 255, 255, 55), 0, 2.0f);
            
            // 5. INTERAÇÃO DO PLATTER EXTERNO E SCRATCH
            char j_id[32];
            snprintf(j_id, sizeof(j_id), "##RekordboxJogPlatter_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(top_left);
            ImGui::InvisibleButton(j_id, ImVec2(size, size));

            // Drag & Drop Target no Jogwheel
            if (ImGui::BeginDragDropTarget()) {
                if (const ImGuiPayload* payload = ImGui::AcceptDragDropPayload("DND_DJ_TRACK_ID")) {
                    const char* dropped_id = (const char*)payload->Data;
                    auto* ptr = KuroAudio::DJLibraryManager::getInstance().getTrackById(dropped_id);
                    if (ptr && current_engine) {
                        if (ptr->is_downloaded) spotify_service.loadLibraryTrack(*ptr, deck.deck_id, *current_engine);
                        else spotify_service.downloadLibraryTrackAsync(*ptr, deck.deck_id, *current_engine);
                    }
                }
                dl->AddCircle(center, radius + 2.0f, ImGui::ColorConvertFloat4ToU32(theme_col), 64, 3.0f);
                ImGui::EndDragDropTarget();
            }

            bool jog_hovered = ImGui::IsItemHovered();
            bool jog_active  = ImGui::IsItemActive();

            if (jog_active) {
                ImVec2 mouse = ImGui::GetMousePos();
                ImVec2 delta = ImGui::GetIO().MouseDelta;
                float dist_sq = (mouse.x - center.x) * (mouse.x - center.x) + (mouse.y - center.y) * (mouse.y - center.y);
                float dist = std::sqrt(dist_sq);

                // Scratch e Nudge só operam ESTRITAMENTE FORA do display LCD central (dist >= hub_r - 2.0f)
                if (dist >= hub_r - 2.0f && dist <= radius + 10.0f) {
                    float ang_delta = (delta.x * (mouse.y - center.y) - delta.y * (mouse.x - center.x)) / (dist_sq + 120.0f);
                    if (dist < r_platter * 0.95f) {
                        if (deck.vinyl_mode) {
                            deck.jog_touch = true;
                            deck.motor_stopped = true;
                        }
                        float rot_delta = ang_delta * 0.16f;
                        deck.target_scratch_velocity = std::clamp(rot_delta * 3.2f, -3.0f, 3.0f);
                        deck.scratch_active_ticks = 4;
                        deck.jog_visual_angle += rot_delta;

                        if (!deck.is_playing) {
                            double frames_delta = (double)rot_delta * (deck.sample_rate * 0.10);
                            if (ImGui::GetIO().KeyShift) frames_delta *= 4.0;
                            deck.current_frame = std::clamp(deck.current_frame + frames_delta, 0.0, (double)deck.buffer_l.size());
                        }
                    } else {
                        float rot_delta = ang_delta * 0.035f;
                        deck.jog_pitch_bend = std::clamp(deck.jog_pitch_bend + rot_delta, -0.35f, 0.35f);
                        deck.jog_visual_angle += rot_delta;
                    }
                }
            } else if (jog_hovered && ImGui::IsMouseReleased(0)) {
                deck.jog_touch = false;
                deck.motor_stopped = false;
            } else if (!jog_active && !jog_hovered && deck.jog_touch) {
                deck.jog_touch = false;
                deck.motor_stopped = false;
            }

            // Feedback Reativo de Toque / Scratch / Slip (Cyberpunk Neon Flash)
            if (deck.jog_touch || deck.motor_stopped) {
                dl->AddCircle(center, hub_r + 2.0f, IM_COL32(235, 0, 255, 240), 64, 2.5f);
                dl->AddCircle(center, r_platter * 0.98f, IM_COL32(0, 240, 255, 200), 64, 1.8f);
            }
        }

        // =========================================================================
        // PAINEL LATERAL ERGONÔMICO DE TEMPO / PITCH / BPM (AO LADO DO VINIL)
        // Solução oficial para Rekordbox quando o vinil reduz de tamanho:
        // Exibe BPM grande, Pitch %, Pitch Range (±6%, ±10%, ±16%, WIDE) e botões
        // táteis [+] e [-] com amplo espaço para clique, mousewheel e hold.
        // Adapta-se perfeitamente tanto a layouts amplos quanto a alturas compactas.
        // =========================================================================
        void renderRekordboxSideTempoPanel(KuroAudio::DJDeck& deck, ImVec2 pos, ImVec2 size, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImFont* f_hero = g_font_display_hero ? g_font_display_hero : (g_font_rekordbox_large ? g_font_rekordbox_large : ImGui::GetFont());
            ImFont* f_bld  = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
            ImFont* f_reg  = g_font_rekordbox_regular ? g_font_rekordbox_regular : ImGui::GetFont();

            // 1. Chassi obsidian / grafite metálico com borda elegante Pioneer
            dl->AddRectFilled(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(11, 14, 19, 255), 4.0f);
            dl->AddRect(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(28, 36, 48, 220), 4.0f, 0, 1.0f);

            bool is_compact = (size.y < 98.0f);
            float pad_x = 5.0f;
            float cur_y = pos.y + (is_compact ? 3.0f : 4.0f);
            float inner_w = size.x - pad_x * 2.0f;

            // 2. SEÇÃO 1: BPM (Label "BPM" + Dígitos Principais Grandes + Centésimos)
            double eff_bpm = (deck.bpm > 20.0) ? (deck.bpm * (1.0 + deck.pitch_percent * 0.01)) : 126.00;
            char bpm_main[16];
            char bpm_dec[8];
            int bpm_int_part = (int)eff_bpm;
            int bpm_frac_part = (int)std::round((eff_bpm - (double)bpm_int_part) * 100.0);
            if (bpm_frac_part >= 100) { bpm_int_part++; bpm_frac_part = 0; }
            snprintf(bpm_main, sizeof(bpm_main), "%d", bpm_int_part);
            snprintf(bpm_dec, sizeof(bpm_dec), ".%02d", bpm_frac_part);

            float bpm_m_sz = is_compact ? ((size.x < 85.0f) ? 15.5f : 17.0f) : ((size.x < 85.0f) ? 17.0f : 19.0f);
            float bpm_d_sz = is_compact ? ((size.x < 85.0f) ? 10.0f : 11.0f) : ((size.x < 85.0f) ? 11.5f : 12.5f);
            ImVec2 sz_m = f_hero->CalcTextSizeA(bpm_m_sz, FLT_MAX, 0.0f, bpm_main);
            ImVec2 sz_d = f_reg->CalcTextSizeA(bpm_d_sz, FLT_MAX, 0.0f, bpm_dec);
            float tot_bpm_w = sz_m.x + sz_d.x;

            float bpm_digits_x = pos.x + pad_x;
            if (is_compact) {
                // Modo compacto: Label "BPM" inline à esquerda
                dl->AddText(f_bld, 8.5f, ImVec2(pos.x + pad_x, cur_y + 3.0f), IM_COL32(140, 160, 185, 230), "BPM");
                bpm_digits_x = pos.x + pad_x + 22.0f;
            } else {
                // Modo normal: Label "BPM" no topo
                dl->AddText(f_bld, 9.5f, ImVec2(pos.x + pad_x, cur_y), IM_COL32(140, 160, 185, 230), "BPM");
                cur_y += 11.0f;
            }

            if (bpm_editing_deck == deck.deck_id && !bpm_edit_from_header) {
                float in_x = is_compact ? (pos.x + pad_x + 20.0f) : (pos.x + pad_x);
                float in_w = is_compact ? (inner_w - 20.0f) : inner_w;
                ImGui::SetCursorScreenPos(ImVec2(in_x, cur_y - 2.0f));
                ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0.06f, 0.08f, 0.12f, 0.98f));
                ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.0f, 0.65f, 1.0f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 3.0f);
                ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(3.0f, 2.0f));
                ImGui::PushItemWidth(in_w);

                if (bpm_edit_focus_needed) {
                    ImGui::SetKeyboardFocusHere();
                    bpm_edit_focus_needed = false;
                }

                char inp_id[32]; snprintf(inp_id, sizeof(inp_id), "##BpmSideInput_%d", deck.deck_id);
                bool enter = ImGui::InputText(inp_id, bpm_edit_buf, sizeof(bpm_edit_buf), 
                    ImGuiInputTextFlags_EnterReturnsTrue | ImGuiInputTextFlags_AutoSelectAll);

                if (enter || (!ImGui::IsItemActive() && ImGui::IsMouseClicked(0))) {
                    float val = (float)atof(bpm_edit_buf);
                    if (val >= 20.0f && val <= 300.0f) {
                        applyManualBpm(deck, val, ImGui::GetIO().KeyShift);
                    }
                    bpm_editing_deck = -1;
                }
                if (ImGui::IsKeyPressed(ImGuiKey_Escape)) {
                    bpm_editing_deck = -1;
                }

                ImGui::PopItemWidth();
                ImGui::PopStyleVar(2);
                ImGui::PopStyleColor(3);
            } else {
                dl->AddText(f_hero, bpm_m_sz, ImVec2(bpm_digits_x, cur_y), IM_COL32(255, 255, 255, 255), bpm_main);
                dl->AddText(f_reg, bpm_d_sz, ImVec2(bpm_digits_x + sz_m.x, cur_y + (bpm_m_sz - bpm_d_sz) * 0.7f), IM_COL32(235, 240, 250, 240), bpm_dec);

                char b_side_id[32]; snprintf(b_side_id, sizeof(b_side_id), "##SideBpmClick_%d", deck.deck_id);
                ImGui::SetCursorScreenPos(ImVec2(bpm_digits_x - 2.0f, cur_y - 2.0f));
                if (ImGui::InvisibleButton(b_side_id, ImVec2(tot_bpm_w + 4.0f, bpm_m_sz + 4.0f))) {
                    bpm_editing_deck = deck.deck_id;
                    bpm_edit_from_header = false;
                    snprintf(bpm_edit_buf, sizeof(bpm_edit_buf), "%.2f", eff_bpm);
                    bpm_edit_focus_needed = true;
                }
                if (ImGui::IsItemHovered()) {
