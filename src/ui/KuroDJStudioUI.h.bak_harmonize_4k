            }

            bool is_held = ImGui::IsItemActive();
            bool is_hovered = ImGui::IsItemHovered();

            // Animação tátil física: deslocamento de 1.2px para baixo quando pressionado
            ImVec2 draw_center = is_held ? ImVec2(center.x, center.y + 1.2f) : center;
            float eff_radius = is_held ? radius * 0.94f : (is_hovered ? radius * 1.02f : radius);

            // Halo difuso de LED Neon (Glow) quando ativo ou em hover
            if (is_active || is_hovered) {
                ImVec4 c_v4 = ImGui::ColorConvertU32ToFloat4(ring_col);
                float glow_alpha = is_active ? 0.32f : 0.16f;
                ImU32 halo_col1 = ImGui::ColorConvertFloat4ToU32(ImVec4(c_v4.x, c_v4.y, c_v4.z, glow_alpha * 0.45f));
                ImU32 halo_col2 = ImGui::ColorConvertFloat4ToU32(ImVec4(c_v4.x, c_v4.y, c_v4.z, glow_alpha));
                dl->AddCircleFilled(draw_center, eff_radius + 4.5f, halo_col1, 36);
                dl->AddCircleFilled(draw_center, eff_radius + 2.0f, halo_col2, 36);
            }

            // Sombra e anel de base rebaixado estilo hardware Pioneer
            dl->AddCircleFilled(ImVec2(center.x, center.y + 1.5f), radius + 1.0f, IM_COL32(5, 7, 10, 240), 36);
