                    ImGui::TextColored(ImVec4(1.0f, 0.70f, 0.20f, 1.0f), ICON_FA_BOLT " ABDUZINDO (%d%%)", dl_pct);
                }
                ImGui::SameLine(0, 6);
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.65f, 0.15f, 0.18f, 0.85f));
