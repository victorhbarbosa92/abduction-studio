                    ImGui::TextColored(ImVec4(0.40f, 0.55f, 0.68f, 0.75f), "Passe o mouse nas faixas");
                }

                ImGui::EndChild();
                ImGui::PopStyleVar();
                ImGui::PopStyleColor(2);
            }

