                // =========================================================================
                // DOCK DE AUDITION // WAVEFORM PLAYER FIXO NA BASE (100% FIEL AO MOCKUP)
                // =========================================================================
                std::string playing_id = preview_player.getCurrentTrackId();
                if (!playing_id.empty()) {
                    ImGui::Spacing();
                    ImVec2 card_pos = ImGui::GetCursorScreenPos();
                    float card_w = avail_w;
                    float card_h = 44.0f;
                    bool is_p = preview_player.isPlaying();

                    dl->AddRectFilled(card_pos, ImVec2(card_pos.x + card_w, card_pos.y + card_h), IM_COL32(8, 12, 19, 255), 6.0f);
                    dl->AddRect(card_pos, ImVec2(card_pos.x + card_w, card_pos.y + card_h), 
                                is_p ? IM_COL32(0, 245, 212, 160) : IM_COL32(35, 50, 70, 140), 6.0f, 0, 1.0f);

                    // 1. Botão Play / Pause Circular / Arredondado
                    float btn_sz = 30.0f;
                    ImGui::SetCursorScreenPos(ImVec2(card_pos.x + 8.0f, card_pos.y + (card_h - btn_sz) * 0.5f));
                    ImGui::PushStyleColor(ImGuiCol_Button, is_p ? ImVec4(0.00f, 0.85f, 0.75f, 1.0f) : ImVec4(0.14f, 0.20f, 0.30f, 0.95f));
                    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.00f, 0.98f, 0.88f, 1.0f));
                    ImGui::PushStyleColor(ImGuiCol_Text, is_p ? ImVec4(0.02f, 0.08f, 0.10f, 1.0f) : ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, btn_sz * 0.5f);
                    const char* btn_ic = preview_player.isLoading() ? ICON_FA_SPINNER : (is_p ? ICON_FA_PAUSE : ICON_FA_PLAY);
                    if (ImGui::Button(btn_ic, ImVec2(btn_sz, btn_sz))) {
                        preview_player.togglePlayPause();
                    }
                    ImGui::PopStyleVar();
                    ImGui::PopStyleColor(3);

                    // 2. Tempo Atual (à esquerda da waveform)
                    double cur_pos = preview_player.getPosition();
                    double dur = preview_player.getDuration();
                    if (dur <= 0.1) dur = 30.0;
                    float progress = (float)std::clamp(cur_pos / dur, 0.0, 1.0);

                    char cur_str[16];
                    int c_m = (int)cur_pos / 60, c_s = (int)cur_pos % 60;
                    snprintf(cur_str, sizeof(cur_str), "%02d:%02d", c_m, c_s);

                    float time_left_x = card_pos.x + 46.0f;
                    ImGui::SetCursorScreenPos(ImVec2(time_left_x, card_pos.y + 14.0f));
                    ImGui::TextColored(ImVec4(0.75f, 0.85f, 0.95f, 1.0f), "%s", cur_str);

                    // 3. Área da Waveform Espectral Multi-colorida (Centro)
                    float wave_x = time_left_x + 46.0f;
                    float wave_y = card_pos.y + 10.0f;
                    float right_controls_w = 175.0f;
                    float wave_w = card_w - (wave_x - card_pos.x) - right_controls_w;
                    float wave_h = 24.0f;

                    if (wave_w > 80.0f) {
                        dl->AddRectFilled(ImVec2(wave_x, wave_y), ImVec2(wave_x + wave_w, wave_y + wave_h), IM_COL32(4, 7, 12, 240), 3.0f);
                        const auto& peaks = preview_player.getWaveformPeaks();
                        int n_bars = (int)peaks.size();
                        if (n_bars > 0) {
                            float bar_step = wave_w / (float)n_bars;
                            float bar_w = std::max(1.5f, bar_step - 1.0f);
                            for (int b = 0; b < n_bars; b++) {
                                float bx = wave_x + b * bar_step;
                                float bh = peaks[b] * (wave_h - 4.0f);
                                float by = wave_y + (wave_h - bh) * 0.5f;
                                float bar_ratio = (float)b / (float)n_bars;
                                bool played = (bar_ratio <= progress);

                                // 3-Band Color Spectrum (Lows=Cyan/Blue, Mids=Orange, Highs=Magenta)
                                ImU32 col_bar;
                                if (played) {
                                    if (bar_ratio < 0.33f) col_bar = IM_COL32(0, 240, 215, 255);      // Neon Cyan
                                    else if (bar_ratio < 0.66f) col_bar = IM_COL32(255, 145, 0, 255); // Amber / Orange
                                    else col_bar = IM_COL32(255, 50, 160, 255);                       // Neon Magenta
                                } else {
                                    if (bar_ratio < 0.33f) col_bar = IM_COL32(0, 100, 110, 110);
                                    else if (bar_ratio < 0.66f) col_bar = IM_COL32(110, 65, 15, 110);
                                    else col_bar = IM_COL32(110, 30, 75, 110);
                                }
                                dl->AddRectFilled(ImVec2(bx, by), ImVec2(bx + bar_w, by + bh), col_bar, 1.0f);
                            }
                        }
                        // Cursor Playhead Branco
                        float playhead_x = wave_x + progress * wave_w;
                        dl->AddLine(ImVec2(playhead_x, wave_y), ImVec2(playhead_x, wave_y + wave_h), IM_COL32(255, 255, 255, 255), 2.0f);

                        // Interatividade de Scrubbing na Waveform
                        ImGui::SetCursorScreenPos(ImVec2(wave_x, wave_y));
                        ImGui::InvisibleButton("##WaveSeekBtn", ImVec2(wave_w, wave_h));
                        if (ImGui::IsItemActive() || ImGui::IsItemClicked()) {
                            float m_x = ImGui::GetMousePos().x;
                            float click_ratio = std::clamp((m_x - wave_x) / wave_w, 0.0f, 1.0f);
                            preview_player.seek(click_ratio * dur);
                        }
                    }

                    // 4. Tempo Restante / Total (à direita da waveform)
                    char rem_str[16];
                    double rem_pos = dur - cur_pos;
                    int r_m = (int)rem_pos / 60, r_s = (int)rem_pos % 60;
                    snprintf(rem_str, sizeof(rem_str), "-%02d:%02d", r_m, r_s);

                    float time_right_x = wave_x + wave_w + 10.0f;
                    ImGui::SetCursorScreenPos(ImVec2(time_right_x, card_pos.y + 14.0f));
                    ImGui::TextColored(ImVec4(0.75f, 0.85f, 0.95f, 1.0f), "%s", rem_str);

                    // 5. Volume e Parar
                    ImGui::SetCursorScreenPos(ImVec2(card_pos.x + card_w - 95.0f, card_pos.y + 12.0f));
                    float v = preview_player.getVolume();
                    ImGui::PushItemWidth(55.0f);
                    if (ImGui::SliderFloat("##PreviewVol", &v, 0.0f, 1.0f, "")) {
                        preview_player.setVolume(v);
                    }
                    ImGui::PopItemWidth();

                    ImGui::SameLine(0, 4.0f);
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.35f, 0.12f, 0.16f, 0.90f));
                    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 4.0f);
                    if (ImGui::SmallButton(ICON_FA_STOP "##StopPrev")) {
                        preview_player.stop();
                    }
                    ImGui::PopStyleVar();
                    ImGui::PopStyleColor();

                    ImGui::SetCursorScreenPos(ImVec2(card_pos.x, card_pos.y + card_h + 4.0f));
                }

                // --- 4. STATUS & RETORNAR AO MODO DJ ---
                ImGui::Spacing();
                ImGui::TextColored(col_deck_1, ICON_FA_COMPACT_DISC " STATUS:");
                ImGui::SameLine();
                ImGui::TextColored(ImVec4(0.70f, 0.85f, 0.95f, 1.0f), "%s", spotify_service.getStatus().c_str());

                ImGui::SameLine(avail_w - 170.0f);
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.18f, 0.28f, 0.85f));
                ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.20f, 0.30f, 0.45f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.85f, 0.92f, 1.0f, 1.0f));
                ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 5.0f);
                if (ImGui::Button(ICON_FA_ARROW_LEFT " VOLTAR AO MODO DJ", ImVec2(165, 24))) {
                    show_search_modal = false;
                    search_modal_view = 0;
                    preview_player.stop();
                }
                ImGui::PopStyleVar();
                ImGui::PopStyleColor(3);

                ImGui::End();
            }

            if (!show_search_modal) {
                KuroAudio::DJPreviewPlayer::getInstance().stop();
            }
            ImGui::PopStyleVar(3);
            ImGui::PopStyleColor(2);
        }


        // =========================================================================
        // MODAL DO RADAR HARMÔNICO REKORDBOX & CAMELOT WHEEL
        // =========================================================================
        void renderCamelotRadarModal(KuroAudio::DJEngine& engine) {
            if (!show_camelot_radar_modal) return;

            if (!ImGui::IsPopupOpen("🎡 RADAR HARMÔNICO REKORDBOX & CAMELOT WHEEL##CamelotRadarModal")) {
                ImGui::OpenPopup("🎡 RADAR HARMÔNICO REKORDBOX & CAMELOT WHEEL##CamelotRadarModal");
            }

            ImGuiViewport* vp = ImGui::GetMainViewport();
            ImVec2 msz = ImVec2(900.0f, 640.0f);
            ImGui::SetNextWindowPos(ImVec2(vp->Pos.x + (vp->Size.x - msz.x) * 0.5f, vp->Pos.y + (vp->Size.y - msz.y) * 0.5f), ImGuiCond_Always);
            ImGui::SetNextWindowSize(msz, ImGuiCond_Always);

            ImGui::PushStyleColor(ImGuiCol_PopupBg, ImVec4(0.05f, 0.07f, 0.11f, 0.98f));
            ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.00f, 0.85f, 0.85f, 0.85f));
            ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 10.0f);
            ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.5f);

            if (ImGui::BeginPopupModal("🎡 RADAR HARMÔNICO REKORDBOX & CAMELOT WHEEL##CamelotRadarModal", &show_camelot_radar_modal, ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize)) {
                // Header
                ImGui::TextColored(ImVec4(0.00f, 0.95f, 0.90f, 1.0f), ICON_FA_CIRCLE_NODES " RADAR HARMÔNICO REKORDBOX & CAMELOT WHEEL");
                ImGui::SameLine();
                ImGui::TextColored(ImVec4(0.65f, 0.75f, 0.85f, 1.0f), "|  Mixagem Harmônica Inteligente em Tempo Real");

                ImGui::Spacing();
                ImGui::Separator();
                ImGui::Spacing();

                // 1. Linha de Seleção do Deck de Referência
                ImGui::TextColored(ImVec4(0.85f, 0.90f, 1.0f, 1.0f), "Deck Referência:");
                ImGui::SameLine();
                for (int d = 0; d < 4; ++d) {
                    auto& dk = engine.decks[d];
                    bool is_playing = dk.is_playing.load();
                    bool is_selected = (camelot_ref_deck == d);

                    char d_label[64];
                    if (is_playing) {
                        snprintf(d_label, sizeof(d_label), "● DECK %d (ON)##RefDeck_%d", d + 1, d);
                    } else {
                        snprintf(d_label, sizeof(d_label), "DECK %d##RefDeck_%d", d + 1, d);
                    }

                    if (is_selected) {
                        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.00f, 0.60f, 0.70f, 0.95f));
                    } else if (is_playing) {
                        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.15f, 0.45f, 0.25f, 0.85f));
                    } else {
                        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.14f, 0.16f, 0.22f, 0.85f));
                    }

                    if (ImGui::Button(d_label, ImVec2(110, 24))) {
                        camelot_ref_deck = d;
                    }
                    ImGui::PopStyleColor();
                    if (d < 3) ImGui::SameLine(0, 4);
                }

                auto& base_deck = engine.decks[camelot_ref_deck];
                KuroAudio::CamelotKey base_ck = KuroAudio::DJHarmonicEngine::parseKey(base_deck.key_signature);
                unsigned int base_col = KuroAudio::DJHarmonicEngine::getCamelotWheelColor(base_ck.number);

                ImGui::SameLine(0, 14);
                ImGui::TextColored(ImVec4(0.70f, 0.75f, 0.85f, 1.0f), "Tom:");
                ImGui::SameLine(0, 4);
                ImGui::PushStyleColor(ImGuiCol_Button, (ImU32)base_col);
                ImGui::PushStyleColor(ImGuiCol_Text, IM_COL32(255, 255, 255, 255));
                char base_pill[32];
                snprintf(base_pill, sizeof(base_pill), "[ %s ] %s", base_ck.getCamelotCode().c_str(), base_ck.musical_key.c_str());
                ImGui::Button(base_pill, ImVec2(100, 24));
                ImGui::PopStyleColor(2);

                ImGui::Spacing();
                ImGui::Separator();
                ImGui::Spacing();

                // 2. Colunas: Esquerda = Roda Gráfica Camelot, Direita = Regras & Filtros
                ImGui::Columns(2, "CamelotColumns", false);
                ImGui::SetColumnWidth(0, 430.0f);

                // --- COLUNA ESQUERDA: CAMELOT WHEEL CANVAS ---
                ImGui::TextColored(ImVec4(0.3f, 0.85f, 1.0f, 1.0f), ICON_FA_COMPASS " RODA CAMELOT INTERATIVA");
                ImGui::TextColored(ImVec4(0.6f, 0.65f, 0.75f, 1.0f), "Anel Externo = Maior (B)  |  Anel Interno = Menor (A)");
                ImGui::Spacing();

                ImVec2 wheel_canvas_sz(400.0f, 400.0f);
                ImGui::Dummy(wheel_canvas_sz);
                ImVec2 p0 = ImGui::GetItemRectMin();
                ImVec2 p1 = ImGui::GetItemRectMax();
                ImVec2 center = ImVec2((p0.x + p1.x) * 0.5f, (p0.y + p1.y) * 0.5f);
                ImDrawList* draw_list = ImGui::GetWindowDrawList();

                const float r_outer = 185.0f;
                const float r_mid   = 125.0f;
                const float r_hub   = 68.0f;
                const float angle_step = 2.0f * 3.14159265f / 12.0f;

                // Fundo do dial
                draw_list->AddCircleFilled(center, r_outer + 4.0f, IM_COL32(12, 16, 24, 255), 64);
                draw_list->AddCircle(center, r_outer + 4.0f, IM_COL32(35, 45, 65, 255), 64, 1.5f);

                // Interação com o Mouse
                ImVec2 m = ImGui::GetIO().MousePos;
                float m_dx = m.x - center.x;
                float m_dy = m.y - center.y;
                float m_dist = sqrtf(m_dx * m_dx + m_dy * m_dy);
                float m_ang = atan2f(m_dy, m_dx);

                float rel_ang = m_ang + 3.14159265f * 0.5f + angle_step * 0.5f;
                while (rel_ang < 0.0f) rel_ang += 2.0f * 3.14159265f;
                while (rel_ang >= 2.0f * 3.14159265f) rel_ang -= 2.0f * 3.14159265f;
                int hovered_h = (int)(rel_ang / angle_step);
                if (hovered_h == 0) hovered_h = 12;

                char hovered_letter = '\0';
                if (m_dist >= r_mid && m_dist <= r_outer) hovered_letter = 'B';
                else if (m_dist >= r_hub && m_dist < r_mid) hovered_letter = 'A';

                bool mouse_clicked = ImGui::IsMouseClicked(0);

                // Dual Deck (Deck 1 + Deck 2) e Detecção de Hover em Tempo Real
                auto& dk1 = engine.decks[0];
                auto& dk2 = engine.decks[1];
                std::string d1_k_str = dk1.getEffectiveKey();
                std::string d2_k_str = dk2.getEffectiveKey();
                bool d1_loaded = !dk1.track_title.empty() && dk1.track_title != "No Track" && dk1.track_title != "Empty";
                bool d2_loaded = !dk2.track_title.empty() && dk2.track_title != "No Track" && dk2.track_title != "Empty";
                KuroAudio::CamelotKey d1_ck = KuroAudio::DJHarmonicEngine::parseKey(d1_k_str);
                KuroAudio::CamelotKey d2_ck = KuroAudio::DJHarmonicEngine::parseKey(d2_k_str);

                std::string hov_k = side_drawer_ui.hovered_track_key;
                std::string hov_id = side_drawer_ui.hovered_track_id;
                double hov_bpm = side_drawer_ui.hovered_track_bpm;
                std::string hov_title = side_drawer_ui.hovered_track_title;
                bool has_hov = (!hov_id.empty() && !hov_k.empty() && side_drawer_ui.hover_anim_timer > 0.02f);
                KuroAudio::CamelotKey hov_ck = KuroAudio::DJHarmonicEngine::parseKey(hov_k);

                // Desenha os 12 setores
                for (int h = 1; h <= 12; ++h) {
                    float mid_ang = -3.14159265f * 0.5f + (float)(h % 12) * angle_step;
                    float a0 = mid_ang - angle_step * 0.5f;
                    float a1 = mid_ang + angle_step * 0.5f;

                    unsigned int wheel_c = KuroAudio::DJHarmonicEngine::getCamelotWheelColor(h);

                    // --- ANEL EXTERNO (B - MAJOR) ---
                    {
                        bool d1_is_b = (d1_loaded && d1_ck.valid && d1_ck.number == h && d1_ck.letter == 'B');
                        bool d2_is_b = (d2_loaded && d2_ck.valid && d2_ck.number == h && d2_ck.letter == 'B');
                        bool hov_is_b = (has_hov && hov_ck.valid && hov_ck.number == h && hov_ck.letter == 'B');
                        bool is_base = (base_ck.valid && base_ck.number == h && base_ck.letter == 'B');
                        std::string code = std::to_string(h) + "B";
                        bool is_filter = (camelot_filter_key == code);
                        bool is_dial_hover = (hovered_h == h && hovered_letter == 'B');

                        unsigned char r_c = (wheel_c) & 0xFF;
                        unsigned char g_c = (wheel_c >> 8) & 0xFF;
                        unsigned char b_c = (wheel_c >> 16) & 0xFF;
                        unsigned int fill_col = IM_COL32(r_c, g_c, b_c, is_dial_hover ? 240 : (is_base ? 225 : 155));
                        if (d1_is_b && d2_is_b) {
                            fill_col = IM_COL32(0, 235, 255, 240); // Ambos Decks no mesmo tom!
                        } else if (d1_is_b) {
                            fill_col = IM_COL32(0, 220, 255, 235); // Deck 1 (Ciano)
                        } else if (d2_is_b) {
                            fill_col = IM_COL32(255, 140, 25, 235); // Deck 2 (Laranja)
                        }
                        if (hov_is_b) {
                            fill_col = IM_COL32(255, 240, 50, 250); // Faixa em hover sob o mouse!
                        }

                        const int segs = 8;
                        ImVec2 pts[segs * 2 + 2];
                        int pt_cnt = 0;
                        for (int s = 0; s <= segs; ++s) {
                            float a = a0 + (a1 - a0) * ((float)s / (float)segs);
                            pts[pt_cnt++] = ImVec2(center.x + cosf(a) * r_outer, center.y + sinf(a) * r_outer);
                        }
                        for (int s = segs; s >= 0; --s) {
                            float a = a0 + (a1 - a0) * ((float)s / (float)segs);
                            pts[pt_cnt++] = ImVec2(center.x + cosf(a) * r_mid, center.y + sinf(a) * r_mid);
                        }
                        draw_list->AddConvexPolyFilled(pts, pt_cnt, fill_col);

                        unsigned int border_c = IM_COL32(20, 26, 36, 255);
                        float thickness = 1.0f;
                        if (hov_is_b) {
                            border_c = IM_COL32(255, 235, 30, 255);
                            thickness = 3.0f;
                        } else if (d1_is_b && d2_is_b) {
                            border_c = IM_COL32(0, 255, 255, 255);
                            thickness = 3.0f;
                        } else if (d1_is_b) {
                            border_c = IM_COL32(0, 230, 255, 255);
                            thickness = 2.5f;
                        } else if (d2_is_b) {
                            border_c = IM_COL32(255, 150, 30, 255);
                            thickness = 2.5f;
                        } else if (is_filter) {
                            border_c = IM_COL32(255, 255, 255, 255);
                            thickness = 2.5f;
                        } else if (is_dial_hover) {
                            border_c = IM_COL32(0, 240, 255, 255);
                            thickness = 2.0f;
                        }
                        draw_list->AddPolyline(pts, pt_cnt, border_c, ImDrawFlags_Closed, thickness);

                        // Pins Indicadores de Decks Carregados no Setor B
                        float mid_r = (r_mid + r_outer) * 0.5f;
                        if (d1_is_b) {
                            ImVec2 p_pin1(center.x + cosf(mid_ang) * (r_mid + (r_outer - r_mid) * 0.28f), center.y + sinf(mid_ang) * (r_mid + (r_outer - r_mid) * 0.28f));
                            draw_list->AddCircleFilled(p_pin1, 9.0f, IM_COL32(0, 20, 32, 240));
                            draw_list->AddCircle(p_pin1, 9.0f, IM_COL32(0, 235, 255, 255), 16, 2.0f);
                            draw_list->AddText(ImVec2(p_pin1.x - 5.0f, p_pin1.y - 7.0f), IM_COL32(0, 255, 255, 255), "1");
                        }
                        if (d2_is_b) {
                            ImVec2 p_pin2(center.x + cosf(mid_ang) * (r_mid + (r_outer - r_mid) * 0.72f), center.y + sinf(mid_ang) * (r_mid + (r_outer - r_mid) * 0.72f));
                            draw_list->AddCircleFilled(p_pin2, 9.0f, IM_COL32(32, 16, 0, 240));
                            draw_list->AddCircle(p_pin2, 9.0f, IM_COL32(255, 140, 20, 255), 16, 2.0f);
                            draw_list->AddText(ImVec2(p_pin2.x - 5.0f, p_pin2.y - 7.0f), IM_COL32(255, 170, 40, 255), "2");
                        }

                        ImVec2 t_center(center.x + cosf(mid_ang) * mid_r, center.y + sinf(mid_ang) * mid_r);
                        std::string m_key = KuroAudio::DJHarmonicEngine::getMusicalKeyFromCamelot(h, 'B');
                        ImVec2 sz1 = ImGui::CalcTextSize(code.c_str());
                        ImVec2 sz2 = ImGui::CalcTextSize(m_key.c_str());
                        draw_list->AddText(ImVec2(t_center.x - sz1.x * 0.5f, t_center.y - 12.0f), IM_COL32(255, 255, 255, 255), code.c_str());
                        draw_list->AddText(ImVec2(t_center.x - sz2.x * 0.5f, t_center.y + 1.0f), IM_COL32(230, 240, 255, 220), m_key.c_str());

                        if (is_dial_hover || hov_is_b) {
                            ImGui::SetTooltip("Chave: %s (%s - Maior)\nCompatibilidade: %s\nClique para filtrar na Crate",
                                code.c_str(), m_key.c_str(),
                                KuroAudio::DJHarmonicEngine::getCompatibilityBadgeText(base_ck.getCamelotCode(), code).c_str());
                            if (mouse_clicked) {
                                camelot_filter_key = (camelot_filter_key == code) ? "" : code;
                            }
                        }
                    }

                    // --- ANEL INTERNO (A - MINOR) ---
                    {
                        bool d1_is_a = (d1_loaded && d1_ck.valid && d1_ck.number == h && d1_ck.letter == 'A');
                        bool d2_is_a = (d2_loaded && d2_ck.valid && d2_ck.number == h && d2_ck.letter == 'A');
                        bool hov_is_a = (has_hov && hov_ck.valid && hov_ck.number == h && hov_ck.letter == 'A');
                        bool is_base = (base_ck.valid && base_ck.number == h && base_ck.letter == 'A');
                        std::string code = std::to_string(h) + "A";
                        bool is_filter = (camelot_filter_key == code);
                        bool is_dial_hover = (hovered_h == h && hovered_letter == 'A');

                        unsigned char r_c = (wheel_c) & 0xFF;
                        unsigned char g_c = (wheel_c >> 8) & 0xFF;
                        unsigned char b_c = (wheel_c >> 16) & 0xFF;
                        unsigned int fill_col = IM_COL32((unsigned char)(r_c * 0.75f), (unsigned char)(g_c * 0.75f), (unsigned char)(b_c * 0.75f), is_dial_hover ? 245 : (is_base ? 230 : 175));
                        if (d1_is_a && d2_is_a) {
                            fill_col = IM_COL32(0, 235, 255, 240);
                        } else if (d1_is_a) {
                            fill_col = IM_COL32(0, 220, 255, 235);
                        } else if (d2_is_a) {
                            fill_col = IM_COL32(255, 140, 25, 235);
                        }
                        if (hov_is_a) {
                            fill_col = IM_COL32(255, 240, 50, 250);
                        }

                        const int segs = 8;
                        ImVec2 pts[segs * 2 + 2];
                        int pt_cnt = 0;
                        for (int s = 0; s <= segs; ++s) {
                            float a = a0 + (a1 - a0) * ((float)s / (float)segs);
                            pts[pt_cnt++] = ImVec2(center.x + cosf(a) * r_mid, center.y + sinf(a) * r_mid);
                        }
                        for (int s = segs; s >= 0; --s) {
                            float a = a0 + (a1 - a0) * ((float)s / (float)segs);
                            pts[pt_cnt++] = ImVec2(center.x + cosf(a) * r_hub, center.y + sinf(a) * r_hub);
                        }
                        draw_list->AddConvexPolyFilled(pts, pt_cnt, fill_col);

                        unsigned int border_c = IM_COL32(20, 26, 36, 255);
                        float thickness = 1.0f;
                        if (hov_is_a) {
                            border_c = IM_COL32(255, 235, 30, 255);
                            thickness = 3.0f;
                        } else if (d1_is_a && d2_is_a) {
                            border_c = IM_COL32(0, 255, 255, 255);
                            thickness = 3.0f;
                        } else if (d1_is_a) {
                            border_c = IM_COL32(0, 230, 255, 255);
                            thickness = 2.5f;
                        } else if (d2_is_a) {
                            border_c = IM_COL32(255, 150, 30, 255);
                            thickness = 2.5f;
                        } else if (is_filter) {
                            border_c = IM_COL32(255, 255, 255, 255);
                            thickness = 2.5f;
                        } else if (is_dial_hover) {
                            border_c = IM_COL32(0, 240, 255, 255);
                            thickness = 2.0f;
                        }
                        draw_list->AddPolyline(pts, pt_cnt, border_c, ImDrawFlags_Closed, thickness);

                        // Pins Indicadores de Decks Carregados no Setor A
                        float mid_r = (r_hub + r_mid) * 0.5f;
                        if (d1_is_a) {
                            ImVec2 p_pin1(center.x + cosf(mid_ang) * (r_hub + (r_mid - r_hub) * 0.28f), center.y + sinf(mid_ang) * (r_hub + (r_mid - r_hub) * 0.28f));
                            draw_list->AddCircleFilled(p_pin1, 8.0f, IM_COL32(0, 20, 32, 240));
                            draw_list->AddCircle(p_pin1, 8.0f, IM_COL32(0, 235, 255, 255), 16, 2.0f);
                            draw_list->AddText(ImVec2(p_pin1.x - 4.0f, p_pin1.y - 7.0f), IM_COL32(0, 255, 255, 255), "1");
                        }
                        if (d2_is_a) {
                            ImVec2 p_pin2(center.x + cosf(mid_ang) * (r_hub + (r_mid - r_hub) * 0.72f), center.y + sinf(mid_ang) * (r_hub + (r_mid - r_hub) * 0.72f));
                            draw_list->AddCircleFilled(p_pin2, 8.0f, IM_COL32(32, 16, 0, 240));
                            draw_list->AddCircle(p_pin2, 8.0f, IM_COL32(255, 140, 20, 255), 16, 2.0f);
                            draw_list->AddText(ImVec2(p_pin2.x - 4.0f, p_pin2.y - 7.0f), IM_COL32(255, 170, 40, 255), "2");
                        }

                        ImVec2 t_center(center.x + cosf(mid_ang) * mid_r, center.y + sinf(mid_ang) * mid_r);
                        std::string m_key = KuroAudio::DJHarmonicEngine::getMusicalKeyFromCamelot(h, 'A');
                        ImVec2 sz1 = ImGui::CalcTextSize(code.c_str());
                        ImVec2 sz2 = ImGui::CalcTextSize(m_key.c_str());
                        draw_list->AddText(ImVec2(t_center.x - sz1.x * 0.5f, t_center.y - 12.0f), IM_COL32(255, 255, 255, 255), code.c_str());
                        draw_list->AddText(ImVec2(t_center.x - sz2.x * 0.5f, t_center.y + 1.0f), IM_COL32(230, 240, 255, 220), m_key.c_str());

                        if (is_dial_hover || hov_is_a) {
                            ImGui::SetTooltip("Chave: %s (%s - Menor)\nCompatibilidade: %s\nClique para filtrar na Crate",
                                code.c_str(), m_key.c_str(),
                                KuroAudio::DJHarmonicEngine::getCompatibilityBadgeText(base_ck.getCamelotCode(), code).c_str());
                            if (mouse_clicked) {
                                camelot_filter_key = (camelot_filter_key == code) ? "" : code;
                            }
                        }
                    }
                }

                // PONTE HARMÔNICA ENTRE DECK 1 E DECK 2
                if (d1_loaded && d2_loaded && d1_ck.valid && d2_ck.valid && (d1_ck.number != d2_ck.number || d1_ck.letter != d2_ck.letter)) {
                    float a_d1 = -3.14159265f * 0.5f + (float)(d1_ck.number % 12) * angle_step;
                    float r_d1 = (d1_ck.letter == 'B') ? ((r_mid + r_outer) * 0.5f) : ((r_hub + r_mid) * 0.5f);
                    ImVec2 pt_d1(center.x + cosf(a_d1) * r_d1, center.y + sinf(a_d1) * r_d1);

                    float a_d2 = -3.14159265f * 0.5f + (float)(d2_ck.number % 12) * angle_step;
                    float r_d2 = (d2_ck.letter == 'B') ? ((r_mid + r_outer) * 0.5f) : ((r_hub + r_mid) * 0.5f);
                    ImVec2 pt_d2(center.x + cosf(a_d2) * r_d2, center.y + sinf(a_d2) * r_d2);

                    draw_list->AddLine(pt_d1, pt_d2, IM_COL32(0, 220, 255, 190), 3.0f);
                    draw_list->AddLine(pt_d1, pt_d2, IM_COL32(255, 140, 30, 170), 1.5f);
                }

                // FEIXE LASER HARMÔNICO DINÂMICO PARA A FAIXA SOB O MOUSE
                if (has_hov && hov_ck.valid && base_ck.valid) {
                    float a_src = -3.14159265f * 0.5f + (float)(base_ck.number % 12) * angle_step;
                    float r_src = (base_ck.letter == 'B') ? ((r_mid + r_outer) * 0.5f) : ((r_hub + r_mid) * 0.5f);
                    ImVec2 pt_src(center.x + cosf(a_src) * r_src, center.y + sinf(a_src) * r_src);

                    float a_tgt = -3.14159265f * 0.5f + (float)(hov_ck.number % 12) * angle_step;
                    float r_tgt = (hov_ck.letter == 'B') ? ((r_mid + r_outer) * 0.5f) : ((r_hub + r_mid) * 0.5f);
                    ImVec2 pt_tgt(center.x + cosf(a_tgt) * r_tgt, center.y + sinf(a_tgt) * r_tgt);

                    auto comp = KuroAudio::DJHarmonicEngine::compareKeys(base_ck, hov_ck);
                    ImU32 beam_c = IM_COL32(0, 255, 128, 255);
                    if (comp == KuroAudio::HarmonicCompatibility::HARMONIC_RELATIVE) beam_c = IM_COL32(0, 225, 255, 255);
                    else if (comp == KuroAudio::HarmonicCompatibility::ENERGY_PLUS_1)  beam_c = IM_COL32(255, 205, 0, 255);
                    else if (comp == KuroAudio::HarmonicCompatibility::ENERGY_MINUS_1) beam_c = IM_COL32(0, 180, 255, 255);
                    else if (comp == KuroAudio::HarmonicCompatibility::ENERGY_BOOST_2) beam_c = IM_COL32(255, 45, 140, 255);
                    else if (comp == KuroAudio::HarmonicCompatibility::CLASH)          beam_c = IM_COL32(255, 60, 60, 255);

                    draw_list->AddLine(pt_src, pt_tgt, (beam_c & 0x00FFFFFF) | 0x60000000, 8.0f);
                    draw_list->AddLine(pt_src, pt_tgt, beam_c, 3.0f);
                    draw_list->AddLine(pt_src, pt_tgt, IM_COL32(255, 255, 255, 220), 1.0f);
                    draw_list->AddCircleFilled(pt_tgt, 8.0f, beam_c);
                    draw_list->AddCircle(pt_tgt, 13.0f, IM_COL32(255, 255, 255, 240), 16, 2.0f);
                }

                // HUB CENTRAL (Núcleo do Deck de Referência)
                draw_list->AddCircleFilled(center, r_hub - 2.0f, IM_COL32(10, 14, 20, 255), 48);
