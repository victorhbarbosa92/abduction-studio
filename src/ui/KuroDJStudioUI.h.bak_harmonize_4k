        void renderRekordboxDeckPanel(KuroAudio::DJDeck& deck, int deck_slot, ImVec4 theme_col, KuroAudio::DJEngine& engine) {
            ImGui::PushID(deck.deck_id);
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 p_min = ImGui::GetCursorScreenPos();
            float w = ImGui::GetContentRegionAvail().x;
            float total_h = ImGui::GetContentRegionAvail().y;

            dl->AddRectFilled(p_min, ImVec2(p_min.x + w, p_min.y + total_h), IM_COL32(14, 16, 21, 255), 4.0f);
            dl->AddRect(p_min, ImVec2(p_min.x + w, p_min.y + total_h), IM_COL32(28, 34, 44, 200), 4.0f, 0, 1.0f);

            int d_num = deck.deck_id + 1;
            ImFont* f_reg = g_font_rekordbox_regular ? g_font_rekordbox_regular : ImGui::GetFont();
            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();

            // 1. Deck Number (1 ou 2) - Pioneer Rekordbox Bold
            bool is_sub_layer = (deck.deck_id >= 2);
            ImU32 d_num_col = is_sub_layer ? IM_COL32(255, 170, 30, 255) : IM_COL32(255, 255, 255, 255);
            char d_num_str[8]; snprintf(d_num_str, sizeof(d_num_str), "%d", d_num);
            dl->AddText(f_bld, 16.0f, ImVec2(p_min.x + 8.0f, p_min.y + 7.0f), d_num_col, d_num_str);

            // Clique no número alterna Dual Layer (Deck 1 <-> 3, Deck 2 <-> 4)
            ImGui::SetCursorScreenPos(ImVec2(p_min.x + 6.0f, p_min.y + 5.0f));
            char d_num_btn[32]; snprintf(d_num_btn, sizeof(d_num_btn), "##DeckNumBtn_%d", deck.deck_id);
            if (ImGui::InvisibleButton(d_num_btn, ImVec2(14.0f, 22.0f))) {
                if (deck_slot == 0) {
                    int cur_l = ddj_hardware.getActiveLeftDeck();
                    ddj_hardware.setActiveLeftDeck(cur_l == 0 ? 2 : 0);
                } else {
                    int cur_r = ddj_hardware.getActiveRightDeck();
                    ddj_hardware.setActiveRightDeck(cur_r == 1 ? 3 : 1);
                }
            }
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Dual Layer: Alternar Deck %d <-> %d", deck_slot == 0 ? 1 : 2, deck_slot == 0 ? 3 : 4);

            // 2. Vinyl Album Art Square Tile (30x30px) com sulcos concêntricos de vinil
            ImVec2 tile_min = ImVec2(p_min.x + 24.0f, p_min.y + 5.0f);
            ImVec2 tile_max = ImVec2(tile_min.x + 30.0f, tile_min.y + 30.0f);
            dl->AddRectFilled(tile_min, tile_max, IM_COL32(14, 17, 22, 255), 3.0f);
            dl->AddRect(tile_min, tile_max, IM_COL32(36, 44, 58, 220), 3.0f, 0, 1.0f);

            ImVec2 v_center = ImVec2(tile_min.x + 15.0f, tile_min.y + 15.0f);
            dl->AddCircle(v_center, 12.0f, IM_COL32(40, 50, 65, 180), 20, 1.0f);
            dl->AddCircle(v_center, 8.5f, IM_COL32(55, 68, 88, 200), 20, 1.0f);
            dl->AddCircle(v_center, 5.0f, IM_COL32(80, 95, 120, 220), 16, 1.0f);
            dl->AddCircleFilled(v_center, 2.0f, IM_COL32(215, 230, 250, 255));

            // 3. Bloco de Botões de Controle na Direita: KEY SYNC, MASTER e BEAT SYNC empilhado
            float r_ctrl_w = 126.0f;
            float rx = p_min.x + w - r_ctrl_w - 6.0f;

            // KEY SYNC (topo à esquerda)
            ImVec2 ks_btn_pos = ImVec2(rx, p_min.y + 4.0f);
            ImVec2 ks_btn_sz = ImVec2(66.0f, 15.0f);
            char ks_id[32]; snprintf(ks_id, sizeof(ks_id), "##KeySyncBtn_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(ks_btn_pos);
            if (ImGui::InvisibleButton(ks_id, ks_btn_sz)) {
                engine.toggleKeySync(deck.deck_id);
            }
            bool ks_held = ImGui::IsItemActive();
            bool ks_hov = ImGui::IsItemHovered();
            ImVec2 ks_dpos = ks_held ? ImVec2(ks_btn_pos.x, ks_btn_pos.y + 1.0f) : ks_btn_pos;
            ImU32 ks_bg = deck.key_sync_active ? IM_COL32(0, 215, 255, 255) : (ks_hov ? IM_COL32(35, 45, 60, 255) : IM_COL32(20, 26, 36, 245));
            ImU32 ks_bd = deck.key_sync_active ? IM_COL32(255, 255, 255, 255) : (ks_hov ? IM_COL32(0, 180, 240, 220) : IM_COL32(40, 50, 68, 200));
            ImU32 ks_tx = deck.key_sync_active ? IM_COL32(0, 0, 0, 255) : (ks_hov ? IM_COL32(255, 255, 255, 255) : IM_COL32(185, 205, 230, 240));
            if (deck.key_sync_active) {
                dl->AddRectFilled(ImVec2(ks_dpos.x - 1.5f, ks_dpos.y - 1.5f), ImVec2(ks_dpos.x + ks_btn_sz.x + 1.5f, ks_dpos.y + ks_btn_sz.y + 1.5f), IM_COL32(0, 215, 255, 50), 3.0f);
            }
            dl->AddRectFilled(ks_dpos, ImVec2(ks_dpos.x + ks_btn_sz.x, ks_dpos.y + ks_btn_sz.y), ks_bg, 2.5f);
            dl->AddRect(ks_dpos, ImVec2(ks_dpos.x + ks_btn_sz.x, ks_dpos.y + ks_btn_sz.y), ks_bd, 2.5f, 0, 1.0f);
            ImVec2 ks_sz = f_bld->CalcTextSizeA(10.5f, FLT_MAX, 0.0f, "KEY SYNC");
            dl->AddText(f_bld, 10.5f, ImVec2(ks_dpos.x + (ks_btn_sz.x - ks_sz.x) * 0.5f, ks_dpos.y + (ks_btn_sz.y - ks_sz.y) * 0.5f), ks_tx, "KEY SYNC");

            // MASTER (embaixo de KEY SYNC)
            ImVec2 mst_btn_pos = ImVec2(rx, p_min.y + 22.0f);
            ImVec2 mst_btn_sz = ImVec2(66.0f, 15.0f);
            char mst_id[32]; snprintf(mst_id, sizeof(mst_id), "##MasterBtn_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(mst_btn_pos);
            if (ImGui::InvisibleButton(mst_id, mst_btn_sz)) {
                engine.setMasterDeck(deck.deck_id);
            }
            bool mst_held = ImGui::IsItemActive();
            bool mst_hov = ImGui::IsItemHovered();
            bool is_m = engine.isMasterDeck(deck.deck_id);
            ImVec2 mst_dpos = mst_held ? ImVec2(mst_btn_pos.x, mst_btn_pos.y + 1.0f) : mst_btn_pos;
            ImU32 mst_bg = is_m ? IM_COL32(245, 175, 15, 255) : (mst_hov ? IM_COL32(35, 45, 60, 255) : IM_COL32(20, 26, 36, 245));
            ImU32 mst_bd = is_m ? IM_COL32(255, 255, 255, 255) : (mst_hov ? IM_COL32(230, 160, 20, 220) : IM_COL32(40, 50, 68, 200));
            ImU32 mst_tx = is_m ? IM_COL32(0, 0, 0, 255) : (mst_hov ? IM_COL32(255, 255, 255, 255) : IM_COL32(185, 205, 230, 240));
            if (is_m) {
                dl->AddRectFilled(ImVec2(mst_dpos.x - 1.5f, mst_dpos.y - 1.5f), ImVec2(mst_dpos.x + mst_btn_sz.x + 1.5f, mst_dpos.y + mst_btn_sz.y + 1.5f), IM_COL32(245, 175, 15, 50), 3.0f);
            }
            dl->AddRectFilled(mst_dpos, ImVec2(mst_dpos.x + mst_btn_sz.x, mst_dpos.y + mst_btn_sz.y), mst_bg, 2.5f);
            dl->AddRect(mst_dpos, ImVec2(mst_dpos.x + mst_btn_sz.x, mst_dpos.y + mst_btn_sz.y), mst_bd, 2.5f, 0, 1.0f);
            ImVec2 m_sz = f_bld->CalcTextSizeA(10.5f, FLT_MAX, 0.0f, "MASTER");
            dl->AddText(f_bld, 10.5f, ImVec2(mst_dpos.x + (mst_btn_sz.x - m_sz.x) * 0.5f, mst_dpos.y + (mst_btn_sz.y - m_sz.y) * 0.5f), mst_tx, "MASTER");

            // BEAT SYNC (botão alto de 2 linhas na direita: "BEAT" e "SYNC")
            ImVec2 sync_btn_pos = ImVec2(rx + 70.0f, p_min.y + 4.0f);
            ImVec2 sync_btn_sz = ImVec2(48.0f, 33.0f);
            char sync_btn_id[32]; snprintf(sync_btn_id, sizeof(sync_btn_id), "##BeatSyncTall_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(sync_btn_pos);
            if (ImGui::InvisibleButton(sync_btn_id, sync_btn_sz)) {
                engine.toggleSync(deck.deck_id, (deck_slot == 0 ? 1 : 0));
            }
            bool sync_held = ImGui::IsItemActive();
            bool sync_hov = ImGui::IsItemHovered();
            ImVec2 sync_dpos = sync_held ? ImVec2(sync_btn_pos.x, sync_btn_pos.y + 1.0f) : sync_btn_pos;
            ImU32 sync_bg = deck.sync_active ? IM_COL32(0, 130, 255, 255) : (sync_hov ? IM_COL32(38, 48, 64, 255) : IM_COL32(24, 30, 42, 245));
            ImU32 sync_bd = deck.sync_active ? IM_COL32(255, 255, 255, 255) : (sync_hov ? IM_COL32(0, 170, 255, 240) : IM_COL32(45, 56, 74, 220));
            ImU32 sync_tx = deck.sync_active ? IM_COL32(255, 255, 255, 255) : (sync_hov ? IM_COL32(255, 255, 255, 255) : IM_COL32(200, 220, 245, 240));

            if (deck.sync_active) {
                dl->AddRectFilled(ImVec2(sync_dpos.x - 2.0f, sync_dpos.y - 2.0f), ImVec2(sync_dpos.x + sync_btn_sz.x + 2.0f, sync_dpos.y + sync_btn_sz.y + 2.0f), IM_COL32(0, 130, 255, 55), 3.5f);
            }
            dl->AddRectFilled(sync_dpos, ImVec2(sync_dpos.x + sync_btn_sz.x, sync_dpos.y + sync_btn_sz.y), sync_bg, 3.0f);
            dl->AddRect(sync_dpos, ImVec2(sync_dpos.x + sync_btn_sz.x, sync_dpos.y + sync_btn_sz.y), sync_bd, 3.0f, 0, 1.0f);

            ImVec2 b_sz = f_bld->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "BEAT");
            ImVec2 s_sz = f_bld->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "SYNC");
            dl->AddText(f_bld, 11.0f, ImVec2(sync_dpos.x + (sync_btn_sz.x - b_sz.x) * 0.5f, sync_dpos.y + 4.0f), sync_tx, "BEAT");
            dl->AddText(f_bld, 11.0f, ImVec2(sync_dpos.x + (sync_btn_sz.x - s_sz.x) * 0.5f, sync_dpos.y + 17.0f), sync_tx, "SYNC");

            // 4. Drag & Drop Target sobre a área do Cabeçalho / Título + Duplo-clique para Instant Doubles
            auto& safety = KuroAudio::DJLiveSafety::getInstance();
            ImGui::SetCursorScreenPos(ImVec2(p_min.x + 22.0f, p_min.y + 2.0f));
            char title_drop_id[32]; snprintf(title_drop_id, sizeof(title_drop_id), "##DeckTitleDrop_%d", deck.deck_id);
            if (ImGui::InvisibleButton(title_drop_id, ImVec2(std::max(100.0f, rx - p_min.x - 26.0f), 38.0f))) {
                // Clique simples
            }
            // Duplo clique na área do cabeçalho / vinil: INSTANT DOUBLES (clona o deck oposto)
            if (ImGui::IsItemHovered() && ImGui::IsMouseDoubleClicked(0)) {
                int opposite_id = (deck.deck_id % 2 == 0) ? (deck.deck_id + 1) : (deck.deck_id - 1);
                if (opposite_id >= 0 && opposite_id < 4) {
                    if (safety.canLoadTrack(deck)) {
                        deck.cloneFrom(engine.decks[opposite_id]);
                    } else {
                        deck_load_lock_alert_timer[deck.deck_id] = 2.0f;
                    }
                }
            }
            if (ImGui::IsItemHovered()) {
                ImGui::SetTooltip("Deck %d: Arraste faixas aqui para carregar.\n• 2-Clique: INSTANT DOUBLES (clona o deck oposto)", deck.deck_id + 1);
            }

            if (ImGui::BeginDragDropTarget()) {
                if (const ImGuiPayload* payload = ImGui::AcceptDragDropPayload("DND_DJ_TRACK_ID")) {
                    if (!safety.canLoadTrack(deck)) {
                        deck_load_lock_alert_timer[deck.deck_id] = 2.5f;
                    } else {
                        const char* dropped_id = (const char*)payload->Data;
                        auto* ptr = KuroAudio::DJLibraryManager::getInstance().getTrackById(dropped_id);
                        if (ptr) {
                            if (ptr->is_downloaded) spotify_service.loadLibraryTrack(*ptr, deck.deck_id, engine);
                            else spotify_service.downloadLibraryTrackAsync(*ptr, deck.deck_id, engine);
                        }
                    }
                }
                dl->AddRect(ImVec2(p_min.x + 22.0f, p_min.y + 2.0f), ImVec2(rx - 4.0f, p_min.y + 38.0f), ImGui::ColorConvertFloat4ToU32(theme_col), 3.0f, 0, 2.0f);
                ImGui::EndDragDropTarget();
            }

            // Alerta visual de LOAD LOCK (Flash Vermelho caso tente carregar com o som ao vivo no ar)
            if (deck_load_lock_alert_timer[deck.deck_id] > 0.0f) {
                deck_load_lock_alert_timer[deck.deck_id] -= ImGui::GetIO().DeltaTime;
                float alert_alpha = std::clamp(deck_load_lock_alert_timer[deck.deck_id], 0.0f, 1.0f);
                ImU32 alert_bg = IM_COL32(230, 25, 45, (int)(alert_alpha * 220.0f));
                ImU32 alert_bd = IM_COL32(255, 200, 210, (int)(alert_alpha * 255.0f));
                ImVec2 a_min = ImVec2(p_min.x + 22.0f, p_min.y + 2.0f);
                ImVec2 a_max = ImVec2(rx - 4.0f, p_min.y + 38.0f);
                dl->AddRectFilled(a_min, a_max, alert_bg, 3.0f);
                dl->AddRect(a_min, a_max, alert_bd, 3.0f, 0, 1.5f);
                ImVec2 lk_sz = f_bld->CalcTextSizeA(12.0f, FLT_MAX, 0.0f, "LOAD LOCK: DECK ON AIR");
                dl->AddText(f_bld, 12.0f, ImVec2(a_min.x + (a_max.x - a_min.x - lk_sz.x) * 0.5f, a_min.y + 6.0f), IM_COL32(255, 255, 255, 255), "LOAD LOCK: DECK ON AIR");
                ImVec2 lk_sub = f_reg->CalcTextSizeA(10.0f, FLT_MAX, 0.0f, "Pause o deck para carregar");
                dl->AddText(f_reg, 10.0f, ImVec2(a_min.x + (a_max.x - a_min.x - lk_sub.x) * 0.5f, a_min.y + 21.0f), IM_COL32(255, 235, 235, 240), "Pause o deck para carregar");
            }

            // 5. Linha 1 do Cabeçalho: Artista + Título da Faixa (ou "Not Loaded.")
            float text_x = p_min.x + 60.0f;
            float row1_y = p_min.y + 4.0f;
            float row2_y = p_min.y + 23.0f;

            if (!deck.track_title.empty() && !deck.buffer_l.empty()) {
                std::string artist = deck.track_artist;
                std::string title = deck.track_title;
                if (artist.empty()) {
                    size_t sep = title.find(" - ");
                    if (sep != std::string::npos) {
                        artist = title.substr(0, sep);
                        title = title.substr(sep + 3);
                    }
                }

                dl->PushClipRect(ImVec2(text_x, row1_y - 2.0f), ImVec2(rx - 8.0f, row1_y + 18.0f), true);
                if (!artist.empty()) {
                    dl->AddText(f_reg, 14.5f, ImVec2(text_x, row1_y), IM_COL32(230, 236, 245, 255), artist.c_str());
                    ImVec2 a_sz = f_reg->CalcTextSizeA(14.5f, FLT_MAX, 0.0f, artist.c_str());
                    float title_x = text_x + a_sz.x + 8.0f;
                    dl->AddText(f_bld, 15.0f, ImVec2(title_x, row1_y), IM_COL32(255, 255, 255, 255), title.c_str());
                } else {
                    dl->AddText(f_bld, 15.0f, ImVec2(text_x, row1_y), IM_COL32(255, 255, 255, 255), title.c_str());
                }
                dl->PopClipRect();

                // Linha 2 de Telemetria: BPM (com ponto), Tom Musical, Tempo Restante, Tempo Decorrido e Key Shift
                // Protegida com PushClipRect para nunca colidir ou desenhar sobre os botões KEY SYNC e MASTER
                dl->PushClipRect(ImVec2(text_x, row2_y - 2.0f), ImVec2(rx - 6.0f, row2_y + 20.0f), true);
                float max_row2_x = rx - 8.0f;

                double eff_b = (deck.bpm > 20.0) ? (deck.bpm * (1.0 + deck.pitch_percent * 0.01)) : 126.0;
                char bpm_buf[32];
                snprintf(bpm_buf, sizeof(bpm_buf), "%.2f", eff_b);
                for (char* p = bpm_buf; *p; ++p) { if (*p == ',') *p = '.'; }

                if (bpm_editing_deck == deck.deck_id && bpm_edit_from_header) {
                    ImGui::SetCursorScreenPos(ImVec2(text_x - 2.0f, row2_y - 2.0f));
                    ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0.06f, 0.09f, 0.14f, 0.98f));
                    ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.0f, 0.70f, 1.0f, 1.0f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 3.0f);
                    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(3.0f, 1.0f));
                    ImGui::PushItemWidth(52.0f);

                    if (bpm_edit_focus_needed) {
                        ImGui::SetKeyboardFocusHere();
                        bpm_edit_focus_needed = false;
                    }

                    char inp_h_id[32]; snprintf(inp_h_id, sizeof(inp_h_id), "##BpmHdrInput_%d", deck.deck_id);
                    bool enter = ImGui::InputText(inp_h_id, bpm_edit_buf, sizeof(bpm_edit_buf),
                        ImGuiInputTextFlags_EnterReturnsTrue | ImGuiInputTextFlags_AutoSelectAll);

                    if (enter || (!ImGui::IsItemActive() && ImGui::IsMouseClicked(0))) {
                        float target = (float)atof(bpm_edit_buf);
                        if (target >= 20.0f && target <= 300.0f) {
                            applyManualBpm(deck, target, ImGui::GetIO().KeyShift);
                        }
                        bpm_editing_deck = -1;
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_Escape)) {
                        bpm_editing_deck = -1;
                    }

                    ImGui::PopItemWidth();
                    ImGui::PopStyleVar(2);
                    ImGui::PopStyleColor(3);
                } else {
                    dl->AddText(f_bld, 14.0f, ImVec2(text_x, row2_y), IM_COL32(255, 255, 255, 255), bpm_buf);
                    ImGui::SetCursorScreenPos(ImVec2(text_x - 2.0f, row2_y - 2.0f));
                    char h_btn_id[32]; snprintf(h_btn_id, sizeof(h_btn_id), "##HdrBpmBtn_%d", deck.deck_id);
                    if (ImGui::InvisibleButton(h_btn_id, ImVec2(48.0f, 18.0f))) {
                        bpm_editing_deck = deck.deck_id;
                        bpm_edit_from_header = true;
                        snprintf(bpm_edit_buf, sizeof(bpm_edit_buf), "%.2f", eff_b);
                        bpm_edit_focus_needed = true;
                    }
                    if (ImGui::IsItemHovered()) {
                        dl->AddRect(ImVec2(text_x - 2.0f, row2_y - 2.0f), ImVec2(text_x + 48.0f, row2_y + 16.0f), IM_COL32(0, 160, 255, 180), 2.0f);
                        if (ImGui::IsMouseDoubleClicked(0)) {
                            deck.pitch_percent = 0.0f;
                            deck.sync_active = false;
                        }
                        ImGui::SetTooltip("BPM: %.2f (Clique para digitar / 2-clique reseta)", eff_b);
                    }
                }
                float cur_tx = text_x + 52.0f;

                double rem_sec = deck.getRemainingTimeSec();
                int r_m = (int)rem_sec / 60, r_s = (int)rem_sec % 60, r_ms = (int)((rem_sec - std::floor(rem_sec)) * 10);
                char rem_buf[32];
                snprintf(rem_buf, sizeof(rem_buf), "-%02d:%02d.%d", r_m, r_s, r_ms);
                for (char* p = rem_buf; *p; ++p) { if (*p == ',') *p = '.'; }
                if (cur_tx + 58.0f < max_row2_x) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(255, 255, 255, 255), rem_buf);
                    cur_tx += 62.0f;
                }

                double elap_sec = deck.getElapsedTimeSec();
                int e_m = (int)elap_sec / 60, e_s = (int)elap_sec % 60, e_ms = (int)((elap_sec - std::floor(elap_sec)) * 10);
                char elap_buf[32];
                snprintf(elap_buf, sizeof(elap_buf), "%02d:%02d.%d", e_m, e_s, e_ms);
                for (char* p = elap_buf; *p; ++p) { if (*p == ',') *p = '.'; }
                if (cur_tx + 54.0f < max_row2_x) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(125, 136, 150, 255), elap_buf);
                    cur_tx += 56.0f;
                }

                // Widget Interativo de Key Shift: <  4A  ±0  > (com reset no clique e clamp seguro)
                if (cur_tx + 76.0f < max_row2_x) {
                    ImGui::SetCursorScreenPos(ImVec2(cur_tx, row2_y - 2.0f));
                    char ks_dn_id[32]; snprintf(ks_dn_id, sizeof(ks_dn_id), "<##KS_DN_%d", deck.deck_id);
                    if (ImGui::SmallButton(ks_dn_id)) {
                        deck.shiftKey(-1);
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Key Shift -1 Semitom");
                    cur_tx += 17.0f;

                    std::string eff_k = deck.getEffectiveKey();
                    auto ck = KuroAudio::DJHarmonicEngine::parseKey(eff_k);
                    std::string k_code = ck.valid ? ck.getCamelotCode() : eff_k;
                    size_t slash = k_code.find(" / ");
                    if (slash != std::string::npos) k_code = k_code.substr(0, slash);

                    char ks_buf[32];
                    int ks = deck.key_shift_semitones;
                    if (ks > 0) snprintf(ks_buf, sizeof(ks_buf), "%s +%d", k_code.c_str(), ks);
                    else if (ks < 0) snprintf(ks_buf, sizeof(ks_buf), "%s %d", k_code.c_str(), ks);
                    else snprintf(ks_buf, sizeof(ks_buf), "%s \xc2\xb1\x30", k_code.c_str()); // ±0
                    
                    ImU32 ks_text_col = (ks != 0) ? IM_COL32(0, 225, 255, 255) : IM_COL32(220, 230, 245, 255);
                    dl->AddText(f_bld, 13.0f, ImVec2(cur_tx, row2_y), ks_text_col, ks_buf);

                    ImGui::SetCursorScreenPos(ImVec2(cur_tx - 2.0f, row2_y - 2.0f));
                    char ks_rst_id[32]; snprintf(ks_rst_id, sizeof(ks_rst_id), "##KS_RST_%d", deck.deck_id);
                    if (ImGui::InvisibleButton(ks_rst_id, ImVec2(44.0f, 16.0f))) {
                        deck.resetKey();
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Tom Efetivo: %s (%+d st)\nTom Original: %s\nClique para resetar tom", deck.getEffectiveKey().c_str(), ks, deck.key_signature.c_str());
                    cur_tx += 46.0f;

                    ImGui::SetCursorScreenPos(ImVec2(cur_tx, row2_y - 2.0f));
                    char ks_up_id[32]; snprintf(ks_up_id, sizeof(ks_up_id), ">##KS_UP_%d", deck.deck_id);
                    if (ImGui::SmallButton(ks_up_id)) {
                        deck.shiftKey(+1);
                    }
                    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Key Shift +1 Semitom");
                }
                dl->PopClipRect();
            } else {
                // Deck Vazio: Idêntico ao Deck 2 do Rekordbox (Image 2) com proteção de clip rect
                dl->PushClipRect(ImVec2(text_x, row1_y - 2.0f), ImVec2(rx - 6.0f, row2_y + 20.0f), true);
                dl->AddText(f_reg, 15.0f, ImVec2(text_x, row1_y), IM_COL32(85, 95, 110, 255), "Not Loaded.");
                float cur_tx = text_x;
                dl->AddText(f_bld, 14.0f, ImVec2(cur_tx, row2_y), IM_COL32(75, 85, 100, 255), "128.00");
                cur_tx += 52.0f;
                if (cur_tx + 28.0f < rx - 8.0f) {
                    dl->AddText(f_bld, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(75, 85, 100, 255), "8A");
                    cur_tx += 30.0f;
                }
                if (cur_tx + 58.0f < rx - 8.0f) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(60, 68, 80, 255), "-00:00.0");
                    cur_tx += 62.0f;
                }
                if (cur_tx + 54.0f < rx - 8.0f) {
                    dl->AddText(f_reg, 13.5f, ImVec2(cur_tx, row2_y), IM_COL32(60, 68, 80, 255), "00:00.0");
                    cur_tx += 56.0f;
                }
                if (cur_tx + 72.0f < rx - 8.0f) {
                    dl->AddText(f_reg, 13.0f, ImVec2(cur_tx, row2_y), IM_COL32(60, 68, 80, 255), "<  8A \xc2\xb1\x30  >");
                }
                dl->PopClipRect();
            }

            // 6. MINI OVERVIEW WAVEFORM STRIP (Idêntica ao Rekordbox - Sobe no eixo +)
            float over_y = p_min.y + 44.0f;
            float over_h = 24.0f;
            ImGui::SetCursorScreenPos(ImVec2(p_min.x + 4.0f, over_y));
            renderMiniOverviewStrip(deck, w - 8.0f, over_h, theme_col);

            // 3. CORPO INFERIOR DO DECK (PIONEER DDJ / REKORDBOX 2-TIER ERGONOMIC ARCHITECTURE)
            float body_y = over_y + over_h + 6.0f;
            float body_h = total_h - (body_y - p_min.y) - 4.0f;

            float margin_x = 4.0f;
            float gap_x = 4.0f;
            float usable_w = w - margin_x * 2.0f;

            // Split vertical do corpo responsivo (Pioneer DDJ / Rekordbox 2-Tier):
            float upper_ratio = (body_h >= 420.0f) ? 0.62f : ((body_h >= 300.0f) ? 0.58f : 0.54f);
            float upper_h = std::clamp(body_h * upper_ratio, 120.0f, 380.0f);
            float lower_y = body_y + upper_h + 4.0f;
            float lower_h = body_h - upper_h - 6.0f;

            // Distribuição horizontal responsiva para cobrir 100% da largura em qualquer resolução:
            float left_w = std::clamp(usable_w * 0.055f, 48.0f, 58.0f);
            float fader_w = std::clamp(usable_w * 0.085f, 62.0f, 90.0f);
            float mem_w = std::clamp(usable_w * 0.13f, 80.0f, 130.0f);
            float side_w = std::clamp(usable_w * 0.12f, 80.0f, 120.0f);
            float jog_bay_w = usable_w - left_w - fader_w - mem_w - side_w - gap_x * 4.0f;

            float j_sz = std::clamp(std::min(jog_bay_w - 12.0f, upper_h - 8.0f), 80.0f, 320.0f);

            // =========================================================================
            // TIER SUPERIOR: LOOP (ESQ) | JOGWHEEL (CENTRO) | TEMPO PANEL | MEMORY CUE | PITCH FADER (DIR)
            // =========================================================================
            float cur_left_x = p_min.x + margin_x;

            // 1. Bloco de Botões Auxiliares Pioneer Rekordbox 1:1 (Loop, 1/2X, 2X, IN, OUT, SLIP, Q, INT)
            renderRekordboxAuxiliaryControlBlock(deck, ImVec2(cur_left_x, body_y + 2.0f), left_w, upper_h - 4.0f, theme_col);

            // 2. JOGWHEEL CENTRALIZADO NA SUA BAIA COM RESPIRO EFEITO GLOW
            float jog_bay_x = cur_left_x + left_w + gap_x;
            float jog_x = jog_bay_x + (jog_bay_w - j_sz) * 0.5f;
            float jog_y = body_y + (upper_h - j_sz) * 0.5f;

            renderRekordboxJogwheel(deck, ImVec2(jog_x, jog_y), j_sz, theme_col, true);

            // 3. PAINEL DE BPM / TEMPO / KEY
            float side_x = jog_bay_x + jog_bay_w + gap_x;
            float side_y = body_y + 2.0f;
            float side_h = upper_h - 4.0f;
            renderRekordboxSideTempoPanel(deck, ImVec2(side_x, side_y), ImVec2(side_w, side_h), theme_col);

            // 4. PAINEL DE MEMORY CUE / CUE CALL & DROP COUNTDOWN (CDJ-3000 Standard)
            float mem_x = side_x + side_w + gap_x;
            renderRekordboxMemoryCuePanel(deck, ImVec2(mem_x, body_y + 2.0f), mem_w, upper_h - 4.0f, theme_col);

            // 5. PITCH FADER na extrema direita do Tier Superior
            float fader_x = mem_x + mem_w + gap_x;
            renderRekordboxPitchFaderWidget(deck, ImVec2(fader_x, body_y + 2.0f), ImVec2(fader_w, upper_h - 4.0f), theme_col);

            // =========================================================================
            // TIER INFERIOR: CUE / PLAY (ESQ) + 8 PERFORMANCE PADS AMPLOS (CENTRO/DIR)
            // =========================================================================
            float t_cx = cur_left_x + left_w * 0.5f;
            float r_btn = std::clamp(lower_h * 0.18f, 13.0f, 22.0f);
            float cue_cy = lower_y + lower_h * 0.28f;
            float play_cy = lower_y + lower_h * 0.72f;

            bool at_cue = (std::abs(deck.current_frame - deck.cue_frame) <= deck.sample_rate * 0.04);
            bool blink_phase = ((int)(ImGui::GetTime() * 4.0) % 2 == 0);

            bool cue_lit = false;
            ImU32 cue_ring_col = IM_COL32(255, 140, 0, 255);
            if (deck.cue_active) {
                cue_lit = true;
                cue_ring_col = IM_COL32(255, 185, 40, 255);
            } else if (!deck.is_playing) {
                if (at_cue) {
                    cue_lit = true;
                    cue_ring_col = IM_COL32(255, 145, 0, 255);
                } else {
                    cue_lit = blink_phase;
                    cue_ring_col = blink_phase ? IM_COL32(255, 145, 0, 255) : IM_COL32(75, 45, 15, 160);
                }
            } else {
                cue_lit = false;
                cue_ring_col = IM_COL32(110, 75, 25, 160);
            }

            renderPioneerRoundButton("CUE", ImVec2(t_cx, cue_cy), r_btn, cue_ring_col, IM_COL32(18, 14, 8, 255), cue_lit,
                [&]() { deck.pressCue(); },
                [&]() { deck.releaseCue(); }
            );

            bool play_lit = false;
            ImU32 play_ring_col = IM_COL32(0, 240, 90, 255);
            if (deck.is_playing && !deck.cue_active) {
                play_lit = true;
                play_ring_col = IM_COL32(0, 255, 100, 255);
            } else {
                // Pausado ou em Cue Audition: PLAY pisca verde convidando o DJ
                play_lit = blink_phase;
                play_ring_col = blink_phase ? IM_COL32(0, 240, 90, 255) : IM_COL32(15, 65, 35, 160);
            }

            renderPioneerRoundButton("PLAY", ImVec2(t_cx, play_cy), r_btn, play_ring_col, IM_COL32(8, 18, 12, 255), play_lit,
                [&]() { deck.togglePlay(); }
            );

            // 4. PERFORMANCE PADS amplos preenchendo todo o restante do Tier Inferior
            float pads_x = cur_left_x + left_w + gap_x;
            float pads_w = (p_min.x + w - margin_x) - pads_x;
            renderRekordboxPads(deck, ImVec2(pads_x, lower_y), pads_w, lower_h, engine);

            ImGui::PopID();
        }

        // =========================================================================================
        // WAVE CENTRAL DE ANÁLISE DE FREQUÊNCIAS (COMBINADA / SOBREPOSTA D1 + D2)
        // Posicionada no centro do console, logo acima dos controles do Mixer Central
        // =========================================================================
        void renderCentralFrequencyWaveform(KuroAudio::DJEngine& engine, float w, float h) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();

            int left_id  = ddj_hardware.getActiveLeftDeck();
            int right_id = ddj_hardware.getActiveRightDeck();
            KuroAudio::DJDeck& deck1 = engine.decks[left_id];
            KuroAudio::DJDeck& deck2 = engine.decks[right_id];

            // 1. Moldura e Fundo Obsidian Club Standard
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(10, 12, 17, 255), 3.0f);
            dl->AddRect(pos, ImVec2(pos.x + w, pos.y + h), IM_COL32(34, 44, 60, 240), 3.0f, 0, 1.0f);

            // 2. Barra de Título Superior da Wave Central (14px)
            float hdr_h = 14.0f;
            dl->AddRectFilled(pos, ImVec2(pos.x + w, pos.y + hdr_h), IM_COL32(16, 20, 28, 255), 3.0f, ImDrawFlags_RoundCornersTop);
            dl->AddLine(ImVec2(pos.x, pos.y + hdr_h), ImVec2(pos.x + w, pos.y + hdr_h), IM_COL32(28, 36, 48, 200), 1.0f);

            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
            dl->AddText(f_bld, 10.5f, ImVec2(pos.x + 5.0f, pos.y + 1.0f), IM_COL32(140, 165, 195, 240), "FREQ MIX");

            // Indicador Central de Decks: D1 (Ciano) + D2 (Âmbar)
            float mid_x = pos.x + w * 0.5f;
            dl->AddText(f_bld, 10.5f, ImVec2(mid_x - 26.0f, pos.y + 1.0f), IM_COL32(0, 245, 212, 255), "D1");
            dl->AddText(ImVec2(mid_x - 8.0f, pos.y + 0.5f), IM_COL32(180, 195, 215, 220), "+");
            dl->AddText(f_bld, 10.5f, ImVec2(mid_x + 6.0f, pos.y + 1.0f), IM_COL32(255, 170, 0, 255), "D2");

            // Indicador de Status de Sincronia / Frequência na direita
            bool both_playing = (deck1.is_playing.load() && deck2.is_playing.load());
            if (both_playing) {
                double bpm_diff = std::abs(deck1.bpm - deck2.bpm);
                if (bpm_diff < 0.15) {
                    dl->AddText(f_bld, 10.0f, ImVec2(pos.x + w - 44.0f, pos.y + 1.0f), IM_COL32(0, 240, 120, 255), "SYNC OK");
                } else {
                    dl->AddText(f_bld, 10.0f, ImVec2(pos.x + w - 40.0f, pos.y + 1.0f), IM_COL32(255, 180, 0, 255), "PHASE");
                }
            } else {
                dl->AddText(f_bld, 10.0f, ImVec2(pos.x + w - 42.0f, pos.y + 1.0f), IM_COL32(90, 110, 140, 200), "ANALYSIS");
            }

            // 3. Área de Exibição da Waveform (Altura = h - hdr_h - 2px)
            float wave_y = pos.y + hdr_h + 1.0f;
            float wave_h = h - hdr_h - 2.0f;
            float mid_y  = wave_y + wave_h * 0.5f;
            float max_half_h = (wave_h * 0.5f) - 2.0f;

            // Fundo preto puro e linha de centro neutra
            dl->AddRectFilled(ImVec2(pos.x + 1.0f, wave_y), ImVec2(pos.x + w - 1.0f, wave_y + wave_h), IM_COL32(0, 0, 0, 255));
            dl->AddLine(ImVec2(pos.x + 1.0f, mid_y), ImVec2(pos.x + w - 1.0f, mid_y), IM_COL32(24, 32, 45, 160), 1.0f);

            // Tempo e Sincronização de Hertz (Zero-Jitter)
            DeckVisualHertzSync& vs1 = vis_sync[deck1.deck_id];
            DeckVisualHertzSync& vs2 = vis_sync[deck2.deck_id];

            double ref_bpm = (deck1.is_playing.load() && deck1.bpm > 20.0) ? deck1.bpm :
                             ((deck2.is_playing.load() && deck2.bpm > 20.0) ? deck2.bpm :
                             ((deck1.bpm > 20.0) ? deck1.bpm : 126.0));
            double seconds_per_bar = (60.0 / ref_bpm) * 4.0;
            double window_sec = 4.0 * seconds_per_bar; // 4 compassos para clareza máxima de mixagem
            if (window_sec < 0.5) window_sec = 0.5;

            double window_f1 = window_sec * deck1.sample_rate;
            double start_f1  = vs1.smooth_frame - window_f1 * 0.5;
            double window_f2 = window_sec * deck2.sample_rate;
            double start_f2  = vs2.smooth_frame - window_f2 * 0.5;

            // Grade Mestre Única (Downbeats 1.1 e Batidas)
            if (deck1.bpm > 20.0 && deck1.sample_rate > 1000.0) {
                double beat_len1 = (60.0 / deck1.bpm) * deck1.sample_rate;
                if (beat_len1 > 10.0) {
                    int b_s = (int)std::floor((start_f1 - deck1.first_beat_frame) / beat_len1);
                    int b_e = (int)std::ceil((start_f1 + window_f1 - deck1.first_beat_frame) / beat_len1);
                    for (int b = b_s; b <= b_e; b++) {
                        double bf = deck1.first_beat_frame + (double)b * beat_len1;
                        float bx = pos.x + (float)((bf - start_f1) / window_f1) * w;
                        if (bx >= pos.x + 1.0f && bx <= pos.x + w - 1.0f) {
                            if (b % 4 == 0) {
                                dl->AddLine(ImVec2(bx, wave_y), ImVec2(bx, wave_y + wave_h), IM_COL32(255, 30, 50, 180), 1.2f);
                            } else {
                                dl->AddLine(ImVec2(bx, wave_y), ImVec2(bx, wave_y + wave_h), IM_COL32(140, 160, 190, 35), 1.0f);
                            }
                        }
                    }
                }
            }

            // Geração de detalhes
            deck1.generateDetailedWaveformIfNeeded();
            deck2.generateDetailedWaveformIfNeeded();

            // Fatores de EQ reais dos knobs da controladora
            float eq_l1 = std::clamp(deck1.eq_low,  0.0f, 2.5f);
            float eq_m1 = std::clamp(deck1.eq_mid,  0.0f, 2.5f);
            float eq_h1 = std::clamp(deck1.eq_high, 0.0f, 2.5f);

            float eq_l2 = std::clamp(deck2.eq_low,  0.0f, 2.5f);
            float eq_m2 = std::clamp(deck2.eq_mid,  0.0f, 2.5f);
            float eq_h2 = std::clamp(deck2.eq_high, 0.0f, 2.5f);

            float col_step = 1.0f;
            int num_cols = std::max(1, (int)(w / col_step));
            double f_per_c1 = window_f1 / (double)num_cols;
            double f_per_c2 = window_f2 / (double)num_cols;
            size_t sz1 = deck1.detailed_waveform.size();
            size_t sz2 = deck2.detailed_waveform.size();
            size_t tot1 = deck1.buffer_l.size();
            size_t tot2 = deck2.buffer_l.size();

            for (int x = 0; x < num_cols; x++) {
                float cur_x = pos.x + (float)x * col_step;

                // Amostragem Deck 1 (Ciano Elétrico #00f5d4)
                float amp1 = 0.0f, core1 = 0.0f;
                ImU32 col_out1 = 0, col_cr1 = 0;
                double f1 = start_f1 + (double)x * f_per_c1;
                if (f1 >= 0.0 && f1 < (double)tot1 && sz1 > 0) {
                    double bin1 = f1 / (double)KuroAudio::DJDeck::DETAILED_WAVE_STEP;
                    size_t b0 = (size_t)std::clamp(std::floor(bin1), 0.0, (double)(sz1 - 1));
                    size_t b1 = std::min(b0 + 1, sz1 - 1);
                    float fr = (float)(bin1 - (double)b0);
                    float st = fr * fr * (3.0f - 2.0f * fr);

                    const auto& p0 = deck1.detailed_waveform[b0];
                    const auto& p1 = deck1.detailed_waveform[b1];

                    float l = (p0.low  + (p1.low  - p0.low)  * st) * eq_l1;
                    float m = (p0.mid  + (p1.mid  - p0.mid)  * st) * eq_m1;
                    float h_val = (p0.high + (p1.high - p0.high) * st) * eq_h1;

                    float eff = (l * 0.50f + m * 0.35f + h_val * 0.25f);
                    if (eff > 0.002f) {
                        float norm = std::clamp((eff - 0.002f) / (1.0f - 0.002f), 0.0f, 1.0f);
                        amp1 = std::clamp(std::pow(norm, 1.02f) * max_half_h, 0.8f, max_half_h);
                        core1 = amp1 * (0.38f * std::clamp(eq_l1, 0.15f, 1.6f));

                        computeRekordboxRGB(waveform_color_mode, l, m, h_val, eff, 1.0f, col_out1, col_cr1);
                    }
                }

                // Amostragem Deck 2 (Rekordbox Palette #ffaa00)
                float amp2 = 0.0f, core2 = 0.0f;
                ImU32 col_out2 = 0, col_cr2 = 0;
                double f2 = start_f2 + (double)x * f_per_c2;
                if (f2 >= 0.0 && f2 < (double)tot2 && sz2 > 0) {
                    double bin2 = f2 / (double)KuroAudio::DJDeck::DETAILED_WAVE_STEP;
                    size_t b0 = (size_t)std::clamp(std::floor(bin2), 0.0, (double)(sz2 - 1));
                    size_t b1 = std::min(b0 + 1, sz2 - 1);
                    float fr = (float)(bin2 - (double)b0);
                    float st = fr * fr * (3.0f - 2.0f * fr);

                    const auto& p0 = deck2.detailed_waveform[b0];
                    const auto& p1 = deck2.detailed_waveform[b1];

                    float l = (p0.low  + (p1.low  - p0.low)  * st) * eq_l2;
                    float m = (p0.mid  + (p1.mid  - p0.mid)  * st) * eq_m2;
                    float h_val = (p0.high + (p1.high - p0.high) * st) * eq_h2;

                    float eff = (l * 0.50f + m * 0.35f + h_val * 0.25f);
                    if (eff > 0.002f) {
                        float norm = std::clamp((eff - 0.002f) / (1.0f - 0.002f), 0.0f, 1.0f);
                        amp2 = std::clamp(std::pow(norm, 1.02f) * max_half_h, 0.8f, max_half_h);
                        core2 = amp2 * (0.38f * std::clamp(eq_l2, 0.15f, 1.6f));

                        int d2_col = (waveform_color_mode == 0) ? 4 : (waveform_color_mode == 2 ? 0 : 2);
                        computeRekordboxRGB(d2_col, l, m, h_val, eff, 1.0f, col_out2, col_cr2);
                    }
                }

                // Hierarquia de Amplitude e Fusão Inteligente
                if (amp1 < 0.8f && amp2 < 0.8f) {
                    dl->AddLine(ImVec2(cur_x, mid_y), ImVec2(cur_x + 1.0f, mid_y), IM_COL32(24, 32, 45, 140), 1.0f);
                } else if (amp1 >= 0.8f && amp2 < 0.8f) {
                    dl->AddLine(ImVec2(cur_x, mid_y - amp1), ImVec2(cur_x, mid_y + amp1), col_out1, 1.0f);
                    if (core1 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core1), ImVec2(cur_x, mid_y + core1), col_cr1, 1.0f);
                } else if (amp2 >= 0.8f && amp1 < 0.8f) {
                    dl->AddLine(ImVec2(cur_x, mid_y - amp2), ImVec2(cur_x, mid_y + amp2), col_out2, 1.0f);
                    if (core2 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core2), ImVec2(cur_x, mid_y + core2), col_cr2, 1.0f);
                } else {
                    // Ambos com som: A maior amplitude envolve a menor
                    if (amp1 >= amp2) {
                        dl->AddLine(ImVec2(cur_x, mid_y - amp1), ImVec2(cur_x, mid_y + amp1), col_out1, 1.0f);
                        dl->AddLine(ImVec2(cur_x, mid_y - amp2), ImVec2(cur_x, mid_y + amp2), IM_COL32(255, 150, 20, 255), 1.0f);
                        if (core1 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core1), ImVec2(cur_x, mid_y + core1), col_cr1, 1.0f);
                        if (core2 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core2), ImVec2(cur_x, mid_y + core2), col_cr2, 1.0f);
                    } else {
                        dl->AddLine(ImVec2(cur_x, mid_y - amp2), ImVec2(cur_x, mid_y + amp2), col_out2, 1.0f);
                        dl->AddLine(ImVec2(cur_x, mid_y - amp1), ImVec2(cur_x, mid_y + amp1), IM_COL32(0, 230, 255, 255), 1.0f);
                        if (core2 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core2), ImVec2(cur_x, mid_y + core2), col_cr2, 1.0f);
                        if (core1 >= 1.0f) dl->AddLine(ImVec2(cur_x, mid_y - core1), ImVec2(cur_x, mid_y + core1), col_cr1, 1.0f);
                    }
                }
            }

            // 4. Agulha Central Playhead Branca com Triângulos
            dl->AddLine(ImVec2(mid_x, wave_y), ImVec2(mid_x, wave_y + wave_h), IM_COL32(255, 255, 255, 255), 1.0f);
            dl->AddLine(ImVec2(mid_x, wave_y), ImVec2(mid_x, wave_y + wave_h), IM_COL32(0, 220, 255, 50), 3.0f);
            dl->AddTriangleFilled(ImVec2(mid_x - 3.5f, wave_y), ImVec2(mid_x + 3.5f, wave_y), ImVec2(mid_x, wave_y + 4.5f), IM_COL32(0, 245, 212, 255));
            dl->AddTriangleFilled(ImVec2(mid_x - 3.5f, wave_y + wave_h), ImVec2(mid_x + 3.5f, wave_y + wave_h), ImVec2(mid_x, wave_y + wave_h - 4.5f), IM_COL32(255, 170, 0, 255));

            // 5. Interatividade de Mouse na Wave Central
            ImGui::SetCursorScreenPos(pos);
            ImGui::InvisibleButton("##CentralFreqWaveBtn", ImVec2(w, h));
            if (ImGui::IsItemHovered()) {
                ImGui::SetTooltip("WAVE CENTRAL DE ANÁLISE DE FREQUÊNCIAS (D1 + D2)\n"
                                  "• Ciano = Deck 1 | Âmbar = Deck 2\n"
                                  "• Reativo em tempo real aos Knobs de EQ (Low/Mid/High) e Sound Color FX\n"
                                  "• A faixa dominante envolve externamente a sobreposta");
            }
        }

        void renderRekordboxCenterMixer(KuroAudio::DJEngine& engine) {
            float w = ImGui::GetContentRegionAvail().x;
            float h = ImGui::GetContentRegionAvail().y;
            ImDrawList* dl = ImGui::GetWindowDrawList();
