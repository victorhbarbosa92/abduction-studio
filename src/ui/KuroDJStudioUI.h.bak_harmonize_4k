                dl->AddCircleFilled(draw_center, eff_radius, IM_COL32(255, 255, 255, 22), 36);
            }

            // Anel do botão com espessura dinâmica
            dl->AddCircle(draw_center, eff_radius, ring_col, 36, is_active ? 2.5f : (is_hovered ? 2.0f : 1.5f));
            
            // Ícone / Texto com iluminação e contraste perfeito
