                drawMidiRow("Deck 2: CUE Button", "deck1_cue", KuroAudio::DJMidiBindingType::NOTE_MOMENTARY);
                drawMidiRow("Deck 2: Volume Fader", "deck1_volume", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                drawMidiRow("Deck 2: EQ High", "deck1_eq_high", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                drawMidiRow("Deck 2: EQ Mid", "deck1_eq_mid", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                drawMidiRow("Deck 2: EQ Low", "deck1_eq_low", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);

                drawMidiRow("Crossfader Geral", "crossfader", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                drawMidiRow("Fone CUE Mix", "headphone_cue_mix", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);

                ImGui::EndChild();

                ImGui::Spacing();
                if (ImGui::Button("Carregar Preset DDJ-FLX4")) {
                    midi.addBinding("deck0_play", 144, 11, KuroAudio::DJMidiBindingType::NOTE_TOGGLE);
                    midi.addBinding("deck0_cue", 144, 12, KuroAudio::DJMidiBindingType::NOTE_MOMENTARY);
                    midi.addBinding("deck0_volume", 176, 19, KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                    midi.addBinding("deck1_play", 145, 11, KuroAudio::DJMidiBindingType::NOTE_TOGGLE);
                    midi.addBinding("deck1_cue", 145, 12, KuroAudio::DJMidiBindingType::NOTE_MOMENTARY);
                    midi.addBinding("deck1_volume", 177, 19, KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                    midi.addBinding("crossfader", 176, 31, KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                    midi.saveToFile("scratch/custom_midi_map.json");
                }
                ImGui::SameLine();
                if (ImGui::Button("Salvar Mapa")) {
                    midi.saveToFile("scratch/custom_midi_map.json");
                }
                ImGui::SameLine();
                if (ImGui::Button("Limpar")) {
                    midi.clearBindings();
                    midi.saveToFile("scratch/custom_midi_map.json");
                }
                ImGui::SameLine();
                if (ImGui::Button("Fechar")) {
                    show_midi_learn_modal = false;
                }
            }
            ImGui::End();
        }

