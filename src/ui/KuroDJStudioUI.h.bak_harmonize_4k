    struct RekordboxBandLayer {
        float height_top = 0.0f;
        float height_bot = 0.0f;
        ImU32 col_outer  = 0;
        int   band_id    = 0; // 0=Low, 1=Mid, 2=High
    };

    // Síntese Oficial Pioneer Rekordbox Waveform Engine (1:1 CDJ-3000 & Rekordbox 6/7)
    // Mode 0: 3-BAND (CDJ-3000 / Rekordbox 7 Padrão) -> Azul Royal (Graves), Âmbar Vibrante (Médios), Branco Cristal (Agudos)
    // Mode 1: BLUE (CDJ-2000 Clássico Monochrome)     -> Azul Marinho Profundo, Azul Elétrico e Picos em Branco Puro
    // Mode 2: RGB (Rekordbox 5 / CDJ-2000NXS2)       -> Vermelho Crimson (Graves), Âmbar Dourado (Médios), Ciano (Agudos)
    // Mode 3: NEON (Cyberpunk)                        -> Magenta, Ciano, Verde Lime
    // Mode 4: SUNSET                                 -> Roxo Profundo, Laranja Pôr do Sol, Dourado Solar
    inline void computeRekordboxWaveformPoint(int color_mode,
                                             float low, float mid, float high, float peak,
                                             float raw_s, float max_half_h, float dim_factor,
                                             RekordboxBandLayer layers[3], ImU32& out_core_col) {
        // Expansão dinâmica Pioneer com curva perceptual (riqueza de graves e corpo volumoso)
        float l_exp = std::pow(std::clamp(low,  0.0f, 1.0f), 0.82f);
        float m_exp = std::pow(std::clamp(mid,  0.0f, 1.0f), 0.85f);
        float h_exp = std::pow(std::clamp(high, 0.0f, 1.0f), 0.88f);
        float p_exp = std::pow(std::clamp(peak, 0.0f, 1.0f), 0.82f);

        // Estabilidade total: envelope suave contínuo sem jitter estroboscópico de amostra
        float ripple_top = 1.0f;
        float ripple_bot = 1.0f;

        float h_l = std::clamp(l_exp * max_half_h, 1.0f, max_half_h);
        float h_m = std::clamp(m_exp * max_half_h * 0.90f, 0.8f, max_half_h);
        float h_h = std::clamp(h_exp * max_half_h * 0.80f, 0.6f, max_half_h);

        // Se o pico geral for maior que o sub-máximo, dá boost sutil e harmônico no envelope geral
        float max_sub = std::max({ h_l, h_m, h_h });
        float peak_h  = std::clamp(p_exp * max_half_h, 1.0f, max_half_h);
        if (peak_h > max_sub && max_sub > 0.001f) {
            float boost = std::clamp(peak_h / max_sub, 1.0f, 1.15f);
            h_l = std::clamp(h_l * boost, 1.0f, max_half_h);
            h_m = std::clamp(h_m * boost, 0.8f, max_half_h);
            h_h = std::clamp(h_h * boost, 0.6f, max_half_h);
        }

        // Camada 0: LOW (Graves / Kick / Sub - Fundação de grande massa visual)
        layers[0].band_id = 0;
        layers[0].height_top = h_l;
        layers[0].height_bot = h_l;

        // Camada 1: MID (Médios / Vocais / Synths / Snare body)
        layers[1].band_id = 1;
        layers[1].height_top = h_m;
        layers[1].height_bot = h_m;

        // Camada 2: HIGH (Agudos / Hi-Hats / Transientes de Ataque)
        layers[2].band_id = 2;
        layers[2].height_top = h_h;
        layers[2].height_bot = h_h;

        float df = std::clamp(dim_factor, 0.20f, 1.0f);
        auto apply_dim = [df](int r, int g, int b, int a = 255) -> ImU32 {
            int dr = (int)std::clamp(r * df, 0.0f, 255.0f);
            int dg = (int)std::clamp(g * df, 0.0f, 255.0f);
            int db = (int)std::clamp(b * df, 0.0f, 255.0f);
            return IM_COL32(dr, dg, db, a);
        };

        if (color_mode == 0) {
            // =========================================================================
            // MODE 0: RGB OFICIAL REKORDBOX / TRAKTOR (Padrão de Ouro de Renderização)
            // =========================================================================
            // Low: Magenta / Rosa Neon Intenso (#FF0080 / 255, 0, 128)
            layers[0].col_outer = apply_dim(255, 0, 128, 255);
            // Mid: Ciano Elétrico Puro (#00E5FF / 0, 229, 255)
            layers[1].col_outer = apply_dim(0, 229, 255, 255);
            // High: Verde Limão Neon (#39FF14 / 57, 255, 20)
            layers[2].col_outer = apply_dim(57, 255, 20, 255);
            out_core_col        = apply_dim(215, 255, 215, 255);
        } else if (color_mode == 1) {
            // =========================================================================
            // MODE 1: 3-BAND (CDJ-3000 / Rekordbox 6 & 7 Flagship Standard Oficial)
            // =========================================================================
            // Low: Deep Royal Electric Blue Pioneer (#0073FF)
            layers[0].col_outer = apply_dim(0, 115, 255, 255);
            // Mid: Radiant Golden Amber (#FF9000)
            layers[1].col_outer = apply_dim(255, 144, 0, 255);
            // High: Pure Crisp Diamond White (#FFFFFF)
            layers[2].col_outer = apply_dim(255, 255, 255, 255);
            out_core_col        = apply_dim(255, 255, 255, 255);
        } else if (color_mode == 2) {
            // =========================================================================
            // MODE 2: BLUE (CDJ-2000 Clássico & Rekordbox 4 Monochrome Blue)
            // =========================================================================
            // Low: Deep Royal Navy Blue (#0C41C3)
            layers[0].col_outer = apply_dim(12, 65, 195, 255);
            // Mid: Vibrant Electric Sky Blue (#00B9FF)
            layers[1].col_outer = apply_dim(0, 185, 255, 255);
            // High: Pure White Peaks (#FFFFFF)
            layers[2].col_outer = apply_dim(245, 250, 255, 255);
            out_core_col        = apply_dim(255, 255, 255, 255);
        } else if (color_mode == 3) {
            // =========================================================================
            // MODE 3: NEON (Cyberpunk)
            // =========================================================================
            layers[0].col_outer = apply_dim(255, 0, 90, 255);    // Hot Red-Pink
            layers[1].col_outer = apply_dim(0, 245, 220, 255);   // Neon Cyan
            layers[2].col_outer = apply_dim(255, 245, 0, 255);   // Neon Lemon
            out_core_col        = apply_dim(255, 255, 220, 255);
        } else {
            // =========================================================================
            // MODE 4: SUNSET (Festival Dusk)
            // =========================================================================
            layers[0].col_outer = apply_dim(115, 20, 140, 255);  // Royal Purple
            layers[1].col_outer = apply_dim(255, 85, 0, 255);    // Sunset Orange
            layers[2].col_outer = apply_dim(255, 215, 0, 255);   // Golden Sun
            out_core_col        = apply_dim(255, 255, 220, 255);
        }
    }

    inline void computeRekordboxRGB(int color_mode, float low, float mid, float high, float peak, float dim_factor, ImU32& out_outer, ImU32& out_core) {
        RekordboxBandLayer layers[3];
        computeRekordboxWaveformPoint(color_mode, low, mid, high, peak, 0.0f, 100.0f, dim_factor, layers, out_core);
        if (low >= mid * 0.95f && low >= high * 0.95f) {
            out_outer = layers[0].col_outer; // Graves
        } else if (mid >= high * 0.90f) {
            out_outer = layers[1].col_outer; // Médios
        } else {
            out_outer = layers[2].col_outer; // Agudos
        }
    }

    inline void computeRekordboxRGB(float low, float mid, float high, float peak, float dim_factor, ImU32& out_outer, ImU32& out_core) {
        computeRekordboxRGB(0 /*RGB*/, low, mid, high, peak, dim_factor, out_outer, out_core);
    }

    // =========================================================================
    // RENDERIZADOR DE OVERVIEW PIONEER REKORDBOX (MINI-STRIP & LIBRARY PREVIEW)
    // Multicamada espectral (Low, Mid, High) com alto alcance dinâmico
    // e cauda ultrafina contínua de 1px em silêncio/intro/outro/breakdown
    // =========================================================================
    inline void drawRekordboxOverviewSlice(ImDrawList* dl, float x, float base_y, float max_h,
                                           float p_tot, float l, float m, float hi,
                                           float dim_factor, int color_mode) {
        if (p_tot <= 0.002f) {
            // Trecho de silêncio ou cauda mínima: linha sutil de osciloscópio de 1px
            ImU32 col_zero = IM_COL32(45, 58, 78, (int)(150 * dim_factor));
            dl->AddLine(ImVec2(x, base_y), ImVec2(x, base_y - 1.0f), col_zero, 1.0f);
            return;
        }

        // Expansão dinâmica logarítmica decibel Pioneer WeDJ / Rekordbox (-48 dB):
        auto to_pioneer_db = [](float linear_v) -> float {
            if (linear_v <= 1e-4f) return 0.0f;
            float db = 20.0f * std::log10(linear_v);
            if (db < -48.0f) return 0.0f;
            return std::clamp((db + 48.0f) / 48.0f, 0.0f, 1.0f);
        };

        float p_db = to_pioneer_db(p_tot);
        float h_tot = std::clamp(p_db * max_h, 1.0f, max_h);

        // Se for cauda ou sussurro de áudio, renderiza como linha fina de osciloscópio
        if (h_tot < 1.8f) {
            ImU32 col_tail = (color_mode == 1) ? IM_COL32(0, 140, 255, (int)(180 * dim_factor))
                                                : IM_COL32(230, 25, 120, (int)(180 * dim_factor));
            dl->AddLine(ImVec2(x, base_y), ImVec2(x, base_y - 1.2f), col_tail, 1.0f);
            return;
        }

        auto apply_dim = [dim_factor](int r, int g, int b, int a = 255) -> ImU32 {
            int dr = (int)std::clamp(r * dim_factor, 0.0f, 255.0f);
            int dg = (int)std::clamp(g * dim_factor, 0.0f, 255.0f);
            int db = (int)std::clamp(b * dim_factor, 0.0f, 255.0f);
            return IM_COL32(dr, dg, db, a);
        };

        if (color_mode == 1) { // 3-BAND OFICIAL (CDJ-3000)
            float h_l = to_pioneer_db(l) * max_h;
            float h_m = to_pioneer_db(m) * max_h;
            float h_h = to_pioneer_db(hi) * max_h;

            ImU32 c_low  = apply_dim(  0, 115, 255, 255); // Royal Blue
            ImU32 c_mid  = apply_dim(255, 140,   0, 240); // Amber
            ImU32 c_high = apply_dim(255, 255, 255, 255); // Diamond White

            dl->AddLine(ImVec2(x, base_y), ImVec2(x, base_y - h_l), c_low, 1.0f);
            if (h_m > 1.2f && m > 0.12f) {
                dl->AddLine(ImVec2(x, base_y), ImVec2(x, base_y - h_m), c_mid, 1.0f);
            }
            if (h_h > 1.5f && hi > 0.20f) {
                float tip_start = std::max(h_l, h_m);
                if (h_tot > tip_start) {
                    dl->AddLine(ImVec2(x, base_y - tip_start), ImVec2(x, base_y - h_tot), c_high, 1.0f);
                }
            }
        } else { // RGB OFICIAL PIONEER REKORDBOX & WEDJ
            float l_val = std::clamp(l, 0.0f, 1.0f);
            float m_val = std::clamp(m, 0.0f, 1.0f);
            float h_val = std::clamp(hi, 0.0f, 1.0f);

            // Regra de Ouro Pioneer: Supressão contínua e suave de verde sob presença de graves
            float l_ratio = l_val / 0.16f;
            float green_suppress = 1.0f / (1.0f + l_ratio * l_ratio * l_ratio);

            float r_val = l_val * 255.0f + m_val * 170.0f + h_val * 20.0f;
            float g_val = (m_val * 140.0f + h_val * 65.0f) * green_suppress;
            float b_val = h_val * 255.0f;

            // Snares / Claps (L + H ou M + H) -> Violeta / Lilás (#B830FF / #D040FF)
            if (h_val > 0.14f && (l_val > 0.16f || m_val > 0.22f)) {
                b_val = std::max(b_val, 220.0f * std::clamp(h_val * 1.5f + l_val * 0.4f, 0.5f, 1.0f));
                r_val = std::max(r_val, 210.0f);
            }

            // Agudos puros (Hi-Hats isolados): Ciano Elétrico (#00E5FF)
            if (h_val > 0.20f && l_val < 0.15f) {
                g_val = std::max(g_val, h_val * 175.0f);
                b_val = std::max(b_val, h_val * 255.0f);
            }

            float mx = std::max({ r_val, g_val, b_val, 1.0f });
            if (mx < 195.0f && p_tot > 0.02f) {
                float sc = 195.0f / mx;
                r_val = std::min(255.0f, r_val * sc);
                g_val = std::min(255.0f, g_val * sc);
                b_val = std::min(255.0f, b_val * sc);
            }

            ImU32 col_bar = apply_dim((int)r_val, (int)g_val, (int)b_val, 255);
            dl->AddLine(ImVec2(x, base_y), ImVec2(x, base_y - h_tot), col_bar, 1.0f);

            if (h_val > 0.30f && h_tot > 3.0f) {
                dl->AddLine(ImVec2(x, base_y - h_tot + 2.0f), ImVec2(x, base_y - h_tot), apply_dim(255, 255, 255, 240), 1.0f);
            }
        }
    }


    struct TapTempoTracker {
        std::vector<double> tap_times;
        double last_tap_time = 0.0;
        float flash_timer = 0.0f;
        
        double registerTap(double current_time_sec) {
            flash_timer = 0.35f;
            if (current_time_sec - last_tap_time > 2.2) {
                tap_times.clear();
            }
            last_tap_time = current_time_sec;
            tap_times.push_back(current_time_sec);
            if (tap_times.size() > 8) {
                tap_times.erase(tap_times.begin());
            }
            if (tap_times.size() < 2) return 0.0;
            
            double total_diff = 0.0;
            for (size_t i = 1; i < tap_times.size(); i++) {
                total_diff += (tap_times[i] - tap_times[i - 1]);
            }
            double avg_diff = total_diff / (double)(tap_times.size() - 1);
            if (avg_diff > 0.05) {
                double calc_bpm = 60.0 / avg_diff;
                return std::clamp(calc_bpm, 40.0, 240.0);
            }
            return 0.0;
        }
    };

