        void renderRekordboxMemoryCuePanel(KuroAudio::DJDeck& deck, ImVec2 pos, float w, float h, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
            ImFont* f_reg = g_font_rekordbox_regular ? g_font_rekordbox_regular : ImGui::GetFont();

            // Helper de botão tátil Pioneer com micro-chanfro e LED de status
            auto drawTactileBtn = [&](const char* id, const char* label, ImVec2 b_pos, ImVec2 b_size, 
                                      bool is_active, ImU32 active_border, ImU32 active_bg, ImU32 active_txt, 
                                      std::function<void()> on_click, const char* tooltip = nullptr, 
                                      bool has_led = false, ImU32 led_col = 0) {
                ImVec2 b_max = ImVec2(b_pos.x + b_size.x, b_pos.y + b_size.y);
                ImGui::SetCursorScreenPos(b_pos);
                if (ImGui::InvisibleButton(id, b_size)) {
                    if (on_click) on_click();
                }
                bool is_held = ImGui::IsItemActive();
                bool is_hov = ImGui::IsItemHovered();

                ImU32 bg = is_active ? active_bg : (is_hov ? IM_COL32(32, 40, 52, 255) : IM_COL32(18, 22, 30, 255));
                if (is_held) bg = IM_COL32(45, 56, 75, 255);

                ImU32 border = is_active ? active_border : (is_hov ? IM_COL32(65, 85, 115, 240) : IM_COL32(36, 46, 62, 220));

                dl->AddRectFilled(b_pos, b_max, bg, 2.5f);
                dl->AddRect(b_pos, b_max, border, 2.5f, 0, 1.0f);

                // Linha de chanfro superior tátil (3D bevel)
                dl->AddLine(ImVec2(b_pos.x + 1.5f, b_pos.y + 1.0f), ImVec2(b_max.x - 1.5f, b_pos.y + 1.0f), 
                            is_active ? IM_COL32(255, 255, 255, 50) : IM_COL32(255, 255, 255, 20), 1.0f);

                // Texto centralizado
                ImU32 txt_col = is_active ? active_txt : (is_hov ? IM_COL32(245, 250, 255, 255) : IM_COL32(175, 190, 210, 240));
                ImVec2 t_sz = ImGui::CalcTextSize(label);
                dl->AddText(ImVec2(b_pos.x + (b_size.x - t_sz.x) * 0.5f, b_pos.y + (b_size.y - t_sz.y) * 0.5f), txt_col, label);

                // Indicador LED de status (Pioneer status pip)
                if (has_led) {
                    float led_r = 1.8f;
                    ImVec2 led_center = ImVec2(b_max.x - 4.5f, b_pos.y + 4.5f);
                    if (is_active) {
                        dl->AddCircleFilled(led_center, led_r + 1.2f, (led_col & 0x00FFFFFF) | 0x55000000);
                        dl->AddCircleFilled(led_center, led_r, led_col);
                    } else {
                        dl->AddCircleFilled(led_center, led_r, IM_COL32(12, 16, 22, 255));
                        dl->AddCircle(led_center, led_r, IM_COL32(40, 50, 68, 200), 0, 0.8f);
                    }
                }

                if (tooltip && is_hov) {
                    ImGui::SetTooltip("%s", tooltip);
                }
            };

            float cur_y = pos.y;
            float row_w = w;
            float half_w = (w - 2.0f) * 0.5f;

            // 1. TIER 1: DISPLAY OLED DE BAR COUNTDOWN (Pioneer CDJ-3000 Countdown to Drop / Next Cue)
            float disp_h = 22.0f;
            ImVec2 disp_min = ImVec2(pos.x, cur_y);
            ImVec2 disp_max = ImVec2(pos.x + row_w, cur_y + disp_h);

            double bars_drop = deck.getBarsToDrop();
            int next_cue_idx = -1;
            double bars_cue = deck.getBarsToNextMemoryCue(&next_cue_idx);

            char count_txt[32] = "";
            char count_sub[32] = "";
            ImU32 txt_col = IM_COL32(0, 225, 255, 255);
            ImU32 bg_col = IM_COL32(8, 12, 17, 255);
            ImU32 bd_col = IM_COL32(32, 42, 58, 220);

            if (bars_drop < 900.0 && bars_drop >= 0.0) {
                int int_bars = (int)bars_drop;
                int frac_beats = (int)((bars_drop - (double)int_bars) * 4.0) + 1;
                snprintf(count_txt, sizeof(count_txt), "-%d.%d", int_bars, frac_beats);
                snprintf(count_sub, sizeof(count_sub), "DROP");
                if (bars_drop < 4.0) {
                    bool blink = ((int)(ImGui::GetTime() * 6.0) % 2 == 0);
                    txt_col = blink ? IM_COL32(255, 40, 40, 255) : IM_COL32(255, 200, 30, 255);
                    bg_col = IM_COL32(40, 10, 10, 255);
                    bd_col = IM_COL32(255, 50, 50, 255);
                } else {
                    txt_col = IM_COL32(255, 170, 0, 255);
                    bg_col = IM_COL32(28, 18, 6, 255);
                    bd_col = IM_COL32(220, 130, 0, 220);
                }
            } else if (bars_cue < 900.0 && bars_cue >= 0.0) {
                int int_bars = (int)bars_cue;
                int frac_beats = (int)((bars_cue - (double)int_bars) * 4.0) + 1;
                snprintf(count_txt, sizeof(count_txt), "-%d.%d", int_bars, frac_beats);
                snprintf(count_sub, sizeof(count_sub), "CUE %d", next_cue_idx + 1);
                txt_col = IM_COL32(0, 230, 255, 255);
                bg_col = IM_COL32(6, 20, 28, 255);
                bd_col = IM_COL32(0, 160, 220, 220);
            } else {
                int bar = 1, beat = 1; float prog = 0.0f;
                deck.getBeatPhaseInfo(bar, beat, prog);
                snprintf(count_txt, sizeof(count_txt), "B%02d.%d", bar, beat);
                snprintf(count_sub, sizeof(count_sub), "PHASE");
                txt_col = IM_COL32(160, 180, 205, 240);
            }

            dl->AddRectFilled(disp_min, disp_max, bg_col, 2.5f);
            dl->AddRect(disp_min, disp_max, bd_col, 2.5f, 0, 1.2f);

            ImVec2 sz_cnt = f_bld->CalcTextSizeA(11.5f, FLT_MAX, 0.0f, count_txt);
            ImVec2 sz_sub = f_reg->CalcTextSizeA(8.5f, FLT_MAX, 0.0f, count_sub);
            dl->AddText(f_bld, 11.5f, ImVec2(pos.x + 4.0f, cur_y + 3.0f), txt_col, count_txt);
            dl->AddText(f_reg, 8.5f, ImVec2(pos.x + row_w - sz_sub.x - 4.0f, cur_y + 5.0f), IM_COL32(160, 180, 205, 220), count_sub);

            ImGui::SetCursorScreenPos(disp_min);
            char disp_id[32]; snprintf(disp_id, sizeof(disp_id), "##DropDisp_%d", deck.deck_id);
            if (ImGui::InvisibleButton(disp_id, ImVec2(row_w, disp_h))) {
                if (deck.drop_point_frame > 0) deck.clearDropPoint();
                else deck.setDropPointHere();
            }
            if (ImGui::IsItemHovered()) {
                ImGui::SetTooltip("Display de Contagem de Compassos (CDJ-3000 Bar Countdown)\n• Clique para definir/remover Ponto de Drop aqui\n• Exibe contagem regressiva para o Drop ou próximo Memory Cue");
            }

            cur_y += disp_h + 3.0f;

            // 2. TIER 2: BOTOES CALL PREV / NEXT (< CALL | CALL >)
            float step_h = 18.0f;
            char id_c_prev[32]; snprintf(id_c_prev, sizeof(id_c_prev), "##MC_Prev_%d", deck.deck_id);
            drawTactileBtn(id_c_prev, "< CALL", ImVec2(pos.x, cur_y), ImVec2(half_w, step_h),
                           false, 0, 0, 0, [&]() { deck.callPrevMemoryCue(); }, "Chamar Memory Cue Anterior (< CALL)");

            char id_c_next[32]; snprintf(id_c_next, sizeof(id_c_next), "##MC_Next_%d", deck.deck_id);
            drawTactileBtn(id_c_next, "CALL >", ImVec2(pos.x + half_w + 2.0f, cur_y), ImVec2(half_w, step_h),
                           false, 0, 0, 0, [&]() { deck.callNextMemoryCue(); }, "Chamar Próximo Memory Cue (CALL >)");

            cur_y += step_h + 3.0f;

            // 3. TIER 3: MEMORY & DELETE
            char id_mem[32]; snprintf(id_mem, sizeof(id_mem), "##MC_Mem_%d", deck.deck_id);
            drawTactileBtn(id_mem, "MEMORY", ImVec2(pos.x, cur_y), ImVec2(half_w, step_h),
                           false, IM_COL32(230, 240, 255, 255), IM_COL32(36, 44, 58, 255), IM_COL32(255, 255, 255, 255),
                           [&]() { deck.addMemoryCueHere(); }, "Salvar Ponto no MEMORY CUE (CDJ-3000 Standard)");

            char id_del[32]; snprintf(id_del, sizeof(id_del), "##MC_Del_%d", deck.deck_id);
            drawTactileBtn(id_del, "DELETE", ImVec2(pos.x + half_w + 2.0f, cur_y), ImVec2(half_w, step_h),
                           false, IM_COL32(255, 60, 60, 220), IM_COL32(40, 16, 18, 255), IM_COL32(255, 90, 90, 255),
                           [&]() { deck.deleteSelectedMemoryCue(); }, "Apagar Memory Cue selecionado");

            cur_y += step_h + 3.0f;

            // 4. TIER 4: ACTIVE LOOP & DROP (SET)
            char id_act_lp[32]; snprintf(id_act_lp, sizeof(id_act_lp), "##MC_ActLp_%d", deck.deck_id);
            drawTactileBtn(id_act_lp, "ACT.LP", ImVec2(pos.x, cur_y), ImVec2(half_w, step_h),
                           deck.has_active_loop, IM_COL32(255, 40, 60, 255), IM_COL32(48, 12, 18, 255), IM_COL32(255, 80, 100, 255),
                           [&]() { deck.toggleActiveLoopHere(deck.loop_beats > 0 ? deck.loop_beats : 4.0); },
                           "ACTIVE LOOP (Rekordbox / CDJ-3000):\nLoop automático de salvaguarda que ativa sozinho ao alcançar este ponto.",
                           true, IM_COL32(255, 30, 60, 255));

            char id_drop[32]; snprintf(id_drop, sizeof(id_drop), "##MC_SetDrop_%d", deck.deck_id);
            bool has_drop = (deck.drop_point_frame > 0.0);
            drawTactileBtn(id_drop, has_drop ? "DROP *" : "DROP", ImVec2(pos.x + half_w + 2.0f, cur_y), ImVec2(half_w, step_h),
                           has_drop, IM_COL32(255, 150, 0, 255), IM_COL32(42, 24, 6, 255), IM_COL32(255, 185, 30, 255),
                           [&]() { if (has_drop) deck.clearDropPoint(); else deck.setDropPointHere(); },
                           "SET DROP POINT:\nDefine o ponto de Drop para a contagem regressiva de compassos (Clique direito limpa).",
                           true, IM_COL32(255, 160, 0, 255));

            cur_y += step_h + 3.0f;

            // 5. TIER 5: STATUS DE MEMORY CUES
            float st_h = 16.0f;
            char st_txt[32];
            snprintf(st_txt, sizeof(st_txt), "%d CUES", (int)deck.memory_cues.size());
            char id_st[32]; snprintf(id_st, sizeof(id_st), "##MC_St_%d", deck.deck_id);
            drawTactileBtn(id_st, st_txt, ImVec2(pos.x, cur_y), ImVec2(row_w, st_h),
                           false, 0, 0, 0, nullptr,
                           "Total de Memory Cues salvos nesta faixa.");
        }

        void renderRekordboxTransportSection(KuroAudio::DJDeck& deck, ImVec2 pos, float w, float h) {
            // Caixa de loop superior
            renderRekordboxLoopBox(deck, pos, w);

            float lower_y = pos.y + 70.0f;
            float col_w = (w - 4.0f) * 0.5f;

            // Coluna Esquerda: INT v, CUE, PLAY
            float left_x = pos.x;
            ImGui::SetCursorScreenPos(ImVec2(left_x, lower_y));
            ImGui::SmallButton("INT v##D1");

            float r_btn = 20.0f;
            float btn_cx = left_x + col_w * 0.5f;
            float cue_cy = lower_y + 24.0f + r_btn;
            float play_cy = cue_cy + r_btn * 2.0f + 12.0f;

            bool at_cue = (std::abs(deck.current_frame - deck.cue_frame) <= deck.sample_rate * 0.04);
            bool blink_phase = ((int)(ImGui::GetTime() * 4.0) % 2 == 0);

            bool cue_lit = false;
            ImU32 cue_ring_col = IM_COL32(255, 140, 0, 255);
            if (deck.cue_active) {
                cue_lit = true;
                cue_ring_col = IM_COL32(255, 185, 40, 255);
            } else if (!deck.is_playing) {
                if (at_cue) {
                    cue_lit = true;
                    cue_ring_col = IM_COL32(255, 145, 0, 255);
                } else {
                    cue_lit = blink_phase;
                    cue_ring_col = blink_phase ? IM_COL32(255, 145, 0, 255) : IM_COL32(75, 45, 15, 160);
                }
            } else {
                cue_lit = false;
                cue_ring_col = IM_COL32(110, 75, 25, 160);
            }

            renderPioneerRoundButton("CUE", ImVec2(btn_cx, cue_cy), r_btn, cue_ring_col, IM_COL32(18, 14, 8, 255), cue_lit,
                [&]() { deck.pressCue(); },
                [&]() { deck.releaseCue(); }
            );

            bool play_lit = false;
            ImU32 play_ring_col = IM_COL32(0, 240, 90, 255);
            if (deck.is_playing && !deck.cue_active) {
                play_lit = true;
                play_ring_col = IM_COL32(0, 255, 100, 255);
            } else {
                play_lit = blink_phase;
                play_ring_col = blink_phase ? IM_COL32(0, 240, 90, 255) : IM_COL32(15, 65, 35, 160);
            }

            renderPioneerRoundButton("PLAY", ImVec2(btn_cx, play_cy), r_btn, play_ring_col, IM_COL32(8, 18, 12, 255), play_lit,
                [&]() { deck.togglePlay(); }
            );

            // Coluna Direita: SLIP, Q, MT
            float right_x = pos.x + col_w + 4.0f;
            ImGui::SetCursorScreenPos(ImVec2(right_x, lower_y));

            if (deck.slip_mode) {
                if (deck.is_slipping) {
                    float pulse = (std::sin((float)ImGui::GetTime() * 16.0f) + 1.0f) * 0.5f;
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(1.0f, 0.25f + pulse * 0.45f, 0.0f, 1.0f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1, 1, 1, 1));
                } else {
                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(1.0f, 0.55f, 0.0f, 1.0f));
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0, 0, 0, 1));
                }
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.15f, 0.20f, 0.85f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button(deck.is_slipping ? "SLIP ⚡##D1" : "SLIP##D1", ImVec2(col_w, 18.0f))) deck.slip_mode = !deck.slip_mode;
            ImGui::PopStyleColor(2);
            if (ImGui::IsItemHovered()) {
                if (deck.is_slipping) ImGui::SetTooltip("SLIP ATIVO: Posição virtual avançando no fundo!\nSolte o scratch/loop para snap perfeito na cabeça do compasso.");
                else ImGui::SetTooltip("SLIP MODE (Pioneer CDJ-3000):\nPermite scratch, loops e hot cues sem perder o andamento original da faixa (Tecla L).");
            }

            ImGui::SetCursorScreenPos(ImVec2(right_x, lower_y + 24.0f));
            if (deck.quantize_active) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.0f, 0.85f, 0.35f, 0.95f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0, 0, 0, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.15f, 0.20f, 0.85f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button("Q##D1", ImVec2(col_w, 18.0f))) deck.quantize_active = !deck.quantize_active;
            ImGui::PopStyleColor(2);

            ImGui::SetCursorScreenPos(ImVec2(right_x, lower_y + 48.0f));
            if (deck.key_sync_active) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.0f, 0.52f, 1.0f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1, 1, 1, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.15f, 0.20f, 0.85f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button("MT##D1", ImVec2(col_w, 18.0f))) deck.key_sync_active = !deck.key_sync_active;
            ImGui::PopStyleColor(2);
        }

        void renderRekordboxPitchFaderWidget(KuroAudio::DJDeck& deck, ImVec2 pos, ImVec2 size, ImVec4 theme_col) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImFont* f_bld = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
            ImFont* f_reg = g_font_rekordbox_regular ? g_font_rekordbox_regular : ImGui::GetFont();

            // 1. Chassi metálico obsidian do Pitch Fader
            dl->AddRectFilled(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(10, 12, 17, 255), 4.0f);
            dl->AddRect(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(30, 38, 50, 220), 4.0f, 0, 1.0f);

            // 2. Header: Label "TEMPO" + Valor "%" em destaque + Botões de Range e MT
            float hdr_h = 36.0f;
            dl->AddRectFilled(pos, ImVec2(pos.x + size.x, pos.y + hdr_h), IM_COL32(16, 20, 28, 255), 4.0f, ImDrawFlags_RoundCornersTop);
            dl->AddLine(ImVec2(pos.x, pos.y + hdr_h), ImVec2(pos.x + size.x, pos.y + hdr_h), IM_COL32(34, 44, 58, 220), 1.0f);

            // Linha 1 do Header: TEMPO e Botão MT (Key Lock)
            float mt_w = (size.x < 70.0f) ? 22.0f : 26.0f;
            float mt_h = 14.0f;
            ImVec2 mt_pos = ImVec2(pos.x + size.x - mt_w - 4.0f, pos.y + 3.0f);
            char mt_id[32]; snprintf(mt_id, sizeof(mt_id), "MT##PF_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(mt_pos);
            if (deck.key_sync_active) {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.0f, 0.55f, 1.0f, 1.0f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1, 1, 1, 1));
            } else {
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.12f, 0.16f, 0.22f, 0.9f));
                ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.7f, 0.8f, 0.9f, 1));
            }
            if (ImGui::Button(mt_id, ImVec2(mt_w, mt_h))) {
                deck.key_sync_active = !deck.key_sync_active;
            }
            ImGui::PopStyleColor(2);

            // Texto TEMPO com clipping para nunca encavalar no botão MT
            dl->PushClipRect(ImVec2(pos.x + 4.0f, pos.y + 2.0f), ImVec2(mt_pos.x - 2.0f, pos.y + 18.0f), true);
            dl->AddText(f_bld, 10.0f, ImVec2(pos.x + 5.0f, pos.y + 3.5f), IM_COL32(170, 185, 205, 230), "TEMPO");
            dl->PopClipRect();

            // Linha 2 do Header: Valor Numérico do Pitch e Botão de Range
            char val_str[32];
            if (std::abs(deck.pitch_percent) < 0.005f) {
                snprintf(val_str, sizeof(val_str), "±0.00%%");
            } else {
                snprintf(val_str, sizeof(val_str), "%+.2f%%", deck.pitch_percent);
            }
            for (char* p = val_str; *p; ++p) { if (*p == ',') *p = '.'; }

            // Se estiver em 0.00%, brilha em VERDE NEON (LED 0% Pioneer Rekordbox)
            bool is_center_zero = (std::abs(deck.pitch_percent) < 0.02f);
            ImU32 col_val = is_center_zero ? IM_COL32(0, 240, 120, 255) : IM_COL32(235, 245, 255, 255);

            const char* rg_str = (deck.pitch_range >= 90.0f) ? "WIDE" : (deck.pitch_range >= 15.0f ? "16%" : (deck.pitch_range >= 9.0f ? "10%" : "6%"));
            float rg_w = (size.x < 70.0f) ? 24.0f : 30.0f;
            float rg_h = 14.0f;
            ImVec2 rg_pos = ImVec2(pos.x + size.x - rg_w - 4.0f, pos.y + 19.0f);
            char rg_id[32]; snprintf(rg_id, sizeof(rg_id), "%s##PFRG_%d", rg_str, deck.deck_id);
            ImGui::SetCursorScreenPos(rg_pos);
            ImGui::PushStyleColor(ImGuiCol_Button, (deck.pitch_range >= 90.0f) ? ImVec4(0.6f, 0.1f, 0.15f, 0.9f) : ImVec4(0.14f, 0.18f, 0.24f, 0.9f));
            ImGui::PushStyleColor(ImGuiCol_Text, (deck.pitch_range >= 90.0f) ? ImVec4(1.0f, 0.3f, 0.35f, 1.0f) : ImVec4(0.85f, 0.9f, 1.0f, 1.0f));
            if (ImGui::Button(rg_id, ImVec2(rg_w, rg_h))) {
                if (deck.pitch_range < 8.0f) deck.pitch_range = 10.0f;
                else if (deck.pitch_range < 12.0f) deck.pitch_range = 16.0f;
                else if (deck.pitch_range < 20.0f) deck.pitch_range = 100.0f;
                else deck.pitch_range = 6.0f;
            }
            ImGui::PopStyleColor(2);

            // Texto de valor do pitch com clipping para não encavalar no botão de Range
            dl->PushClipRect(ImVec2(pos.x + 4.0f, pos.y + 18.0f), ImVec2(rg_pos.x - 2.0f, pos.y + 35.0f), true);
            float v_font_sz = (size.x < 70.0f) ? 10.5f : 12.0f;
            dl->AddText(f_bld, v_font_sz, ImVec2(pos.x + 5.0f, pos.y + 20.0f), col_val, val_str);
            dl->PopClipRect();

            // 3. Fader Track Vertical (Slot harmônico estilo Pioneer Rekordbox)
            float track_top = pos.y + hdr_h + 10.0f;
            float track_bot = pos.y + size.y - 12.0f;
            float track_h   = track_bot - track_top;
            float track_cx  = pos.x + size.x * 0.46f;
            float slot_w    = 7.0f;

            // Interação com o Fader (Submetido PRIMEIRO para zero latência visual e hit test prioritário)
            char fdr_btn_id[32]; snprintf(fdr_btn_id, sizeof(fdr_btn_id), "##PitchFaderHit_%d", deck.deck_id);
            ImGui::SetCursorScreenPos(ImVec2(pos.x + 2.0f, track_top - 6.0f));
            ImGui::InvisibleButton(fdr_btn_id, ImVec2(size.x - 4.0f, track_h + 12.0f));
            bool fdr_active = ImGui::IsItemActive();
            bool fdr_hovered = ImGui::IsItemHovered();

            if (fdr_active) {
                float my = ImGui::GetMousePos().y;
                float new_norm = (my - track_top) / track_h;
                new_norm = std::clamp(new_norm, 0.0f, 1.0f);
                float target_pitch = -deck.pitch_range + new_norm * (deck.pitch_range * 2.0f);
                if (std::abs(target_pitch) < 0.04f) target_pitch = 0.0f;
                deck.pitch_percent = target_pitch;
                deck.sync_active = false;
            }

            if (fdr_hovered) {
                float mw = ImGui::GetIO().MouseWheel;
                if (mw != 0.0f) {
                    deck.pitch_percent = std::clamp(deck.pitch_percent + mw * 0.02f, -deck.pitch_range, deck.pitch_range);
                    if (std::abs(deck.pitch_percent) < 0.01f) deck.pitch_percent = 0.0f;
                    deck.sync_active = false;
                }
                if (ImGui::IsMouseDoubleClicked(0)) {
                    deck.pitch_percent = 0.0f;
                    deck.sync_active = false;
                }
                ImGui::SetTooltip("Tempo / Pitch: %+.2f%% (Arraste / Roda do mouse ajusta / 2-clique reseta)", deck.pitch_percent);
            }

            // Rasgo rebaixado do fader (slot interno)
            ImVec2 slot_min = ImVec2(track_cx - slot_w * 0.5f, track_top);
            ImVec2 slot_max = ImVec2(track_cx + slot_w * 0.5f, track_bot);
            dl->AddRectFilled(slot_min, slot_max, IM_COL32(5, 6, 9, 255), 3.0f);
            dl->AddRect(slot_min, slot_max, IM_COL32(24, 30, 42, 220), 3.0f, 0, 1.0f);
            // Trilho metálico brilhante no fundo do rasgo
            dl->AddLine(ImVec2(track_cx, track_top + 2.0f), ImVec2(track_cx, track_bot - 2.0f), IM_COL32(42, 52, 70, 255), 1.5f);

            // Linha e Marcação Central de 0.0% (Detent)
            float center_y = track_top + track_h * 0.5f;
            dl->AddLine(ImVec2(track_cx - 11.0f, center_y), ImVec2(track_cx + 11.0f, center_y), IM_COL32(200, 220, 245, 230), 1.5f);

            // Escala Graduada Pioneer (- no topo, + na base)
            float tick_left_x = track_cx - 13.0f;
            dl->AddText(f_bld, 10.0f, ImVec2(tick_left_x - 7.0f, track_top - 5.0f), IM_COL32(180, 195, 215, 230), "-");
            dl->AddText(f_bld, 10.0f, ImVec2(tick_left_x - 7.0f, track_bot - 7.0f), IM_COL32(180, 195, 215, 230), "+");
            dl->AddText(f_reg, 9.5f, ImVec2(tick_left_x - 8.0f, center_y - 5.0f), IM_COL32(160, 175, 195, 220), "0");

            int num_steps = 10;
            for (int i = 0; i <= num_steps; i++) {
                float ty = track_top + (float)i / (float)num_steps * track_h;
                bool is_mid = (i == num_steps / 2);
                float tw = is_mid ? 8.0f : ((i % 2 == 0) ? 5.5f : 3.0f);
                ImU32 tcol = is_mid ? IM_COL32(200, 215, 235, 220) : IM_COL32(75, 90, 115, 180);
                dl->AddLine(ImVec2(track_cx - 6.0f - tw, ty), ImVec2(track_cx - 6.0f, ty), tcol, 1.0f);
            }

            // LED Indicador Central 0% Pioneer (Luz Verde que acende exatamente no 0.00% com soft glow)
            float led_x = track_cx + std::clamp(size.x * 0.35f, 22.0f, 32.0f);
            if (is_center_zero) {
                dl->AddCircleFilled(ImVec2(led_x, center_y), 7.0f, IM_COL32(0, 255, 120, 60), 16);
                dl->AddCircleFilled(ImVec2(led_x, center_y), 4.0f, IM_COL32(0, 255, 120, 255), 16);
                dl->AddCircleFilled(ImVec2(led_x, center_y), 1.8f, IM_COL32(230, 255, 240, 255), 16);
            } else {
                dl->AddCircleFilled(ImVec2(led_x, center_y), 2.5f, IM_COL32(14, 38, 22, 255), 16);
                dl->AddCircle(ImVec2(led_x, center_y), 2.5f, IM_COL32(28, 65, 38, 255), 16, 1.0f);
            }

            // 4. Handle (Knob do Fader Metálico Pioneer CDJ Harmonizado com a UI)
            float norm = (deck.pitch_percent - (-deck.pitch_range)) / (deck.pitch_range * 2.0f);
            norm = std::clamp(norm, 0.0f, 1.0f);
            float knob_cy = track_top + norm * track_h;

            float knob_w = std::clamp(size.x * 0.40f, 28.0f, 32.0f);
            float knob_h = 16.0f;
            ImVec2 k_min = ImVec2(track_cx - knob_w * 0.5f, knob_cy - knob_h * 0.5f);
            ImVec2 k_max = ImVec2(track_cx + knob_w * 0.5f, knob_cy + knob_h * 0.5f);

            // Sombra 3D projetada do knob
            dl->AddRectFilled(ImVec2(k_min.x + 1.0f, k_min.y + 2.0f), ImVec2(k_max.x + 1.5f, k_max.y + 3.0f), IM_COL32(0, 0, 0, 160), 2.5f);
            // Corpo metálico chanfrado obsidian
            dl->AddRectFilled(k_min, k_max, IM_COL32(36, 42, 54, 255), 2.5f);
            // Chanfro e reflexo de luz superior
            dl->AddRectFilled(k_min, ImVec2(k_max.x, knob_cy), IM_COL32(56, 66, 84, 255), 2.5f, ImDrawFlags_RoundCornersTop);
            // Sombra inferior do chanfro
            dl->AddRectFilled(ImVec2(k_min.x, knob_cy), k_max, IM_COL32(24, 28, 38, 255), 2.5f, ImDrawFlags_RoundCornersBottom);
            // Borda chanfrada superior metálica
            dl->AddLine(ImVec2(k_min.x + 1.5f, k_min.y + 1.0f), ImVec2(k_max.x - 1.5f, k_min.y + 1.0f), IM_COL32(110, 130, 160, 220), 1.0f);
            // Ranhuras táteis de pegada lateral (Pioneer P-LOCK grips - 2 frisos)
            for (int g = 0; g < 2; g++) {
                float gx_l = k_min.x + 3.0f + g * 2.2f;
                float gx_r = k_max.x - 3.0f - g * 2.2f;
                dl->AddLine(ImVec2(gx_l, knob_cy - 4.5f), ImVec2(gx_l, knob_cy + 4.5f), IM_COL32(18, 22, 30, 200), 1.0f);
                dl->AddLine(ImVec2(gx_r, knob_cy - 4.5f), ImVec2(gx_r, knob_cy + 4.5f), IM_COL32(18, 22, 30, 200), 1.0f);
            }
            // Borda com realce cyan ao interagir ou passar o mouse
            ImU32 bd_col = fdr_active ? IM_COL32(0, 200, 255, 255) : (fdr_hovered ? IM_COL32(0, 160, 230, 220) : IM_COL32(75, 90, 115, 230));
            dl->AddRect(k_min, k_max, bd_col, 2.5f, 0, (fdr_active || fdr_hovered) ? 1.5f : 1.0f);
            // Marcador branco central de alta precisão (Pioneer White Index Bar)
            dl->AddRectFilled(ImVec2(k_min.x + 3.0f, knob_cy - 1.0f), ImVec2(k_max.x - 3.0f, knob_cy + 1.0f), IM_COL32(255, 255, 255, 255), 1.0f);
        }

