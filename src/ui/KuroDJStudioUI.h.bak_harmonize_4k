                ImVec2 sz = f_bld->CalcTextSizeA(11.0f, FLT_MAX, 0.0f, "CUE");
                ImVec2 txt_pos = ImVec2(draw_center.x - sz.x * 0.5f, draw_center.y - sz.y * 0.5f);
                dl->AddText(f_bld, 11.0f, txt_pos, ring_col, "CUE");
