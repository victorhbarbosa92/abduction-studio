                } else {
                    ImGui::Text("Clique em 'MAPEAR' ao lado do comando e mexa o controle físico:");
                }

                ImGui::Spacing();
                ImGui::BeginChild("##MidiActionList", ImVec2(0, 220), true);
                auto drawMidiRow = [&](const char* label, const char* act_id, KuroAudio::DJMidiBindingType type) {
                    ImGui::Text("%s", label);
                    ImGui::SameLine(260);
                    char btn_id[64]; snprintf(btn_id, sizeof(btn_id), "MAPEAR##%s", act_id);
                    if (ImGui::SmallButton(btn_id)) {
                        midi.startLearn(act_id, type);
                    }
                    ImGui::Separator();
                };

                drawMidiRow("Deck 1: Play / Pause", "deck0_play", KuroAudio::DJMidiBindingType::NOTE_TOGGLE);
                drawMidiRow("Deck 1: CUE Button", "deck0_cue", KuroAudio::DJMidiBindingType::NOTE_MOMENTARY);
                drawMidiRow("Deck 1: Volume Fader", "deck0_volume", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                drawMidiRow("Deck 1: EQ High", "deck0_eq_high", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                drawMidiRow("Deck 1: EQ Mid", "deck0_eq_mid", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);
                drawMidiRow("Deck 1: EQ Low", "deck0_eq_low", KuroAudio::DJMidiBindingType::CC_ABSOLUTE);

