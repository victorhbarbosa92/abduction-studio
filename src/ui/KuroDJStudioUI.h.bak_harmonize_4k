                    if (ImGui::IsKeyPressed(ImGuiKey_LeftArrow, true)) {
                        auto& d = engine.decks[active_l];
                        KuroAudio::DJGridEngine::getInstance().nudgeGrid(active_l, -ms, d.sample_rate);
                        d.first_beat_frame = KuroAudio::DJGridEngine::getInstance().getGridData(active_l).first_beat_frame;
                    }
                    if (ImGui::IsKeyPressed(ImGuiKey_RightArrow, true)) {
                        auto& d = engine.decks[active_l];
                        KuroAudio::DJGridEngine::getInstance().nudgeGrid(active_l, ms, d.sample_rate);
                        d.first_beat_frame = KuroAudio::DJGridEngine::getInstance().getGridData(active_l).first_beat_frame;
                    }
