        void renderMidiLearnModal(KuroAudio::DJEngine& engine) {
            if (!show_midi_learn_modal) return;
            ImGui::SetNextWindowSize(ImVec2(560, 400), ImGuiCond_FirstUseEver);
            if (ImGui::Begin("CENTRAL MIDI LEARN UNIVERSAL##Modal", &show_midi_learn_modal, ImGuiWindowFlags_NoCollapse)) {
                auto& midi = KuroAudio::DJMidiLearnEngine::getInstance();
                ImGui::TextColored(ImVec4(0.0f, 0.96f, 0.83f, 1.0f), ICON_FA_SLIDERS " MAPEAMENTO DE CONTROLADORAS MIDI");
                ImGui::TextDisabled("Pioneer DDJ-FLX4, DDJ-400, DDJ-SB3, Traktor Kontrol e genericas.");
                ImGui::Separator();

                if (midi.isLearning()) {
                    float pulse = (std::sin((float)ImGui::GetTime() * 10.0f) + 1.0f) * 0.5f;
                    ImGui::TextColored(ImVec4(1.0f, 0.3f + pulse * 0.7f, 0.0f, 1.0f), 
