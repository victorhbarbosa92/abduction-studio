                                  IM_COL32(8, 16, 12, 230), 4.0f);
                dl->AddRect      (ImVec2(fps_x - 5.0f, pos.y + 3.0f),
                                  ImVec2(fps_x + fps_sz.x + 8.0f, pos.y + row1_h - 3.0f),
                                  fps_col, 4.0f, 0, 1.0f);
                dl->AddText(ImVec2(fps_x, pos.y + 5.0f), fps_col, fps_buf);
            }

            // ── ROW 2: Phase Meter & Contador de 4 Períodos de 4 Batidas (Padrão Rekordbox / CDJ-3000) ──
            float r2_y  = pos.y + row1_h + 2.0f;
            float r2_h  = row2_h - 4.0f;
            float cx    = pos.x + w * 0.5f;

            int left_id  = ddj_hardware.getActiveLeftDeck();
            int right_id = ddj_hardware.getActiveRightDeck();
            KuroAudio::DJDeck& deck_l = engine.decks[left_id];
            KuroAudio::DJDeck& deck_r = engine.decks[right_id];

            int period_l = 1, beat_l = 1, tot_bar_l = 1; float prog_l = 0.0f;
            int period_r = 1, beat_r = 1, tot_bar_r = 1; float prog_r = 0.0f;
            deck_l.getBeatPhaseInfo(period_l, beat_l, prog_l, &tot_bar_l);
            deck_r.getBeatPhaseInfo(period_r, beat_r, prog_r, &tot_bar_r);

            ImVec4 th_l = (left_id  == 0 ? col_deck_1 : col_deck_3);
            ImVec4 th_r = (right_id == 1 ? col_deck_2 : col_deck_4);
            ImU32 col_l = ImGui::GetColorU32(th_l);
            ImU32 col_r = ImGui::GetColorU32(th_r);

            // Largura do centro (Agulha de Fase Zero)
            float center_zone_w = 110.0f;

            // === DECK ESQUERDO: Indicador do Período (1, 2, 3 ou 4) e 4 Blocos de 4 Batidas ===
            char lbl_l[36];
            snprintf(lbl_l, sizeof(lbl_l), "D%d  P%d • %d/4", left_id + 1, period_l, beat_l);
            dl->AddText(ImVec2(pos.x + 6.0f, r2_y + 1.0f), col_l, lbl_l);
            float lbl_l_w = ImGui::CalcTextSize(lbl_l).x + 8.0f;

            // 4 Períodos (Compassos 1, 2, 3, 4 da Frase), cada um com 4 batidas
            float lane_l_start = pos.x + lbl_l_w + 4.0f;
            float lane_l_end   = cx - center_zone_w * 0.5f - 4.0f;
            float lane_l_w     = std::max(60.0f, lane_l_end - lane_l_start);
            float period_gap   = 4.0f;
            float period_w     = (lane_l_w - 3.0f * period_gap) / 4.0f;

            for (int p = 0; p < 4; p++) {
                int p_num = p + 1; // Período 1, 2, 3, 4
                float px = lane_l_start + p * (period_w + period_gap);
                bool is_active_period = (deck_l.is_playing.load() && p_num == period_l);
                bool is_past_period   = (deck_l.is_playing.load() && p_num < period_l);

                // Fundo do Período
                ImU32 bg_col = is_active_period ? IM_COL32(10, 24, 38, 240) : (is_past_period ? IM_COL32(12, 18, 28, 200) : IM_COL32(8, 12, 18, 160));
                ImU32 border_col = is_active_period ? col_l : IM_COL32(25, 36, 50, 160);
                dl->AddRectFilled(ImVec2(px, r2_y), ImVec2(px + period_w, r2_y + r2_h), bg_col, 2.0f);
                dl->AddRect(ImVec2(px, r2_y), ImVec2(px + period_w, r2_y + r2_h), border_col, 2.0f, 0, 1.0f);

                // 4 Sub-Batidas dentro deste Período
                float beat_gap = 1.5f;
                float beat_w = (period_w - 3.0f * beat_gap - 4.0f) / 4.0f;
                for (int b = 0; b < 4; b++) {
                    int b_num = b + 1; // Batida 1, 2, 3, 4
                    float bx = px + 2.0f + b * (beat_w + beat_gap);
                    ImU32 beat_col = IM_COL32(20, 30, 44, 180);

                    if (is_past_period) {
                        beat_col = IM_COL32(0, 110, 150, 170); // Já tocado
                    } else if (is_active_period) {
                        if (b_num < beat_l) {
                            beat_col = IM_COL32(0, 140, 190, 210); // Batida anterior do período atual
                        } else if (b_num == beat_l) {
                            beat_col = (b_num == 1) ? IM_COL32(255, 45, 65, 255) : col_l; // Beat 1 vermelho ou cor do deck
                        }
                    }

                    dl->AddRectFilled(ImVec2(bx, r2_y + 2.0f), ImVec2(bx + beat_w, r2_y + r2_h - 2.0f), beat_col, 1.0f);
                }
            }

            // === CENTRO: ZERO-PHASE NEEDLE ===
            {
                float c_l = cx - center_zone_w * 0.5f;
                float c_r = cx + center_zone_w * 0.5f;
                dl->AddRectFilled(ImVec2(c_l, r2_y), ImVec2(c_r, r2_y + r2_h), IM_COL32(8, 12, 18, 255), 3.0f);
                dl->AddLine(ImVec2(cx, r2_y + 2.0f), ImVec2(cx, r2_y + r2_h - 2.0f), IM_COL32(60, 80, 100, 180), 1.0f);

                bool both = deck_l.is_playing.load() && deck_r.is_playing.load();
                if (both) {
                    float phase_diff = deck_r.sync_phase_diff;
                    bool in_ph = std::abs(phase_diff) < 0.04f;
                    float max_d = (center_zone_w * 0.5f) - 6.0f;
                    float nx = cx + std::clamp(phase_diff * 2.0f, -1.0f, 1.0f) * max_d;
                    ImU32 nc = in_ph ? IM_COL32(0, 255, 140, 255) : IM_COL32(255, 170, 0, 255);
                    dl->AddRectFilled(ImVec2(nx - 2.0f, r2_y + 2.0f), ImVec2(nx + 2.0f, r2_y + r2_h - 2.0f), nc, 1.5f);
                    const char* ph_lbl = in_ph ? "IN PHASE" : "PHASE";
                    ImVec2 psz = ImGui::CalcTextSize(ph_lbl);
                    dl->AddText(ImVec2(cx - psz.x * 0.5f, r2_y + 2.0f), nc, ph_lbl);
                } else {
                    const char* ph_lbl = "BEAT PHASE";
                    ImVec2 psz = ImGui::CalcTextSize(ph_lbl);
                    dl->AddText(ImVec2(cx - psz.x * 0.5f, r2_y + 2.0f), IM_COL32(90, 110, 135, 200), ph_lbl);
                }
            }

            // === DECK DIREITO: 4 Blocos de 4 Batidas e Indicador de Período ===
            char lbl_r[36];
            snprintf(lbl_r, sizeof(lbl_r), "P%d • %d/4  D%d", period_r, beat_r, right_id + 1);
            float lbl_r_w = ImGui::CalcTextSize(lbl_r).x + 8.0f;

            float lane_r_start = cx + center_zone_w * 0.5f + 4.0f;
            float lane_r_end   = pos.x + w - lbl_r_w - 4.0f;
            float lane_r_w     = std::max(60.0f, lane_r_end - lane_r_start);
            float period_r_w   = (lane_r_w - 3.0f * period_gap) / 4.0f;

            for (int p = 0; p < 4; p++) {
                int p_num = p + 1;
                float px = lane_r_start + p * (period_r_w + period_gap);
                bool is_active_period = (deck_r.is_playing.load() && p_num == period_r);
                bool is_past_period   = (deck_r.is_playing.load() && p_num < period_r);

                ImU32 bg_col = is_active_period ? IM_COL32(38, 20, 10, 240) : (is_past_period ? IM_COL32(28, 16, 10, 200) : IM_COL32(18, 12, 8, 160));
                ImU32 border_col = is_active_period ? col_r : IM_COL32(50, 32, 22, 160);
                dl->AddRectFilled(ImVec2(px, r2_y), ImVec2(px + period_r_w, r2_y + r2_h), bg_col, 2.0f);
                dl->AddRect(ImVec2(px, r2_y), ImVec2(px + period_r_w, r2_y + r2_h), border_col, 2.0f, 0, 1.0f);

                float beat_gap = 1.5f;
                float beat_w = (period_r_w - 3.0f * beat_gap - 4.0f) / 4.0f;
                for (int b = 0; b < 4; b++) {
                    int b_num = b + 1;
                    float bx = px + 2.0f + b * (beat_w + beat_gap);
                    ImU32 beat_col = IM_COL32(40, 26, 18, 180);

                    if (is_past_period) {
                        beat_col = IM_COL32(160, 80, 0, 170);
                    } else if (is_active_period) {
                        if (b_num < beat_r) {
                            beat_col = IM_COL32(200, 100, 0, 210);
                        } else if (b_num == beat_r) {
                            beat_col = (b_num == 1) ? IM_COL32(255, 45, 65, 255) : col_r;
                        }
                    }

                    dl->AddRectFilled(ImVec2(bx, r2_y + 2.0f), ImVec2(bx + beat_w, r2_y + r2_h - 2.0f), beat_col, 1.0f);
                }
            }
            dl->AddText(ImVec2(pos.x + w - lbl_r_w, r2_y + 1.0f), col_r, lbl_r);

            // Finaliza: avança cursor para após a toolbar
            ImGui::SetCursorScreenPos(ImVec2(pos.x, pos.y + bar_h));
            ImGui::Dummy(ImVec2(w, 2.0f));
        }

        // Waveforms Duplas Horizontais Empilhadas no Topo (Estilo Rekordbox 3-Band com Beatgrid e Modulação FX)
        // Waveforms Duplas Horizontais Empilhadas no Topo (Sincronizadas com os Hertz da Tela, Sem Tremor e Anti-Aliased)
        // Waveforms Duplas Horizontais Empilhadas no Topo (Sincronizadas com os Hertz da Tela, Sem Tremor e Anti-Aliased)
                        void renderStackedRekordboxWaveforms(KuroAudio::DJEngine& engine, float w, float h) {
            ImDrawList* dl = ImGui::GetWindowDrawList();
            ImVec2 pos = ImGui::GetCursorScreenPos();

            float lane_gap = 2.0f; // Divisor Rekordbox
            float min_lane = KuroUI::UIScaleManager::Scale(78.0f);
            float lane_h   = std::max(min_lane, (h - lane_gap) * 0.5f);
            float total_stack_h = lane_h * 2.0f + lane_gap;

            // Botoes de Controle / Zoom Verticais na lateral esquerda (^, v, +, RST, -, 1L/2L)
            float ctrl_w = 26.0f;
            float wave_x = pos.x + ctrl_w;
            float wave_w = w - ctrl_w;
            float center_x = wave_x + wave_w * 0.5f;
            const char* hot_cue_letters[8] = { "A", "B", "C", "D", "E", "F", "G", "H" };

            dl->AddRectFilled(pos, ImVec2(pos.x + ctrl_w, pos.y + total_stack_h), IM_COL32(12, 15, 20, 255));
            dl->AddLine(ImVec2(pos.x + ctrl_w, pos.y), ImVec2(pos.x + ctrl_w, pos.y + total_stack_h), IM_COL32(24, 30, 42, 255), 1.0f);

            auto zoomSideBtn = [&](const char* id, const char* lbl, float y_off, auto on_click) {
                ImVec2 bp = ImVec2(pos.x + 2.0f, pos.y + y_off);
                dl->AddRectFilled(bp, ImVec2(bp.x + 22.0f, bp.y + 16.0f), IM_COL32(20, 25, 34, 255), 2.0f);
                dl->AddRect(bp, ImVec2(bp.x + 22.0f, bp.y + 16.0f), IM_COL32(38, 48, 65, 200), 2.0f, 0, 1.0f);
                ImVec2 sz = ImGui::CalcTextSize(lbl);
                dl->AddText(ImVec2(bp.x + (22.0f - sz.x) * 0.5f, bp.y + 1.0f), IM_COL32(190, 205, 225, 240), lbl);
                ImGui::SetCursorScreenPos(bp);
                if (ImGui::InvisibleButton(id, ImVec2(22.0f, 16.0f))) on_click();
            };

            zoomSideBtn("##WfSideUp", "^", 4.0f, [&]() {
                if (waveform_zoom_bars > 1) waveform_zoom_bars /= 2;
            });
            zoomSideBtn("##WfSidePlus", "+", 24.0f, [&]() {
                wf_height_user_adjusted = true;
                waveform_height = std::clamp(waveform_height + 24.0f, 130.0f, 380.0f);
            });
            zoomSideBtn("##WfSideRst", "RST", 44.0f, [&]() {
                waveform_zoom_bars = 2;
                wf_height_user_adjusted = false;
                waveform_height = 200.0f;
            });
            zoomSideBtn("##WfSideMinus", "-", 64.0f, [&]() {
                wf_height_user_adjusted = true;
                waveform_height = std::clamp(waveform_height - 24.0f, 130.0f, 380.0f);
            });
            zoomSideBtn("##WfSideDn", "v", 84.0f, [&]() {
                if (waveform_zoom_bars < 64) waveform_zoom_bars *= 2;
            });
            // Alternador de Modo: 2L (Pistas Empilhadas Rekordbox) vs 1L (Pista Unica Sobreposta)
            zoomSideBtn("##WfSideMode", waveform_view_mode == 1 ? "2L" : "1L", 106.0f, [&]() {
                waveform_view_mode = (waveform_view_mode == 1 ? 0 : 1);
            });
            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Alternar visualizacao: 2L = Pistas Empilhadas Independentes | 1L = Pista Unica Sobreposta");

            // Alternador de Paleta Rekordbox (RGB / 3B / BLU / NEO / SUN)
            const char* clr_short[] = { "RGB", "3B", "BLU", "NEO", "SUN" };
            zoomSideBtn("##WfSideColor", clr_short[std::clamp(waveform_color_mode, 0, 4)], 128.0f, [&]() {
                waveform_color_mode = (waveform_color_mode + 1) % 5;
                for(auto& c: wf_cache) c.invalidate();
            });
            if (ImGui::IsItemHovered()) {
                const char* mode_descs[] = {
                    "RGB (Rekordbox & Traktor Oficial: Rosa Graves, Ciano Medios, Verde Agudos)",
                    "3-BAND (CDJ-3000 / Rekordbox 7 Oficial: Graves Azul, Medios Ambar, Agudos Branco)",
                    "BLUE (CDJ-2000 Classico Rekordbox Azul Monocromatico)",
                    "NEON (Cyberpunk)",
                    "SUNSET (Festival Solar)"
                };
                ImGui::SetTooltip("Paleta Rekordbox: %s\nClique para alternar", mode_descs[std::clamp(waveform_color_mode, 0, 4)]);
            }

            int active_l_id = ddj_hardware.getActiveLeftDeck();
            int active_r_id = ddj_hardware.getActiveRightDeck();
            KuroAudio::DJDeck& deck1 = engine.decks[active_l_id];
            KuroAudio::DJDeck& deck2 = engine.decks[active_r_id];

            float dt = ImGui::GetIO().DeltaTime;
            if (dt <= 0.0001f || dt > 0.1f) dt = 1.0f / 60.0f;

            // Sincronizacao de Hertz para ambos os Decks
            DeckVisualHertzSync& vs1 = vis_sync[deck1.deck_id];
            if (!vs1.active) { vs1.smooth_frame = deck1.current_frame; vs1.active = true; }
            if (deck1.is_playing.load() && !deck1.jog_touch) {
                double eff_speed1 = (1.0 + deck1.pitch_percent * 0.01);
                vs1.smooth_frame += eff_speed1 * deck1.sample_rate * (double)dt;
                double diff1 = deck1.current_frame - vs1.smooth_frame;
                if (std::abs(diff1) > (deck1.sample_rate * 0.20)) vs1.smooth_frame = deck1.current_frame;
                else vs1.smooth_frame += diff1 * std::clamp((double)dt * 14.0, 0.02, 0.35);
            } else {
                vs1.smooth_frame = deck1.current_frame;
            }

            DeckVisualHertzSync& vs2 = vis_sync[deck2.deck_id];
            if (!vs2.active) { vs2.smooth_frame = deck2.current_frame; vs2.active = true; }
            if (deck2.is_playing.load() && !deck2.jog_touch) {
                double eff_speed2 = (1.0 + deck2.pitch_percent * 0.01);
                vs2.smooth_frame += eff_speed2 * deck2.sample_rate * (double)dt;
                double diff2 = deck2.current_frame - vs2.smooth_frame;
                if (std::abs(diff2) > (deck2.sample_rate * 0.20)) vs2.smooth_frame = deck2.current_frame;
                else vs2.smooth_frame += diff2 * std::clamp((double)dt * 14.0, 0.02, 0.35);
            } else {
                vs2.smooth_frame = deck2.current_frame;
            }

            // =========================================================================================
            // MOTOR DE RENDERIZAÇÃO DE WAVEFORM REKORDBOX / TRAKTOR (MALHA VETORIAL CONTÍNUA)
            // =========================================================================================
            auto getWaveColors = [](int color_mode, ImU32& col_low, ImU32& col_mid, ImU32& col_high, ImU32& col_core) {
                if (color_mode == 0) {
                    // RGB OFICIAL REKORDBOX / TRAKTOR (Rosa Graves, Ciano Médios, Verde Agudos)
                    col_low  = IM_COL32(255,   0, 128, 255);
                    col_mid  = IM_COL32(  0, 229, 255, 255);
                    col_high = IM_COL32( 57, 255,  20, 255);
                    col_core = IM_COL32(235, 255, 235, 255);
                } else if (color_mode == 1) {
                    // 3-BAND OFICIAL REKORDBOX (CDJ-3000: Azul Royal Graves, Âmbar Médios, Branco Agudos)
                    col_low  = IM_COL32(  0, 115, 255, 255);
                    col_mid  = IM_COL32(255, 144,   0, 255);
                    col_high = IM_COL32(255, 255, 255, 255);
                    col_core = IM_COL32(255, 255, 255, 255);
                } else if (color_mode == 2) {
                    // BLUE CLÁSSICO (CDJ-2000: Azul Marinho/Elétrico, Azul Céu, Branco Gelo)
                    col_low  = IM_COL32( 12,  65, 225, 255);
                    col_mid  = IM_COL32(  0, 195, 255, 255);
                    col_high = IM_COL32(240, 250, 255, 255);
                    col_core = IM_COL32(255, 255, 255, 255);
                } else if (color_mode == 3) {
                    // NEON (Cyberpunk)
                    col_low  = IM_COL32(255,   0,  90, 255);
                    col_mid  = IM_COL32(  0, 245, 220, 255);
                    col_high = IM_COL32(255, 245,   0, 255);
                    col_core = IM_COL32(255, 255, 220, 255);
                } else {
                    // SUNSET (Festival Dusk)
                    col_low  = IM_COL32(115,  20, 140, 255);
                    col_mid  = IM_COL32(255,  85,   0, 255);
                    col_high = IM_COL32(255, 215,   0, 255);
                    col_core = IM_COL32(255, 255, 220, 255);
                }
            };

            struct WaveMeshPoint {
                float x = 0.0f;
                float h_total = 0.0f; // Amplitude dinâmica real (picos sem achatamento/sausage)
                float h_low   = 0.0f; // Altura concêntrica Graves (3-Band)
                float h_mid   = 0.0f; // Altura concêntrica Médios (3-Band)
                float h_high  = 0.0f; // Altura concêntrica Agudos (3-Band)
                float low     = 0.0f; // Energia espectral Graves [0..1]
                float mid     = 0.0f; // Energia espectral Médios [0..1]
                float high    = 0.0f; // Energia espectral Agudos [0..1]
                float osc_val = 0.0f; // [-1.0 .. +1.0] Amostra de osciloscópio instantânea
                float cycle_min = 0.0f; // Min no intervalo de frames [-1.0 .. 0.0]
                float cycle_max = 0.0f; // Max no intervalo de frames [0.0 .. +1.0]
                bool is_tail   = true; // Se é cauda de osciloscópio / silêncio / intro
                bool active    = false;
            };

            // =========================================================================
            // LINHA DE OSCILOSCÓPIO CONTÍNUA DE ALTA RESOLUÇÃO (REKORDBOX SIGNATURE)
            // Desenha o traço contínuo de 1px de osciloscópio em quebras, intros e silêncio
            // =========================================================================
            auto drawOscilloscopeTrace = [&](const std::vector<WaveMeshPoint>& pts,
                                             float seg_mid_y, float max_half_h,
                                             int color_mode, int deck_id, int side) {
                if (pts.size() < 2) return;

                // Cor do traço de osciloscópio por modo e deck
                ImU32 col_trace;
                if (color_mode == 0) {
                    // RGB Rekordbox: Deck 1 = Ciano Elétrico Brilhante (#00E5FF), Deck 2 = Ouro/Laranja (#FF9900)
                    col_trace = (deck_id == 0) ? IM_COL32(0, 229, 255, 235) : IM_COL32(255, 170, 0, 235);
                } else if (color_mode == 1) {
                    // 3-Band: Branco Diamante Fosfórico
                    col_trace = IM_COL32(230, 245, 255, 240);
                } else {
                    // Classic Blue
                    col_trace = IM_COL32(0, 215, 255, 235);
                }

                int sz = (int)pts.size();
                for (int i = 0; i < sz - 1; i++) {
                    const auto& p1 = pts[i];
                    const auto& p2 = pts[i + 1];

                    if (!p1.active && !p2.active) continue;

                    // Na cauda ou no áudio, calculamos a posição Y do osciloscópio
                    float y1 = seg_mid_y - p1.osc_val * (max_half_h * 0.20f);
                    float y2 = seg_mid_y - p2.osc_val * (max_half_h * 0.20f);

                    if (side == 1) {
                        y1 = std::min(y1, seg_mid_y);
                        y2 = std::min(y2, seg_mid_y);
                    } else if (side == -1) {
                        y1 = std::max(y1, seg_mid_y);
                        y2 = std::max(y2, seg_mid_y);
                    }

                    // Se for cauda ou ponto de transição, desenha linha de osciloscópio contínua
                    if (p1.is_tail || p2.is_tail) {
                        dl->AddLine(ImVec2(p1.x, y1), ImVec2(p2.x, y2), col_trace, 1.2f);
                    }
                }
            };
            auto drawRekordboxContinuousMesh = [&](ImDrawList* dl,
                                                   const std::vector<WaveMeshPoint>& pts,
                                                   float seg_mid_y,
                                                   float max_half_h,
                                                   int color_mode,
                                                   int side /* 0 = simétrico completo, 1 = metade superior, -1 = metade inferior */) {
                int sz = (int)pts.size();
                if (sz < 2) return;

                for (int i = 0; i < sz; i++) {
                    const auto& p = pts[i];
                    if (!p.active || p.is_tail) continue;

                    // Cada estria vertical Rekordbox oficial é contínua e adjacente (passo 1.0px)
                    float cur_x = p.x;
                    float x1 = cur_x;
                    float x2 = cur_x + 1.0f;

                    // 1. Cálculo da Altura e Limites da Onda (Escala de Expansão Perceptual Pioneer)
                    float dyn_h = std::clamp(p.h_total, 1.2f, max_half_h);
                    float y_top, y_bot;

                    if (side == 0) {
                        // Modo simétrico / estriação completa de áudio real (2L)
                        float top_amp = dyn_h * std::clamp(p.cycle_max, 0.35f, 1.25f);
                        float bot_amp = dyn_h * std::clamp(-p.cycle_min, 0.35f, 1.25f);
                        y_top = seg_mid_y - top_amp;
                        y_bot = seg_mid_y + bot_amp;
                    } else if (side == 1) { // Hemisfério Superior (1L Deck A)
                        float top_amp = dyn_h * std::clamp(p.cycle_max, 0.35f, 1.25f);
                        y_top = seg_mid_y - top_amp;
                        y_bot = seg_mid_y;
                    } else { // Hemisfério Inferior (1L Deck B)
                        float bot_amp = dyn_h * std::clamp(-p.cycle_min, 0.35f, 1.25f);
                        y_top = seg_mid_y;
                        y_bot = seg_mid_y + bot_amp;
                    }

                    if (y_bot - y_top < 2.0f) {
                        y_top = seg_mid_y - 1.0f;
                        y_bot = seg_mid_y + 1.0f;
                    }

                    // 2. Cores Espectrais Oficiais Pioneer Rekordbox & WeDJ (Algoritmo z2.m.q)
                    ImU32 col_outer = 0;
                    ImU32 col_core = 0;

                    if (color_mode == 1) {
                        // MODO 1: REKORDBOX 3-BAND OFICIAL (PIONEER CDJ-3000)
                        float l = p.low;
                        float m = p.mid;
                        float h = p.high;
                        if (l >= m * 0.92f && l >= h * 0.92f) {
                            col_outer = IM_COL32(  0,  60, 180, 255); // Dark Royal Blue
                            col_core  = IM_COL32( 30, 150, 255, 255); // Bright Blue
                        } else if (m >= h * 0.88f) {
                            col_outer = IM_COL32(180,  90,   0, 255); // Dark Amber
                            col_core  = IM_COL32(255, 175,  30, 255); // Bright Amber
                        } else {
                            col_outer = IM_COL32(170, 210, 240, 255); // Diamond Blue-White
                            col_core  = IM_COL32(245, 250, 255, 255);
                        }
                    } else if (color_mode == 2) {
                        // MODO 2: BLUE CLÁSSICO (CDJ-2000 Nexus)
                        float l_d = std::clamp(p.low  * 1.6f, 0.0f, 1.0f);
                        float m_d = std::clamp(p.mid  * 1.5f, 0.0f, 1.0f);
                        float h_d = std::clamp(p.high * 2.0f, 0.0f, 1.0f);
                        int r = (int)(15 * l_d + 175 * h_d);
                        int g = (int)(70 * l_d + 195 * m_d + 225 * h_d);
                        int b = (int)(230 * l_d + 255 * m_d + 255 * h_d);
                        col_outer = IM_COL32((int)(r * 0.5f), (int)(g * 0.5f), (int)(b * 0.5f), 255);
                        col_core  = IM_COL32(r, g, b, 255);
                    } else {
                        // MODO 0: REKORDBOX & WEDJ RGB OFICIAL (BYTECODE DESCOMPILADO PIONEER Lz2/m.q)
                        float l = std::clamp(p.low,  0.0f, 1.0f);
                        float m = std::clamp(p.mid,  0.0f, 1.0f);
                        float h = std::clamp(p.high, 0.0f, 1.0f);

                        float v1 = std::max({ l, m, h, 0.0001f });
                        float v0 = l / v1; // r_norm
                        float v2 = m / v1; // g_norm
                        float v3 = h / v1; // b_norm

                        float max_rb = std::max(v0, v3);
                        float damp = std::min(max_rb, 0.5f) * 0.3f;
                        float g_val = (1.0f - damp) * v2;
                        float b_val = v3 * 1.3f;

                        int ir = (int)(std::clamp(v0,    0.0f, 1.0f) * 255.0f);
                        int ig = (int)(std::clamp(g_val, 0.0f, 1.0f) * 255.0f);
                        int ib = (int)(std::clamp(b_val, 0.0f, 1.0f) * 255.0f);

                        // Miolo Incandescente Sólido (Core Color)
                        col_core = IM_COL32(ir, ig, ib, 255);

                        // Pontas externas (Gouraud Falloff proporcional suave Pioneer)
                        int out_r = (int)(ir * 0.65f);
                        int out_g = (int)(ig * 0.60f);
                        int out_b = (int)(ib * 0.65f);
                        col_outer = IM_COL32(out_r, out_g, out_b, 255);
                    }

                    // 3. Renderização Nativa GPU por Vértices (Pioneer Pass 1: Envelope externo contíguo)
                    if (side == 0) {
                        dl->AddRectFilledMultiColor(ImVec2(x1, y_top), ImVec2(x2, seg_mid_y),
                                                   col_outer, col_outer, col_core, col_core);
                        dl->AddRectFilledMultiColor(ImVec2(x1, seg_mid_y), ImVec2(x2, y_bot),
                                                   col_core, col_core, col_outer, col_outer);
                    } else if (side == 1) {
                        dl->AddRectFilledMultiColor(ImVec2(x1, y_top), ImVec2(x2, seg_mid_y),
                                                   col_outer, col_outer, col_core, col_core);
                    } else {
                        dl->AddRectFilledMultiColor(ImVec2(x1, seg_mid_y), ImVec2(x2, y_bot),
                                                   col_core, col_core, col_outer, col_outer);
                    }

                    // 4. Miolo Interno Incandescente Denso (Pioneer Pass 2: div-int/lit8 2 - miolo a 50% de amplitude)
                    float core_top = seg_mid_y - (seg_mid_y - y_top) * 0.5f;
                    float core_bot = seg_mid_y + (y_bot - seg_mid_y) * 0.5f;
                    if (side == 0) {
                        dl->AddRectFilled(ImVec2(x1, core_top), ImVec2(x2, core_bot), col_core);
                    } else if (side == 1) {
                        dl->AddRectFilled(ImVec2(x1, core_top), ImVec2(x2, seg_mid_y), col_core);
                    } else {
                        dl->AddRectFilled(ImVec2(x1, seg_mid_y), ImVec2(x2, core_bot), col_core);
                    }
                }
            };

            auto sampleDeckWaveform = [](const KuroAudio::DJDeck& deck,
                                         double start_f, double window_f,
                                         float wave_x, float wave_w, float bar_step,
                                         float max_half_h,
                                         std::vector<WaveMeshPoint>& out_pts) {
                int num_pts = std::max(2, (int)(wave_w / bar_step));
                out_pts.resize(num_pts);

                size_t det_sz = deck.detailed_waveform.size();
                size_t tot_f  = deck.buffer_l.size();
                double frames_per_pt = window_f / (double)num_pts;

                // Curva de expansão perceptual Rekordbox (-48 dB piso com expansão de potência nos vales)
                auto to_pioneer_db = [](float linear_v) -> float {
                    if (linear_v <= 1e-4f) return 0.0f;
                    float db = 20.0f * std::log10(linear_v);
                    if (db < -48.0f) return 0.0f;
                    float norm = (db + 48.0f) / 48.0f;
                    return std::pow(norm, 1.25f);
                };

                for (int i = 0; i < num_pts; i++) {
                    float cur_x = wave_x + (float)i * bar_step;
                    out_pts[i].x = cur_x;
                    out_pts[i].h_total   = 0.0f;
                    out_pts[i].h_low     = 0.0f;
                    out_pts[i].h_mid     = 0.0f;
                    out_pts[i].h_high    = 0.0f;
                    out_pts[i].low       = 0.0f;
                    out_pts[i].mid       = 0.0f;
                    out_pts[i].high      = 0.0f;
                    out_pts[i].osc_val   = 0.0f;
                    out_pts[i].cycle_min = -1.0f;
                    out_pts[i].cycle_max = 1.0f;
                    out_pts[i].is_tail   = true;
                    out_pts[i].active    = true;

                    double f_start = start_f + (double)i * frames_per_pt;
                    double f_end   = f_start + frames_per_pt;

                    if (f_end < 0.0 || f_start >= (double)tot_f || tot_f == 0 || det_sz == 0) {
                        continue;
                    }

                    double center_f = (f_start + f_end) * 0.5;

                    // Amostra real do sinal de áudio PCM (picos positivo e negativo reais da faixa)
                    size_t s_start = (size_t)std::clamp(f_start, 0.0, (double)(tot_f - 1));
                    size_t s_end   = (size_t)std::clamp(f_end, 0.0, (double)(tot_f - 1));
                    float real_pos = 0.0f;
                    float real_neg = 0.0f;
                    size_t stride = std::max(size_t(1), (s_end - s_start) / 16);
                    for (size_t s = s_start; s <= s_end; s += stride) {
                        float v = deck.buffer_l[s];
                        if (v > real_pos) real_pos = v;
                        if (v < real_neg) real_neg = v;
                    }

                    size_t s_idx = (size_t)std::clamp(center_f, 0.0, (double)(tot_f - 1));
                    out_pts[i].osc_val = deck.buffer_l[s_idx];

                    // Interpolação suave contínua de envelope filtrado (elimina flickering)
                    double bin_pos = center_f / (double)KuroAudio::DJDeck::DETAILED_WAVE_STEP;
                    size_t b0 = (size_t)std::clamp(std::floor(bin_pos), 0.0, (double)(det_sz - 1));
                    size_t b1 = std::min(b0 + 1, det_sz - 1);
                    float frac = (float)(bin_pos - (double)b0);

                    const auto& pt0 = deck.detailed_waveform[b0];
                    const auto& pt1 = deck.detailed_waveform[b1];
                    float cur_l = (1.0f - frac) * pt0.low  + frac * pt1.low;
                    float cur_m = (1.0f - frac) * pt0.mid  + frac * pt1.mid;
                    float cur_h = (1.0f - frac) * pt0.high + frac * pt1.high;
                    float cur_p = (1.0f - frac) * pt0.peak + frac * pt1.peak;

                    // Silêncio / cauda
                    if (cur_p <= 0.012f && cur_l <= 0.012f && cur_m <= 0.012f) {
                        out_pts[i].is_tail = true;
                    } else {
                        out_pts[i].is_tail = false;

                        float p_db = to_pioneer_db(cur_p);
                        float l_db = to_pioneer_db(cur_l);
                        float m_db = to_pioneer_db(cur_m);
                        float h_db = to_pioneer_db(cur_h);

                        float h_tot = p_db * max_half_h;
                        if (h_tot < 1.2f) h_tot = 1.2f;

                        // Modulação orgânica do áudio real (excursão física assimétrica do sinal analógico)
                        float pos_mod = (real_pos > 0.02f) ? std::clamp(real_pos * 1.35f, 0.40f, 1.25f) : 1.0f;
                        float neg_mod = (real_neg < -0.02f) ? std::clamp(-real_neg * 1.35f, 0.40f, 1.25f) : 1.0f;

                        out_pts[i].h_total   = h_tot;
                        out_pts[i].h_low     = l_db * max_half_h;
                        out_pts[i].h_mid     = m_db * (max_half_h * 0.85f);
                        out_pts[i].h_high    = h_db * (max_half_h * 0.72f);
                        out_pts[i].low       = cur_l;
                        out_pts[i].mid       = cur_m;
                        out_pts[i].high      = cur_h;
                        out_pts[i].cycle_max = pos_mod;
                        out_pts[i].cycle_min = -neg_mod;
                    }
                }
            };

            // =========================================================================================
            // MODO 0: MOTOR DE WAVEFORM EM PISTA ÚNICA SOBREPOSTA (SESSÕES 5, 6, 7)
            // =========================================================================================
            if (waveform_view_mode == 0) {
                float uni_lane_h = total_stack_h;
                ImVec2 uni_pos = ImVec2(wave_x, pos.y);
                float mid_y = uni_pos.y + uni_lane_h * 0.5f;
                float max_half_h = (uni_lane_h * 0.5f) * 0.78f; // Headroom Rekordbox 22% (Espaco livre para a regua)

                // Visor Rígido Rekordbox: nada da waveform (grades, badges, agulhas) pode vazar para a lateral de botões
                dl->PushClipRect(ImVec2(wave_x, pos.y), ImVec2(wave_x + wave_w, pos.y + total_stack_h), true);

                // 1. Fundo Preto Puro Obsidian Club Standard
                dl->AddRectFilled(uni_pos, ImVec2(uni_pos.x + wave_w, uni_pos.y + uni_lane_h), IM_COL32(0, 0, 0, 255));
                dl->AddRect(uni_pos, ImVec2(uni_pos.x + wave_w, uni_pos.y + uni_lane_h), IM_COL32(20, 26, 38, 255), 0.0f, 0, 1.0f);

                // Regua Superior Rekordbox Club Standard (Fundo sutil)
                dl->AddRectFilled(uni_pos, ImVec2(uni_pos.x + wave_w, uni_pos.y + 14.0f), IM_COL32(6, 9, 14, 180));
                dl->AddLine(ImVec2(uni_pos.x, uni_pos.y + 14.0f), ImVec2(uni_pos.x + wave_w, uni_pos.y + 14.0f), IM_COL32(28, 36, 48, 140), 1.0f);

                // Linha de centro neutra (1px ultrafina)
                dl->AddLine(ImVec2(uni_pos.x, mid_y), ImVec2(uni_pos.x + wave_w, mid_y), IM_COL32(28, 38, 52, 160), 1.0f);

                // Referencia de tempo compartilhada (baseada no BPM principal)
                double ref_bpm = (deck1.is_playing.load() && deck1.bpm > 20.0) ? deck1.bpm :
                                 ((deck2.is_playing.load() && deck2.bpm > 20.0) ? deck2.bpm :
                                 ((deck1.bpm > 20.0) ? deck1.bpm : 126.0));
                double seconds_per_bar = (60.0 / ref_bpm) * 4.0;
                double window_sec = (double)waveform_zoom_bars * seconds_per_bar;
                if (window_sec < 0.5) window_sec = 0.5;

                double window_f1 = window_sec * deck1.sample_rate;
                double start_f1  = vs1.smooth_frame - window_f1 * 0.5;
                double window_f2 = window_sec * deck2.sample_rate;
                double start_f2  = vs2.smooth_frame - window_f2 * 0.5;

                // --- 2. RENDERIZACAO DA WAVEFORM SOBREPOSTA ESPECTRAL (REKORDBOX / TRAKTOR) ---
                deck1.generateDetailedWaveformIfNeeded();
                deck2.generateDetailedWaveformIfNeeded();

                // Passo de estriação contínua oficial Rekordbox (1.0px por coluna contígua)
                float bar_step = 1.0f;
                static std::vector<WaveMeshPoint> pts1, pts2;
                sampleDeckWaveform(deck1, start_f1, window_f1, uni_pos.x, wave_w, bar_step, max_half_h, pts1);
                sampleDeckWaveform(deck2, start_f2, window_f2, uni_pos.x, wave_w, bar_step, max_half_h, pts2);

                // Renderização Vetorial Contínua Rekordbox (Ribbon Strip Mesh sem degraus)
                bool d1_has_audio = !deck1.buffer_l.empty();
                bool d2_has_audio = !deck2.buffer_l.empty();

                if (d1_has_audio && !d2_has_audio) {
                    drawRekordboxContinuousMesh(dl, pts1, mid_y, max_half_h, waveform_color_mode, 0);
                } else if (d2_has_audio && !d1_has_audio) {
                    drawRekordboxContinuousMesh(dl, pts2, mid_y, max_half_h, waveform_color_mode, 0);
                } else if (d1_has_audio && d2_has_audio) {
                    drawRekordboxContinuousMesh(dl, pts1, mid_y, max_half_h, waveform_color_mode, 1);
                    drawRekordboxContinuousMesh(dl, pts2, mid_y, max_half_h, waveform_color_mode, -1);
                }
                // Linha central divisória de zero-crossing 1px
                dl->AddLine(ImVec2(uni_pos.x, mid_y), ImVec2(uni_pos.x + wave_w, mid_y), IM_COL32(255, 255, 255, 180), 1.0f);

                // Traço Contínuo de Osciloscópio Rekordbox (Zero-Crossing / Cauda de Silêncio 1px)
                bool d1_has_track = !deck1.buffer_l.empty();
                bool d2_has_track = !deck2.buffer_l.empty();
                if (d1_has_track && !d2_has_track) {
                    drawOscilloscopeTrace(pts1, mid_y, max_half_h, waveform_color_mode, 0, 0);
                } else if (d2_has_track && !d1_has_track) {
                    drawOscilloscopeTrace(pts2, mid_y, max_half_h, waveform_color_mode, 1, 0);
                } else if (d1_has_track && d2_has_track) {
                    drawOscilloscopeTrace(pts1, mid_y, max_half_h, waveform_color_mode, 0, 1);
                    drawOscilloscopeTrace(pts2, mid_y, max_half_h, waveform_color_mode, 1, -1);
                }

                // --- 3. GRADE MESTRE & REGUA REKORDBOX EM PRIMEIRO PLANO (FOREGROUND) ---
                // Renderizado APOS a waveform para que numeros, badges e pontos fiquem 100% visiveis
                ImFont* f_rb = g_font_micro_tag ? g_font_micro_tag : (g_font_rekordbox_small ? g_font_rekordbox_small : ImGui::GetFont());
                float f_sz = 10.0f;

                // Grade Primaria Deck 1 (Master):
                if (deck1.has_rekordbox_grid && !deck1.rekordbox_beats.empty() && !deck1.buffer_l.empty()) {
                    auto it_start = std::lower_bound(deck1.rekordbox_beats.begin(), deck1.rekordbox_beats.end(), (int64_t)start_f1,
                        [](const KuroAudio::RekordboxBeat& b, int64_t val) { return b.frame < val; });
                    if (it_start != deck1.rekordbox_beats.begin()) --it_start;

                    for (auto it = it_start; it != deck1.rekordbox_beats.end() && it->frame <= (int64_t)(start_f1 + window_f1 + 100); ++it) {
                        double beat_f = (double)it->frame;
                        float bx = std::round(uni_pos.x + (float)((beat_f - start_f1) / window_f1) * wave_w);
                        if (bx >= uni_pos.x && bx <= uni_pos.x + wave_w) {
                            int beat_in_bar = it->bar_beat - 1; // 1 -> 0 (Downbeat), 2,3,4 -> 1,2,3
                            size_t b_idx = std::distance(deck1.rekordbox_beats.begin(), it);
                            int bar_num = (int)(b_idx / 4) + 1;

                            if (beat_in_bar == 0) {
                                // Downbeat 1.1: Linha Vermelha Sólida Rekordbox através de toda a pista
                                dl->AddLine(ImVec2(bx, uni_pos.y), ImVec2(bx, uni_pos.y + uni_lane_h), IM_COL32(255, 35, 55, 245), 1.5f);
                                dl->AddTriangleFilled(ImVec2(bx - 4.5f, uni_pos.y), ImVec2(bx + 4.5f, uni_pos.y), ImVec2(bx, uni_pos.y + 6.5f), IM_COL32(255, 35, 55, 255));
                                dl->AddTriangleFilled(ImVec2(bx - 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx + 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx, uni_pos.y + uni_lane_h - 6.5f), IM_COL32(255, 35, 55, 255));

                                char b_tag[32];
                                snprintf(b_tag, sizeof(b_tag), "%d.1Bars", bar_num);
                                ImVec2 txt_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, b_tag);
                                float badge_w = txt_sz.x + 8.0f;
                                float badge_h = 13.0f;
                                float b_x0 = std::clamp(bx - badge_w * 0.5f, uni_pos.x + 2.0f, uni_pos.x + wave_w - badge_w - 2.0f);
                                ImVec2 b_min(b_x0, uni_pos.y + 1.0f);
                                ImVec2 b_max(b_x0 + badge_w, uni_pos.y + 1.0f + badge_h);
                                dl->AddRectFilled(b_min, b_max, IM_COL32(10, 16, 26, 245), 3.0f);
                                dl->AddRect(b_min, b_max, IM_COL32(0, 229, 255, 255), 3.0f, 0, 1.0f);
                                dl->AddText(f_rb, f_sz, ImVec2(b_min.x + (badge_w - txt_sz.x) * 0.5f, b_min.y + 0.5f), IM_COL32(0, 229, 255, 255), b_tag);
                            } else {
                                dl->AddLine(ImVec2(bx, uni_pos.y + 6.0f), ImVec2(bx, uni_pos.y + uni_lane_h - 6.0f), IM_COL32(190, 215, 245, 95), 1.0f);
                                dl->AddLine(ImVec2(bx, uni_pos.y), ImVec2(bx, uni_pos.y + 6.0f), IM_COL32(230, 245, 255, 220), 1.5f);
                                dl->AddLine(ImVec2(bx, uni_pos.y + uni_lane_h - 6.0f), ImVec2(bx, uni_pos.y + uni_lane_h), IM_COL32(230, 245, 255, 220), 1.5f);
                                dl->AddRectFilled(ImVec2(bx - 1.0f, mid_y - 1.5f), ImVec2(bx + 1.0f, mid_y + 1.5f), IM_COL32(255, 255, 255, 240));
                            }
                        }
                    }
                } else if (deck1.bpm > 20.0 && deck1.sample_rate > 1000.0 && !deck1.buffer_l.empty()) {
                    double natural_beat_len1 = (60.0 / deck1.bpm) * deck1.sample_rate;
                    if (natural_beat_len1 > 10.0) {
                        int b_start1 = (int)std::floor((start_f1 - deck1.first_beat_frame) / natural_beat_len1);
                        int b_end1   = (int)std::ceil((start_f1 + window_f1 - deck1.first_beat_frame) / natural_beat_len1);
                        for (int b = b_start1; b <= b_end1; b++) {
                            double beat_f = deck1.first_beat_frame + (double)b * natural_beat_len1;
                            float bx = std::round(uni_pos.x + (float)((beat_f - start_f1) / window_f1) * wave_w);
                            if (bx >= uni_pos.x && bx <= uni_pos.x + wave_w) {
                                int beat_in_bar = ((b % 4) + 4) % 4;
                                int bar_num = (int)std::floor((double)b / 4.0) + 1;

                                if (beat_in_bar == 0) {
                                    // Downbeat 1.1: Linha Vermelha Sólida Rekordbox através de toda a pista
                                    dl->AddLine(ImVec2(bx, uni_pos.y), ImVec2(bx, uni_pos.y + uni_lane_h), IM_COL32(255, 35, 55, 245), 1.5f);
                                    // Triângulos vermelhos Rekordbox no topo (apontando para baixo) e na base (apontando para cima)
                                    dl->AddTriangleFilled(ImVec2(bx - 4.5f, uni_pos.y), ImVec2(bx + 4.5f, uni_pos.y), ImVec2(bx, uni_pos.y + 6.5f), IM_COL32(255, 35, 55, 255));
                                    dl->AddTriangleFilled(ImVec2(bx - 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx + 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx, uni_pos.y + uni_lane_h - 6.5f), IM_COL32(255, 35, 55, 255));

                                    // Tag numérica superior em PRIMEIRO PLANO (FOREGROUND) formato Rekordbox ("X.1Bars")
                                    char b_tag[32];
                                    snprintf(b_tag, sizeof(b_tag), "%d.1Bars", bar_num);
                                    ImVec2 txt_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, b_tag);
                                    float badge_w = txt_sz.x + 8.0f;
                                    float badge_h = 13.0f;
                                    ImVec2 b_min(bx - badge_w * 0.5f, uni_pos.y + 1.0f);
                                    ImVec2 b_max(bx + badge_w * 0.5f, uni_pos.y + 1.0f + badge_h);
                                    dl->AddRectFilled(b_min, b_max, IM_COL32(10, 16, 26, 245), 3.0f);
                                    dl->AddRect(b_min, b_max, IM_COL32(0, 229, 255, 255), 3.0f, 0, 1.0f);
                                    dl->AddText(f_rb, f_sz, ImVec2(b_min.x + (badge_w - txt_sz.x) * 0.5f, b_min.y + 0.5f), IM_COL32(0, 229, 255, 255), b_tag);
                                } else {
                                    // Batidas intermediárias 2, 3, 4:
                                    // 1) Linha vertical que corta a waveform em primeiro plano
                                    dl->AddLine(ImVec2(bx, uni_pos.y + 6.0f), ImVec2(bx, uni_pos.y + uni_lane_h - 6.0f), IM_COL32(190, 215, 245, 95), 1.0f);
                                    // 2) Ticks nítidos de régua no topo e na base
                                    dl->AddLine(ImVec2(bx, uni_pos.y), ImVec2(bx, uni_pos.y + 6.0f), IM_COL32(230, 245, 255, 220), 1.5f);
                                    dl->AddLine(ImVec2(bx, uni_pos.y + uni_lane_h - 6.0f), ImVec2(bx, uni_pos.y + uni_lane_h), IM_COL32(230, 245, 255, 220), 1.5f);
                                    // 3) PONTO DA GRID no centro exato (Zero-Crossing Point)
                                    dl->AddRectFilled(ImVec2(bx - 1.0f, mid_y - 1.5f), ImVec2(bx + 1.0f, mid_y + 1.5f), IM_COL32(255, 255, 255, 240));
                                }
                            }
                        }
                    }
                }

                // Grade Secundária Deck 2 (Âmbar na borda inferior em Primeiro Plano):
                if (deck2.has_rekordbox_grid && !deck2.rekordbox_beats.empty() && !deck2.buffer_l.empty()) {
                    auto it_start2 = std::lower_bound(deck2.rekordbox_beats.begin(), deck2.rekordbox_beats.end(), (int64_t)start_f2,
                        [](const KuroAudio::RekordboxBeat& b, int64_t val) { return b.frame < val; });
                    if (it_start2 != deck2.rekordbox_beats.begin()) --it_start2;

                    for (auto it = it_start2; it != deck2.rekordbox_beats.end() && it->frame <= (int64_t)(start_f2 + window_f2 + 100); ++it) {
                        double beat_f2 = (double)it->frame;
                        float bx2 = std::round(uni_pos.x + (float)((beat_f2 - start_f2) / window_f2) * wave_w);
                        if (bx2 >= uni_pos.x && bx2 <= uni_pos.x + wave_w) {
                            int beat_in_bar2 = it->bar_beat - 1;
                            size_t b_idx2 = std::distance(deck2.rekordbox_beats.begin(), it);
                            int bar_num2 = (int)(b_idx2 / 4) + 1;

                            if (beat_in_bar2 == 0) {
                                dl->AddLine(ImVec2(bx2, uni_pos.y + uni_lane_h - 14.0f), ImVec2(bx2, uni_pos.y + uni_lane_h), IM_COL32(255, 160, 0, 240), 1.8f);
                                dl->AddTriangleFilled(ImVec2(bx2 - 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx2 + 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx2, uni_pos.y + uni_lane_h - 6.5f), IM_COL32(255, 160, 0, 255));
                                char b2_tag[32];
                                snprintf(b2_tag, sizeof(b2_tag), "%d.1Bars", bar_num2);
                                ImVec2 txt2_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, b2_tag);
                                float b2_w = txt2_sz.x + 8.0f;
                                float b2_h = 13.0f;
                                float b2_x0 = std::clamp(bx2 - b2_w * 0.5f, uni_pos.x + 2.0f, uni_pos.x + wave_w - b2_w - 2.0f);
                                ImVec2 b2_min(b2_x0, uni_pos.y + uni_lane_h - b2_h - 1.0f);
                                ImVec2 b2_max(b2_x0 + b2_w, uni_pos.y + uni_lane_h - 1.0f);
                                dl->AddRectFilled(b2_min, b2_max, IM_COL32(20, 14, 8, 245), 3.0f);
                                dl->AddRect(b2_min, b2_max, IM_COL32(255, 175, 20, 255), 3.0f, 0, 1.0f);
                                dl->AddText(f_rb, f_sz, ImVec2(b2_min.x + (b2_w - txt2_sz.x) * 0.5f, b2_min.y + 0.5f), IM_COL32(255, 200, 50, 255), b2_tag);
                            } else {
                                dl->AddLine(ImVec2(bx2, uni_pos.y + uni_lane_h - 5.0f), ImVec2(bx2, uni_pos.y + uni_lane_h), IM_COL32(255, 170, 0, 180), 1.2f);
                            }
                        }
                    }
                } else if (deck2.bpm > 20.0 && deck2.sample_rate > 1000.0 && !deck2.buffer_l.empty()) {
                    double natural_beat_len2 = (60.0 / deck2.bpm) * deck2.sample_rate;
                    if (natural_beat_len2 > 10.0) {
                        int b_start2 = (int)std::floor((start_f2 - deck2.first_beat_frame) / natural_beat_len2);
                        int b_end2   = (int)std::ceil((start_f2 + window_f2 - deck2.first_beat_frame) / natural_beat_len2);
                        for (int b = b_start2; b <= b_end2; b++) {
                            double beat_f2 = deck2.first_beat_frame + (double)b * natural_beat_len2;
                            float bx2 = std::round(uni_pos.x + (float)((beat_f2 - start_f2) / window_f2) * wave_w);
                            if (bx2 >= uni_pos.x && bx2 <= uni_pos.x + wave_w) {
                                int beat_in_bar2 = ((b % 4) + 4) % 4;
                                int bar_num2 = (int)std::floor((double)b / 4.0) + 1;

                                if (beat_in_bar2 == 0) {
                                    // Downbeat Deck 2: Tick Âmbar/Dourado com tag inferior em FOREGROUND
                                    dl->AddLine(ImVec2(bx2, uni_pos.y + uni_lane_h - 14.0f), ImVec2(bx2, uni_pos.y + uni_lane_h), IM_COL32(255, 160, 0, 240), 1.8f);
                                    dl->AddTriangleFilled(ImVec2(bx2 - 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx2 + 4.5f, uni_pos.y + uni_lane_h), ImVec2(bx2, uni_pos.y + uni_lane_h - 6.5f), IM_COL32(255, 160, 0, 255));
                                    char b2_tag[32];
                                    snprintf(b2_tag, sizeof(b2_tag), "%d.1Bars", bar_num2);
                                    ImVec2 txt2_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, b2_tag);
                                    float b2_w = txt2_sz.x + 8.0f;
                                    float b2_h = 13.0f;
                                    ImVec2 b2_min(bx2 - b2_w * 0.5f, uni_pos.y + uni_lane_h - b2_h - 1.0f);
                                    ImVec2 b2_max(bx2 + b2_w * 0.5f, uni_pos.y + uni_lane_h - 1.0f);
                                    dl->AddRectFilled(b2_min, b2_max, IM_COL32(20, 14, 8, 245), 3.0f);
                                    dl->AddRect(b2_min, b2_max, IM_COL32(255, 175, 20, 255), 3.0f, 0, 1.0f);
                                    dl->AddText(f_rb, f_sz, ImVec2(b2_min.x + (b2_w - txt2_sz.x) * 0.5f, b2_min.y + 0.5f), IM_COL32(255, 200, 50, 255), b2_tag);
                                } else {
                                    // Ticks intermediários Deck 2
                                    dl->AddLine(ImVec2(bx2, uni_pos.y + uni_lane_h - 5.0f), ImVec2(bx2, uni_pos.y + uni_lane_h), IM_COL32(255, 170, 0, 180), 1.2f);
                                }
                            }
                        }
                    }
                }

                // CUE Points Deck 1 (Topo da pista)
                if (deck1.duration_sec > 0.0 && deck1.cue_frame >= 0.0) {
                    float cx_cue1 = uni_pos.x + (float)((deck1.cue_frame - start_f1) / window_f1) * wave_w;
                    if (cx_cue1 >= uni_pos.x && cx_cue1 <= uni_pos.x + wave_w) {
                        ImU32 c_cue = IM_COL32(0, 229, 255, 255);
                        dl->AddLine(ImVec2(cx_cue1, uni_pos.y), ImVec2(cx_cue1, mid_y), c_cue, 1.2f);
                        dl->AddRectFilled(ImVec2(cx_cue1 - 10.0f, uni_pos.y + 1.0f), ImVec2(cx_cue1 + 10.0f, uni_pos.y + 13.0f), c_cue, 2.0f);
                        dl->AddText(ImVec2(cx_cue1 - 8.0f, uni_pos.y + 0.5f), IM_COL32(0, 0, 0, 255), "CUE1");
                    }
                }

                // CUE Points Deck 2 (Base da pista)
                if (deck2.duration_sec > 0.0 && deck2.cue_frame >= 0.0) {
                    float cx_cue2 = uni_pos.x + (float)((deck2.cue_frame - start_f2) / window_f2) * wave_w;
                    if (cx_cue2 >= uni_pos.x && cx_cue2 <= uni_pos.x + wave_w) {
                        ImU32 c_cue2 = IM_COL32(255, 160, 0, 255);
                        dl->AddLine(ImVec2(cx_cue2, mid_y), ImVec2(cx_cue2, uni_pos.y + uni_lane_h), c_cue2, 1.2f);
                        dl->AddRectFilled(ImVec2(cx_cue2 - 10.0f, uni_pos.y + uni_lane_h - 13.0f), ImVec2(cx_cue2 + 10.0f, uni_pos.y + uni_lane_h - 1.0f), c_cue2, 2.0f);
                        dl->AddText(ImVec2(cx_cue2 - 8.0f, uni_pos.y + uni_lane_h - 13.5f), IM_COL32(0, 0, 0, 255), "CUE2");
                    }
                }

                // Hot Cues Deck 1 & 2
                // hot_cue_letters declared at function scope
                for (int c = 0; c < 8; c++) {
                    if (deck1.hot_cues[c].active) {
                        double cf1 = deck1.hot_cues[c].time_sec * deck1.sample_rate;
                        float cx1 = uni_pos.x + (float)((cf1 - start_f1) / window_f1) * wave_w;
                        if (cx1 >= uni_pos.x && cx1 <= uni_pos.x + wave_w) {
                            ImU32 hc_col = deck1.hot_cues[c].color_rgba;
                            dl->AddLine(ImVec2(cx1, uni_pos.y), ImVec2(cx1, mid_y), hc_col, 1.0f);
                            dl->AddRectFilled(ImVec2(cx1 - 7.0f, uni_pos.y + 1.0f), ImVec2(cx1 + 7.0f, uni_pos.y + 13.0f), hc_col, 2.0f);
                            dl->AddText(ImVec2(cx1 - 4.0f, uni_pos.y + 0.5f), IM_COL32(0, 0, 0, 255), hot_cue_letters[c]);
                        }
                    }
                    if (deck2.hot_cues[c].active) {
                        double cf2 = deck2.hot_cues[c].time_sec * deck2.sample_rate;
                        float cx2 = uni_pos.x + (float)((cf2 - start_f2) / window_f2) * wave_w;
                        if (cx2 >= uni_pos.x && cx2 <= uni_pos.x + wave_w) {
                            ImU32 hc_col2 = deck2.hot_cues[c].color_rgba;
                            dl->AddLine(ImVec2(cx2, mid_y), ImVec2(cx2, uni_pos.y + uni_lane_h), hc_col2, 1.0f);
                            dl->AddRectFilled(ImVec2(cx2 - 7.0f, uni_pos.y + uni_lane_h - 13.0f), ImVec2(cx2 + 7.0f, uni_pos.y + uni_lane_h - 1.0f), hc_col2, 2.0f);
                            dl->AddText(ImVec2(cx2 - 4.0f, uni_pos.y + uni_lane_h - 13.5f), IM_COL32(0, 0, 0, 255), hot_cue_letters[c]);
                        }
                    }
                }

                // --- REGIÕES E MARCADORES DE LOOP ATIVO REKORDBOX (PISTA ÚNICA SOBREPOSTA) ---
                // Deck 1 (Metade Superior)
                if (deck1.loop_active && deck1.loop_length_frames > 0.0 && window_f1 > 0.0) {
                    double l_start1 = deck1.loop_start_frame;
                    double l_end1 = deck1.loop_start_frame + deck1.loop_length_frames;
                    float lx1_in = uni_pos.x + (float)((l_start1 - start_f1) / window_f1) * wave_w;
                    float lx1_out = uni_pos.x + (float)((l_end1 - start_f1) / window_f1) * wave_w;
                    float rx1_in = std::clamp(lx1_in, uni_pos.x, uni_pos.x + wave_w);
                    float rx1_out = std::clamp(lx1_out, uni_pos.x, uni_pos.x + wave_w);
                    if (rx1_out > rx1_in) {
                        dl->AddRectFilled(ImVec2(rx1_in, uni_pos.y), ImVec2(rx1_out, mid_y), IM_COL32(255, 140, 0, 75));
                        dl->AddLine(ImVec2(rx1_in, uni_pos.y + 0.5f), ImVec2(rx1_out, uni_pos.y + 0.5f), IM_COL32(255, 190, 30, 245), 2.0f);
                        dl->AddLine(ImVec2(rx1_in, mid_y - 0.5f), ImVec2(rx1_out, mid_y - 0.5f), IM_COL32(255, 190, 30, 245), 2.0f);
                    }
                    if (lx1_in >= uni_pos.x && lx1_in <= uni_pos.x + wave_w) {
                        dl->AddLine(ImVec2(lx1_in, uni_pos.y), ImVec2(lx1_in, mid_y), IM_COL32(255, 200, 30, 255), 2.0f);
                        dl->AddTriangleFilled(ImVec2(lx1_in, uni_pos.y), ImVec2(lx1_in + 7.0f, uni_pos.y), ImVec2(lx1_in, uni_pos.y + 9.0f), IM_COL32(255, 170, 0, 255));
                        dl->AddRectFilled(ImVec2(lx1_in, uni_pos.y + 1.0f), ImVec2(lx1_in + 20.0f, uni_pos.y + 13.0f), IM_COL32(255, 150, 0, 255), 2.0f);
                        dl->AddText(f_rb, 10.0f, ImVec2(lx1_in + 3.0f, uni_pos.y + 1.0f), IM_COL32(0, 0, 0, 255), "IN");
                    }
                    if (lx1_out >= uni_pos.x && lx1_out <= uni_pos.x + wave_w) {
                        dl->AddLine(ImVec2(lx1_out, uni_pos.y), ImVec2(lx1_out, mid_y), IM_COL32(255, 200, 30, 255), 2.0f);
                        dl->AddTriangleFilled(ImVec2(lx1_out, uni_pos.y), ImVec2(lx1_out - 7.0f, uni_pos.y), ImVec2(lx1_out, uni_pos.y + 9.0f), IM_COL32(255, 170, 0, 255));
                        dl->AddRectFilled(ImVec2(lx1_out - 26.0f, uni_pos.y + 1.0f), ImVec2(lx1_out, uni_pos.y + 13.0f), IM_COL32(255, 150, 0, 255), 2.0f);
                        dl->AddText(f_rb, 10.0f, ImVec2(lx1_out - 24.0f, uni_pos.y + 1.0f), IM_COL32(0, 0, 0, 255), "OUT");
                    }
                    if (rx1_out - rx1_in > 45.0f) {
                        char lp_tag1[32];
                        if (std::fmod(deck1.loop_beats, 1.0) == 0.0) snprintf(lp_tag1, sizeof(lp_tag1), "LOOP %.0f B", deck1.loop_beats);
                        else snprintf(lp_tag1, sizeof(lp_tag1), "LOOP %.2f B", deck1.loop_beats);
                        ImVec2 t_sz = f_rb->CalcTextSizeA(10.0f, FLT_MAX, 0.0f, lp_tag1);
                        float cx = (rx1_in + rx1_out) * 0.5f;
                        ImVec2 b_min(cx - t_sz.x * 0.5f - 5.0f, uni_pos.y + 2.0f);
                        ImVec2 b_max(cx + t_sz.x * 0.5f + 5.0f, uni_pos.y + 15.0f);
                        dl->AddRectFilled(b_min, b_max, IM_COL32(18, 12, 4, 235), 3.0f);
                        dl->AddRect(b_min, b_max, IM_COL32(255, 170, 0, 255), 3.0f, 0, 1.0f);
                        dl->AddText(f_rb, 10.0f, ImVec2(b_min.x + 5.0f, b_min.y + 1.0f), IM_COL32(255, 205, 30, 255), lp_tag1);
                    }
                }

                // Deck 2 (Metade Inferior)
                if (deck2.loop_active && deck2.loop_length_frames > 0.0 && window_f2 > 0.0) {
                    double l_start2 = deck2.loop_start_frame;
                    double l_end2 = deck2.loop_start_frame + deck2.loop_length_frames;
                    float lx2_in = uni_pos.x + (float)((l_start2 - start_f2) / window_f2) * wave_w;
                    float lx2_out = uni_pos.x + (float)((l_end2 - start_f2) / window_f2) * wave_w;
                    float rx2_in = std::clamp(lx2_in, uni_pos.x, uni_pos.x + wave_w);
                    float rx2_out = std::clamp(lx2_out, uni_pos.x, uni_pos.x + wave_w);
                    if (rx2_out > rx2_in) {
                        dl->AddRectFilled(ImVec2(rx2_in, mid_y), ImVec2(rx2_out, uni_pos.y + uni_lane_h), IM_COL32(255, 140, 0, 75));
                        dl->AddLine(ImVec2(rx2_in, mid_y + 0.5f), ImVec2(rx2_out, mid_y + 0.5f), IM_COL32(255, 190, 30, 245), 2.0f);
                        dl->AddLine(ImVec2(rx2_in, uni_pos.y + uni_lane_h - 0.5f), ImVec2(rx2_out, uni_pos.y + uni_lane_h - 0.5f), IM_COL32(255, 190, 30, 245), 2.0f);
                    }
                    if (lx2_in >= uni_pos.x && lx2_in <= uni_pos.x + wave_w) {
                        dl->AddLine(ImVec2(lx2_in, mid_y), ImVec2(lx2_in, uni_pos.y + uni_lane_h), IM_COL32(255, 200, 30, 255), 2.0f);
                        dl->AddTriangleFilled(ImVec2(lx2_in, uni_pos.y + uni_lane_h), ImVec2(lx2_in + 7.0f, uni_pos.y + uni_lane_h), ImVec2(lx2_in, uni_pos.y + uni_lane_h - 9.0f), IM_COL32(255, 170, 0, 255));
                        dl->AddRectFilled(ImVec2(lx2_in, uni_pos.y + uni_lane_h - 13.0f), ImVec2(lx2_in + 20.0f, uni_pos.y + uni_lane_h - 1.0f), IM_COL32(255, 150, 0, 255), 2.0f);
                        dl->AddText(f_rb, 10.0f, ImVec2(lx2_in + 3.0f, uni_pos.y + uni_lane_h - 13.0f), IM_COL32(0, 0, 0, 255), "IN");
                    }
                    if (lx2_out >= uni_pos.x && lx2_out <= uni_pos.x + wave_w) {
                        dl->AddLine(ImVec2(lx2_out, mid_y), ImVec2(lx2_out, uni_pos.y + uni_lane_h), IM_COL32(255, 200, 30, 255), 2.0f);
                        dl->AddTriangleFilled(ImVec2(lx2_out, uni_pos.y + uni_lane_h), ImVec2(lx2_out - 7.0f, uni_pos.y + uni_lane_h), ImVec2(lx2_out, uni_pos.y + uni_lane_h - 9.0f), IM_COL32(255, 170, 0, 255));
                        dl->AddRectFilled(ImVec2(lx2_out - 26.0f, uni_pos.y + uni_lane_h - 13.0f), ImVec2(lx2_out, uni_pos.y + uni_lane_h - 1.0f), IM_COL32(255, 150, 0, 255), 2.0f);
                        dl->AddText(f_rb, 10.0f, ImVec2(lx2_out - 24.0f, uni_pos.y + uni_lane_h - 13.0f), IM_COL32(0, 0, 0, 255), "OUT");
                    }
                    if (rx2_out - rx2_in > 45.0f) {
                        char lp_tag2[32];
                        if (std::fmod(deck2.loop_beats, 1.0) == 0.0) snprintf(lp_tag2, sizeof(lp_tag2), "LOOP %.0f B", deck2.loop_beats);
                        else snprintf(lp_tag2, sizeof(lp_tag2), "LOOP %.2f B", deck2.loop_beats);
                        ImVec2 t_sz = f_rb->CalcTextSizeA(10.0f, FLT_MAX, 0.0f, lp_tag2);
                        float cx = (rx2_in + rx2_out) * 0.5f;
                        ImVec2 b_min(cx - t_sz.x * 0.5f - 5.0f, uni_pos.y + uni_lane_h - 15.0f);
                        ImVec2 b_max(cx + t_sz.x * 0.5f + 5.0f, uni_pos.y + uni_lane_h - 2.0f);
                        dl->AddRectFilled(b_min, b_max, IM_COL32(18, 12, 4, 235), 3.0f);
                        dl->AddRect(b_min, b_max, IM_COL32(255, 170, 0, 255), 3.0f, 0, 1.0f);
                        dl->AddText(f_rb, 10.0f, ImVec2(b_min.x + 5.0f, b_min.y + 1.0f), IM_COL32(255, 205, 30, 255), lp_tag2);
                    }
                }

                // --- GHOST PLAYHEAD HOLOGRÁFICO NO SLIP MODE (PISTA ÚNICA SOBREPOSTA) ---
                float ghost_pulse = (std::sin((float)ImGui::GetTime() * 12.0f) + 1.0f) * 0.5f;

                // Deck 1 Ghost (Pista Superior - Ciano)
                if (deck1.is_slipping && deck1.duration_sec > 0.0 && deck1.sample_rate > 1000.0) {
                    float gx1 = uni_pos.x + (float)((deck1.slip_virtual_frame - start_f1) / window_f1) * wave_w;
                    ImU32 col_ghost_cyan = IM_COL32(0, 245, 212, 255);
                    ImU32 col_ghost_glow1 = IM_COL32(0, 220, 255, (int)(45 + ghost_pulse * 35));
                    ImU32 col_ghost_pulse1 = IM_COL32(0, 255, 240, (int)(160 + ghost_pulse * 95));

                    double delta_f1 = deck1.slip_virtual_frame - vs1.smooth_frame;
                    double beat_len1 = (deck1.bpm > 20.0) ? ((60.0 / deck1.bpm) * deck1.sample_rate) : (deck1.sample_rate * 0.5);
                    double delta_bars1 = (delta_f1 / beat_len1) / 4.0;

                    // Faixa sombreada conectando
                    float r1_x1 = std::clamp(std::min(center_x, gx1), uni_pos.x, uni_pos.x + wave_w);
                    float r1_x2 = std::clamp(std::max(center_x, gx1), uni_pos.x, uni_pos.x + wave_w);
                    if (r1_x2 - r1_x1 > 1.0f) {
                        dl->AddRectFilled(ImVec2(r1_x1, uni_pos.y), ImVec2(r1_x2, mid_y), col_ghost_glow1, 0.0f);
                        dl->AddLine(ImVec2(r1_x1, uni_pos.y), ImVec2(r1_x2, uni_pos.y), col_ghost_pulse1, 1.5f);
                    }

                    if (gx1 >= uni_pos.x && gx1 <= uni_pos.x + wave_w) {
                        dl->AddLine(ImVec2(gx1, uni_pos.y), ImVec2(gx1, mid_y), col_ghost_glow1, 6.0f);
                        dl->AddLine(ImVec2(gx1, uni_pos.y), ImVec2(gx1, mid_y), col_ghost_pulse1, 2.0f);
                        dl->AddTriangleFilled(ImVec2(gx1 - 4.5f, uni_pos.y), ImVec2(gx1 + 4.5f, uni_pos.y), ImVec2(gx1, uni_pos.y + 6.5f), col_ghost_cyan);

                        char g_txt1[36]; snprintf(g_txt1, sizeof(g_txt1), "SLIP 1: %+.1f B", delta_bars1);
                        float f_sz = 10.0f;
                        ImVec2 t_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, g_txt1);
                        float bx1 = std::clamp(gx1 - (t_sz.x + 8.0f) * 0.5f, uni_pos.x + 2.0f, uni_pos.x + wave_w - t_sz.x - 10.0f);
                        dl->AddRectFilled(ImVec2(bx1, uni_pos.y + 2.0f), ImVec2(bx1 + t_sz.x + 8.0f, uni_pos.y + 16.0f), IM_COL32(4, 18, 24, 235), 3.0f);
                        dl->AddRect(ImVec2(bx1, uni_pos.y + 2.0f), ImVec2(bx1 + t_sz.x + 8.0f, uni_pos.y + 16.0f), col_ghost_pulse1, 3.0f, 0, 1.0f);
                        dl->AddText(f_rb, f_sz, ImVec2(bx1 + 4.0f, uni_pos.y + 2.5f), col_ghost_cyan, g_txt1);
                    } else {
                        bool ahead = (gx1 > uni_pos.x + wave_w);
                        float ex = ahead ? (uni_pos.x + wave_w - 78.0f) : (uni_pos.x + 4.0f);
                        char off_str[32]; snprintf(off_str, sizeof(off_str), ahead ? "SLIP 1 >>" : "<< SLIP 1");
                        dl->AddRectFilled(ImVec2(ex, uni_pos.y + 2.0f), ImVec2(ex + 74.0f, uni_pos.y + 15.0f), IM_COL32(4, 18, 24, 220), 2.0f);
                        dl->AddRect(ImVec2(ex, uni_pos.y + 2.0f), ImVec2(ex + 74.0f, uni_pos.y + 15.0f), col_ghost_pulse1, 2.0f, 0, 1.0f);
                        dl->AddText(f_rb, 9.5f, ImVec2(ex + 4.0f, uni_pos.y + 2.0f), col_ghost_cyan, off_str);
                    }
                }

                // Deck 2 Ghost (Pista Inferior - Âmbar)
                if (deck2.is_slipping && deck2.duration_sec > 0.0 && deck2.sample_rate > 1000.0) {
                    float gx2 = uni_pos.x + (float)((deck2.slip_virtual_frame - start_f2) / window_f2) * wave_w;
                    ImU32 col_ghost_amb = IM_COL32(255, 170, 0, 255);
                    ImU32 col_ghost_glow2 = IM_COL32(255, 150, 0, (int)(45 + ghost_pulse * 35));
                    ImU32 col_ghost_pulse2 = IM_COL32(255, 190, 20, (int)(160 + ghost_pulse * 95));

                    double delta_f2 = deck2.slip_virtual_frame - vs2.smooth_frame;
                    double beat_len2 = (deck2.bpm > 20.0) ? ((60.0 / deck2.bpm) * deck2.sample_rate) : (deck2.sample_rate * 0.5);
                    double delta_bars2 = (delta_f2 / beat_len2) / 4.0;

                    // Faixa sombreada conectando
                    float r2_x1 = std::clamp(std::min(center_x, gx2), uni_pos.x, uni_pos.x + wave_w);
                    float r2_x2 = std::clamp(std::max(center_x, gx2), uni_pos.x, uni_pos.x + wave_w);
                    if (r2_x2 - r2_x1 > 1.0f) {
                        dl->AddRectFilled(ImVec2(r2_x1, mid_y), ImVec2(r2_x2, uni_pos.y + uni_lane_h), col_ghost_glow2, 0.0f);
                        dl->AddLine(ImVec2(r2_x1, uni_pos.y + uni_lane_h), ImVec2(r2_x2, uni_pos.y + uni_lane_h), col_ghost_pulse2, 1.5f);
                    }

                    if (gx2 >= uni_pos.x && gx2 <= uni_pos.x + wave_w) {
                        dl->AddLine(ImVec2(gx2, mid_y), ImVec2(gx2, uni_pos.y + uni_lane_h), col_ghost_glow2, 6.0f);
                        dl->AddLine(ImVec2(gx2, mid_y), ImVec2(gx2, uni_pos.y + uni_lane_h), col_ghost_pulse2, 2.0f);
                        dl->AddTriangleFilled(ImVec2(gx2 - 4.5f, uni_pos.y + uni_lane_h), ImVec2(gx2 + 4.5f, uni_pos.y + uni_lane_h), ImVec2(gx2, uni_pos.y + uni_lane_h - 6.5f), col_ghost_amb);

                        char g_txt2[36]; snprintf(g_txt2, sizeof(g_txt2), "SLIP 2: %+.1f B", delta_bars2);
                        float f_sz = 10.0f;
                        ImVec2 t_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, g_txt2);
                        float bx2 = std::clamp(gx2 - (t_sz.x + 8.0f) * 0.5f, uni_pos.x + 2.0f, uni_pos.x + wave_w - t_sz.x - 10.0f);
                        dl->AddRectFilled(ImVec2(bx2, uni_pos.y + uni_lane_h - 16.0f), ImVec2(bx2 + t_sz.x + 8.0f, uni_pos.y + uni_lane_h - 2.0f), IM_COL32(24, 16, 4, 235), 3.0f);
                        dl->AddRect(ImVec2(bx2, uni_pos.y + uni_lane_h - 16.0f), ImVec2(bx2 + t_sz.x + 8.0f, uni_pos.y + uni_lane_h - 2.0f), col_ghost_pulse2, 3.0f, 0, 1.0f);
                        dl->AddText(f_rb, f_sz, ImVec2(bx2 + 4.0f, uni_pos.y + uni_lane_h - 15.5f), col_ghost_amb, g_txt2);
                    } else {
                        bool ahead = (gx2 > uni_pos.x + wave_w);
                        float ex = ahead ? (uni_pos.x + wave_w - 78.0f) : (uni_pos.x + 4.0f);
                        char off_str[32]; snprintf(off_str, sizeof(off_str), ahead ? "SLIP 2 >>" : "<< SLIP 2");
                        dl->AddRectFilled(ImVec2(ex, uni_pos.y + uni_lane_h - 15.0f), ImVec2(ex + 74.0f, uni_pos.y + uni_lane_h - 2.0f), IM_COL32(24, 16, 4, 220), 2.0f);
                        dl->AddRect(ImVec2(ex, uni_pos.y + uni_lane_h - 15.0f), ImVec2(ex + 74.0f, uni_pos.y + uni_lane_h - 2.0f), col_ghost_pulse2, 2.0f, 0, 1.0f);
                        dl->AddText(f_rb, 9.5f, ImVec2(ex + 4.0f, uni_pos.y + uni_lane_h - 14.5f), col_ghost_amb, off_str);
                    }
                }

                // --- 4. AGULHA CENTRAL PLAYHEAD UNICA COM TELEMETRIA ---

                dl->AddLine(ImVec2(center_x, uni_pos.y), ImVec2(center_x, uni_pos.y + uni_lane_h), IM_COL32(255, 255, 255, 255), 1.0f);
                dl->AddLine(ImVec2(center_x, uni_pos.y), ImVec2(center_x, uni_pos.y + uni_lane_h), IM_COL32(0, 220, 255, 60), 3.0f);

                // Indicador Superior Ciano (Deck 1) apontando para baixo
                dl->AddTriangleFilled(ImVec2(center_x - 4.0f, uni_pos.y), ImVec2(center_x + 4.0f, uni_pos.y), ImVec2(center_x, uni_pos.y + 6.5f), IM_COL32(0, 245, 212, 255));
                // Indicador Inferior Ambar (Deck 2) apontando para cima
                dl->AddTriangleFilled(ImVec2(center_x - 4.0f, uni_pos.y + uni_lane_h), ImVec2(center_x + 4.0f, uni_pos.y + uni_lane_h), ImVec2(center_x, uni_pos.y + uni_lane_h - 6.5f), IM_COL32(255, 170, 0, 255));

                // Contador de compassos / Badges Oficiais Rekordbox Gold
                if (deck1.bpm > 20.0 && deck1.sample_rate > 1000.0 && !deck1.buffer_l.empty()) {
                    double beat_len1 = (60.0 / deck1.bpm) * deck1.sample_rate;
                    double rel_beats1 = (deck1.current_frame - deck1.first_beat_frame) / beat_len1;
                    int total_b1 = (int)std::floor(rel_beats1);
                    int bar1 = (total_b1 >= 0) ? ((total_b1 / 4) + 1) : -(((-total_b1 - 1) / 4) + 1);
                    int beat1 = (total_b1 >= 0) ? ((total_b1 % 4) + 1) : (4 - ((-total_b1 - 1) % 4));
                    char buf1[32]; snprintf(buf1, sizeof(buf1), "%d.%d BARS", bar1, beat1);
                    float b_font_sz = 12.0f;
                    ImVec2 bsz = f_rb->CalcTextSizeA(b_font_sz, FLT_MAX, 0.0f, buf1);
                    float badge_w = bsz.x + 14.0f;
                    float badge_h = 18.0f;
                    float badge_x = center_x - badge_w * 0.5f;
                    float badge_y = uni_pos.y + 2.0f;
                    ImVec2 b_min = ImVec2(badge_x, badge_y);
                    ImVec2 b_max = ImVec2(badge_x + badge_w, badge_y + badge_h);
                    dl->AddRectFilled(b_min, b_max, IM_COL32(8, 11, 16, 245), 4.0f);
                    dl->AddRect(b_min, b_max, IM_COL32(255, 200, 20, 240), 4.0f, 0, 1.2f);
                    ImVec2 t_pos = ImVec2(badge_x + (badge_w - bsz.x) * 0.5f, badge_y + (badge_h - bsz.y) * 0.5f);
                    dl->AddText(f_rb, b_font_sz, t_pos, IM_COL32(255, 215, 0, 255), buf1);
                }
                if (deck2.bpm > 20.0 && deck2.sample_rate > 1000.0 && !deck2.buffer_l.empty()) {
                    double beat_len2 = (60.0 / deck2.bpm) * deck2.sample_rate;
                    double rel_beats2 = (deck2.current_frame - deck2.first_beat_frame) / beat_len2;
                    int total_b2 = (int)std::floor(rel_beats2);
                    int bar2 = (total_b2 >= 0) ? ((total_b2 / 4) + 1) : -(((-total_b2 - 1) / 4) + 1);
                    int beat2 = (total_b2 >= 0) ? ((total_b2 % 4) + 1) : (4 - ((-total_b2 - 1) % 4));
                    char buf2[32]; snprintf(buf2, sizeof(buf2), "%d.%d BARS", bar2, beat2);
                    float b_font_sz = 12.0f;
                    ImVec2 bsz2 = f_rb->CalcTextSizeA(b_font_sz, FLT_MAX, 0.0f, buf2);
                    float badge2_w = bsz2.x + 14.0f;
                    float badge2_h = 18.0f;
                    float badge2_x = center_x - badge2_w * 0.5f;
                    float badge2_y = uni_pos.y + uni_lane_h - badge2_h - 2.0f;
                    ImVec2 b2_min = ImVec2(badge2_x, badge2_y);
                    ImVec2 b2_max = ImVec2(badge2_x + badge2_w, badge2_y + badge2_h);
                    dl->AddRectFilled(b2_min, b2_max, IM_COL32(8, 11, 16, 245), 4.0f);
                    dl->AddRect(b2_min, b2_max, IM_COL32(255, 200, 20, 240), 4.0f, 0, 1.2f);
                    ImVec2 t2_pos = ImVec2(badge2_x + (badge2_w - bsz2.x) * 0.5f, badge2_y + (badge2_h - bsz2.y) * 0.5f);
                    dl->AddText(f_rb, b_font_sz, t2_pos, IM_COL32(255, 215, 0, 255), buf2);
                }

                // --- 5. INTERATIVIDADE DE MOUSE NA PISTA ÚNICA ---
                ImGui::SetCursorScreenPos(uni_pos);
                ImGui::InvisibleButton("##UniSuperimposedWaveLane", ImVec2(wave_w, uni_lane_h));

                if (ImGui::BeginDragDropTarget()) {
                    if (const ImGuiPayload* payload = ImGui::AcceptDragDropPayload("DND_DJ_TRACK_ID")) {
                        const char* dropped_id = (const char*)payload->Data;
                        auto* ptr = KuroAudio::DJLibraryManager::getInstance().getTrackById(dropped_id);
                        if (ptr) {
                            ImVec2 mp = ImGui::GetMousePos();
                            int target_deck_dnd = (mp.y < mid_y) ? deck1.deck_id : deck2.deck_id;
                            if (ptr->is_downloaded) spotify_service.loadLibraryTrack(*ptr, target_deck_dnd, engine);
                            else spotify_service.downloadLibraryTrackAsync(*ptr, target_deck_dnd, engine);
                        }
                    }
                    dl->AddRect(uni_pos, ImVec2(uni_pos.x + wave_w, uni_pos.y + uni_lane_h), IM_COL32(0, 240, 255, 255), 2.0f, 0, 2.5f);
                    ImGui::EndDragDropTarget();
                }

                if (ImGui::BeginPopupContextItem()) {
                    ImGui::TextColored(ImVec4(0.00f, 0.95f, 0.83f, 1.0f), " Rekordbox Waveform Color");
                    ImGui::Separator();
                    if (ImGui::MenuItem("RGB (Rekordbox / Traktor Oficial: Rosa Graves, Ciano Medios, Verde Agudos)", nullptr, waveform_color_mode == 0)) {
                        waveform_color_mode = 0;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    if (ImGui::MenuItem("3-BAND (CDJ-3000: Graves Azul, Medios Ambar, Agudos Branco)", nullptr, waveform_color_mode == 1)) {
                        waveform_color_mode = 1;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    if (ImGui::MenuItem("BLUE (CDJ-2000 Classico Rekordbox Azul Monocromatico)", nullptr, waveform_color_mode == 2)) {
                        waveform_color_mode = 2;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    if (ImGui::MenuItem("NEON (Cyberpunk)", nullptr, waveform_color_mode == 3)) {
                        waveform_color_mode = 3;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    if (ImGui::MenuItem("SUNSET (Festival Solar)", nullptr, waveform_color_mode == 4)) {
                        waveform_color_mode = 4;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    ImGui::Separator();
                    if (ImGui::MenuItem("Recalcular Waveform de Alta Precisao (Limpar Cache)")) {
                        deck1.recomputeDetailedWaveform();
                        deck2.recomputeDetailedWaveform();
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    ImGui::EndPopup();
                }

                bool lane_active = ImGui::IsItemActive();
                bool lane_clicked = ImGui::IsItemClicked(0);
                bool lane_hovered = ImGui::IsItemHovered();
                ImVec2 mouse_pos = ImGui::GetMousePos();
                bool target_is_d1 = (mouse_pos.y < mid_y);
                KuroAudio::DJDeck& target_deck = target_is_d1 ? deck1 : deck2;
                DeckVisualHertzSync& target_vs  = target_is_d1 ? vs1 : vs2;
                double target_window_f         = target_is_d1 ? window_f1 : window_f2;

                if (lane_active) {
                    ImGuiIO& io = ImGui::GetIO();
                    if (io.KeyAlt) {
                        ImGui::SetMouseCursor(ImGuiMouseCursor_ResizeEW);
                        int g_idx = (grid_edit_deck == 0) ? active_l_id : active_r_id;
                        auto& g_deck = engine.decks[g_idx];
                        if (io.MouseDelta.x != 0.0f) {
                            double delta_frames = ((double)io.MouseDelta.x / (double)wave_w) * target_window_f;
                            if (io.KeyShift) delta_frames *= 0.20;
                            g_deck.first_beat_frame += delta_frames;
                            g_deck.has_rekordbox_grid = false;
                            g_deck.rekordbox_beats.clear();
                            KuroAudio::DJGridEngine::getInstance().setFirstBeatMarker(g_deck.deck_id, g_deck.first_beat_frame, g_deck.sample_rate);
                        }
                        double rel_ms = (g_deck.first_beat_frame - g_deck.current_frame) / g_deck.sample_rate * 1000.0;
                        ImGui::SetTooltip("REPOSICIONAR BEATGRID (Deck %d): Deslocamento %.1f ms", g_idx + 1, rel_ms);
                    } else {
                        target_deck.jog_touch = true;
                        target_deck.scratch_active_ticks = 6;
                        if (io.MouseDelta.x != 0.0f) {
                            double delta_frames = -((double)io.MouseDelta.x / (double)w) * target_window_f;
                            if (io.KeyShift) delta_frames *= 4.0;
                            target_deck.current_frame += delta_frames;
                            target_deck.current_frame = std::clamp(target_deck.current_frame, 0.0, (double)target_deck.buffer_l.size());
                            target_vs.smooth_frame = target_deck.current_frame;
                            target_deck.target_scratch_velocity = (float)(-io.MouseDelta.x * 0.18f);
                            target_deck.jog_visual_angle -= (float)io.MouseDelta.x * 0.025f;
                        }
                    }
                } else if (lane_clicked) {
                    if (ImGui::GetIO().KeyAlt) {
                        float click_x = ImGui::GetMousePos().x;
                        double offset_frames = ((double)(click_x - center_x) / (double)wave_w) * target_window_f;
                        double target_f = target_deck.current_frame + offset_frames;
                        target_deck.first_beat_frame = target_f;
                        target_deck.has_rekordbox_grid = false;
                        target_deck.rekordbox_beats.clear();
                        KuroAudio::DJGridEngine::getInstance().setFirstBeatMarker(target_deck.deck_id, target_deck.first_beat_frame, target_deck.sample_rate);
                    } else {
                        float click_x = ImGui::GetMousePos().x;
                        double offset_frames = ((double)(click_x - center_x) / (double)w) * target_window_f;
                        target_deck.current_frame = std::clamp(target_deck.current_frame + offset_frames, 0.0, (double)target_deck.buffer_l.size());
                        target_vs.smooth_frame = target_deck.current_frame;
                    }
                } else if (lane_hovered && ImGui::IsMouseReleased(0)) {
                    target_deck.jog_touch = false;
                }

                if (lane_hovered && ImGui::GetIO().MouseWheel != 0.0f) {
                    float wheel = ImGui::GetIO().MouseWheel;
                    if (ImGui::GetIO().KeyCtrl) {
                        if (wheel > 0.0f) { if (waveform_zoom_bars > 1) waveform_zoom_bars /= 2; }
                        else { if (waveform_zoom_bars < 64) waveform_zoom_bars *= 2; }
                    } else {
                        double seek_step = (double)wheel * (target_deck.sample_rate * (ImGui::GetIO().KeyShift ? 4.0 : 0.4));
                        target_deck.current_frame = std::clamp(target_deck.current_frame + seek_step, 0.0, (double)target_deck.buffer_l.size());
                        target_vs.smooth_frame = target_deck.current_frame;
                    }
                }

                if (lane_hovered) {
                    ImGui::SetTooltip("PISTA UNICA SOBREPOSTA: Superior = Deck 1 (Ciano) | Inferior = Deck 2 (Ambar) | Alt+Arrastar: Beatgrid | Ctrl+Scroll: Zoom");
                }

                // Fechamento do Visor Rígido Rekordbox no Modo 0
                dl->PopClipRect();

                ImGui::SetCursorScreenPos(ImVec2(pos.x, pos.y + total_stack_h));
                ImGui::Dummy(ImVec2(w, 2.0f));
                return;
            }

            // =========================================================================================
            // MODO 1: PISTAS DUPLAS EMPILHADAS TRADICIONAIS (MODO CLÁSSICO ALTERNATIVO)
            // =========================================================================================
            // Visor Rígido Rekordbox no Modo 1
            dl->PushClipRect(ImVec2(wave_x, pos.y), ImVec2(wave_x + wave_w, pos.y + total_stack_h), true);

            ImVec2 l0_pos = ImVec2(wave_x, pos.y);
            ImVec2 l1_pos = ImVec2(wave_x, pos.y + lane_h + lane_gap);
            KuroAudio::DJDeck* lane_decks[2] = { &deck1, &deck2 };
            int deck_ids[2] = { active_l_id, active_r_id };
            ImVec4 lane_themes[2] = {
                (active_l_id == 0 ? col_deck_1 : col_deck_3),
                (active_r_id == 1 ? col_deck_2 : col_deck_4)
            };

            for (int lane = 0; lane < 2; lane++) {
                KuroAudio::DJDeck& deck = *lane_decks[lane];
                int d_num = deck_ids[lane] + 1;
                ImVec4 theme_col = lane_themes[lane];
                ImVec2 l_pos = (lane == 0) ? l0_pos : l1_pos;

                dl->AddRectFilled(l_pos, ImVec2(l_pos.x + wave_w, l_pos.y + lane_h), IM_COL32(0, 0, 0, 255));
                if (lane == 0) dl->AddLine(ImVec2(l_pos.x, l_pos.y + lane_h), ImVec2(l_pos.x + w, l_pos.y + lane_h), IM_COL32(20, 26, 36, 255), 1.0f);
                else dl->AddLine(l_pos, ImVec2(l_pos.x + w, l_pos.y), IM_COL32(20, 26, 36, 255), 1.0f);

                float mid_y = l_pos.y + lane_h * 0.5f;
                dl->AddLine(ImVec2(l_pos.x, mid_y), ImVec2(l_pos.x + w, mid_y), IM_COL32(28, 38, 52, 160), 1.0f);

                DeckVisualHertzSync& vs = vis_sync[deck.deck_id];
                double render_frame = vs.smooth_frame;
                double eff_bpm = (deck.bpm > 20.0) ? deck.bpm : 126.0;
                double seconds_per_bar = (60.0 / eff_bpm) * 4.0;
                double window_sec = (double)waveform_zoom_bars * seconds_per_bar;
                if (window_sec < 0.5) window_sec = 0.5;
                double window_frames_d = window_sec * deck.sample_rate;
                double start_f_d = render_frame - window_frames_d * 0.5;

                    // Regua Superior Rekordbox Club Standard (Fundo sutil)
                    dl->AddRectFilled(l_pos, ImVec2(l_pos.x + wave_w, l_pos.y + 14.0f), IM_COL32(6, 9, 14, 180));
                    dl->AddLine(ImVec2(l_pos.x, l_pos.y + 14.0f), ImVec2(l_pos.x + wave_w, l_pos.y + 14.0f), IM_COL32(28, 36, 48, 140), 1.0f);

                    deck.generateDetailedWaveformIfNeeded();
                    // Passo de estriação contínua oficial Rekordbox (1.0px por coluna contígua)
                    float bar_step = 1.0f;
                    float max_half_h = (lane_h * 0.5f) * 0.78f; // Headroom Rekordbox 22% (Espaco livre para a regua)

                    static std::vector<WaveMeshPoint> pts_lane;
                    sampleDeckWaveform(deck, start_f_d, window_frames_d, l_pos.x, wave_w, bar_step, max_half_h, pts_lane);

                    // Renderização Vetorial Contínua Rekordbox (Pistas Duplas Empilhadas - 2L)
                    drawRekordboxContinuousMesh(dl, pts_lane, mid_y, max_half_h, waveform_color_mode, 0);

                    // Traço Contínuo de Osciloscópio Rekordbox (Zero-Crossing / Cauda de Silêncio 1px)
                    drawOscilloscopeTrace(pts_lane, mid_y, max_half_h, waveform_color_mode, lane, 0);

                    // Linha central neutra 1px
                    dl->AddLine(ImVec2(l_pos.x, mid_y), ImVec2(l_pos.x + wave_w, mid_y), IM_COL32(28, 38, 52, 160), 1.0f);

                    // --- GRADE MESTRE & REGUA REKORDBOX EM PRIMEIRO PLANO (FOREGROUND) ---
                    // Renderizado APOS a waveform para que numeros, badges e pontos fiquem 100% visiveis
                    if (deck.has_rekordbox_grid && !deck.rekordbox_beats.empty()) {
                        auto it_start = std::lower_bound(deck.rekordbox_beats.begin(), deck.rekordbox_beats.end(), (int64_t)start_f_d,
                            [](const KuroAudio::RekordboxBeat& b, int64_t val) { return b.frame < val; });
                        if (it_start != deck.rekordbox_beats.begin()) --it_start;

                        ImFont* f_rb = g_font_micro_tag ? g_font_micro_tag : (g_font_rekordbox_small ? g_font_rekordbox_small : ImGui::GetFont());
                        float f_sz = 10.0f;

                        for (auto it = it_start; it != deck.rekordbox_beats.end() && it->frame <= (int64_t)(start_f_d + window_frames_d + 100); ++it) {
                            double beat_f = (double)it->frame;
                            float bx = std::round(l_pos.x + (float)((beat_f - start_f_d) / window_frames_d) * wave_w);
                            if (bx >= l_pos.x && bx <= l_pos.x + wave_w) {
                                int beat_in_bar = it->bar_beat - 1;
                                size_t b_idx = std::distance(deck.rekordbox_beats.begin(), it);
                                int bar_num = (int)(b_idx / 4) + 1;

                                if (beat_in_bar == 0) {
                                    // Downbeat 1.1: Linha Vermelha Sólida Rekordbox através de toda a pista
                                    dl->AddLine(ImVec2(bx, l_pos.y), ImVec2(bx, l_pos.y + lane_h), IM_COL32(255, 35, 55, 245), 1.5f);
                                    // Triângulos vermelhos nas pontas superior e inferior
                                    dl->AddTriangleFilled(ImVec2(bx - 4.5f, l_pos.y), ImVec2(bx + 4.5f, l_pos.y), ImVec2(bx, l_pos.y + 6.5f), IM_COL32(255, 35, 55, 255));
                                    dl->AddTriangleFilled(ImVec2(bx - 4.5f, l_pos.y + lane_h), ImVec2(bx + 4.5f, l_pos.y + lane_h), ImVec2(bx, l_pos.y + lane_h - 6.5f), IM_COL32(255, 35, 55, 255));

                                    // Tag numérica superior em PRIMEIRO PLANO (FOREGROUND) formato Rekordbox ("X.1Bars")
                                    char b_str[32]; snprintf(b_str, sizeof(b_str), "%d.1Bars", bar_num);
                                    ImVec2 txt_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, b_str);
                                    float badge_w = txt_sz.x + 8.0f;
                                    float badge_h = 13.0f;
                                    float b_x0 = std::clamp(bx - badge_w * 0.5f, l_pos.x + 2.0f, l_pos.x + wave_w - badge_w - 2.0f);
                                    ImVec2 b_min(b_x0, l_pos.y + 1.0f);
                                    ImVec2 b_max(b_x0 + badge_w, l_pos.y + 1.0f + badge_h);
                                    if (lane == 0) {
                                         dl->AddRectFilled(b_min, b_max, IM_COL32(10, 16, 26, 245), 3.0f);
                                         dl->AddRect(b_min, b_max, IM_COL32(0, 229, 255, 255), 3.0f, 0, 1.0f);
                                         dl->AddText(f_rb, f_sz, ImVec2(b_min.x + (badge_w - txt_sz.x) * 0.5f, b_min.y + 0.5f), IM_COL32(0, 229, 255, 255), b_str);
                                    } else {
                                         dl->AddRectFilled(b_min, b_max, IM_COL32(20, 14, 8, 245), 3.0f);
                                         dl->AddRect(b_min, b_max, IM_COL32(255, 175, 20, 255), 3.0f, 0, 1.0f);
                                         dl->AddText(f_rb, f_sz, ImVec2(b_min.x + (badge_w - txt_sz.x) * 0.5f, b_min.y + 0.5f), IM_COL32(255, 200, 50, 255), b_str);
                                    }
                                } else {
                                    // Batidas intermediárias 2, 3, 4:
                                    dl->AddLine(ImVec2(bx, l_pos.y + 6.0f), ImVec2(bx, l_pos.y + lane_h - 6.0f), IM_COL32(190, 215, 245, 95), 1.0f);
                                    dl->AddLine(ImVec2(bx, l_pos.y), ImVec2(bx, l_pos.y + 6.0f), IM_COL32(230, 245, 255, 220), 1.5f);
                                    dl->AddLine(ImVec2(bx, l_pos.y + lane_h - 6.0f), ImVec2(bx, l_pos.y + lane_h), IM_COL32(230, 245, 255, 220), 1.5f);
                                    dl->AddRectFilled(ImVec2(bx - 1.0f, mid_y - 1.5f), ImVec2(bx + 1.0f, mid_y + 1.5f), IM_COL32(255, 255, 255, 240));
                                }
                            }
                        }
                    } else if (deck.bpm > 20.0) {
                        double natural_beat_len = (60.0 / deck.bpm) * deck.sample_rate;
                        if (natural_beat_len > 10.0) {
                            int b_start = (int)std::floor((start_f_d - deck.first_beat_frame) / natural_beat_len);
                            int b_end   = (int)std::ceil((start_f_d + window_frames_d - deck.first_beat_frame) / natural_beat_len);
                            ImFont* f_rb = g_font_micro_tag ? g_font_micro_tag : (g_font_rekordbox_small ? g_font_rekordbox_small : ImGui::GetFont());
                            float f_sz = 10.0f;

                            for (int b = b_start; b <= b_end; b++) {
                                double beat_f = deck.first_beat_frame + (double)b * natural_beat_len;
                                float bx = std::round(l_pos.x + (float)((beat_f - start_f_d) / window_frames_d) * wave_w);
                                if (bx >= l_pos.x && bx <= l_pos.x + wave_w) {
                                    int beat_in_bar = ((b % 4) + 4) % 4;
                                    int bar_num = (int)std::floor((double)b / 4.0) + 1;

                                    if (beat_in_bar == 0) {
                                        // Downbeat 1.1: Linha Vermelha Sólida Rekordbox através de toda a pista
                                        dl->AddLine(ImVec2(bx, l_pos.y), ImVec2(bx, l_pos.y + lane_h), IM_COL32(255, 35, 55, 245), 1.5f);
                                        // Triângulos vermelhos nas pontas superior e inferior
                                        dl->AddTriangleFilled(ImVec2(bx - 4.5f, l_pos.y), ImVec2(bx + 4.5f, l_pos.y), ImVec2(bx, l_pos.y + 6.5f), IM_COL32(255, 35, 55, 255));
                                        dl->AddTriangleFilled(ImVec2(bx - 4.5f, l_pos.y + lane_h), ImVec2(bx + 4.5f, l_pos.y + lane_h), ImVec2(bx, l_pos.y + lane_h - 6.5f), IM_COL32(255, 35, 55, 255));

                                        // Tag numérica superior em PRIMEIRO PLANO (FOREGROUND) formato Rekordbox ("X.1Bars")
                                        char b_str[32]; snprintf(b_str, sizeof(b_str), "%d.1Bars", bar_num);
                                        ImVec2 txt_sz = f_rb->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, b_str);
                                        float badge_w = txt_sz.x + 8.0f;
                                        float badge_h = 13.0f;
                                        float b_x0 = std::clamp(bx - badge_w * 0.5f, l_pos.x + 2.0f, l_pos.x + wave_w - badge_w - 2.0f);
                                        ImVec2 b_min(b_x0, l_pos.y + 1.0f);
                                        ImVec2 b_max(b_x0 + badge_w, l_pos.y + 1.0f + badge_h);
                                        if (lane == 0) {
                                             dl->AddRectFilled(b_min, b_max, IM_COL32(10, 16, 26, 245), 3.0f);
                                             dl->AddRect(b_min, b_max, IM_COL32(0, 229, 255, 255), 3.0f, 0, 1.0f);
                                             dl->AddText(f_rb, f_sz, ImVec2(b_min.x + (badge_w - txt_sz.x) * 0.5f, b_min.y + 0.5f), IM_COL32(0, 229, 255, 255), b_str);
                                        } else {
                                             dl->AddRectFilled(b_min, b_max, IM_COL32(20, 14, 8, 245), 3.0f);
                                             dl->AddRect(b_min, b_max, IM_COL32(255, 175, 20, 255), 3.0f, 0, 1.0f);
                                             dl->AddText(f_rb, f_sz, ImVec2(b_min.x + (badge_w - txt_sz.x) * 0.5f, b_min.y + 0.5f), IM_COL32(255, 200, 50, 255), b_str);
                                        }
                                    } else {
                                        // Batidas intermediárias 2, 3, 4:
                                        // 1) Linha vertical que corta a waveform em primeiro plano
                                        dl->AddLine(ImVec2(bx, l_pos.y + 6.0f), ImVec2(bx, l_pos.y + lane_h - 6.0f), IM_COL32(190, 215, 245, 95), 1.0f);
                                        // 2) Ticks nítidos de régua no topo e na base
                                        dl->AddLine(ImVec2(bx, l_pos.y), ImVec2(bx, l_pos.y + 6.0f), IM_COL32(230, 245, 255, 220), 1.5f);
                                        dl->AddLine(ImVec2(bx, l_pos.y + lane_h - 6.0f), ImVec2(bx, l_pos.y + lane_h), IM_COL32(230, 245, 255, 220), 1.5f);
                                        // 3) PONTO DA GRID no centro exato (Zero-Crossing Point)
                                        dl->AddRectFilled(ImVec2(bx - 1.0f, mid_y - 1.5f), ImVec2(bx + 1.0f, mid_y + 1.5f), IM_COL32(255, 255, 255, 240));
                                    }
                                }
                            }
                        }
                    }

                                        if (deck.duration_sec > 0.0 && deck.cue_frame >= 0.0) {
                        float cx_cue = l_pos.x + (float)((deck.cue_frame - start_f_d) / window_frames_d) * wave_w;
                        if (cx_cue >= l_pos.x && cx_cue <= l_pos.x + w) {
                            ImU32 col_cue_amb = IM_COL32(255, 160, 0, 255);
                            dl->AddLine(ImVec2(cx_cue, l_pos.y), ImVec2(cx_cue, l_pos.y + lane_h), col_cue_amb, 1.0f);
                            dl->AddRectFilled(ImVec2(cx_cue - 10.0f, l_pos.y + 1.0f), ImVec2(cx_cue + 10.0f, l_pos.y + 12.0f), col_cue_amb, 2.0f);
                            dl->AddText(ImVec2(cx_cue - 8.0f, l_pos.y + 0.5f), IM_COL32(0, 0, 0, 255), "CUE");
                        }
                    }

                    for (int c = 0; c < 8; c++) {
                        if (deck.hot_cues[c].active) {
                            double cf = deck.hot_cues[c].time_sec * deck.sample_rate;
                            float cx = l_pos.x + (float)((cf - start_f_d) / window_frames_d) * wave_w;
                            if (cx >= l_pos.x && cx <= l_pos.x + w) {
                                ImU32 cue_c = deck.hot_cues[c].color_rgba;
                                dl->AddLine(ImVec2(cx, l_pos.y), ImVec2(cx, l_pos.y + lane_h), cue_c, 1.0f);
                                dl->AddRectFilled(ImVec2(cx - 7.0f, l_pos.y + 1.0f), ImVec2(cx + 7.0f, l_pos.y + 13.0f), cue_c, 2.0f);
                                dl->AddText(ImVec2(cx - 4.0f, l_pos.y + 0.5f), IM_COL32(0, 0, 0, 255), hot_cue_letters[c]);
                            }
                        }
                    }

                    // --- REGIÃO E MARCADORES DE LOOP ATIVO REKORDBOX (PISTAS SEPARADAS) ---
                    if (deck.loop_active && deck.loop_length_frames > 0.0 && window_frames_d > 0.0) {
                        ImFont* f_rb = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
                        double l_start = deck.loop_start_frame;
                        double l_end = deck.loop_start_frame + deck.loop_length_frames;
                        float lx_in = l_pos.x + (float)((l_start - start_f_d) / window_frames_d) * wave_w;
                        float lx_out = l_pos.x + (float)((l_end - start_f_d) / window_frames_d) * wave_w;
                        float rx_in = std::clamp(lx_in, l_pos.x, l_pos.x + wave_w);
                        float rx_out = std::clamp(lx_out, l_pos.x, l_pos.x + wave_w);
                        if (rx_out > rx_in) {
                            dl->AddRectFilled(ImVec2(rx_in, l_pos.y), ImVec2(rx_out, l_pos.y + lane_h), IM_COL32(255, 140, 0, 85));
                            dl->AddLine(ImVec2(rx_in, l_pos.y + 0.5f), ImVec2(rx_out, l_pos.y + 0.5f), IM_COL32(255, 200, 30, 255), 2.5f);
                            dl->AddLine(ImVec2(rx_in, l_pos.y + lane_h - 0.5f), ImVec2(rx_out, l_pos.y + lane_h - 0.5f), IM_COL32(255, 200, 30, 255), 2.5f);
                        }
                        if (lx_in >= l_pos.x && lx_in <= l_pos.x + wave_w) {
                            dl->AddLine(ImVec2(lx_in, l_pos.y), ImVec2(lx_in, l_pos.y + lane_h), IM_COL32(255, 215, 35, 255), 2.0f);
                            dl->AddTriangleFilled(ImVec2(lx_in, l_pos.y), ImVec2(lx_in + 7.0f, l_pos.y), ImVec2(lx_in, l_pos.y + 9.0f), IM_COL32(255, 175, 0, 255));
                            dl->AddRectFilled(ImVec2(lx_in, l_pos.y + 1.0f), ImVec2(lx_in + 20.0f, l_pos.y + 13.0f), IM_COL32(255, 155, 0, 255), 2.0f);
                            dl->AddText(f_rb, 10.0f, ImVec2(lx_in + 3.0f, l_pos.y + 1.0f), IM_COL32(0, 0, 0, 255), "IN");
                        }
                        if (lx_out >= l_pos.x && lx_out <= l_pos.x + wave_w) {
                            dl->AddLine(ImVec2(lx_out, l_pos.y), ImVec2(lx_out, l_pos.y + lane_h), IM_COL32(255, 215, 35, 255), 2.0f);
                            dl->AddTriangleFilled(ImVec2(lx_out, l_pos.y), ImVec2(lx_out - 7.0f, l_pos.y), ImVec2(lx_out, l_pos.y + 9.0f), IM_COL32(255, 175, 0, 255));
                            dl->AddRectFilled(ImVec2(lx_out - 26.0f, l_pos.y + 1.0f), ImVec2(lx_out, l_pos.y + 13.0f), IM_COL32(255, 155, 0, 255), 2.0f);
                            dl->AddText(f_rb, 10.0f, ImVec2(lx_out - 24.0f, l_pos.y + 1.0f), IM_COL32(0, 0, 0, 255), "OUT");
                        }
                        if (rx_out - rx_in > 45.0f) {
                            char lp_tag[32];
                            if (std::fmod(deck.loop_beats, 1.0) == 0.0) snprintf(lp_tag, sizeof(lp_tag), "LOOP %.0f B", deck.loop_beats);
                            else snprintf(lp_tag, sizeof(lp_tag), "LOOP %.2f B", deck.loop_beats);
                            ImVec2 t_sz = f_rb->CalcTextSizeA(10.0f, FLT_MAX, 0.0f, lp_tag);
                            float cx = (rx_in + rx_out) * 0.5f;
                            ImVec2 b_min(cx - t_sz.x * 0.5f - 5.0f, l_pos.y + 2.0f);
                            ImVec2 b_max(cx + t_sz.x * 0.5f + 5.0f, l_pos.y + 15.0f);
                            dl->AddRectFilled(b_min, b_max, IM_COL32(18, 12, 4, 235), 3.0f);
                            dl->AddRect(b_min, b_max, IM_COL32(255, 170, 0, 255), 3.0f, 0, 1.0f);
                            dl->AddText(f_rb, 10.0f, ImVec2(b_min.x + 5.0f, b_min.y + 1.0f), IM_COL32(255, 205, 30, 255), lp_tag);
                        }
                    }

                    // --- GHOST PLAYHEAD HOLOGRÁFICO NO SLIP MODE (PISTAS EMPILHADAS) ---
                    if (deck.is_slipping && deck.duration_sec > 0.0 && deck.sample_rate > 1000.0) {
                        float gx = l_pos.x + (float)((deck.slip_virtual_frame - start_f_d) / window_frames_d) * wave_w;
                        float pulse = (std::sin((float)ImGui::GetTime() * 12.0f) + 1.0f) * 0.5f;
                        ImU32 col_ghost_base = (lane == 0) ? IM_COL32(0, 245, 212, 255) : IM_COL32(255, 170, 0, 255);
                        ImU32 col_ghost_pulse = (lane == 0) ? IM_COL32(0, 255, 240, (int)(160 + pulse * 95)) : IM_COL32(255, 190, 20, (int)(160 + pulse * 95));
                        ImU32 col_ghost_glow = (lane == 0) ? IM_COL32(0, 220, 255, (int)(45 + pulse * 35)) : IM_COL32(255, 150, 0, (int)(45 + pulse * 35));

                        double delta_f = deck.slip_virtual_frame - vs.smooth_frame;
                        double beat_len = (deck.bpm > 20.0) ? ((60.0 / deck.bpm) * deck.sample_rate) : (deck.sample_rate * 0.5);
                        double delta_beats = delta_f / beat_len;
                        double delta_bars = delta_beats / 4.0;

                        // 1. Faixa sombreada conectando a agulha atual ao Ghost Playhead
                        float ribbon_x1 = std::clamp(std::min(center_x, gx), l_pos.x, l_pos.x + wave_w);
                        float ribbon_x2 = std::clamp(std::max(center_x, gx), l_pos.x, l_pos.x + wave_w);
                        if (ribbon_x2 - ribbon_x1 > 1.0f) {
                            dl->AddRectFilled(ImVec2(ribbon_x1, l_pos.y + 14.0f), ImVec2(ribbon_x2, l_pos.y + lane_h - 1.0f), col_ghost_glow, 0.0f);
                            dl->AddLine(ImVec2(ribbon_x1, l_pos.y + 14.0f), ImVec2(ribbon_x2, l_pos.y + 14.0f), col_ghost_pulse, 1.5f);
                            dl->AddLine(ImVec2(ribbon_x1, l_pos.y + lane_h - 1.0f), ImVec2(ribbon_x2, l_pos.y + lane_h - 1.0f), col_ghost_pulse, 1.5f);
                        }

                        ImFont* fb_ghost = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();

                        // 2. Agulha Holográfica Laser (quando visível no campo de visão)
                        if (gx >= l_pos.x && gx <= l_pos.x + wave_w) {
                            dl->AddLine(ImVec2(gx, l_pos.y + 14.0f), ImVec2(gx, l_pos.y + lane_h), col_ghost_glow, 6.0f);
                            dl->AddLine(ImVec2(gx, l_pos.y + 14.0f), ImVec2(gx, l_pos.y + lane_h), col_ghost_pulse, 2.0f);
                            dl->AddLine(ImVec2(gx, l_pos.y + 14.0f), ImVec2(gx, l_pos.y + lane_h), IM_COL32(255, 255, 255, (int)(180 + pulse * 75)), 1.0f);

                            dl->AddTriangleFilled(ImVec2(gx - 4.5f, l_pos.y + 14.0f), ImVec2(gx + 4.5f, l_pos.y + 14.0f), ImVec2(gx, l_pos.y + 20.0f), col_ghost_pulse);
                            dl->AddTriangleFilled(ImVec2(gx - 4.5f, l_pos.y + lane_h), ImVec2(gx + 4.5f, l_pos.y + lane_h), ImVec2(gx, l_pos.y + lane_h - 6.0f), col_ghost_pulse);

                            char g_txt[48];
                            snprintf(g_txt, sizeof(g_txt), "SLIP GHOST: %+.1f B (%+.0f)", delta_bars, delta_beats);
                            float f_sz = 10.5f;
                            ImVec2 t_sz = fb_ghost->CalcTextSizeA(f_sz, FLT_MAX, 0.0f, g_txt);
                            float bw = t_sz.x + 12.0f;
                            float bh = 15.0f;
                            float bx = std::clamp(gx - bw * 0.5f, l_pos.x + 2.0f, l_pos.x + wave_w - bw - 2.0f);
                            float by = l_pos.y + 16.0f;
                            dl->AddRectFilled(ImVec2(bx, by), ImVec2(bx + bw, by + bh), IM_COL32(8, 14, 22, 240), 3.0f);
                            dl->AddRect(ImVec2(bx, by), ImVec2(bx + bw, by + bh), col_ghost_pulse, 3.0f, 0, 1.0f);
                            dl->AddText(fb_ghost, f_sz, ImVec2(bx + 6.0f, by + 1.0f), col_ghost_base, g_txt);
                        } else {
                            bool is_ahead = (gx > l_pos.x + wave_w);
                            float edge_x = is_ahead ? (l_pos.x + wave_w - 95.0f) : (l_pos.x + 4.0f);
                            float edge_y = l_pos.y + 16.0f;
                            char off_txt[48];
                            if (is_ahead) snprintf(off_txt, sizeof(off_txt), "SLIP >> %+.1f B", delta_bars);
                            else snprintf(off_txt, sizeof(off_txt), "%+.1f B << SLIP", delta_bars);
                            float f_sz = 10.0f;
                            dl->AddRectFilled(ImVec2(edge_x, edge_y), ImVec2(edge_x + 90.0f, edge_y + 14.0f), IM_COL32(18, 14, 8, 230), 3.0f);
                            dl->AddRect(ImVec2(edge_x, edge_y), ImVec2(edge_x + 90.0f, edge_y + 14.0f), col_ghost_pulse, 3.0f, 0, 1.0f);
                            dl->AddText(fb_ghost, f_sz, ImVec2(edge_x + 5.0f, edge_y + 0.5f), col_ghost_base, off_txt);
                        }
                    }

                char lane_btn_id[32];
                snprintf(lane_btn_id, sizeof(lane_btn_id), "##WaveLane_%d", deck.deck_id);
                ImGui::SetCursorScreenPos(l_pos);
                ImGui::InvisibleButton(lane_btn_id, ImVec2(wave_w, lane_h));

                if (ImGui::BeginDragDropTarget()) {
                    if (const ImGuiPayload* payload = ImGui::AcceptDragDropPayload("DND_DJ_TRACK_ID")) {
                        const char* dropped_id = (const char*)payload->Data;
                        auto* ptr = KuroAudio::DJLibraryManager::getInstance().getTrackById(dropped_id);
                        if (ptr) {
                            if (ptr->is_downloaded) spotify_service.loadLibraryTrack(*ptr, deck.deck_id, engine);
                            else spotify_service.downloadLibraryTrackAsync(*ptr, deck.deck_id, engine);
                        }
                    }
                    dl->AddRect(l_pos, ImVec2(l_pos.x + wave_w, l_pos.y + lane_h), ImGui::ColorConvertFloat4ToU32(theme_col), 2.0f, 0, 2.5f);
                    ImGui::EndDragDropTarget();
                }

                if (ImGui::BeginPopupContextItem()) {
                    ImGui::TextColored(ImVec4(0.00f, 0.95f, 0.83f, 1.0f), " Rekordbox Waveform Color");
                    ImGui::Separator();
                    if (ImGui::MenuItem("RGB (Rekordbox / Traktor Oficial: Rosa Graves, Ciano Medios, Verde Agudos)", nullptr, waveform_color_mode == 0)) {
                        waveform_color_mode = 0;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    if (ImGui::MenuItem("3-BAND (CDJ-3000: Graves Azul, Medios Ambar, Agudos Branco)", nullptr, waveform_color_mode == 1)) {
                        waveform_color_mode = 1;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    if (ImGui::MenuItem("BLUE (CDJ-2000 Classico Rekordbox Azul Monocromatico)", nullptr, waveform_color_mode == 2)) {
                        waveform_color_mode = 2;
                        for (auto& c : wf_cache) c.invalidate();
                    }

                    if (ImGui::MenuItem("NEON (Cyberpunk)", nullptr, waveform_color_mode == 3)) {
                        waveform_color_mode = 3;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    if (ImGui::MenuItem("SUNSET (Festival Solar)", nullptr, waveform_color_mode == 4)) {
                        waveform_color_mode = 4;
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    ImGui::Separator();
                    if (ImGui::MenuItem("Recalcular Waveform de Alta Precisao (Limpar Cache)")) {
                        deck.recomputeDetailedWaveform();
                        for (auto& c : wf_cache) c.invalidate();
                    }
                    ImGui::EndPopup();
                }

                bool lane_active = ImGui::IsItemActive();
                bool lane_clicked = ImGui::IsItemClicked(0);
                bool lane_hovered = ImGui::IsItemHovered();

                if (lane_active) {
                    ImGuiIO& io = ImGui::GetIO();
                    if (io.KeyAlt) {
                        ImGui::SetMouseCursor(ImGuiMouseCursor_ResizeEW);
                        if (io.MouseDelta.x != 0.0f) {
                            double delta_frames = ((double)io.MouseDelta.x / (double)wave_w) * window_frames_d;
                            if (io.KeyShift) delta_frames *= 0.20;
                            deck.first_beat_frame += delta_frames;
                            deck.has_rekordbox_grid = false;
                            deck.rekordbox_beats.clear();
                            KuroAudio::DJGridEngine::getInstance().setFirstBeatMarker(deck.deck_id, deck.first_beat_frame, deck.sample_rate);
                        }
                    } else {
                        deck.jog_touch = true;
                        deck.scratch_active_ticks = 6;
                        if (io.MouseDelta.x != 0.0f) {
                            double delta_frames = -((double)io.MouseDelta.x / (double)w) * window_frames_d;
                            if (io.KeyShift) delta_frames *= 4.0;
                            deck.current_frame = std::clamp(deck.current_frame + delta_frames, 0.0, (double)deck.buffer_l.size());
                            vs.smooth_frame = deck.current_frame;
                            deck.target_scratch_velocity = (float)(-io.MouseDelta.x * 0.18f);
                            deck.jog_visual_angle -= (float)io.MouseDelta.x * 0.025f;
                        }
                    }
                } else if (lane_clicked) {
                    if (ImGui::GetIO().KeyAlt) {
                        float click_x = ImGui::GetMousePos().x;
                        double offset_frames = ((double)(click_x - center_x) / (double)wave_w) * window_frames_d;
                        double target_f = deck.current_frame + offset_frames;
                        deck.first_beat_frame = target_f;
                        deck.has_rekordbox_grid = false;
                        deck.rekordbox_beats.clear();
                        KuroAudio::DJGridEngine::getInstance().setFirstBeatMarker(deck.deck_id, deck.first_beat_frame, deck.sample_rate);
                    } else {
                        float click_x = ImGui::GetMousePos().x;
                        double offset_frames = ((double)(click_x - center_x) / (double)w) * window_frames_d;
                        deck.current_frame = std::clamp(deck.current_frame + offset_frames, 0.0, (double)deck.buffer_l.size());
                        vs.smooth_frame = deck.current_frame;
                    }
                } else if (lane_hovered && ImGui::IsMouseReleased(0)) {
                    deck.jog_touch = false;
                }
            }

            dl->AddLine(ImVec2(center_x, pos.y), ImVec2(center_x, pos.y + total_stack_h), IM_COL32(255, 255, 255, 255), 1.0f);
            ImU32 col_play_tri = IM_COL32(255, 140, 0, 255);
            dl->AddTriangleFilled(ImVec2(center_x - 3.5f, pos.y), ImVec2(center_x + 3.5f, pos.y), ImVec2(center_x, pos.y + 5.5f), col_play_tri);
            dl->AddTriangleFilled(ImVec2(center_x - 3.5f, pos.y + total_stack_h), ImVec2(center_x + 3.5f, pos.y + total_stack_h), ImVec2(center_x, pos.y + total_stack_h - 5.5f), col_play_tri);

            // 6. Badges de Compassos / Bars no Centro Exato de cada pista (sobre o Playhead) em Ouro/Âmbar Luminoso
            for (int l = 0; l < 2; l++) {
                auto& d = (l == 0) ? engine.decks[0] : engine.decks[1];
                float l_y = pos.y + (float)l * (lane_h + lane_gap);
                if (d.bpm > 20.0 && d.sample_rate > 1000.0 && !d.buffer_l.empty()) {
                    double natural_beat_len = (60.0 / d.bpm) * d.sample_rate;
                    double rel_beats = (d.current_frame - d.first_beat_frame) / natural_beat_len;
                    int total_b = (int)std::floor(rel_beats);
                    int bar = (total_b >= 0) ? ((total_b / 4) + 1) : -(((-total_b - 1) / 4) + 1);
                    int beat = (total_b >= 0) ? ((total_b % 4) + 1) : (4 - ((-total_b - 1) % 4));
                    char b_tag[32]; snprintf(b_tag, sizeof(b_tag), "%d.%d BARS", bar, beat);
                    ImFont* fb = g_font_rekordbox_bold ? g_font_rekordbox_bold : ImGui::GetFont();
                    float b_font_sz = 13.0f;
                    ImVec2 bsz = fb->CalcTextSizeA(b_font_sz, FLT_MAX, 0.0f, b_tag);
                    float badge_w = bsz.x + 14.0f;
                    float badge_h = 18.0f;
                    float badge_x = center_x - badge_w * 0.5f;
                    float badge_y = l_y + 3.0f;
                    badge_x = std::clamp(badge_x, wave_x + 2.0f, wave_x + wave_w - badge_w - 2.0f);

                    ImVec2 b_min = ImVec2(badge_x, badge_y);
                    ImVec2 b_max = ImVec2(badge_x + badge_w, badge_y + badge_h);
                    dl->AddRectFilled(b_min, b_max, IM_COL32(8, 11, 16, 240), 4.0f);
                    dl->AddRect(b_min, b_max, IM_COL32(255, 200, 20, 230), 4.0f, 0, 1.2f);
                    ImVec2 t_pos = ImVec2(badge_x + (badge_w - bsz.x) * 0.5f, badge_y + (badge_h - bsz.y) * 0.5f);
                    dl->AddText(fb, b_font_sz, t_pos, IM_COL32(255, 215, 0, 255), b_tag);
                }
            }

            // Fechamento do Visor Rígido Rekordbox no Modo 1
            dl->PopClipRect();

            ImGui::SetCursorScreenPos(ImVec2(pos.x, pos.y + total_stack_h));
            ImGui::Dummy(ImVec2(w, 2.0f));
        }

